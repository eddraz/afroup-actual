// AfroUp Worker — beta
{
  "name": "afroup-beta",
  "main": "dist/server/entry.mjs",
  "compatibility_date": "2026-03-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afroup-db-beta",
      "database_id": "6ccc3d4e-479f-4cde-8ad7-7b7c96154ce7",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "APP_NAME": "AfroUp",
    "EMAIL_FROM_ADDRESS": "verificacion@afroup.com",
    "EMAIL_FROM_NAME": "AfroUp"
  },
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "afroup-avatars-beta"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "6aac44af22a944cf8599e8e66b4f4aa4"
    }
  ],
  "routes": [
    {
      "pattern": "beta.afroup.com/*",
      "zone_name": "afroup.com"
    }
  ]
}
