{
  "name": "afroup",
  "main": "src/index.js",
  "compatibility_date": "2026-03-14",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "afroup.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afroup-db",
      "database_id": "7b41bfc3-d3f0-4eb0-a89f-c3111dbb4ecb",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "AfroUp"
  }
}
