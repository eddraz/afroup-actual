---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const communityHref = localizedPath(locale, routeIds.community);
const collaborateHref = localizedPath(locale, routeIds.collaborate);
const personHref = routeIds.person;
const chips = [
  copy.peopleChipAll,
  copy.peopleChipHistory,
  copy.peopleChipActivism,
  copy.peopleChipArt,
  copy.peopleChipScience,
  copy.peopleChipSport,
] as const;
const people = [
  { name: "Martin Luther King Jr.", role: "Activismo · 1929–1968", figure: "bg-primary/20" },
  { name: "Reina Nzinga", role: "Historia · 1583–1663", figure: "bg-secondary/30" },
  { name: "Lélia Gonzalez", role: "Pensamiento · 1935–1994", figure: "bg-accent/30" },
  { name: "Benkos Biohó", role: "Historia · s. XVII", figure: "bg-secondary/30" },
  { name: "Nina Simone", role: "Arte · 1933–2003", figure: "bg-primary/20" },
  { name: "Francia Márquez", role: "Activismo · Presente", figure: "bg-accent/30" },
] as const;
---

<BaseLayout title={copy.titlePeople} active="comunidad">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li><a href={communityHref}>{copy.navCommunity}</a></li>
      <li>{copy.footerPeople}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] bg-neutral text-neutral-content shadow-lg">
    <div class="absolute inset-y-0 right-0 w-[200px] bg-[url('/assets/pattern.png')] bg-cover bg-center max-md:w-[90px]"></div>
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-secondary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.peopleEyebrow}</p>
      <h1 class="font-display max-w-[18ch] text-[31px] font-bold lg:text-[44px]">{copy.peopleTitle}</h1>
      <p class="max-w-[56ch] text-[17px] leading-[1.55] text-neutral-content/70">{copy.peopleLead}</p>
    </div>
  </section>

  <div class="mt-6 mb-6 flex flex-wrap gap-2" data-chips>
    {
      chips.map((chip, index) => (
        <button class:list={["btn btn-sm", index === 0 ? undefined : "btn-dash"]} data-chip type="button">
          {chip}
        </button>
      ))
    }
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      people.map((person) => (
        <a class="card bg-base-200 shadow" href={personHref}>
          <figure class:list={["relative aspect-[4/3]", person.figure]}>
            <span class="badge badge-sm absolute bottom-3 left-3">retrato</span>
          </figure>
          <div class="card-body">
            <h3 class="card-title font-display">{person.name}</h3>
            <p class="text-sm opacity-60">{person.role}</p>
          </div>
        </a>
      ))
    }
  </div>

  <div class="card bg-neutral text-neutral-content mt-9">
    <div class="card-body sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h3 class="card-title">{copy.peopleBandTitle}</h3>
        <p class="opacity-70">{copy.peopleBandDek}</p>
      </div>
      <div class="card-actions">
        <a class="btn btn-accent" href={collaborateHref}>
          {copy.peopleCta}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <use href="#ic-arrow"></use>
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const chips = document.querySelectorAll("[data-chip]");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((item) => item.classList.add("btn-dash"));
      chip.classList.remove("btn-dash");
    });
  });
</script>
