---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";
import { loadCollaborateSkills, loadCollaboratePageConfig } from "../lib/collaborate";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const communityHref = localizedPath(locale, routeIds.community);

const pageConfig = await loadCollaboratePageConfig(env.DB, locale);
const skills = await loadCollaborateSkills(env.DB, locale, { status: "active" });

const colorMap: Record<string, string> = {
  accent: "bg-accent/20 text-accent",
  secondary: "bg-secondary/30 text-secondary-content",
  primary: "bg-primary/15 text-primary",
  warning: "bg-warning/20 text-warning",
  info: "bg-info/20 text-info",
};
---

<BaseLayout title={pageConfig.title || copy.titleCollaborate} active="comunidad">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li><a href={communityHref}>{copy.navCommunity}</a></li>
      <li>{copy.footerCollaborate}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] bg-accent text-accent-content shadow-lg">
    <div class="absolute inset-y-0 right-0 w-[200px] bg-[url('/assets/pattern.png')] bg-cover bg-center max-md:w-[90px]"></div>
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-xs font-extrabold tracking-[0.18em] uppercase opacity-70">{pageConfig.eyebrow || copy.collabEyebrow}</p>
      <h1 class="font-display max-w-[18ch] text-[31px] font-bold lg:text-[44px]">{pageConfig.title || copy.collabTitle}</h1>
      <p class="max-w-[56ch] text-[17px] leading-[1.55] opacity-80">{pageConfig.lead || copy.collabLead}</p>
    </div>
  </section>

  <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.map((skill) => {
        const wrapClass = colorMap[skill.badge_color] || "bg-accent/20 text-accent";
        return (
          <article class="card bg-base-200 shadow hover:shadow-md transition-shadow">
            <div class="card-body items-center text-center p-6">
              <span class:list={["btn btn-circle pointer-events-none no-animation border-0 shadow-none size-12", wrapClass]}>
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <use href={`#${skill.icon}`}></use>
                </svg>
              </span>
              <h3 class="card-title font-display text-[17px] mt-2">{skill.title}</h3>
              <p class="text-[13px] leading-[1.5] opacity-60 mt-1">{skill.dek}</p>
            </div>
          </article>
        );
      })
    }
  </div>

  <form class="card bg-base-200 mx-auto mt-[34px] max-w-[680px] shadow-lg rounded-3xl border border-base-300" id="public-collab-form">
    <div class="card-body p-6 sm:p-8">
      <h2 class="card-title font-display text-[21px] font-bold text-base-content">{pageConfig.form_title || copy.collabFormTitle}</h2>
      
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 mt-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-bold text-xs">{copy.collabName || "Nombre"}</legend>
          <input class="input input-bordered w-full text-sm" type="text" name="name" placeholder={copy.collabNamePlaceholder || "Tu nombre"} required />
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-bold text-xs">{copy.collabEmail || "Correo"}</legend>
          <input class="input input-bordered w-full text-sm" type="email" name="email" placeholder={copy.collabEmailPlaceholder || "tu@correo.com"} required />
        </fieldset>
      </div>

      <fieldset class="fieldset mt-2">
        <legend class="fieldset-legend font-bold text-xs">{copy.collabRole || "Quiero colaborar como…"}</legend>
        <select class="select select-bordered w-full text-sm font-medium" name="role" required>
          {skills.map((s) => (
            <option value={s.title}>{s.title}</option>
          ))}
          <option value="Otro">{copy.collabRoleOther || "Otro perfil / propuesta libre"}</option>
        </select>
      </fieldset>

      <fieldset class="fieldset mt-2">
        <legend class="fieldset-legend font-bold text-xs">{copy.collabMessage || "Cuéntanos sobre tu experiencia o idea"}</legend>
        <textarea class="textarea textarea-bordered w-full text-sm leading-relaxed" name="message" rows="5" placeholder={copy.collabMessagePlaceholder || "Enlaces a tu trabajo, portafolio, tema que te interesa abordar..."} required></textarea>
      </fieldset>

      <div class="card-actions mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <button class="btn btn-primary font-bold gap-2 shadow-sm" type="submit" id="collab-submit-btn">
          <span>{copy.collabSubmit || "Enviar postulación"}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <use href="#ic-arrow"></use>
          </svg>
        </button>
      </div>

      <p class="text-[12.5px] opacity-60 mt-3">{pageConfig.form_note || copy.collabNote}</p>
    </div>
  </form>
</BaseLayout>

<script>
  function setupPublicCollabForm() {
    const form = document.getElementById("public-collab-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById("collab-submit-btn") as HTMLButtonElement | null;
      const originalText = submitBtn ? submitBtn.innerHTML : "";
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="loading loading-spinner loading-xs"></span> <span>Enviando...</span>';
      }

      const fd = new FormData(form);
      try {
        const res = await fetch("/api/collaborate", { method: "POST", body: fd });
        const result = await res.json();
        if (result.ok) {
          form.reset();
          if ((window as any).AfroUpFeedback) {
            (window as any).AfroUpFeedback.toast(result.message || "¡Postulación enviada!", "success");
          } else {
            alert(result.message || "¡Gracias por tu postulación! Te contactaremos pronto.");
          }
        } else {
          if ((window as any).AfroUpFeedback) {
            (window as any).AfroUpFeedback.toast(result.message || "Error al enviar la postulación.", "error");
          } else {
            alert(result.message || "Error al enviar la postulación.");
          }
        }
      } catch {
        if ((window as any).AfroUpFeedback) {
          (window as any).AfroUpFeedback.toast("Error de conexión. Intenta de nuevo.", "error");
        } else {
          alert("Error de conexión al enviar el formulario.");
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      }
    });
  }

  setupPublicCollabForm();
  document.addEventListener("astro:page-load", setupPublicCollabForm);
</script>
