---
import BaseLayout from "../layouts/BaseLayout.astro";
import SessionAvatar from "../components/SessionAvatar.astro";
import SessionUser from "../components/SessionUser.astro";
import PageLocaleSwitch from "../components/PageLocaleSwitch.astro";
import { env } from "cloudflare:workers";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";
import { getPublicUser, obfuscateEmail, PUBLIC_SESSION_COOKIE } from "../lib/public-session";
import { listSiteLanguages } from "../lib/site-languages";
import { loadUserBios, translationAccessForEmail } from "../lib/user-bios";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const loginHref = localizedPath(locale, routeIds.login);
const logoutHref = `/api/logout?next=${encodeURIComponent(loginHref)}`;

const user = await getPublicUser(env.DB, Astro.cookies.get(PUBLIC_SESSION_COOKIE)?.value);
if (!user) {
  return Astro.redirect(`${loginHref}?next=${encodeURIComponent(Astro.url.pathname)}`, 303);
}

const maskedEmail = obfuscateEmail(user.email);
const languages = await listSiteLanguages(env.DB);
const bios = await loadUserBios(env.DB, user.id);
if (!bios.es && user.bio) bios.es = user.bio;
const translation = await translationAccessForEmail(env.DB, user.email);
---

<BaseLayout title={copy.titleAccount} active="account">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li>{copy.navAccount}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] border border-base-300 bg-base-200 shadow-lg">
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <div class="flex w-full flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex flex-col gap-3">
          <p class="text-primary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.accountEyebrow}</p>
          <h1 class="font-display max-w-[20ch] text-[31px] leading-[1.06] font-bold lg:text-[46px]">{copy.accountTitle}</h1>
        </div>
        <PageLocaleSwitch languages={languages} label={copy.accountBioLanguage} current="es" />
      </div>
      <p class="max-w-[58ch] text-[17px] leading-[1.55] opacity-70">{copy.accountLead}</p>
    </div>
  </section>

  <div class="mt-9 grid grid-cols-1 gap-7 lg:grid-cols-[1.15fr_0.85fr]">
    <div class="tabs tabs-lift w-full">
      <input type="radio" name="account-tabs" class="tab" aria-label={copy.accountProfileTitle} checked="checked" />
      <div class="tab-content bg-base-200 border-base-300 p-0">
        <form class="card shadow-none" data-profile-form>
          <div class="card-body gap-5">
            <div>
              <h2 class="card-title font-display text-[20px] tracking-[-0.005em]">{copy.accountProfileTitle}</h2>
              <p class="text-sm opacity-70">{copy.accountProfileLead}</p>
            </div>

            <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
              <SessionAvatar name={user.name} avatarUrl={user.avatar_url} size="lg" />
              <div class="flex flex-1 flex-col gap-2">
                <p class="text-sm font-semibold">{copy.accountPhotoLabel}</p>
                <div class="flex flex-wrap gap-2">
                  <label class="btn btn-dash btn-sm cursor-pointer">
                    <svg class="size-4"><use href="#ic-camera"></use></svg>
                    {copy.accountPhotoUpload}
                    <input
                      class="hidden"
                      type="file"
                      name="avatar"
                      accept="image/png,image/jpeg,image/webp"
                      data-avatar-file
                      data-error-type={copy.accountPhotoTypeError}
                      data-error-size={copy.accountPhotoSizeError}
                      data-error-upload={copy.accountPhotoUploadError}
                    />
                  </label>
                  {user.avatar_url ? (
                    <button type="button" class="btn btn-ghost btn-sm" data-avatar-remove>{copy.accountPhotoRemove}</button>
                  ) : null}
                </div>
                <p class="text-xs opacity-60">{copy.accountPhotoHelp}</p>
                <div class="alert alert-error hidden" data-avatar-error><span data-avatar-error-text></span></div>
              </div>
            </div>

            <div>
              <p class="text-sm font-semibold">{copy.accountName}</p>
              <p class="mt-1 text-[17px] font-bold">{user.name}</p>
            </div>

            <div>
              <p class="text-sm font-semibold">{copy.loginEmail}</p>
              <p class="mt-1 text-[17px] font-bold">{maskedEmail}</p>
            </div>

            <div class="flex flex-col gap-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-sm font-semibold">{copy.accountBioLabel}</p>
                {translation.canUseAi ? (
                  <button class="btn btn-dash btn-sm" type="button" data-bio-translate>{copy.accountBioTranslate}</button>
                ) : null}
              </div>
              {languages.map((language) => {
                const locked = !translation.canWrite && language.code !== "es";
                const active = language.code === "es";
                return (
                  <fieldset class:list={["fieldset", !active && "hidden"]} data-i18n-panel={language.code}>
                    <legend class="fieldset-legend">{copy.accountBioLabel} · {language.native_name}</legend>
                    <textarea
                      id={language.code === "es" ? "bio" : `bio-${language.code}`}
                      class="textarea w-full"
                      name={`bio[${language.code}]`}
                      rows="4"
                      maxlength="280"
                      placeholder={language.native_name}
                      data-bio-locale={language.code}
                      readonly={locked}
                    >{bios[language.code] ?? ""}</textarea>
                  </fieldset>
                );
              })}
              <p class="text-xs opacity-60">
                {translation.canUseAi
                  ? copy.accountBioTranslateHelp
                  : translation.canWrite
                    ? copy.accountBioManualOnly
                    : copy.accountBioNoTranslate}
              </p>
              <p class="text-xs opacity-60">{copy.accountBioHelp}</p>
              <div class="alert alert-error hidden" data-bio-translate-error><span>{copy.accountBioTranslateError}</span></div>
            </div>

            <div class="alert alert-success hidden" data-profile-success><span>{copy.accountProfileSaved}</span></div>
            <div class="alert alert-error hidden" data-profile-error><span>{copy.accountProfileSaveError}</span></div>
            <button class="btn btn-primary mt-2 h-[46px] min-h-[46px]" type="submit">
              {copy.accountProfileSave}
              <svg class="size-4"><use href="#ic-arrow"></use></svg>
            </button>
          </div>
        </form>
      </div>

      <input type="radio" name="account-tabs" class="tab" aria-label={copy.accountPasswordTab} />
      <div class="tab-content bg-base-200 border-base-300 p-0">
        <form class="card shadow-none" data-password-form>
          <div class="card-body gap-5">
            <div>
              <h2 class="card-title font-display text-[20px] tracking-[-0.005em]">{copy.accountPasswordTab}</h2>
              <p class="text-sm opacity-70">{copy.accountSecurityLead}</p>
            </div>

            <fieldset class="fieldset">
              <legend class="fieldset-legend">{copy.accountCurrentPassword}</legend>
              <input class="input w-full" type="password" name="current" autocomplete="current-password" placeholder={copy.accountCurrentPasswordPlaceholder} required />
            </fieldset>

            <fieldset class="fieldset">
              <legend class="fieldset-legend">{copy.accountNewPassword}</legend>
              <input class="input w-full" type="password" name="new" autocomplete="new-password" placeholder={copy.accountNewPasswordPlaceholder} minlength="8" required />
            </fieldset>

            <fieldset class="fieldset">
              <legend class="fieldset-legend">{copy.accountConfirmPassword}</legend>
              <input class="input w-full" type="password" name="confirm" autocomplete="new-password" placeholder={copy.accountConfirmPasswordPlaceholder} minlength="8" required />
            </fieldset>

            <div class="alert alert-success hidden" data-password-success><span>{copy.accountPasswordSaved}</span></div>
            <div class="alert alert-error hidden" data-password-error><span data-password-error-text>{copy.accountPasswordSaveError}</span></div>
            <button class="btn btn-primary mt-2 h-[46px] min-h-[46px]" type="submit">
              {copy.accountPasswordSubmit}
              <svg class="size-4"><use href="#ic-arrow"></use></svg>
            </button>
          </div>
        </form>
      </div>

      <input type="radio" name="account-tabs" class="tab" aria-label={copy.accountDangerTitle} />
      <div class="tab-content border-error/40 bg-error/5 p-0">
        <section class="card shadow-none">
          <div class="card-body gap-4">
            <div>
              <h2 class="card-title font-display text-[20px] tracking-[-0.005em]">{copy.accountDangerTitle}</h2>
              <p class="text-sm opacity-80">{copy.accountDangerLead}</p>
            </div>
            <button class="btn btn-error btn-outline self-start" type="button" onclick="document.getElementById('delete-account-dialog').showModal()">
              <svg class="size-4"><use href="#ic-trash"></use></svg>
              {copy.accountDeleteButton}
            </button>
          </div>
        </section>
      </div>
    </div>

    <aside class="flex flex-col gap-5">
      <div class="card bg-base-200 shadow">
        <div class="card-body gap-4">
          <SessionUser name={user.name} email={maskedEmail} avatarUrl={user.avatar_url} size="md" showEmail />
          <form method="post" action={logoutHref}>
            <button class="btn btn-dash btn-sm self-start" type="submit">
              <svg class="size-4"><use href="#ic-logout"></use></svg>
              {copy.accountLogout}
            </button>
          </form>
        </div>
      </div>

      <div class="card bg-base-200 shadow">
        <div class="card-body gap-3">
          <p class="text-sm opacity-70">{copy.accountLead}</p>
          <a class="btn btn-ghost btn-sm self-start" href={homeHref}>{copy.accountBackHome}</a>
        </div>
      </div>
    </aside>
  </div>

  <dialog id="delete-account-dialog" class="modal">
    <div class="modal-box max-w-[440px]">
      <h3 class="font-display text-[20px] tracking-[-0.005em]">{copy.accountDeleteConfirmTitle}</h3>
      <p class="mt-2 text-sm opacity-70">{copy.accountDeleteConfirmLead}</p>
      <p class="mt-4 text-sm">{copy.accountDeletePhrase}</p>
      <input class="input mt-2 w-full" type="text" name="confirm" placeholder={copy.accountDeleteConfirmPlaceholder} data-confirm-delete />
      <div class="alert alert-error mt-3 hidden" data-delete-error><span>{copy.accountDeleteError}</span></div>
      <div class="modal-action mt-5 flex-wrap gap-2">
        <form method="dialog" class="contents">
          <button class="btn btn-ghost btn-sm" type="submit">{copy.accountDeleteCancel}</button>
        </form>
        <button class="btn btn-error btn-sm" type="button" disabled data-confirm-delete-submit data-target={locale === "en" ? "delete" : "eliminar"}>
          <svg class="size-4"><use href="#ic-trash"></use></svg>
          {copy.accountDeleteConfirm}
        </button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  <dialog id="avatar-remove-dialog" class="modal">
    <div class="modal-box max-w-[440px]">
      <h3 class="font-display text-[20px] tracking-[-0.005em]">{copy.accountPhotoRemoveTitle}</h3>
      <p class="mt-2 text-sm opacity-70">{copy.accountPhotoRemoveLead}</p>
      <div class="modal-action">
        <button class="btn btn-ghost btn-sm" type="button" data-avatar-remove-cancel>{copy.accountPhotoCropCancel}</button>
        <button class="btn btn-error btn-sm" type="button" data-avatar-remove-confirm>
          <svg class="size-4"><use href="#ic-trash"></use></svg>
          {copy.accountPhotoRemoveConfirm}
        </button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  <dialog id="avatar-crop-dialog" class="modal">
    <div class="modal-box max-w-[440px]">
      <h3 class="font-display text-[20px] tracking-[-0.005em]">{copy.accountPhotoCropTitle}</h3>
      <p class="mt-2 text-sm opacity-70">{copy.accountPhotoCropLead}</p>
      <canvas id="avatar-crop-canvas" class="mt-4 w-full cursor-move rounded-box border border-base-300 bg-neutral" width="360" height="360"></canvas>
      <label class="mt-4 flex items-center gap-3 text-sm">
        <span class="shrink-0">{copy.accountPhotoCropZoom}</span>
        <input id="avatar-crop-zoom" class="range range-sm range-primary" type="range" min="1" max="3" step="0.01" value="1" />
      </label>
      <div class="modal-action">
        <button class="btn btn-ghost btn-sm" type="button" data-avatar-crop-cancel>{copy.accountPhotoCropCancel}</button>
        <button class="btn btn-primary btn-sm" type="button" data-avatar-crop-save>{copy.accountPhotoCropSave}</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  <script is:inline src="/rich-editor.js"></script>
  <script is:inline src="/avatar-crop.js"></script>
  <script is:inline>
    (function () {
      var bind = function () {
        if (window.AfroUpRichEditor) {
          document.querySelectorAll("[data-bio-locale]").forEach(function (field) {
            if (field.id) window.AfroUpRichEditor.attach("#" + field.id);
          });
        }
        var translateBtn = document.querySelector("[data-bio-translate]");
        if (translateBtn && translateBtn.dataset.bound !== "true") {
          translateBtn.dataset.bound = "true";
          translateBtn.addEventListener("click", function () {
            var source = document.querySelector('[data-bio-locale="es"]');
            var targets = document.querySelectorAll("[data-bio-locale]:not([data-bio-locale=es])");
            var errorBox = document.querySelector("[data-bio-translate-error]");
            if (!source || !source.value.trim()) return;
            if (errorBox) errorBox.classList.add("hidden");
            translateBtn.disabled = true;
            var jobs = Array.prototype.map.call(targets, function (field) {
              var data = new FormData();
              data.set("source", source.value);
              data.set("target", field.getAttribute("data-bio-locale"));
              return fetch("/api/profile/translate", { method: "POST", body: data })
                .then(function (res) { return res.json(); })
                .then(function (result) {
                  if (!result || !result.ok) throw new Error("translate");
                  field.value = result.text;
                });
            });
            Promise.all(jobs)
              .catch(function () {
                if (errorBox) errorBox.classList.remove("hidden");
              })
              .finally(function () {
                translateBtn.disabled = false;
              });
          });
        }
        var profileForm = document.querySelector("[data-profile-form]");
        if (profileForm && profileForm.dataset.bound !== "true") {
          profileForm.dataset.bound = "true";
          profileForm.addEventListener("submit", function (event) {
            event.preventDefault();
            var submit = profileForm.querySelector("button[type=submit]");
            var success = profileForm.querySelector("[data-profile-success]");
            var errorBox = profileForm.querySelector("[data-profile-error]");
            if (success) success.classList.add("hidden");
            if (errorBox) errorBox.classList.add("hidden");
            if (submit) submit.disabled = true;
            fetch("/api/profile", { method: "POST", body: new FormData(profileForm) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (!result.ok) throw new Error("save");
                if (success) success.classList.remove("hidden");
                if (submit) submit.disabled = false;
              })
              .catch(function () {
                if (errorBox) errorBox.classList.remove("hidden");
                if (submit) submit.disabled = false;
              });
          });
        }
        var passwordForm = document.querySelector("[data-password-form]");
        if (passwordForm && passwordForm.dataset.bound !== "true") {
          passwordForm.dataset.bound = "true";
          passwordForm.addEventListener("submit", function (event) {
            event.preventDefault();
            var submit = passwordForm.querySelector("button[type=submit]");
            var success = passwordForm.querySelector("[data-password-success]");
            var errorBox = passwordForm.querySelector("[data-password-error]");
            var errorText = passwordForm.querySelector("[data-password-error-text]");
            if (success) success.classList.add("hidden");
            if (errorBox) errorBox.classList.add("hidden");
            if (submit) submit.disabled = true;
            var lang = document.documentElement.lang === "en" ? "en" : "es";
            var messages = {
              password_mismatch: lang === "en" ? "The new passwords don't match." : "Las contraseñas nuevas no coinciden.",
              invalid_current: lang === "en" ? "The current password is incorrect." : "La contraseña actual no es correcta.",
              password_short: lang === "en" ? "Use at least 8 characters." : "Usa al menos 8 caracteres.",
            };
            fetch("/api/password", { method: "POST", body: new FormData(passwordForm) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (!result.ok) {
                  if (errorText) errorText.textContent = messages[result.body && result.body.error] || errorText.textContent;
                  throw new Error("save");
                }
                passwordForm.reset();
                if (success) success.classList.remove("hidden");
                if (submit) submit.disabled = false;
              })
              .catch(function () {
                if (errorBox) errorBox.classList.remove("hidden");
                if (submit) submit.disabled = false;
              });
          });
        }
        var input = document.querySelector("[data-confirm-delete]");
        var submit = document.querySelector("[data-confirm-delete-submit]");
        if (!input || !submit || submit.dataset.bound === "true") return;
        submit.dataset.bound = "true";
        var target = (submit.getAttribute("data-target") || "").toLowerCase();
        var errorBox = document.querySelector("[data-delete-error]");
        var update = function () {
          submit.disabled = input.value.trim().toLowerCase() !== target;
        };
        input.addEventListener("input", update);
        update();
        submit.addEventListener("click", function () {
          if (input.value.trim().toLowerCase() !== target) return;
          if (errorBox) errorBox.classList.add("hidden");
          submit.disabled = true;
          var data = new FormData();
          data.append("confirm", input.value.trim());
          fetch("/api/account", { method: "DELETE", body: data })
            .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
            .then(function (result) {
              if (!result.ok) throw new Error("delete");
              window.location.href = document.documentElement.lang === "en" ? "/en/login" : "/login";
            })
            .catch(function () {
              if (errorBox) errorBox.classList.remove("hidden");
              submit.disabled = false;
            });
        });
      };
      bind();
      document.addEventListener("astro:after-swap", bind);
    })();
  </script>
</BaseLayout>
