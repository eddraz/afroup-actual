---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const loginHref = localizedPath(locale, routeIds.login);
const supportHref = localizedPath(locale, routeIds.support);
---

<BaseLayout title={copy.titleRecover} active="recover">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li><a href={loginHref}>{copy.navLogin}</a></li>
      <li>{copy.recoverTitle}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] border border-base-300 bg-base-200 shadow-lg">
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-primary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.recoverEyebrow}</p>
      <h1 class="font-display max-w-[20ch] text-[31px] leading-[1.06] font-bold lg:text-[46px]">{copy.recoverTitle}</h1>
      <p class="max-w-[58ch] text-[17px] leading-[1.55] opacity-70">{copy.recoverLead}</p>
    </div>
  </section>

  <div class="mt-9 grid grid-cols-1 gap-7 lg:grid-cols-[1.15fr_0.85fr]">
    <form class="card bg-base-200 shadow" data-recover-form>
      <div class="card-body gap-4">
        <h2 class="card-title font-display text-[22px] tracking-[-0.005em]">{copy.recoverTitle}</h2>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.loginEmail}</legend>
          <input class="input w-full" type="email" name="email" autocomplete="email" placeholder={copy.loginEmailPlaceholder} required />
        </fieldset>

        <div class="alert alert-success hidden" data-recover-success>
          <span>{copy.recoverSentLead}</span>
        </div>
        <div class="alert alert-error hidden" data-recover-error><span data-recover-error-text>{copy.recoverEmailFailed}</span></div>

        <button class="btn btn-primary mt-2 h-[46px] min-h-[46px]" type="submit">
          {copy.recoverSubmit}
          <svg class="size-4"><use href="#ic-arrow"></use></svg>
        </button>

        <a class="btn btn-ghost btn-sm mt-1 self-center" href={loginHref}>{copy.recoverBack}</a>
      </div>
    </form>

    <aside class="flex flex-col gap-5">
      <div class="card bg-base-200 shadow">
        <div class="card-body gap-4">
          <div class="flex items-start gap-3">
            <div class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-full">
              <svg class="size-5"><use href="#ic-mail"></use></svg>
            </div>
            <div>
              <p class="font-bold">{copy.recoverHelpTitle}</p>
              <p class="text-sm opacity-70">{copy.recoverHelpLead}</p>
            </div>
          </div>
          <p class="text-sm">{copy.recoverHelpBack}</p>
          <a class="btn btn-dash btn-sm self-start" href={loginHref}>{copy.recoverBack}</a>
        </div>
      </div>

      <div class="card bg-accent text-accent-content shadow">
        <div class="card-body gap-3">
          <h3 class="font-display text-[19px] tracking-[-0.005em]">{copy.supportTitle}</h3>
          <p class="text-sm opacity-90">{copy.supportLead}</p>
          <a class="btn btn-neutral btn-block" href={supportHref}>
            <svg class="size-4"><use href="#ic-heart"></use></svg>
            {copy.donateCta}
          </a>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
  <script is:inline>
    (function () {
      var form = document.querySelector("[data-recover-form]");
      if (!form || form.dataset.bound === "true") return;
      form.dataset.bound = "true";
      form.addEventListener("submit", function (event) {
        event.preventDefault();
        var submit = form.querySelector("button[type=submit]");
        var success = form.querySelector("[data-recover-success]");
        var errorBox = form.querySelector("[data-recover-error]");
        var errorText = form.querySelector("[data-recover-error-text]");
        if (success) success.classList.add("hidden");
        if (errorBox) errorBox.classList.add("hidden");
        if (submit) submit.disabled = true;
        var data = new FormData(form);
        data.set("locale", document.documentElement.lang === "en" ? "en" : "es");
        fetch("/api/recover", { method: "POST", body: data })
          .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
          .then(function (result) {
            if (!result.ok) {
              if (errorText && result.body && result.body.error === "email_invalid") {
                errorText.textContent = document.documentElement.lang === "en" ? "Enter a valid email." : "Ingresa un correo válido.";
              }
              throw new Error("recover");
            }
            if (success) success.classList.remove("hidden");
            if (submit) submit.disabled = false;
          })
          .catch(function () {
            if (errorBox) errorBox.classList.remove("hidden");
            if (submit) submit.disabled = false;
          });
      });
    })();
  </script>
