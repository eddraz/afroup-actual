---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import CategoryEditor from "../../../../components/CategoryEditor.astro";
import { joinPath, localizedPath } from "../../../../lib/i18n";
import { requireModuleAccess } from "../../../../lib/admin-scope";
import { defaultLocale } from "../../../../lib/i18n";
import { resolveRequestCopy } from "../../../../lib/request-locale";
import { canManageOwnedRecord, translationAccess } from "../../../../lib/editorial";
import { routeIds } from "../../../../lib/paths";
import { listSiteLanguages } from "../../../../lib/site-languages";
import { parseOgMetadata } from "../../../../lib/og-metadata";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "categorias", "update");
if (access instanceof Response) return access;
const actor = access;

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) return new Response(null, { status: 404 });
if (!(await canManageOwnedRecord(env.DB, actor.id, "article_categories", id, "categorias"))) {
  return Response.redirect(new URL(localizedPath(locale, joinPath(routeIds.admin, "categorias")), Astro.url).toString(), 303);
}

const category = await env.DB.prepare("SELECT id, slug FROM article_categories WHERE id = ? LIMIT 1")
  .bind(id)
  .first<{ id: number; slug: string }>();
if (!category) return new Response(null, { status: 404 });

const localeRows = (await env.DB.prepare(
  "SELECT locale, title, description, og_json FROM article_category_locales WHERE category_id = ?",
)
  .bind(id)
  .all<{ locale: string; title: string; description: string; og_json: string }>()).results ?? [];
const titles = Object.fromEntries(localeRows.map((row) => [row.locale, row.title]));
const descriptions = Object.fromEntries(localeRows.map((row) => [row.locale, row.description]));
const ogs = Object.fromEntries(localeRows.map((row) => [row.locale, parseOgMetadata(row.og_json)]));
const translation = await translationAccess(env.DB, actor.id, "categorias", "update");
const languages = await listSiteLanguages(env.DB);
const listHref = localizedPath(locale, joinPath(routeIds.admin, "categorias"));
---

<AdminLayout title={`${copy.adminEdit}: ${titles[defaultLocale] || category.slug}`} active="categories">
  <CategoryEditor
    category={category}
    titles={titles}
    descriptions={descriptions}
    ogs={ogs}
    languages={languages}
    translation={translation}
    locale={locale}
    copy={copy}
    backHref={listHref}
    layoutMode="full"
  />
</AdminLayout>
