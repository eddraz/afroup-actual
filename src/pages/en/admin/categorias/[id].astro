---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import PageLocaleSwitch from "../../../../components/PageLocaleSwitch.astro";
import { joinPath, localizedPath } from "../../../../lib/i18n";
import { requireModuleAccess } from "../../../../lib/admin-scope";
import { defaultLocale } from "../../../../lib/i18n";
import { resolveRequestCopy } from "../../../../lib/request-locale";
import { canManageOwnedRecord, translationAccess } from "../../../../lib/editorial";
import { routeIds } from "../../../../lib/paths";
import { listSiteLanguages } from "../../../../lib/site-languages";
import OgMetadataFields from "../../../../components/OgMetadataFields.astro";
import { parseOgMetadata } from "../../../../lib/og-metadata";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "categorias", "update");
if (access instanceof Response) return access;
const actor = access;

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) return new Response(null, { status: 404 });
if (!(await canManageOwnedRecord(env.DB, actor.id, "article_categories", id, "categorias"))) {
  return Response.redirect(new URL(localizedPath(locale, joinPath(routeIds.admin, "categorias")), Astro.url).toString(), 303);
}

const category = await env.DB.prepare("SELECT id, slug FROM article_categories WHERE id = ? LIMIT 1")
  .bind(id)
  .first<{ id: number; slug: string }>();
if (!category) return new Response(null, { status: 404 });

const localeRows = (await env.DB.prepare(
  "SELECT locale, title, description, og_json FROM article_category_locales WHERE category_id = ?",
)
  .bind(id)
  .all<{ locale: string; title: string; description: string; og_json: string }>()).results ?? [];
const titles = Object.fromEntries(localeRows.map((row) => [row.locale, row.title]));
const descriptions = Object.fromEntries(localeRows.map((row) => [row.locale, row.description]));
const ogs = Object.fromEntries(localeRows.map((row) => [row.locale, parseOgMetadata(row.og_json)]));
const translation = await translationAccess(env.DB, actor.id, "categorias", "update");
const languages = await listSiteLanguages(env.DB);
const listHref = localizedPath(locale, joinPath(routeIds.admin, "categorias"));
---

<AdminLayout title={`${copy.adminEdit}: ${titles[defaultLocale] || category.slug}`} active="categories">
  <form
    method="post"
    action="/api/admin/categories"
    class="space-y-6"
    data-editorial-form
    data-success={copy.adminEditorialSaved}
    data-error={copy.adminEditorialSaveError}
  >
    <input type="hidden" name="id" value={category.id} />

    <!-- Sticky Top Action Bar -->
    <div class="sticky top-0 z-20 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-100/95 p-3.5 backdrop-blur-md shadow-xs">
      <div class="flex items-center gap-3 min-w-0">
        <a class="btn btn-ghost btn-sm gap-1.5 text-xs font-bold" href={listHref}>
          <svg class="size-4"><use href="#ic-arrow"></use></svg>
          <span>{copy.adminCategories}</span>
        </a>
        <span class="text-base-content/30 hidden sm:inline">/</span>
        <span class="font-display font-bold text-sm text-base-content truncate hidden sm:inline max-w-[320px]">
          {titles[defaultLocale] || category.slug}
        </span>
        <span class="badge badge-neutral badge-xs py-1 px-2 font-mono hidden md:inline-flex">#{category.id}</span>
      </div>

      <div class="flex items-center gap-2">
        <button class="btn btn-primary btn-sm px-6 font-bold shadow-sm hover:scale-[1.02] transition-transform" type="submit">
          <svg class="size-4"><use href="#ic-check"></use></svg>
          <span>{copy.adminSave}</span>
        </button>
      </div>
    </div>

    <!-- Category Form Container -->
    <div class="rounded-3xl border border-base-300 bg-base-100 p-6 sm:p-8 shadow-xs space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-base-300 pb-4">
        <div>
          <h3 class="font-display text-lg font-bold text-base-content">
            Editorial & Multilingual Details
          </h3>
          <p class="text-xs text-base-content/60 mt-0.5">Configure title and theme description in each active language.</p>
        </div>
        <PageLocaleSwitch languages={languages} label={copy.adminLanguages} current={defaultLocale} />
      </div>

      {languages.map((language) => {
        const locked = language.code !== defaultLocale && !translation.canWrite && !translation.canUseAi;
        return (
          <div class:list={["grid grid-cols-1 gap-4", language.code !== defaultLocale && "hidden"]} data-i18n-panel={language.code}>
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">
                {copy.adminCategoryTitle} · {language.native_name}
              </legend>
              <input
                class="input input-bordered w-full font-semibold text-lg py-3"
                name={`title[${language.code}]`}
                maxlength="160"
                required={language.code === defaultLocale}
                disabled={locked}
                value={titles[language.code] ?? ""}
                placeholder="Category title..."
              />
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">
                {copy.adminCategoryDescription} · {language.native_name}
              </legend>
              <textarea
                class="textarea textarea-bordered w-full text-base leading-relaxed"
                name={`description[${language.code}]`}
                rows="3"
                maxlength="400"
                disabled={locked}
                placeholder="Editorial description of the theme..."
              >{descriptions[language.code] ?? ""}</textarea>
            </fieldset>
            <OgMetadataFields
              localeCode={language.code}
              values={ogs[language.code]}
              canUseAi={translation.canUseAi}
              kind="category"
              moduleSlug="categorias"
              copy={copy}
              disabled={locked}
            />
          </div>
        );
      })}

      <fieldset class="fieldset border-t border-base-300/80 pt-4">
        <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminCategorySlug}</legend>
        <input
          class="input input-bordered w-full font-mono text-xs max-w-md"
          name="slug"
          pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
          maxlength="80"
          value={category.slug}
          placeholder="category-slug"
        />
        <p class="text-[11px] text-base-content/50 mt-1">Unique URL identifier used for public site navigation.</p>
      </fieldset>
    </div>
  </form>

  <script is:inline>
    (function () {
      var bind = function () {
        document.querySelectorAll("form[data-editorial-form]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            var btn = form.querySelector("button[type='submit']");
            if (btn) btn.disabled = true;

            fetch(form.action, { method: "POST", body: new FormData(form) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast(form.getAttribute("data-success") || "Saved.", "success");
                  setTimeout(function () { window.location.reload(); }, 600);
                  return;
                }
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast(form.getAttribute("data-error") || "Failed to save.", "error");
                if (btn) btn.disabled = false;
              })
              .catch(function () {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Network error.", "error");
                if (btn) btn.disabled = false;
              });
          });
        });
      };
      bind();
      document.addEventListener("astro:page-load", bind);
    })();
  </script>
</AdminLayout>
