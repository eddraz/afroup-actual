---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { resolveRequestCopy } from "../../../lib/request-locale";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import AdminToolbar from "../../../components/admin/AdminToolbar.astro";
import AdminTable from "../../../components/admin/AdminTable.astro";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "proyectos");
if (access instanceof Response) return access;
const actor = access;

const projects = [
  { id: 1, name: "Afro-Colombian Oral Archive", org: "Casa de la Memoria", stage: "Under Review", budget: "USD 8,500", date: "Jun 10" },
  { id: 2, name: "Afro-Latin American Atlas", org: "Red AfroLatam", stage: "Approved", budget: "USD 12,000", date: "Jun 02" },
  { id: 3, name: "Podcast: Pacific Knowledge", org: "Colectivo Tambó", stage: "Draft", budget: "USD 3,200", date: "May 28" },
];
---

<AdminLayout title={copy.adminProjects} active="projects">
  <!-- Page Header -->
  <AdminPageHeader
    title={copy.adminProjects}
    count={projects.length}
    countLabel="initiatives"
    lead="Tracking grants, community initiatives, and funded cultural projects."
  />

  <!-- Filter & Search Toolbar -->
  <AdminToolbar
    searchId="projects-search"
    searchPlaceholder="Search initiatives by title or organization..."
    filterName="project"
    filters={[
      { value: "all", label: "All", count: projects.length },
      { value: "Approved", label: "Approved", count: projects.filter((p) => p.stage === "Approved").length },
      { value: "Under Review", label: "Under Review", count: projects.filter((p) => p.stage === "Under Review").length },
      { value: "Draft", label: "Drafts", count: projects.filter((p) => p.stage === "Draft").length },
    ]}
  />

  <!-- Projects Table -->
  <AdminTable
    id="projects-table"
    columns={[
      { label: "Project", class: "py-4 pl-6" },
      { label: "Organization" },
      { label: "Stage" },
      { label: "Budget" },
      { label: "Date", class: "text-right pr-6" },
    ]}
  >
    <Fragment slot="rows">
      {projects.map((project) => (
        <tr class="hover:bg-base-200/50 transition-colors project-row" data-name={project.name.toLowerCase()} data-org={project.org.toLowerCase()} data-stage={project.stage}>
          <td class="py-3.5 pl-6 font-bold text-base-content">{project.name}</td>
          <td class="text-xs text-base-content/70">{project.org}</td>
          <td>
            <span class:list={[
              "badge badge-xs font-bold py-1 px-2.5 uppercase tracking-wider",
              project.stage === "Approved" && "badge-success",
              project.stage === "Under Review" && "badge-warning",
              project.stage === "Draft" && "badge-ghost"
            ]}>
              {project.stage}
            </span>
          </td>
          <td>
            <span class="font-mono text-xs font-bold text-base-content/90">{project.budget}</span>
          </td>
          <td class="text-right pr-6 text-xs text-base-content/60">{project.date}</td>
        </tr>
      ))}
    </Fragment>
  </AdminTable>

  <script is:inline>
    (function () {
      var bind = function () {
        var searchInput = document.getElementById("projects-search");
        var filterButtons = document.querySelectorAll(".project-filter-btn");
        var rows = document.querySelectorAll(".project-row");

        var currentFilter = "all";
        var searchQuery = "";

        var applyFilters = function () {
          rows.forEach(function (row) {
            var name = row.getAttribute("data-name") || "";
            var org = row.getAttribute("data-org") || "";
            var stage = row.getAttribute("data-stage") || "";

            var matchesSearch = !searchQuery || name.indexOf(searchQuery) !== -1 || org.indexOf(searchQuery) !== -1;
            var matchesFilter = currentFilter === "all" || stage === currentFilter;

            if (matchesSearch && matchesFilter) {
              row.style.display = "";
            } else {
              row.style.display = "none";
            }
          });
        };

        if (searchInput && searchInput.dataset.bound !== "true") {
          searchInput.dataset.bound = "true";
          searchInput.addEventListener("input", function () {
            searchQuery = searchInput.value.trim().toLowerCase();
            applyFilters();
          });
        }

        filterButtons.forEach(function (btn) {
          if (btn.dataset.bound === "true") return;
          btn.dataset.bound = "true";
          btn.addEventListener("click", function () {
            filterButtons.forEach(function (b) {
              b.classList.remove("btn-primary", "text-primary-content");
              b.classList.add("btn-ghost");
            });
            btn.classList.remove("btn-ghost");
            btn.classList.add("btn-primary", "text-primary-content");

            currentFilter = btn.getAttribute("data-filter") || "all";
            applyFilters();
          });
        });
      };

      bind();
      document.addEventListener("astro:page-load", bind);
    })();
  </script>
</AdminLayout>
