---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import PermissionMatrix from "../../../components/PermissionMatrix.astro";
import { localizedPath } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { routeIds } from "../../../lib/paths";
import { env } from "cloudflare:workers";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "permisos");
if (access instanceof Response) return access;
const actor = access;

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
}

interface PermissionRow {
  id: number;
  module_id: number;
  action: "create" | "read" | "update" | "delete";
}

const modules = (await env.DB.prepare(
  "SELECT id, name, slug FROM admin_modules ORDER BY name",
).all<ModuleRow>()).results ?? [];

const permissions = (await env.DB.prepare(
  "SELECT id, module_id, action FROM admin_permissions ORDER BY module_id, action",
).all<PermissionRow>()).results ?? [];

const actionLabels: Record<PermissionRow["action"], string> = {
  create: copy.adminActionCreate,
  read: copy.adminActionRead,
  update: copy.adminActionUpdate,
  delete: copy.adminActionDelete,
};
---

<AdminLayout title={copy.adminPermissions} active="permissions">
  <!-- Page Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5">
        <h2 class="font-display text-2xl font-bold text-base-content">{copy.adminPermissions}</h2>
        <span class="badge badge-neutral badge-sm font-semibold">{permissions.length} rules</span>
      </div>
      <p class="text-xs sm:text-sm text-base-content/60 mt-1">
        Global system permission catalog defined per module and action.
      </p>
    </div>
  </div>

  <div class="rounded-3xl border border-base-300 bg-base-100 p-6 sm:p-8 shadow-xs">
    <PermissionMatrix
      modules={modules}
      permissions={permissions}
      actionLabels={actionLabels}
      allowLabel={copy.adminPermissionAllow}
      limitLabel={copy.adminPermissionLimit}
      translateLabel={copy.adminPermissionTranslate}
      translateNoneLabel={copy.adminPermissionTranslateNone}
      translateManualLabel={copy.adminPermissionTranslateManual}
      translateAiLabel={copy.adminPermissionTranslateAi}
      unlimitedLabel={copy.adminPermissionUnlimited}
      noneLabel={copy.adminPermissionNone}
      helpToggleLabel={copy.adminPermissionHelpToggle}
      doneLabel={copy.adminPermissionDone}
      helpCreate={copy.adminPermissionHelpCreate}
      helpRead={copy.adminPermissionHelpRead}
      helpUpdate={copy.adminPermissionHelpUpdate}
      helpDelete={copy.adminPermissionHelpDelete}
      helpAllow={copy.adminPermissionHelpAllow}
      helpLimit={copy.adminPermissionHelpLimit}
      helpTranslate={copy.adminPermissionHelpTranslate}
      readonly
    />
  </div>
</AdminLayout>