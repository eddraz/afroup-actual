---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../../../lib/i18n";
import { routeIds } from "../../../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
---

<AdminLayout title={copy.titleAdmin} active="dashboard">
  <header class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-end">
    <div>
      <p class="text-primary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.navAdmin}</p>
      <h1 class="font-display text-[28px] leading-[1.06] font-bold tracking-[-0.005em] lg:text-[34px]">{copy.adminDashboard}</h1>
    </div>
    <a class="btn btn-sm btn-ghost" href={homeHref}>{copy.adminBackSite}</a>
  </header>

  <section class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body gap-1">
        <p class="text-xs font-extrabold tracking-[0.16em] text-base-content/60 uppercase">{copy.adminStatsArticles}</p>
        <p class="font-display text-[32px] leading-none font-bold">128</p>
        <p class="text-xs text-success font-bold">{copy.adminStatsArticlesTrend}</p>
      </div>
    </div>
    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body gap-1">
        <p class="text-xs font-extrabold tracking-[0.16em] text-base-content/60 uppercase">{copy.adminStatsUsers}</p>
        <p class="font-display text-[32px] leading-none font-bold">4 218</p>
        <p class="text-xs text-success font-bold">{copy.adminStatsUsersTrend}</p>
      </div>
    </div>
    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body gap-1">
        <p class="text-xs font-extrabold tracking-[0.16em] text-base-content/60 uppercase">{copy.adminStatsComments}</p>
        <p class="font-display text-[32px] leading-none font-bold">23</p>
        <p class="text-xs text-warning font-bold">{copy.adminStatsCommentsTrend}</p>
      </div>
    </div>
    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body gap-1">
        <p class="text-xs font-extrabold tracking-[0.16em] text-base-content/60 uppercase">{copy.adminStatsRevenue}</p>
        <p class="font-display text-[32px] leading-none font-bold">$1.240</p>
        <p class="text-xs text-success font-bold">{copy.adminStatsRevenueTrend}</p>
      </div>
    </div>
  </section>

  <section class="mt-7 grid grid-cols-1 gap-6 lg:grid-cols-[1.4fr_1fr]">
    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body">
        <h2 class="card-title font-display text-[20px] tracking-[-0.005em]">{copy.adminRecentActivity}</h2>
        <ul class="mt-3 divide-y divide-base-300">
          <li class="flex items-start gap-3 py-3">
            <div class="bg-primary/10 text-primary flex size-9 shrink-0 items-center justify-center rounded-full">
              <svg class="size-4"><use href="#ic-book2"></use></svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm"><span class="font-bold">Jenniffer M.</span> {copy.adminActivity1}</p>
              <p class="text-xs opacity-60">{copy.adminActivityTime1}</p>
            </div>
          </li>
          <li class="flex items-start gap-3 py-3">
            <div class="bg-warning/15 text-warning flex size-9 shrink-0 items-center justify-center rounded-full">
              <svg class="size-4"><use href="#ic-pin"></use></svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm"><span class="font-bold">Equipo AfroUp</span> {copy.adminActivity2}</p>
              <p class="text-xs opacity-60">{copy.adminActivityTime2}</p>
            </div>
          </li>
          <li class="flex items-start gap-3 py-3">
            <div class="bg-error/15 text-error flex size-9 shrink-0 items-center justify-center rounded-full">
              <svg class="size-4"><use href="#ic-heart"></use></svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm"><span class="font-bold">María P.</span> {copy.adminActivity3}</p>
              <p class="text-xs opacity-60">{copy.adminActivityTime3}</p>
            </div>
          </li>
          <li class="flex items-start gap-3 py-3">
            <div class="bg-accent/15 text-accent flex size-9 shrink-0 items-center justify-center rounded-full">
              <svg class="size-4"><use href="#ic-share"></use></svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm"><span class="font-bold">Carlos R.</span> {copy.adminActivity4}</p>
              <p class="text-xs opacity-60">{copy.adminActivityTime4}</p>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body gap-3">
        <h2 class="card-title font-display text-[20px] tracking-[-0.005em]">{copy.adminQuickActions}</h2>
        <a class="btn btn-primary justify-start" href="#">
          <svg class="size-4"><use href="#ic-book2"></use></svg>
          {copy.adminNewArticle}
        </a>
        <a class="btn btn-dash justify-start" href="#">
          <svg class="size-4"><use href="#ic-download"></use></svg>
          {copy.adminNewResource}
        </a>
        <a class="btn btn-dash justify-start" href="#">
          <svg class="size-4"><use href="#ic-pin"></use></svg>
          {copy.adminModerateComments}
        </a>
        <a class="btn btn-dash justify-start" href="#">
          <svg class="size-4"><use href="#ic-share"></use></svg>
          {copy.adminReviewProjects}
        </a>
      </div>
    </div>
  </section>
</AdminLayout>