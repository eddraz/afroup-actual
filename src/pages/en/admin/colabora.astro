---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import CollaborateAdmin from "../../../components/CollaborateAdmin.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { translationAccess } from "../../../lib/editorial";
import { listSiteLanguages } from "../../../lib/site-languages";
import {
  loadCollaborateSkills,
  loadAllCollaborateSkills,
  loadAllCollaboratePageConfigs,
  listCollaborateSubmissions,
  getCollaborateSubmissionStats,
} from "../../../lib/collaborate";
import { localizedPath } from "../../../lib/i18n";
import { routeIds } from "../../../lib/paths";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "colabora");
if (access instanceof Response) return access;
const actor = access;

const translation = await translationAccess(env.DB, actor.id, "colabora", "update");
const languages = await listSiteLanguages(env.DB);
const skills = await loadCollaborateSkills(env.DB, locale);
const allSkillsWithLocales = await loadAllCollaborateSkills(env.DB);
const submissions = await listCollaborateSubmissions(env.DB);
const stats = await getCollaborateSubmissionStats(env.DB);
const pageConfigByLocale = await loadAllCollaboratePageConfigs(env.DB);
const publicHref = localizedPath(locale, routeIds.collaborate);
---

<AdminLayout title={copy.adminCollaborate || "Collaborate"} active="collaborate">
  <CollaborateAdmin
    skills={skills}
    allSkillsWithLocales={allSkillsWithLocales}
    submissions={submissions}
    stats={stats}
    pageConfigByLocale={pageConfigByLocale}
    languages={languages}
    translation={translation}
    locale={locale}
    copy={copy}
    publicHref={publicHref}
  />
</AdminLayout>
