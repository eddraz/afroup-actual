---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { resolveRequestCopy } from "../../../lib/request-locale";
import {
  COMMENT_STATUSES,
  formatCommentAge,
  getCommentsStats,
  loadComments,
} from "../../../lib/comments";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import AdminStatCard from "../../../components/admin/AdminStatCard.astro";
import AdminToolbar from "../../../components/admin/AdminToolbar.astro";
import AdminTable from "../../../components/admin/AdminTable.astro";
import AdminDrawerPanel from "../../../components/admin/AdminDrawerPanel.astro";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "comentarios");
if (access instanceof Response) return access;

const comments = await loadComments(env.DB);
const stats = await getCommentsStats(env.DB);
const statusLabels: Record<string, string> = Object.fromEntries(
  COMMENT_STATUSES.map((status) => [status.value, status.en])
);
const statusBadge: Record<string, string> = {
  pending: "badge-warning",
  approved: "badge-success",
  reported: "badge-error",
  rejected: "badge-ghost",
};
const jsonForScript = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<AdminLayout title={copy.adminComments} active="comments">
  <AdminDrawerPanel toggleId="comment-drawer" width="form" title="Moderate comment" subtitle="Status, reply, and discard">
    <button slot="actions" id="delete-comment-btn" type="button" class="btn btn-error btn-xs font-bold hidden">Discard</button>

    <Fragment slot="content">
      <AdminPageHeader
        title={copy.adminComments}
        count={stats.total}
        countLabel="in queue"
        badgeVariant="warning"
        lead="Moderate replies, comments, and community discussion on AfroUp articles."
      />

      <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <AdminStatCard label="Total" value={stats.total} icon="#ic-pin" tone="primary" />
        <AdminStatCard label="Pending" value={stats.pending} icon="#ic-edit" tone="warning" />
        <AdminStatCard label="Reported" value={stats.reported} icon="#ic-message-report" tone="secondary" />
        <AdminStatCard label="Approved" value={stats.approved} icon="#ic-shield" tone="success" />
      </div>

      <AdminToolbar
        searchId="comments-search"
        searchPlaceholder="Search by user, article, or comment text..."
        filterName="comment"
        filters={[
          { value: "all", label: "All", count: stats.total },
          { value: "reported", label: "Reported", count: stats.reported },
          { value: "pending", label: "Pending", count: stats.pending },
          { value: "approved", label: "Approved", count: stats.approved },
        ]}
      />

      <AdminTable
        id="comments-table"
        columns={[
          { label: "Author", class: "py-4 pl-6" },
          { label: "Comment" },
          { label: "Reference" },
          { label: "Status" },
          { label: "Actions", class: "text-right pr-6" },
        ]}
      >
        {comments.length > 0 ? (
          <Fragment slot="rows">
            {comments.map((item) => (
              <tr
                class="hover:bg-base-200/50 transition-colors comment-card"
                data-user={item.author_name.toLowerCase()}
                data-article={item.article_title.toLowerCase()}
                data-comment={item.body.toLowerCase()}
                data-reason={item.status}
              >
                <td class="py-3.5 pl-6">
                  <div class="flex items-center gap-3">
                    <div class="avatar placeholder">
                      <div class="size-9 rounded-xl bg-base-200 border border-base-300 font-bold font-display text-xs text-base-content/70 flex items-center justify-center">
                        <span>{(item.author_name || "A")[0]}</span>
                      </div>
                    </div>
                    <span class="font-bold text-sm text-base-content">{item.author_name}</span>
                  </div>
                </td>
                <td class="max-w-[320px]">
                  <p class="text-sm text-base-content/90 leading-relaxed line-clamp-2">«{item.body}»</p>
                </td>
                <td>
                  <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-200 border border-base-300 text-base-content/70">
                    {item.article_title || "—"}
                  </span>
                </td>
                <td>
                  <div class="flex flex-col items-start gap-1">
                    <span class:list={["badge badge-xs font-bold py-1 px-2.5 uppercase tracking-wider", statusBadge[item.status] || "badge-ghost"]}>
                      {statusLabels[item.status] ?? item.status}
                    </span>
                    <span class="text-xs text-base-content/50">{formatCommentAge(item.created_at, locale)}</span>
                  </div>
                </td>
                <td class="text-right pr-6">
                  <div class="inline-flex items-center gap-1.5">
                    <button class="btn btn-success btn-xs font-bold" type="button" data-quick-status={item.id} data-status="approved">Approve</button>
                    <button class="btn btn-ghost btn-xs border border-base-300 text-xs font-semibold hover:bg-base-200" type="button" data-edit-comment={item.id}>Reply</button>
                    <button class="btn btn-ghost btn-xs border border-base-300 text-error hover:bg-error/10 text-xs font-semibold" type="button" data-quick-status={item.id} data-status="rejected">Discard</button>
                  </div>
                </td>
              </tr>
            ))}
          </Fragment>
        ) : (
          <Fragment slot="empty">
            <tr>
              <td colspan={5} class="py-12 text-center text-sm text-base-content/60">No comments in the queue.</td>
            </tr>
          </Fragment>
        )}
      </AdminTable>
    </Fragment>

    <form id="comment-editor-form" action="/api/admin/comments" method="post" class="space-y-5">
      <input type="hidden" name="id" id="comment-field-id" />
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-base-content/60">Author</p>
        <p id="comment-preview-author" class="mt-1 font-bold text-base-content"></p>
      </div>
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-base-content/60">Article</p>
        <p id="comment-preview-article" class="mt-1 font-mono text-xs text-base-content/70"></p>
      </div>
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-base-content/60">Comment</p>
        <p id="comment-preview-body" class="mt-1 text-sm leading-relaxed text-base-content/90"></p>
      </div>
      <div>
        <label class="mb-1 block text-[11px] font-bold uppercase tracking-wider text-base-content/60" for="comment-field-status">Status</label>
        <select id="comment-field-status" name="status" class="select select-sm select-bordered w-full bg-base-200/40">
          {COMMENT_STATUSES.map((status) => (
            <option value={status.value}>{status.en}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="mb-1 block text-[11px] font-bold uppercase tracking-wider text-base-content/60" for="comment-field-reply">Staff reply</label>
        <textarea id="comment-field-reply" name="admin_reply" rows="4" class="textarea textarea-sm textarea-bordered w-full bg-base-200/40"></textarea>
      </div>
      <div class="flex items-center justify-end gap-2 border-t border-base-300 pt-4">
        <label for="comment-drawer" class="btn btn-ghost btn-sm">Cancel</label>
        <button type="submit" class="btn btn-primary btn-sm font-bold">Save moderation</button>
      </div>
    </form>
  </AdminDrawerPanel>

  <script is:inline type="application/json" id="comments-data-script" set:html={jsonForScript(comments)} />

  <script is:inline>
    (function () {
      function toast(message, type) {
        if (window.AfroUpFeedback) window.AfroUpFeedback.toast(message, type);
      }
      function parseJson(id, fallback) {
        try {
          var el = document.getElementById(id);
          return JSON.parse(el ? el.textContent : "") || fallback;
        } catch (e) { return fallback; }
      }
      function postComment(id, fields) {
        var formData = new FormData();
        formData.set("id", String(id));
        Object.keys(fields).forEach(function (key) { formData.set(key, fields[key]); });
        return fetch("/api/admin/comments", { method: "POST", body: formData }).then(function (res) { return res.json(); });
      }

      function setup() {
        var searchInput = document.getElementById("comments-search");
        var filterButtons = document.querySelectorAll(".comment-filter-btn");
        var cards = document.querySelectorAll(".comment-card");
        var drawerToggle = document.getElementById("comment-drawer");
        var form = document.getElementById("comment-editor-form");
        var deleteBtn = document.getElementById("delete-comment-btn");
        var rows = {};
        parseJson("comments-data-script", []).forEach(function (row) { rows[String(row.id)] = row; });
        var currentFilter = "all";
        var searchQuery = "";

        var applyFilters = function () {
          cards.forEach(function (card) {
            var user = card.getAttribute("data-user") || "";
            var article = card.getAttribute("data-article") || "";
            var comment = card.getAttribute("data-comment") || "";
            var reason = card.getAttribute("data-reason") || "";
            var matchesSearch = !searchQuery || user.indexOf(searchQuery) !== -1 || article.indexOf(searchQuery) !== -1 || comment.indexOf(searchQuery) !== -1;
            var matchesFilter = currentFilter === "all" || reason === currentFilter;
            card.style.display = matchesSearch && matchesFilter ? "" : "none";
          });
        };

        if (searchInput && searchInput.dataset.bound !== "true") {
          searchInput.dataset.bound = "true";
          searchInput.addEventListener("input", function () {
            searchQuery = searchInput.value.trim().toLowerCase();
            applyFilters();
          });
        }
        filterButtons.forEach(function (btn) {
          if (btn.dataset.bound === "true") return;
          btn.dataset.bound = "true";
          btn.addEventListener("click", function () {
            filterButtons.forEach(function (b) {
              b.classList.remove("btn-primary", "text-primary-content");
              b.classList.add("btn-ghost");
            });
            btn.classList.remove("btn-ghost");
            btn.classList.add("btn-primary", "text-primary-content");
            currentFilter = btn.getAttribute("data-filter") || "all";
            applyFilters();
          });
        });

        function openDrawer(row) {
          var idField = document.getElementById("comment-field-id");
          var statusField = document.getElementById("comment-field-status");
          var replyField = document.getElementById("comment-field-reply");
          var author = document.getElementById("comment-preview-author");
          var article = document.getElementById("comment-preview-article");
          var body = document.getElementById("comment-preview-body");
          if (idField) idField.value = row.id;
          if (statusField) statusField.value = row.status;
          if (replyField) replyField.value = row.admin_reply || "";
          if (author) author.textContent = row.author_name || "";
          if (article) article.textContent = row.article_title || "—";
          if (body) body.textContent = row.body || "";
          if (deleteBtn) deleteBtn.classList.remove("hidden");
          if (drawerToggle) {
            drawerToggle.checked = true;
            document.body.style.overflow = "hidden";
          }
        }

        document.querySelectorAll("[data-edit-comment]").forEach(function (btn) {
          if (btn.dataset.bound === "true") return;
          btn.dataset.bound = "true";
          btn.addEventListener("click", function () {
            var row = rows[btn.getAttribute("data-edit-comment")];
            if (row) openDrawer(row);
          });
        });

        document.querySelectorAll("[data-quick-status]").forEach(function (btn) {
          if (btn.dataset.bound === "true") return;
          btn.dataset.bound = "true";
          btn.addEventListener("click", function () {
            var id = btn.getAttribute("data-quick-status");
            var status = btn.getAttribute("data-status");
            if (!id || !status) return;
            postComment(id, { status: status })
              .then(function (result) {
                toast(result.message || (result.ok ? "Comment updated." : "Could not moderate."), result.ok ? "success" : "error");
                if (result.ok) setTimeout(function () { window.location.reload(); }, 400);
              })
              .catch(function () { toast("Network error while moderating.", "error"); });
          });
        });

        if (form && form.dataset.submitBound !== "true") {
          form.dataset.submitBound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            fetch(form.action, { method: "POST", body: new FormData(form) })
              .then(function (res) { return res.json(); })
              .then(function (result) {
                toast(result.message || (result.ok ? "Moderation saved." : "Could not save."), result.ok ? "success" : "error");
                if (result.ok) {
                  document.body.style.overflow = "";
                  setTimeout(function () { window.location.reload(); }, 400);
                }
              })
              .catch(function () { toast("Network error while saving.", "error"); });
          });
        }

        if (deleteBtn && deleteBtn.dataset.bound !== "true") {
          deleteBtn.dataset.bound = "true";
          deleteBtn.addEventListener("click", function () {
            var idField = document.getElementById("comment-field-id");
            var id = idField ? idField.value : "";
            if (!id || !window.confirm("Permanently discard this comment?")) return;
            fetch("/api/admin/comments?id=" + encodeURIComponent(id), { method: "DELETE" })
              .then(function (res) { return res.json(); })
              .then(function (result) {
                toast(result.message || (result.ok ? "Comment discarded." : "Could not discard."), result.ok ? "success" : "error");
                if (result.ok) {
                  document.body.style.overflow = "";
                  setTimeout(function () { window.location.reload(); }, 400);
                }
              })
              .catch(function () { toast("Network error while discarding.", "error"); });
          });
        }
      }
      setup();
      document.addEventListener("astro:page-load", setup);
    })();
  </script>
</AdminLayout>
