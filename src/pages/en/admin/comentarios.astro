---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { resolveRequestCopy } from "../../../lib/request-locale";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import AdminToolbar from "../../../components/admin/AdminToolbar.astro";
import AdminTable from "../../../components/admin/AdminTable.astro";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "comentarios");
if (access instanceof Response) return access;
const actor = access;

const queueItems = [
  { id: 1, user: "Anonymous", article: "Voices of the Diaspora", comment: "Excellent interview, made me reflect deeply on my own family history and roots.", reason: "Reported", time: "4 min ago" },
  { id: 2, user: "Laura G.", article: "Afrofuturism: Imagining Tomorrow", comment: "Where can I find the book mentioned in paragraph two? Very interested.", reason: "Question", time: "22 min ago" },
  { id: 3, user: "Andres M.", article: "Braids as Maps of Resistance", comment: "Incredible historical information. I'm using this as study material for my class.", reason: "Approved", time: "1 hr ago" },
  { id: 4, user: "Sofia R.", article: "Quilombos & Palenques: Territories of Freedom", comment: "Would love to see more depth on the New Granada historical context.", reason: "Pending", time: "2 hrs ago" },
];
---

<AdminLayout title={copy.adminComments} active="comments">
  <!-- Page Header -->
  <AdminPageHeader
    title={copy.adminComments}
    count={queueItems.length}
    countLabel="in queue"
    badgeVariant="warning"
    lead="Moderate user replies, comments, and community discussions on AfroUp articles."
  />

  <!-- Filter & Search Toolbar -->
  <AdminToolbar
    searchId="comments-search"
    searchPlaceholder="Search by user, article, or comment text..."
    filterName="comment"
    filters={[
      { value: "all", label: "All", count: queueItems.length },
      { value: "Reported", label: "Reported", count: queueItems.filter((q) => q.reason === "Reported").length },
      { value: "Pending", label: "Pending", count: queueItems.filter((q) => q.reason === "Pending").length },
      { value: "Approved", label: "Approved", count: queueItems.filter((q) => q.reason === "Approved").length },
    ]}
  />

  <!-- Comments Table -->
  <AdminTable
    id="comments-table"
    columns={[
      { label: "Author", class: "py-4 pl-6" },
      { label: "Comment" },
      { label: "Reference" },
      { label: "Status" },
      { label: "Actions", class: "text-right pr-6" },
    ]}
  >
    <Fragment slot="rows">
      {queueItems.map((item) => {
        const isReported = item.reason === "Reported";
        const isPending = item.reason === "Pending";
        const isApproved = item.reason === "Approved";

        return (
          <tr
            class="hover:bg-base-200/50 transition-colors comment-card"
            data-user={item.user.toLowerCase()}
            data-article={item.article.toLowerCase()}
            data-comment={item.comment.toLowerCase()}
            data-reason={item.reason}
          >
            <td class="py-3.5 pl-6">
              <div class="flex items-center gap-3">
                <div class="avatar placeholder">
                  <div class="size-9 rounded-xl bg-base-200 border border-base-300 font-bold font-display text-xs text-base-content/70 flex items-center justify-center">
                    <span>{item.user[0]}</span>
                  </div>
                </div>
                <span class="font-bold text-sm text-base-content">{item.user}</span>
              </div>
            </td>
            <td class="max-w-[320px]">
              <p class="text-sm text-base-content/90 leading-relaxed line-clamp-2">“{item.comment}”</p>
            </td>
            <td>
              <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-200 border border-base-300 text-base-content/70">
                {item.article}
              </span>
            </td>
            <td>
              <div class="flex flex-col items-start gap-1">
                <span class:list={[
                  "badge badge-xs font-bold py-1 px-2.5 uppercase tracking-wider",
                  isReported && "badge-error",
                  isPending && "badge-warning",
                  isApproved && "badge-success",
                  !isReported && !isPending && !isApproved && "badge-info"
                ]}>
                  {item.reason}
                </span>
                <span class="text-xs text-base-content/50">{item.time}</span>
              </div>
            </td>
            <td class="text-right pr-6">
              <div class="inline-flex items-center gap-1.5">
                <button class="btn btn-success btn-xs gap-1 font-bold" type="button">
                  <svg class="size-3.5"><use href="#ic-check"></use></svg>
                  <span>Approve</span>
                </button>
                <button class="btn btn-ghost btn-xs border border-base-300 text-xs font-semibold hover:bg-base-200" type="button">
                  Reply
                </button>
                <button class="btn btn-ghost btn-xs border border-base-300 text-error hover:bg-error/10 text-xs font-semibold" type="button">
                  <svg class="size-3.5"><use href="#ic-trash"></use></svg>
                  <span>Dismiss</span>
                </button>
              </div>
            </td>
          </tr>
        );
      })}
    </Fragment>
  </AdminTable>
</AdminLayout>

<script is:inline>
  (function () {
    var bind = function () {
      var searchInput = document.getElementById("comments-search");
      var filterButtons = document.querySelectorAll(".comment-filter-btn");
      var cards = document.querySelectorAll(".comment-card");

      var currentFilter = "all";
      var searchQuery = "";

      var applyFilters = function () {
        cards.forEach(function (card) {
          var user = card.getAttribute("data-user") || "";
          var article = card.getAttribute("data-article") || "";
          var comment = card.getAttribute("data-comment") || "";
          var reason = card.getAttribute("data-reason") || "";

          var matchesSearch = !searchQuery || user.indexOf(searchQuery) !== -1 || article.indexOf(searchQuery) !== -1 || comment.indexOf(searchQuery) !== -1;
          var matchesFilter = currentFilter === "all" || reason === currentFilter;

          if (matchesSearch && matchesFilter) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      };

      if (searchInput && searchInput.dataset.bound !== "true") {
        searchInput.dataset.bound = "true";
        searchInput.addEventListener("input", function () {
          searchQuery = searchInput.value.trim().toLowerCase();
          applyFilters();
        });
      }

      filterButtons.forEach(function (btn) {
        if (btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";
        btn.addEventListener("click", function () {
          filterButtons.forEach(function (b) {
            b.classList.remove("btn-primary", "text-primary-content");
            b.classList.add("btn-ghost");
          });
          btn.classList.remove("btn-ghost");
          btn.classList.add("btn-primary", "text-primary-content");

          currentFilter = btn.getAttribute("data-filter") || "all";
          applyFilters();
        });
      });
    };

    bind();
    document.addEventListener("astro:page-load", bind);
  })();
</script>
