---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import PermissionMatrix from "../../../components/PermissionMatrix.astro";
import { defaultLocale, localizedPath } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { routeIds } from "../../../lib/paths";
import { parsePermissionGrants, type PermissionGrant } from "../../../lib/permission-grants";
import { env } from "cloudflare:workers";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import AdminToolbar from "../../../components/admin/AdminToolbar.astro";
import AdminTable from "../../../components/admin/AdminTable.astro";
import AdminDrawerPanel from "../../../components/admin/AdminDrawerPanel.astro";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "roles");
if (access instanceof Response) return access;
const actor = access;

interface RoleRow {
  id: number;
  name: string;
  description: string | null;
  user_count: number;
}

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
}

interface PermissionRow {
  id: number;
  module_id: number;
  action: "create" | "read" | "update" | "delete";
}

interface GrantRow {
  role_id: number;
  permission_id: number;
  quota: number | null;
  translate_manual: number | null;
  translate_ai: number | null;
}

const roles = (await env.DB.prepare(
  `SELECT r.id, r.name, r.description,
          (SELECT COUNT(*) FROM users u WHERE u.role_id = r.id) AS user_count
     FROM admin_roles r
     ORDER BY r.name`,
).all<RoleRow>()).results ?? [];

const modules = (await env.DB.prepare(
  "SELECT id, name, slug FROM admin_modules ORDER BY name",
).all<ModuleRow>()).results ?? [];

const permissions = (await env.DB.prepare(
  "SELECT id, module_id, action FROM admin_permissions ORDER BY module_id, action",
).all<PermissionRow>()).results ?? [];

const grantRows = (await env.DB.prepare(
  "SELECT role_id, permission_id, quota, translate_manual, translate_ai FROM admin_role_permissions",
).all<GrantRow>()).results ?? [];

const grantedByRole = new Map<number, Map<number, PermissionGrant>>();
for (const row of grantRows) {
  let map = grantedByRole.get(row.role_id);
  if (!map) {
    map = new Map<number, PermissionGrant>();
    grantedByRole.set(row.role_id, map);
  }
  map.set(row.permission_id, {
    quota: row.quota,
    translateManual: Boolean(row.translate_manual),
    translateAi: Boolean(row.translate_ai),
  });
}

const actionLabels: Record<PermissionRow["action"], string> = {
  create: copy.adminActionCreate,
  read: copy.adminActionRead,
  update: copy.adminActionUpdate,
  delete: copy.adminActionDelete,
};
---

<AdminLayout title={copy.adminRoles} active="roles">
  <!-- Right-to-Left Drawer for Roles -->
  <AdminDrawerPanel
    toggleId="role-drawer"
    width="form"
    title={copy.adminNewRole || "Create new role"}
    subtitle="Configure reusable permissions and capabilities for the team."
  >
    <Fragment slot="content">
      <!-- Page Header -->
      <AdminPageHeader
        title={copy.adminRoles}
        count={roles.length}
        countLabel="roles"
        lead="Define permission matrices and privileges assignable to team members."
      >
        <Fragment slot="actions">
          <label
            for="role-drawer"
            class="drawer-button btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform cursor-pointer"
          >
            <svg class="size-4"><use href="#ic-plus"></use></svg>
            <span>{copy.adminNewRole || "New Role"}</span>
          </label>
        </Fragment>
      </AdminPageHeader>

      <!-- Filter & Search Toolbar -->
      <AdminToolbar searchId="roles-search" searchPlaceholder="Search roles by name or description..." />

      <!-- Roles Table -->
      <AdminTable
        id="roles-table"
        columns={[
          { label: copy.adminRoles || "Role", class: "py-4 pl-6" },
          { label: "Permissions" },
          { label: "Members" },
          { label: "Actions", class: "text-right pr-6" },
        ]}
      >
        {roles.length === 0 ? (
          <Fragment slot="empty">
            <tr>
              <td colspan="4" class="text-center py-12 text-base-content/60">
                <div class="flex flex-col items-center gap-2">
                  <div class="size-12 rounded-2xl bg-base-200 flex items-center justify-center text-base-content/40">
                    <svg class="size-6"><use href="#ic-shield"></use></svg>
                  </div>
                  <span class="font-bold text-base">No roles registered</span>
                </div>
              </td>
            </tr>
          </Fragment>
        ) : (
          <Fragment slot="rows">
            {roles.map((role) => {
              const granted = grantedByRole.get(role.id) ?? new Map();
              return (
                <tr
                  class="hover:bg-base-200/50 transition-colors role-card"
                  data-name={(role.name || "").toLowerCase()}
                  data-desc={(role.description || "").toLowerCase()}
                >
                  <td class="py-3.5 pl-6">
                    <div class="flex items-start gap-3.5">
                      <div class="size-11 rounded-2xl bg-secondary/15 text-secondary border border-secondary/20 flex items-center justify-center font-bold shrink-0">
                        <svg class="size-5.5"><use href="#ic-shield"></use></svg>
                      </div>
                      <div class="min-w-0 space-y-2">
                        <div>
                          <h3 class="font-display text-base font-bold text-base-content">{role.name}</h3>
                          <p class="text-xs text-base-content/60 mt-0.5">{role.description ?? "No description"}</p>
                        </div>

                        <details class="border-t border-base-300/60 pt-2 group">
                          <summary class="cursor-pointer text-xs font-bold text-base-content/70 hover:text-primary flex items-center justify-between list-none py-1">
                            <span class="flex items-center gap-1.5">
                              <svg class="size-4"><use href="#ic-key"></use></svg>
                              <span>Edit Permission Matrix</span>
                            </span>
                            <span class="text-base-content/40 group-open:rotate-180 transition-transform">▼</span>
                          </summary>

                          <form method="post" action="/api/admin/roles" class="mt-3 space-y-4" data-admin-form data-intent="update_role">
                            <input type="hidden" name="_intent" value="update_role" />
                            <input type="hidden" name="id" value={role.id} />

                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                              <fieldset class="fieldset">
                                <legend class="fieldset-legend font-semibold text-xs text-base-content/70">{copy.adminRoleName}</legend>
                                <input class="input input-bordered input-sm w-full font-semibold" name="name" value={role.name} required maxlength="80" />
                              </fieldset>
                              <fieldset class="fieldset">
                                <legend class="fieldset-legend font-semibold text-xs text-base-content/70">{copy.adminRoleDescription}</legend>
                                <input class="input input-bordered input-sm w-full" name="description" value={role.description ?? ""} maxlength="240" />
                              </fieldset>
                            </div>

                            <div class="mt-2">
                              <PermissionMatrix
                                modules={modules}
                                permissions={permissions}
                                assignments={granted}
                                actionLabels={actionLabels}
                                allowLabel={copy.adminPermissionAllow}
                                limitLabel={copy.adminPermissionLimit}
                                translateLabel={copy.adminPermissionTranslate}
                                translateNoneLabel={copy.adminPermissionTranslateNone}
                                translateManualLabel={copy.adminPermissionTranslateManual}
                                translateAiLabel={copy.adminPermissionTranslateAi}
                                unlimitedLabel={copy.adminPermissionUnlimited}
                                noneLabel={copy.adminPermissionNone}
                                helpToggleLabel={copy.adminPermissionHelpToggle}
                                doneLabel={copy.adminPermissionDone}
                                helpCreate={copy.adminPermissionHelpCreate}
                                helpRead={copy.adminPermissionHelpRead}
                                helpUpdate={copy.adminPermissionHelpUpdate}
                                helpDelete={copy.adminPermissionHelpDelete}
                                helpAllow={copy.adminPermissionHelpAllow}
                                helpLimit={copy.adminPermissionHelpLimit}
                                helpTranslate={copy.adminPermissionHelpTranslate}
                              />
                            </div>

                            <div class="flex justify-end gap-2 pt-2 border-t border-base-300/60">
                              <button class="btn btn-primary btn-sm px-5 font-bold" type="submit">{copy.adminSave}</button>
                            </div>
                          </form>
                        </details>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge badge-xs badge-neutral font-mono py-1 px-2 font-bold">{granted.size} permissions</span>
                  </td>
                  <td>
                    <span class="badge badge-xs badge-neutral font-mono py-1 px-2 font-bold">{role.user_count} members</span>
                  </td>
                  <td class="text-right pr-6">
                    <form method="post" action="/api/admin/roles" data-admin-confirm class="inline-flex">
                      <input type="hidden" name="_intent" value="delete_role" />
                      <input type="hidden" name="id" value={role.id} />
                      <button class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-error/10 hover:text-error" type="submit" title={copy.adminRemove}>
                        <svg class="size-3.5"><use href="#ic-trash"></use></svg>
                      </button>
                    </form>
                  </td>
                </tr>
              );
            })}
          </Fragment>
        )}
      </AdminTable>
    </Fragment>

    <!-- Drawer Side (Right to Left Form) -->
    <form method="post" action="/api/admin/roles" class="space-y-6 flex-1 flex flex-col justify-between" data-admin-form data-intent="create_role">
      <input type="hidden" name="_intent" value="create_role" />
      <div class="space-y-5">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminRoleName || "Role Name"}</legend>
            <input class="input input-bordered w-full font-semibold" name="name" required maxlength="80" placeholder="Editor-in-Chief" />
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminRoleDescription || "Description"}</legend>
            <input class="input input-bordered w-full" name="description" maxlength="240" placeholder="Full access to editorial content and translation" />
          </fieldset>
        </div>

        <div class="border-t border-base-300 pt-4">
          <p class="text-xs font-extrabold tracking-wider text-base-content/60 uppercase">{copy.adminRolePermissions || "Role Permissions"}</p>
          <p class="mt-1 text-xs text-base-content/60">{copy.adminPermissionMatrixHelp}</p>
          <div class="mt-3">
            <PermissionMatrix
              modules={modules}
              permissions={permissions}
              actionLabels={actionLabels}
              allowLabel={copy.adminPermissionAllow}
              limitLabel={copy.adminPermissionLimit}
              translateLabel={copy.adminPermissionTranslate}
              translateNoneLabel={copy.adminPermissionTranslateNone}
              translateManualLabel={copy.adminPermissionTranslateManual}
              translateAiLabel={copy.adminPermissionTranslateAi}
              unlimitedLabel={copy.adminPermissionUnlimited}
              noneLabel={copy.adminPermissionNone}
              helpToggleLabel={copy.adminPermissionHelpToggle}
              doneLabel={copy.adminPermissionDone}
              helpCreate={copy.adminPermissionHelpCreate}
              helpRead={copy.adminPermissionHelpRead}
              helpUpdate={copy.adminPermissionHelpUpdate}
              helpDelete={copy.adminPermissionHelpDelete}
              helpAllow={copy.adminPermissionHelpAllow}
              helpLimit={copy.adminPermissionHelpLimit}
              helpTranslate={copy.adminPermissionHelpTranslate}
            />
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-4 border-t border-base-300 mt-6 shrink-0">
        <label for="role-drawer" class="btn btn-ghost btn-sm cursor-pointer">{copy.adminCancel}</label>
        <button class="btn btn-primary btn-sm px-6 font-bold" type="submit">{copy.adminSave || "Create Role"}</button>
      </div>
    </form>
  </AdminDrawerPanel>

  <script is:inline>
    (function () {
      var bind = function () {
        var drawerToggle = document.getElementById("role-drawer");

        if (drawerToggle && drawerToggle.dataset.boundScroll !== "true") {
          drawerToggle.dataset.boundScroll = "true";
          drawerToggle.addEventListener("change", function () {
            if (drawerToggle.checked) {
              document.body.style.overflow = "hidden";
              var firstInput = document.querySelector(".drawer-side input:not([disabled])");
              if (firstInput) setTimeout(function () { firstInput.focus(); }, 150);
            } else {
              document.body.style.overflow = "";
            }
          });

          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && drawerToggle.checked) {
              drawerToggle.checked = false;
              document.body.style.overflow = "";
            }
          });
        }

        // Live search filter
        var searchInput = document.getElementById("roles-search");
        var cards = document.querySelectorAll(".role-card");

        if (searchInput && searchInput.dataset.bound !== "true") {
          searchInput.dataset.bound = "true";
          searchInput.addEventListener("input", function () {
            var q = searchInput.value.trim().toLowerCase();
            cards.forEach(function (c) {
              var name = c.getAttribute("data-name") || "";
              var desc = c.getAttribute("data-desc") || "";
              if (!q || name.indexOf(q) !== -1 || desc.indexOf(q) !== -1) {
                c.style.display = "";
              } else {
                c.style.display = "none";
              }
            });
          });
        }

        var forms = document.querySelectorAll("form[data-admin-form]");
        forms.forEach(function (form) {
          if (form.dataset.boundSubmit) return;
          form.dataset.boundSubmit = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            fetch(form.action, { method: "POST", body: new FormData(form) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Role saved.", "success");
                  if (drawerToggle) drawerToggle.checked = false;
                  document.body.style.overflow = "";
                  setTimeout(function () { window.location.reload(); }, 600);
                  return;
                }
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error saving role.", "error");
              })
              .catch(function () {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Network error.", "error");
              });
          });
        });
      };

      bind();
      document.addEventListener("astro:page-load", bind);
      document.addEventListener("astro:before-swap", function () {
        document.body.style.overflow = "";
      });
    })();
  </script>
</AdminLayout>


