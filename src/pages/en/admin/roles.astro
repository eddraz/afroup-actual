---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import PermissionMatrix from "../../../components/PermissionMatrix.astro";
import { localizedPath } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { routeIds } from "../../../lib/paths";
import { env } from "cloudflare:workers";
import { loadAllRoleGrants } from "../../../lib/permission-grants";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "roles");
if (access instanceof Response) return access;
const actor = access;

interface RoleRow {
  id: number;
  name: string;
  description: string | null;
}

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
}

interface PermissionRow {
  id: number;
  module_id: number;
  action: "create" | "read" | "update" | "delete";
}

const roles = (await env.DB.prepare("SELECT id, name, description FROM admin_roles ORDER BY name").all<RoleRow>()).results ?? [];
const modules = (await env.DB.prepare("SELECT id, name, slug FROM admin_modules ORDER BY name").all<ModuleRow>()).results ?? [];
const permissions = (await env.DB.prepare("SELECT id, module_id, action FROM admin_permissions ORDER BY module_id, action").all<PermissionRow>()).results ?? [];
const grantedByRole = await loadAllRoleGrants(env.DB);

const actionLabels: Record<PermissionRow["action"], string> = {
  create: copy.adminActionCreate,
  read: copy.adminActionRead,
  update: copy.adminActionUpdate,
  delete: copy.adminActionDelete,
};
---

<AdminLayout title={copy.adminRoles} active="roles">
  <!-- Page Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5">
        <h2 class="font-display text-2xl font-bold text-base-content">{copy.adminRoles}</h2>
        <span class="badge badge-neutral badge-sm font-semibold">{roles.length} profiles</span>
      </div>
      <p class="text-xs sm:text-sm text-base-content/60 mt-1">
        Define system roles and preset permissions to assign to team members.
      </p>
    </div>

    <button
      type="button"
      id="btn-toggle-new-role"
      class="btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform"
    >
      <svg class="size-4"><use href="#ic-plus"></use></svg>
      <span>{copy.adminNewRole || "Create Role"}</span>
    </button>
  </div>

  <!-- Collapsible New Role Form -->
  <div id="new-role-box" class="hidden mb-8">
    <div class="rounded-3xl border border-primary/30 bg-base-100 p-6 sm:p-8 shadow-md ring-1 ring-primary/20">
      <div class="flex items-center justify-between border-b border-base-300 pb-3 mb-6">
        <div class="flex items-center gap-2">
          <span class="size-2.5 rounded-full bg-primary animate-pulse"></span>
          <h3 class="font-display font-bold text-lg text-base-content">{copy.adminNewRole || "Create new role"}</h3>
        </div>
        <button type="button" class="btn btn-circle btn-ghost btn-xs" id="btn-close-new-role">✕</button>
      </div>

      <form method="post" action="/api/admin/roles" class="space-y-5" data-admin-form data-intent="create_role">
        <input type="hidden" name="_intent" value="create_role" />
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminRoleName || "Role Name"}</legend>
            <input class="input input-bordered w-full font-semibold" name="name" required maxlength="80" placeholder="Editor in Chief" />
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminRoleDescription || "Description"}</legend>
            <input class="input input-bordered w-full" name="description" maxlength="240" placeholder="Full access to articles and translations" />
          </fieldset>
        </div>

        <div class="border-t border-base-300 pt-4">
          <p class="text-xs font-extrabold tracking-wider text-base-content/60 uppercase">{copy.adminRolePermissions || "Role Permissions"}</p>
          <p class="mt-1 text-xs text-base-content/60">{copy.adminPermissionMatrixHelp}</p>
          <div class="mt-3">
            <PermissionMatrix
              modules={modules}
              permissions={permissions}
              actionLabels={actionLabels}
              allowLabel={copy.adminPermissionAllow}
              limitLabel={copy.adminPermissionLimit}
              translateLabel={copy.adminPermissionTranslate}
              translateNoneLabel={copy.adminPermissionTranslateNone}
              translateManualLabel={copy.adminPermissionTranslateManual}
              translateAiLabel={copy.adminPermissionTranslateAi}
              unlimitedLabel={copy.adminPermissionUnlimited}
              noneLabel={copy.adminPermissionNone}
              helpToggleLabel={copy.adminPermissionHelpToggle}
              doneLabel={copy.adminPermissionDone}
              helpCreate={copy.adminPermissionHelpCreate}
              helpRead={copy.adminPermissionHelpRead}
              helpUpdate={copy.adminPermissionHelpUpdate}
              helpDelete={copy.adminPermissionHelpDelete}
              helpAllow={copy.adminPermissionHelpAllow}
              helpLimit={copy.adminPermissionHelpLimit}
              helpTranslate={copy.adminPermissionHelpTranslate}
            />
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-base-300">
          <button class="btn btn-ghost btn-sm" type="button" id="btn-cancel-new-role">{copy.adminCancel}</button>
          <button class="btn btn-primary btn-sm px-5 font-bold" type="submit">{copy.adminSave || "Save Role"}</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Roles Grid -->
  <div class="grid grid-cols-1 gap-4">
    {roles.map((role) => {
      const granted = grantedByRole.get(role.id) ?? new Map();
      return (
        <article class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-xs space-y-4 hover:border-base-300/80 transition-all">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex items-center gap-3.5">
              <div class="size-12 rounded-2xl bg-secondary/10 text-secondary border border-secondary/20 flex items-center justify-center flex-none">
                <svg class="size-6"><use href="#ic-shield"></use></svg>
              </div>
              <div>
                <h3 class="font-display text-lg font-bold text-base-content">{role.name}</h3>
                <p class="text-xs text-base-content/60">{role.description || "No description provided."}</p>
              </div>
            </div>

            <form method="post" action="/api/admin/roles" data-admin-confirm>
              <input type="hidden" name="_intent" value="delete_role" />
              <input type="hidden" name="id" value={role.id} />
              <button class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-error/10 hover:text-error" type="submit" title={copy.adminRemove}>
                <svg class="size-3.5"><use href="#ic-trash"></use></svg>
              </button>
            </form>
          </div>

          <details class="border-t border-base-300/60 pt-3 group">
            <summary class="cursor-pointer text-xs font-bold text-base-content/70 hover:text-primary flex items-center justify-between list-none py-1">
              <span class="flex items-center gap-1.5">
                <svg class="size-3.5"><use href="#ic-key"></use></svg>
                <span>Assigned permissions for this role</span>
              </span>
              <span class="text-xs group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <form method="post" action="/api/admin/roles" class="mt-3 space-y-3" data-admin-form data-intent="update_role">
              <input type="hidden" name="_intent" value="update_role" />
              <input type="hidden" name="id" value={role.id} />
              <input type="hidden" name="name" value={role.name} />
              <input type="hidden" name="description" value={role.description ?? ""} />
              <PermissionMatrix
                modules={modules}
                permissions={permissions}
                assignments={granted}
                actionLabels={actionLabels}
                allowLabel={copy.adminPermissionAllow}
                limitLabel={copy.adminPermissionLimit}
                translateLabel={copy.adminPermissionTranslate}
                translateNoneLabel={copy.adminPermissionTranslateNone}
                translateManualLabel={copy.adminPermissionTranslateManual}
                translateAiLabel={copy.adminPermissionTranslateAi}
                unlimitedLabel={copy.adminPermissionUnlimited}
                noneLabel={copy.adminPermissionNone}
                helpToggleLabel={copy.adminPermissionHelpToggle}
                doneLabel={copy.adminPermissionDone}
                helpCreate={copy.adminPermissionHelpCreate}
                helpRead={copy.adminPermissionHelpRead}
                helpUpdate={copy.adminPermissionHelpUpdate}
                helpDelete={copy.adminPermissionHelpDelete}
                helpAllow={copy.adminPermissionHelpAllow}
                helpLimit={copy.adminPermissionHelpLimit}
                helpTranslate={copy.adminPermissionHelpTranslate}
              />
              <div class="flex justify-end pt-2">
                <button class="btn btn-primary btn-xs px-4 font-bold" type="submit">{copy.adminSave}</button>
              </div>
            </form>
          </details>
        </article>
      );
    })}
  </div>

  <script is:inline>
    (function () {
      var bind = function () {
        var toggleBtn = document.getElementById("btn-toggle-new-role");
        var closeBtn = document.getElementById("btn-close-new-role");
        var cancelBtn = document.getElementById("btn-cancel-new-role");
        var box = document.getElementById("new-role-box");

        if (toggleBtn && box && toggleBtn.dataset.bound !== "true") {
          toggleBtn.dataset.bound = "true";
          toggleBtn.addEventListener("click", function () { box.classList.toggle("hidden"); });
        }
        if (closeBtn && box && closeBtn.dataset.bound !== "true") {
          closeBtn.dataset.bound = "true";
          closeBtn.addEventListener("click", function () { box.classList.add("hidden"); });
        }
        if (cancelBtn && box && cancelBtn.dataset.bound !== "true") {
          cancelBtn.dataset.bound = "true";
          cancelBtn.addEventListener("click", function () { box.classList.add("hidden"); });
        }

        document.querySelectorAll("form[data-admin-form]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            fetch(form.action, { method: "POST", body: new FormData(form) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Role saved.", "success");
                  setTimeout(function () { window.location.reload(); }, 700);
                  return;
                }
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Failed to save role.", "error");
              })
              .catch(function () {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Network error.", "error");
              });
          });
        });
      };

      bind();
      document.addEventListener("astro:page-load", bind);
    })();
  </script>
</AdminLayout>