---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { localizedPath } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { routeIds } from "../../../lib/paths";
import { listSiteLanguages } from "../../../lib/site-languages";
import { env } from "cloudflare:workers";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "idiomas");
if (access instanceof Response) return access;
const actor = access;

const languages = await listSiteLanguages(env.DB);
---

<AdminLayout title={copy.adminLanguages} active="languages">
  <!-- Page Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5">
        <h2 class="font-display text-2xl font-bold text-base-content">{copy.adminLanguages}</h2>
        <span class="badge badge-neutral badge-sm font-semibold">{languages.length} languages</span>
      </div>
      <p class="text-xs sm:text-sm text-base-content/60 mt-1">
        Manage public language visibility and system translations.
      </p>
    </div>

    <button
      type="button"
      id="btn-toggle-new-lang"
      class="btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform"
    >
      <svg class="size-4"><use href="#ic-plus"></use></svg>
      <span>{copy.adminLanguageTranslate || "Add Language"}</span>
    </button>
  </div>

  <!-- Collapsible Add Language Form -->
  <div id="new-lang-box" class="hidden mb-8 transition-all duration-300">
    <div class="rounded-3xl border border-primary/30 bg-base-100 p-6 sm:p-8 shadow-md ring-1 ring-primary/20">
      <div class="flex items-center justify-between border-b border-base-300 pb-3 mb-6">
        <div class="flex items-center gap-2">
          <span class="size-2.5 rounded-full bg-primary animate-pulse"></span>
          <h3 class="font-display font-bold text-lg text-base-content">{copy.adminLanguageTranslate || "Configure new language"}</h3>
        </div>
        <button type="button" class="btn btn-circle btn-ghost btn-xs" id="btn-close-new-lang">✕</button>
      </div>

      <form method="post" action="/api/admin/languages" class="space-y-5" data-language-form>
        <input type="hidden" name="_intent" value="create" />
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminLanguageCode || "ISO Code (2 letters)"}</legend>
            <input class="input input-bordered w-full font-mono font-bold uppercase" name="code" required maxlength="2" pattern="[a-zA-Z]{2}" placeholder="pt" />
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminLanguageName || "International Name"}</legend>
            <input class="input input-bordered w-full font-semibold" name="name" required maxlength="80" placeholder="Portuguese" />
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminLanguageNative || "Native Name"}</legend>
            <div class="join w-full">
              <input class="input input-bordered join-item w-full font-semibold" name="nativeName" maxlength="80" placeholder="Português" data-native-name />
              <button class="btn btn-ai join-item text-xs font-bold" type="button" data-suggest-native>{copy.adminLanguageSuggest || "Suggest AI"}</button>
            </div>
            <p class="text-[11px] text-base-content/50 mt-1">{copy.adminLanguageNativeHelp}</p>
          </fieldset>
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-base-300">
          <button class="btn btn-ghost btn-sm" type="button" id="btn-cancel-new-lang">{copy.adminCancel}</button>
          <button class="btn btn-primary btn-sm px-5 font-bold" type="submit">{copy.adminLanguageTranslate || "Add Language"}</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-100 p-3 shadow-xs">
    <div class="relative flex-1 min-w-[240px] max-w-md">
      <svg class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none">
        <use href="#ic-world"></use>
      </svg>
      <input
        type="search"
        id="languages-search"
        placeholder="Search languages by code, name, or translation..."
        class="input input-sm input-bordered w-full pl-9 bg-base-200/40 text-xs sm:text-sm font-medium"
      />
    </div>
  </div>

  <!-- Languages Table -->
  <div class="rounded-3xl border border-base-300 bg-base-100 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full" id="languages-table">
        <thead>
          <tr class="border-b border-base-300 bg-base-200/60 text-xs font-extrabold uppercase tracking-wider text-base-content/60">
            <th class="py-4 pl-6">{copy.adminLanguageShow || "Active"}</th>
            <th>{copy.adminLanguageCode || "Code"}</th>
            <th>{copy.adminLanguageName || "Name"}</th>
            <th>{copy.adminLanguageNative || "Native Name"}</th>
            <th class="text-right pr-6">Type</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-base-300/60 font-medium text-sm">
          {languages.map((language) => (
            <tr class="hover:bg-base-200/50 transition-colors language-row" data-code={language.code.toLowerCase()} data-name={(language.name || "").toLowerCase()} data-native={(language.native_name || "").toLowerCase()}>
              <td class="py-3.5 pl-6">
                <form method="post" action="/api/admin/languages" data-language-toggle>
                  <input type="hidden" name="_intent" value="toggle" />
                  <input type="hidden" name="code" value={language.code} />
                  <input type="hidden" name="visible" value={language.is_visible ? "0" : "1"} />
                  <input type="checkbox" class="checkbox checkbox-sm checkbox-primary rounded-md" checked={language.is_visible === 1} data-show-toggle />
                </form>
              </td>
              <td>
                <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-200 border border-base-300 font-bold uppercase text-base-content/80">
                  {language.code}
                </span>
              </td>
              <td class="font-bold text-base-content">{language.name}</td>
              <td class="text-base-content/80">{language.native_name}</td>
              <td class="text-right pr-6">
                {language.is_pillar ? (
                  <span class="badge badge-xs badge-accent font-bold py-1 px-2.5 uppercase">{copy.adminLanguagePillar || "Pillar"}</span>
                ) : (
                  <span class="badge badge-xs badge-ghost py-1 px-2 font-semibold">Optional</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    (function () {
      var bind = function () {
        var toggleBtn = document.getElementById("btn-toggle-new-lang");
        var closeBtn = document.getElementById("btn-close-new-lang");
        var cancelBtn = document.getElementById("btn-cancel-new-lang");
        var box = document.getElementById("new-lang-box");

        if (toggleBtn && box && toggleBtn.dataset.bound !== "true") {
          toggleBtn.dataset.bound = "true";
          toggleBtn.addEventListener("click", function () {
            box.classList.toggle("hidden");
            if (!box.classList.contains("hidden")) {
              var input = box.querySelector("input[name='code']");
              if (input) input.focus();
            }
          });
        }

        var hide = function () { if (box) box.classList.add("hidden"); };
        if (closeBtn && closeBtn.dataset.bound !== "true") { closeBtn.dataset.bound = "true"; closeBtn.addEventListener("click", hide); }
        if (cancelBtn && cancelBtn.dataset.bound !== "true") { cancelBtn.dataset.bound = "true"; cancelBtn.addEventListener("click", hide); }

        // Search live filter
        var searchInput = document.getElementById("languages-search");
        var rows = document.querySelectorAll(".language-row");

        if (searchInput && searchInput.dataset.bound !== "true") {
          searchInput.dataset.bound = "true";
          searchInput.addEventListener("input", function () {
            var q = searchInput.value.trim().toLowerCase();
            rows.forEach(function (r) {
              var code = r.getAttribute("data-code") || "";
              var name = r.getAttribute("data-name") || "";
              var native = r.getAttribute("data-native") || "";
              if (!q || code.indexOf(q) !== -1 || name.indexOf(q) !== -1 || native.indexOf(q) !== -1) {
                r.style.display = "";
              } else {
                r.style.display = "none";
              }
            });
          });
        }

        // Toggle visibility
        document.querySelectorAll("input[data-show-toggle]").forEach(function (input) {
          if (input.dataset.boundToggle) return;
          input.dataset.boundToggle = "true";
          input.addEventListener("change", function () {
            var form = input.closest("form");
            if (form) {
              fetch(form.action, { method: "POST", body: new FormData(form) })
                .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
                .then(function (result) {
                  if (result.ok) {
                    if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Language updated.", "success");
                    return;
                  }
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error updating visibility.", "error");
                  input.checked = !input.checked;
                })
                .catch(function () {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Network error.", "error");
                  input.checked = !input.checked;
                });
            }
          });
        });

        // AI Suggestion
        var suggestBtn = document.querySelector("[data-suggest-native]");
        if (suggestBtn && !suggestBtn.dataset.boundSuggest) {
          suggestBtn.dataset.boundSuggest = "true";
          suggestBtn.addEventListener("click", function () {
            var nameInp = document.querySelector("input[name='name']");
            var nativeInp = document.querySelector("input[data-native-name]");
            var codeInp = document.querySelector("input[name='code']");
            var name = nameInp ? nameInp.value.trim() : "";
            var code = codeInp ? codeInp.value.trim() : "";

            if (!name && !code) {
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Enter code or name first.", "error");
              return;
            }

            suggestBtn.disabled = true;
            fetch("/api/admin/translate", {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: new URLSearchParams({
                module: "idiomas",
                source: name || code,
                target: code || "en",
                intent: "suggest_native_name"
              })
            })
              .then(function (r) { return r.json(); })
              .then(function (res) {
                if (res.ok && res.text && nativeInp) {
                  nativeInp.value = res.text;
                }
              })
              .finally(function () { suggestBtn.disabled = false; });
          });
        }
      };

      bind();
      document.addEventListener("astro:page-load", bind);
    })();
  </script>
</AdminLayout>
