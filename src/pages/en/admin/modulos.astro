---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { localizedPath } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { routeIds } from "../../../lib/paths";
import { env } from "cloudflare:workers";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "modulos");
if (access instanceof Response) return access;
const actor = access;

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
  description: string | null;
  permission_count: number;
}

const modules = (await env.DB.prepare(
  `SELECT m.id, m.name, m.slug, m.description,
          (SELECT COUNT(*) FROM admin_permissions p WHERE p.module_id = m.id) AS permission_count
     FROM admin_modules m
     ORDER BY m.name`,
).all<ModuleRow>()).results ?? [];
---

<AdminLayout title={copy.adminModules} active="modules">
  <!-- Right-to-Left Drawer for Modules -->
  <div class="drawer drawer-end">
    <input id="module-drawer" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content">
      <!-- Page Header -->
      <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5">
            <h2 class="font-display text-2xl font-bold text-base-content">{copy.adminModules}</h2>
            <span class="badge badge-neutral badge-sm font-semibold">{modules.length} modules</span>
          </div>
          <p class="text-xs sm:text-sm text-base-content/60 mt-1">
            System modules and manageable resources controlled through RBAC policies.
          </p>
        </div>

        <label
          for="module-drawer"
          class="drawer-button btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform cursor-pointer"
        >
          <svg class="size-4"><use href="#ic-plus"></use></svg>
          <span>{copy.adminNewModule || "New Module"}</span>
        </label>
      </div>

      <!-- Filter & Search Toolbar -->
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-100 p-3 shadow-xs">
        <div class="relative flex-1 min-w-[240px] max-w-md">
          <svg class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none">
            <use href="#ic-stack"></use>
          </svg>
          <input
            type="search"
            id="modules-search"
            placeholder="Search modules by name or slug..."
            class="input input-sm input-bordered w-full pl-9 bg-base-200/40 text-xs sm:text-sm font-medium"
          />
        </div>
      </div>

      <!-- Modules Table -->
      <div class="rounded-3xl border border-base-300 bg-base-100 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full" id="modules-table">
            <thead>
              <tr class="border-b border-base-300 bg-base-200/60 text-xs font-extrabold uppercase tracking-wider text-base-content/60">
                <th class="py-4 pl-6">{copy.adminModuleName || "Module"}</th>
                <th>{copy.adminModuleSlug || "Slug"}</th>
                <th>{copy.adminModuleDescription || "Description"}</th>
                <th>Permissions</th>
                <th class="text-right pr-6">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-300/60 font-medium text-sm">
              {modules.length === 0 ? (
                <tr>
                  <td colspan="5" class="text-center py-12 text-base-content/60">
                    <div class="flex flex-col items-center gap-2">
                      <div class="size-12 rounded-2xl bg-base-200 flex items-center justify-center text-base-content/40">
                        <svg class="size-6"><use href="#ic-stack"></use></svg>
                      </div>
                      <span class="font-bold text-base">No modules registered</span>
                    </div>
                  </td>
                </tr>
              ) : null}

              {modules.map((m) => (
                <tr class="hover:bg-base-200/50 transition-colors module-row" data-name={(m.name || "").toLowerCase()} data-slug={(m.slug || "").toLowerCase()}>
                  <td class="py-3.5 pl-6 font-bold text-base-content">{m.name}</td>
                  <td>
                    <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-200 border border-base-300 text-base-content/80">
                      {m.slug}
                    </span>
                  </td>
                  <td class="text-xs text-base-content/70">{m.description ?? "—"}</td>
                  <td>
                    <span class="badge badge-xs badge-neutral font-mono py-1 px-2 font-bold">{m.permission_count} actions</span>
                  </td>
                  <td class="text-right pr-6">
                    <form method="post" action="/api/admin/modules" data-admin-confirm>
                      <input type="hidden" name="_intent" value="delete" />
                      <input type="hidden" name="id" value={m.id} />
                      <button class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-error/10 hover:text-error" type="submit" title={copy.adminRemove}>
                        <svg class="size-3.5"><use href="#ic-trash"></use></svg>
                      </button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Drawer Side (Right to Left Form) -->
    <div class="drawer-side z-50">
      <label for="module-drawer" aria-label="close drawer" class="drawer-overlay"></label>
      <aside class="w-full max-w-xl sm:max-w-2xl bg-base-100 min-h-dvh h-dvh max-h-dvh flex flex-col p-6 sm:p-8 shadow-2xl border-l border-base-300 overflow-y-auto overscroll-contain">
        <div class="flex items-center justify-between border-b border-base-300 pb-4 mb-6 shrink-0">
          <div class="flex items-center gap-2.5">
            <span class="size-3 rounded-full bg-primary animate-pulse"></span>
            <div>
              <h3 class="font-display font-bold text-lg text-base-content">{copy.adminNewModule || "Create new module"}</h3>
              <p class="text-xs text-base-content/60">Register a new system resource with manageable permissions.</p>
            </div>
          </div>
          <label for="module-drawer" class="btn btn-circle btn-ghost btn-xs">✕</label>
        </div>

        <form method="post" action="/api/admin/modules" class="space-y-6 flex-1 flex flex-col justify-between" data-admin-form>
          <div class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <fieldset class="fieldset">
                <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminModuleName || "Module Name"}</legend>
                <input class="input input-bordered w-full font-semibold" name="name" required maxlength="80" placeholder="Articles" />
              </fieldset>
              <fieldset class="fieldset">
                <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminModuleSlug || "Slug Identifier"}</legend>
                <input class="input input-bordered w-full font-mono text-xs" name="slug" required pattern="[a-z0-9-]+" maxlength="60" placeholder="articulos" />
              </fieldset>
            </div>
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminModuleDescription || "Description"}</legend>
              <textarea class="textarea textarea-bordered w-full text-sm leading-relaxed" name="description" rows="3" maxlength="240" placeholder="Editorial management of articles..."></textarea>
            </fieldset>
          </div>

          <div class="flex justify-end gap-2 pt-4 border-t border-base-300 mt-6 shrink-0">
            <label for="module-drawer" class="btn btn-ghost btn-sm cursor-pointer">{copy.adminCancel}</label>
            <button class="btn btn-primary btn-sm px-6 font-bold" type="submit">{copy.adminAdd || "Create Module"}</button>
          </div>
        </form>
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      var bind = function () {
        var drawerToggle = document.getElementById("module-drawer");

        if (drawerToggle && drawerToggle.dataset.boundScroll !== "true") {
          drawerToggle.dataset.boundScroll = "true";
          drawerToggle.addEventListener("change", function () {
            if (drawerToggle.checked) {
              document.body.style.overflow = "hidden";
              var firstInput = document.querySelector(".drawer-side input:not([disabled])");
              if (firstInput) setTimeout(function () { firstInput.focus(); }, 150);
            } else {
              document.body.style.overflow = "";
            }
          });

          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && drawerToggle.checked) {
              drawerToggle.checked = false;
              document.body.style.overflow = "";
            }
          });
        }

        // Search live filter
        var searchInput = document.getElementById("modules-search");
        var rows = document.querySelectorAll(".module-row");

        if (searchInput && searchInput.dataset.bound !== "true") {
          searchInput.dataset.bound = "true";
          searchInput.addEventListener("input", function () {
            var q = searchInput.value.trim().toLowerCase();
            rows.forEach(function (r) {
              var name = r.getAttribute("data-name") || "";
              var slug = r.getAttribute("data-slug") || "";
              if (!q || name.indexOf(q) !== -1 || slug.indexOf(q) !== -1) {
                r.style.display = "";
              } else {
                r.style.display = "none";
              }
            });
          });
        }

        var form = document.querySelector("[data-admin-form]");
        if (form && !form.dataset.boundSubmit) {
          form.dataset.boundSubmit = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            fetch(form.action, { method: "POST", body: new FormData(form) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Module saved.", "success");
                  if (drawerToggle) drawerToggle.checked = false;
                  document.body.style.overflow = "";
                  setTimeout(function () { window.location.reload(); }, 600);
                  return;
                }
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error saving module.", "error");
              })
              .catch(function () {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Network error.", "error");
              });
          });
        }
      };

      bind();
      document.addEventListener("astro:page-load", bind);
      document.addEventListener("astro:before-swap", function () {
        document.body.style.overflow = "";
      });
    })();
  </script>
</AdminLayout>