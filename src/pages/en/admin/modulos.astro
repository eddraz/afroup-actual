---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../../../lib/i18n";
import { routeIds } from "../../../lib/paths";
import { env } from "cloudflare:workers";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const adminHref = localizedPath(locale, routeIds.admin);

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
  description: string | null;
  permission_count: number;
}

const modules = (await env.DB.prepare(
  `SELECT m.id, m.name, m.slug, m.description,
          (SELECT COUNT(*) FROM admin_permissions p WHERE p.module_id = m.id) AS permission_count
     FROM admin_modules m
     ORDER BY m.name`,
).all<ModuleRow>()).results ?? [];
---

<AdminLayout title={`${copy.titleAdmin} · ${copy.adminModules}`} active="modules">
  <header class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-end">
    <div>
      <p class="text-primary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.navAdmin}</p>
      <h1 class="font-display text-[28px] leading-[1.06] font-bold tracking-[-0.005em] lg:text-[34px]">{copy.adminModules}</h1>
    </div>
    <a class="btn btn-sm btn-ghost" href={adminHref}>{copy.adminBackSite.replace("sitio", "Panel") || "Panel"}</a>
  </header>

  <details class="card bg-base-100 border border-base-300 shadow-sm mt-6" data-admin-create>
    <summary class="card-body cursor-pointer list-none">
      <span class="flex items-center gap-2 font-bold">
        <svg class="size-4"><use href="#ic-plus"></use></svg>
        {copy.adminNewModule}
      </span>
    </summary>
    <form method="post" action="/api/admin/modules" class="card-body border-t border-base-300 pt-4" data-admin-form>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.adminModuleName}</legend>
          <input class="input w-full" name="name" required maxlength="80" />
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.adminModuleSlug}</legend>
          <input class="input w-full" name="slug" required pattern="[a-z0-9-]+" maxlength="60" />
        </fieldset>
      </div>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">{copy.adminModuleDescription}</legend>
        <textarea class="textarea w-full" name="description" rows="2" maxlength="240"></textarea>
      </fieldset>
      <div class="alert alert-error mt-3 hidden" data-admin-error><span data-admin-error-text></span></div>
      <div class="flex justify-end gap-2">
        <button class="btn btn-ghost btn-sm" type="reset">{copy.adminCancel}</button>
        <button class="btn btn-primary btn-sm" type="submit">{copy.adminAdd}</button>
      </div>
    </form>
  </details>

  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>{copy.adminModuleName}</th>
              <th>{copy.adminModuleSlug}</th>
              <th>{copy.adminModuleDescription}</th>
              <th>{copy.adminPermissions}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {modules.map((m) => (
              <tr>
                <td class="font-semibold">{m.name}</td>
                <td><code class="text-xs">{m.slug}</code></td>
                <td class="text-sm opacity-70">{m.description ?? "—"}</td>
                <td><span class="badge badge-sm badge-ghost">{m.permission_count}</span></td>
                <td class="text-right">
                  <form method="post" action="/api/admin/modules" data-admin-confirm>
                    <input type="hidden" name="_intent" value="delete" />
                    <input type="hidden" name="id" value={m.id} />
                    <button class="btn btn-square btn-ghost btn-sm" type="submit" title={copy.adminRemove}>
                      <svg class="size-4"><use href="#ic-trash"></use></svg>
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var bind = function () {
        document.querySelectorAll("form[data-admin-form]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          var errorBox = form.querySelector("[data-admin-error]");
          var errorText = form.querySelector("[data-admin-error-text]");
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            if (errorBox) errorBox.classList.add("hidden");
            var data = new FormData(form);
            fetch(form.action, { method: "POST", body: data })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  window.location.reload();
                  return;
                }
                var key = result.body && result.body.error;
                var lang = document.documentElement.lang === "en" ? "en" : "es";
                var msg = lang === "en"
                  ? { slug_invalid: "Slug must be lowercase letters, numbers, and dashes.", slug_taken: "A module with that slug already exists.", name_required: "Name is required." }[key] || "Could not save."
                  : { slug_invalid: "El slug solo admite minúsculas, números y guiones.", slug_taken: "Ya existe un módulo con ese slug.", name_required: "El nombre es obligatorio." }[key] || "No pudimos guardar.";
                if (errorText) errorText.textContent = msg;
                if (errorBox) errorBox.classList.remove("hidden");
              })
              .catch(function () {
                if (errorText) errorText.textContent = lang === "en" ? "Network error." : "Error de red.";
                if (errorBox) errorBox.classList.remove("hidden");
              });
          });
        });

        document.querySelectorAll("form[data-admin-confirm]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            var lang = document.documentElement.lang === "en" ? "en" : "es";
            var prompt = lang === "en" ? "Delete this module?" : "¿Eliminar este módulo?";
            if (!window.confirm(prompt)) return;
            var data = new FormData(form);
            fetch(form.action, { method: "POST", body: data }).then(function () { window.location.reload(); });
          });
        });
      };
      bind();
      document.addEventListener("astro:after-swap", bind);
    })();
  </script>
</AdminLayout>