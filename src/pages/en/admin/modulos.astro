---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { localizedPath } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { routeIds } from "../../../lib/paths";
import { env } from "cloudflare:workers";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "modulos");
if (access instanceof Response) return access;
const actor = access;

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
  description: string | null;
  permission_count: number;
}

const modules = (await env.DB.prepare(
  `SELECT m.id, m.name, m.slug, m.description,
          (SELECT COUNT(*) FROM admin_permissions p WHERE p.module_id = m.id) AS permission_count
     FROM admin_modules m
     ORDER BY m.name`,
).all<ModuleRow>()).results ?? [];
---

<AdminLayout title={copy.adminModules} active="modules">
  <!-- Page Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5">
        <h2 class="font-display text-2xl font-bold text-base-content">{copy.adminModules}</h2>
        <span class="badge badge-neutral badge-sm font-semibold">{modules.length} modules</span>
      </div>
      <p class="text-xs sm:text-sm text-base-content/60 mt-1">
        System modules and manageable resources configured with RBAC policies.
      </p>
    </div>

    <button
      type="button"
      id="btn-toggle-new-module"
      class="btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform"
    >
      <svg class="size-4"><use href="#ic-plus"></use></svg>
      <span>{copy.adminNewModule || "New Module"}</span>
    </button>
  </div>

  <!-- Collapsible Add Module Form -->
  <div id="new-module-box" class="hidden mb-8">
    <div class="rounded-3xl border border-primary/30 bg-base-100 p-6 sm:p-8 shadow-md ring-1 ring-primary/20">
      <div class="flex items-center justify-between border-b border-base-300 pb-3 mb-6">
        <div class="flex items-center gap-2">
          <span class="size-2.5 rounded-full bg-primary animate-pulse"></span>
          <h3 class="font-display font-bold text-lg text-base-content">{copy.adminNewModule || "Create new module"}</h3>
        </div>
        <button type="button" class="btn btn-circle btn-ghost btn-xs" id="btn-close-new-module">✕</button>
      </div>

      <form method="post" action="/api/admin/modules" class="space-y-4" data-admin-form>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminModuleName || "Module Name"}</legend>
            <input class="input input-bordered w-full font-semibold" name="name" required maxlength="80" placeholder="Articles" />
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminModuleSlug || "Slug"}</legend>
            <input class="input input-bordered w-full font-mono text-xs" name="slug" required pattern="[a-z0-9-]+" maxlength="60" placeholder="articles" />
          </fieldset>
        </div>
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminModuleDescription || "Description"}</legend>
          <textarea class="textarea textarea-bordered w-full text-sm" name="description" rows="2" maxlength="240" placeholder="Editorial content management..."></textarea>
        </fieldset>
        <div class="flex justify-end gap-2 pt-2 border-t border-base-300">
          <button class="btn btn-ghost btn-sm" type="button" id="btn-cancel-new-module">{copy.adminCancel}</button>
          <button class="btn btn-primary btn-sm px-5 font-bold" type="submit">{copy.adminAdd || "Create Module"}</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modules Table -->
  <div class="rounded-3xl border border-base-300 bg-base-100 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr class="border-b border-base-300 bg-base-200/60 text-xs font-extrabold uppercase tracking-wider text-base-content/60">
            <th class="py-4 pl-6">{copy.adminModuleName || "Module"}</th>
            <th>{copy.adminModuleSlug || "Slug"}</th>
            <th>{copy.adminModuleDescription || "Description"}</th>
            <th>Permissions</th>
            <th class="text-right pr-6">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-base-300/60 font-medium text-sm">
          {modules.map((m) => (
            <tr class="hover:bg-base-200/50 transition-colors">
              <td class="py-3.5 pl-6 font-bold text-base-content">{m.name}</td>
              <td>
                <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-200 border border-base-300 text-base-content/80">
                  {m.slug}
                </span>
              </td>
              <td class="text-xs text-base-content/70">{m.description ?? "—"}</td>
              <td>
                <span class="badge badge-xs badge-neutral font-mono py-1 px-2 font-bold">{m.permission_count} actions</span>
              </td>
              <td class="text-right pr-6">
                <form method="post" action="/api/admin/modules" data-admin-confirm>
                  <input type="hidden" name="_intent" value="delete" />
                  <input type="hidden" name="id" value={m.id} />
                  <button class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-error/10 hover:text-error" type="submit" title={copy.adminRemove}>
                    <svg class="size-3.5"><use href="#ic-trash"></use></svg>
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    (function () {
      var bind = function () {
        var toggleBtn = document.getElementById("btn-toggle-new-module");
        var closeBtn = document.getElementById("btn-close-new-module");
        var cancelBtn = document.getElementById("btn-cancel-new-module");
        var box = document.getElementById("new-module-box");

        if (toggleBtn && box && toggleBtn.dataset.bound !== "true") {
          toggleBtn.dataset.bound = "true";
          toggleBtn.addEventListener("click", function () { box.classList.toggle("hidden"); });
        }
        if (closeBtn && box && closeBtn.dataset.bound !== "true") {
          closeBtn.dataset.bound = "true";
          closeBtn.addEventListener("click", function () { box.classList.add("hidden"); });
        }
        if (cancelBtn && box && cancelBtn.dataset.bound !== "true") {
          cancelBtn.dataset.bound = "true";
          cancelBtn.addEventListener("click", function () { box.classList.add("hidden"); });
        }

        document.querySelectorAll("form[data-admin-form]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            var data = new FormData(form);
            fetch(form.action, { method: "POST", body: data })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Module saved.", "success");
                  setTimeout(function () { window.location.reload(); }, 700);
                  return;
                }
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Failed to save module.", "error");
              })
              .catch(function () {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Network error.", "error");
              });
          });
        });

        document.querySelectorAll("form[data-admin-confirm]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            if (!window.confirm("Delete this module?")) return;
            var data = new FormData(form);
            fetch(form.action, { method: "POST", body: data }).then(function () { window.location.reload(); });
          });
        });
      };

      bind();
      document.addEventListener("astro:page-load", bind);
    })();
  </script>
</AdminLayout>