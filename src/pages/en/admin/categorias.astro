---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import PageLocaleSwitch from "../../../components/PageLocaleSwitch.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { defaultLocale } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { translationAccess, visibleOwnerClause } from "../../../lib/editorial";
import { hasPermission } from "../../../lib/rbac";
import { listSiteLanguages } from "../../../lib/site-languages";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "categorias");
if (access instanceof Response) return access;
const actor = access;
const canCreate = await hasPermission(env.DB, actor.id, "categorias", "create");
const canUpdate = await hasPermission(env.DB, actor.id, "categorias", "update");
const canDelete = await hasPermission(env.DB, actor.id, "categorias", "delete");
const translation = await translationAccess(env.DB, actor.id, "categorias", canCreate ? "create" : "update");
const languages = await listSiteLanguages(env.DB);

interface CategoryRow {
  id: number;
  slug: string;
  title: string | null;
}

const categories = (await env.DB.prepare(
  `SELECT c.id, c.slug,
          (SELECT title FROM article_category_locales l
            WHERE l.category_id = c.id
            ORDER BY CASE WHEN l.locale = ? THEN 0 ELSE 1 END, l.locale
            LIMIT 1) AS title
     FROM article_categories c
    WHERE ${visibleOwnerClause("c.created_by")}
    ORDER BY c.created_at DESC, c.id DESC`,
)
  .bind(locale, actor.id, "categorias", actor.id)
  .all<CategoryRow>()).results ?? [];
---

<AdminLayout title={copy.adminCategories} active="categories">
  {canCreate ? (
    <details class="card bg-base-100 border border-base-300 shadow-sm">
      <summary class="card-body cursor-pointer list-none">
        <span class="flex items-center gap-2 font-bold">
          <svg class="size-4"><use href="#ic-plus"></use></svg>
          {copy.adminNewCategory}
        </span>
      </summary>
      <form method="post" action="/api/admin/categories" class="card-body border-t border-base-300 pt-4" data-editorial-form data-success={copy.adminEditorialSaved} data-error={copy.adminEditorialSaveError}>
        <div class="flex justify-end">
          <PageLocaleSwitch languages={languages} label={copy.adminLanguages} current={defaultLocale} />
        </div>
        {languages.map((language) => {
          const locked = language.code !== defaultLocale && !translation.canWrite && !translation.canUseAi;
          return (
            <div class:list={["grid grid-cols-1 gap-3", language.code !== defaultLocale && "hidden"]} data-i18n-panel={language.code}>
              <fieldset class="fieldset">
                <legend class="fieldset-legend">{copy.adminCategoryTitle} · {language.native_name}</legend>
                <input class="input w-full" name={`title[${language.code}]`} maxlength="160" required={language.code === defaultLocale} disabled={locked} />
              </fieldset>
              <fieldset class="fieldset">
                <legend class="fieldset-legend">{copy.adminCategoryDescription} · {language.native_name}</legend>
                <textarea class="textarea w-full" name={`description[${language.code}]`} rows="3" maxlength="400" disabled={locked}></textarea>
              </fieldset>
            </div>
          );
        })}
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.adminCategorySlug}</legend>
          <input class="input w-full" name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="80" />
        </fieldset>
        <div class="flex justify-end">
          <button class="btn btn-primary btn-sm" type="submit">{copy.adminSave}</button>
        </div>
      </form>
    </details>
  ) : null}

  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>{copy.adminCategoryTitle}</th>
              <th>{copy.adminCategorySlug}</th>
              {canUpdate || canDelete ? <th></th> : null}
            </tr>
          </thead>
          <tbody>
            {categories.map((category) => (
              <tr>
                <td class="font-semibold">{category.title ?? "—"}</td>
                <td class="font-mono text-sm">{category.slug}</td>
                {canUpdate || canDelete ? (
                  <td>
                    <div class="flex justify-end gap-1">
                      {canUpdate ? (
                        <a class="btn btn-square btn-ghost btn-sm" href={`${Astro.url.pathname.replace(/\/$/, "")}/${category.id}`} title={copy.adminEdit}>
                          <svg class="size-4"><use href="#ic-edit"></use></svg>
                        </a>
                      ) : null}
                      {canDelete ? (
                        <button
                          class="btn btn-square btn-ghost btn-sm"
                          type="button"
                          data-delete-id={category.id}
                          data-name={category.title ?? category.slug}
                          data-confirm={copy.adminDeleteConfirm}
                          data-success={copy.adminEditorialDeleted}
                          data-title={copy.adminDeleteTitle}
                          data-accept={copy.adminDeleteAccept}
                          data-cancel={copy.adminDeleteCancel}
                          title={copy.adminRemove}
                        >
                          <svg class="size-4"><use href="#ic-trash"></use></svg>
                        </button>
                      ) : null}
                    </div>
                  </td>
                ) : null}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

<dialog id="admin-delete-dialog" class="modal">
  <div class="modal-box max-w-[480px]">
    <h3 class="font-display text-[20px] tracking-[-0.005em]" data-delete-title></h3>
    <p class="mt-3 text-sm opacity-80" data-delete-message></p>
    <div class="modal-action">
      <form method="dialog" class="contents">
        <button class="btn btn-ghost btn-sm" type="submit" data-delete-cancel></button>
      </form>
      <button class="btn btn-error btn-sm" type="button" data-delete-confirm></button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button type="submit">close</button></form>
</dialog>

<script is:inline>
  (function () {
    if (window.__adminEditorialBound) return;
    window.__adminEditorialBound = true;
    var setup = function () {
      document.querySelectorAll("form[data-editorial-form]").forEach(function (form) {
        if (form.dataset.bound === "true") return;
        form.dataset.bound = "true";
        form.addEventListener("submit", function (event) {
          event.preventDefault();
          fetch(form.action, { method: "POST", body: new FormData(form) })
            .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
            .then(function (result) {
              if (result.ok) {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast(form.getAttribute("data-success") || "Guardado.", "success");
                setTimeout(function () { window.location.reload(); }, 700);
                return;
              }
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast(form.getAttribute("data-error") || "No pudimos guardar.", "error");
            })
            .catch(function () {
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error de red.", "error");
            });
        });
      });
      var dialog = document.getElementById("admin-delete-dialog");
      if (!dialog) return;
      if (dialog.dataset.bound !== "true") {
        dialog.dataset.bound = "true";
        var pending = null;
        dialog.querySelector("[data-delete-confirm]").addEventListener("click", function () {
          if (!pending) return;
          var data = new FormData();
          data.append("_intent", "delete");
          data.append("id", pending.id);
          fetch("/api/admin/categories", { method: "POST", body: data })
            .then(function (res) { return res.json(); })
            .then(function (body) {
              if (body && body.ok) {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast(pending.success || "Eliminado.", "success");
                setTimeout(function () { window.location.reload(); }, 700);
                return;
              }
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast(pending.error || "No pudimos guardar.", "error");
            })
            .catch(function () {
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error de red.", "error");
            });
          dialog.close();
        });
      }
      document.querySelectorAll("button[data-delete-id]").forEach(function (button) {
        if (button.dataset.bound === "true") return;
        button.dataset.bound = "true";
        button.addEventListener("click", function () {
          var name = button.getAttribute("data-name") || "";
          var message = (button.getAttribute("data-confirm") || "").replace("{title}", name);
          dialog.querySelector("[data-delete-title]").textContent = button.getAttribute("data-title") || "";
          dialog.querySelector("[data-delete-message]").textContent = message;
          dialog.querySelector("[data-delete-confirm]").textContent = button.getAttribute("data-accept") || "Eliminar";
          dialog.querySelector("[data-delete-cancel]").textContent = button.getAttribute("data-cancel") || "Cancelar";
          pending = {
            id: button.getAttribute("data-delete-id"),
            success: button.getAttribute("data-success") || "Eliminado.",
            error: "No pudimos guardar.",
          };
          if (typeof dialog.showModal === "function") dialog.showModal();
        });
      });
    };
    setup();
    document.addEventListener("astro:page-load", function () {
      document.querySelectorAll("form[data-editorial-form]").forEach(function (form) { form.dataset.bound = ""; });
      document.querySelectorAll("button[data-delete-id]").forEach(function (button) { button.dataset.bound = ""; });
      setup();
    });
  })();
</script>

</AdminLayout>


