---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import PageLocaleSwitch from "../../../components/PageLocaleSwitch.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { defaultLocale } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { translationAccess, visibleOwnerClause } from "../../../lib/editorial";
import { hasPermission } from "../../../lib/rbac";
import { listSiteLanguages } from "../../../lib/site-languages";
import { getCategoryTheme } from "../../../lib/category-routes";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "categorias");
if (access instanceof Response) return access;
const actor = access;
const canCreate = await hasPermission(env.DB, actor.id, "categorias", "create");
const canUpdate = await hasPermission(env.DB, actor.id, "categorias", "update");
const canDelete = await hasPermission(env.DB, actor.id, "categorias", "delete");
const translation = await translationAccess(env.DB, actor.id, "categorias", canCreate ? "create" : "update");
const languages = await listSiteLanguages(env.DB);

interface CategoryRow {
  id: number;
  slug: string;
  title: string | null;
  article_count?: number;
}

const categories = (await env.DB.prepare(
  `SELECT c.id, c.slug,
          (SELECT title FROM article_category_locales l
            WHERE l.category_id = c.id
            ORDER BY CASE WHEN l.locale = ? THEN 0 ELSE 1 END, l.locale
            LIMIT 1) AS title,
          (SELECT COUNT(*) FROM article_category_map m WHERE m.category_id = c.id) AS article_count
     FROM article_categories c
    WHERE ${visibleOwnerClause("c.created_by")}
    ORDER BY c.created_at DESC, c.id DESC`,
)
  .bind(locale, actor.id, "categorias", actor.id)
  .all<CategoryRow>()).results ?? [];
---

<AdminLayout title={copy.adminCategories} active="categories">
  <!-- Page Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5">
        <h2 class="font-display text-2xl font-bold text-base-content">{copy.adminCategories}</h2>
        <span class="badge badge-neutral badge-sm font-semibold">{categories.length} taxonomies</span>
      </div>
      <p class="text-xs sm:text-sm text-base-content/60 mt-1">
        Thematic structure and editorial sections to categorize publications.
      </p>
    </div>

    {canCreate ? (
      <button
        type="button"
        id="btn-toggle-new-category"
        class="btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform"
      >
        <svg class="size-4"><use href="#ic-plus"></use></svg>
        <span>{copy.adminNewCategory}</span>
      </button>
    ) : null}
  </div>

  <!-- Collapsible New Category Form -->
  {canCreate ? (
    <div id="new-category-box" class="hidden mb-6">
      <div class="rounded-3xl border border-primary/30 bg-base-100 p-6 shadow-md ring-1 ring-primary/20">
        <div class="flex items-center justify-between border-b border-base-300 pb-3 mb-4">
          <div class="flex items-center gap-2">
            <span class="size-2.5 rounded-full bg-primary animate-pulse"></span>
            <h3 class="font-display font-bold text-base text-base-content">{copy.adminNewCategory}</h3>
          </div>
          <button type="button" class="btn btn-circle btn-ghost btn-xs" id="btn-close-new-category">✕</button>
        </div>

        <form
          method="post"
          action="/api/admin/categories"
          class="space-y-4"
          data-editorial-form
          data-success={copy.adminEditorialSaved}
          data-error={copy.adminEditorialSaveError}
        >
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-base-content/50">Language:</span>
            <PageLocaleSwitch languages={languages} label={copy.adminLanguages} current={defaultLocale} />
          </div>

          {languages.map((language) => {
            const locked = language.code !== defaultLocale && !translation.canWrite && !translation.canUseAi;
            return (
              <div class:list={["grid grid-cols-1 gap-4", language.code !== defaultLocale && "hidden"]} data-i18n-panel={language.code}>
                <fieldset class="fieldset">
                  <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">
                    {copy.adminCategoryTitle} · {language.native_name}
                  </legend>
                  <input class="input input-bordered w-full font-semibold" name={`title[${language.code}]`} maxlength="160" required={language.code === defaultLocale} disabled={locked} placeholder="Category name..." />
                </fieldset>
                <fieldset class="fieldset">
                  <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">
                    {copy.adminCategoryDescription} · {language.native_name}
                  </legend>
                  <textarea class="textarea textarea-bordered w-full" name={`description[${language.code}]`} rows="2" maxlength="400" disabled={locked} placeholder="Category summary..."></textarea>
                </fieldset>
              </div>
            );
          })}

          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminCategorySlug}</legend>
            <input class="input input-bordered w-full font-mono text-xs" name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="80" placeholder="example-category-slug" />
          </fieldset>

          <div class="flex justify-end gap-2 pt-2 border-t border-base-300">
            <button class="btn btn-ghost btn-sm" type="button" id="btn-cancel-new-category">{copy.adminDeleteCancel || "Cancel"}</button>
            <button class="btn btn-primary btn-sm px-5" type="submit">{copy.adminSave}</button>
          </div>
        </form>
      </div>
    </div>
  ) : null}

  <!-- Categories Table -->
  <div class="rounded-3xl border border-base-300 bg-base-100 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr class="border-b border-base-300 bg-base-200/60 text-xs font-extrabold uppercase tracking-wider text-base-content/60">
            <th class="py-4 pl-6">{copy.adminCategoryTitle || "Category"}</th>
            <th>{copy.adminCategorySlug || "Slug URL"}</th>
            <th>Articles</th>
            <th class="text-right pr-6">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-base-300/60 font-medium text-sm">
          {categories.length === 0 ? (
            <tr>
              <td colspan="4" class="text-center py-10 text-base-content/60">
                No categories found.
              </td>
            </tr>
          ) : null}

          {categories.map((category) => {
            const theme = getCategoryTheme(category.slug);
            const editUrl = `${Astro.url.pathname.replace(/\/$/, "")}/${category.id}`;

            return (
              <tr class="hover:bg-base-200/50 transition-colors">
                <td class="py-3.5 pl-6">
                  <div class="flex items-center gap-2.5">
                    <span class:list={["size-2.5 rounded-full", theme.dotClass]}></span>
                    <span class="font-bold text-base-content text-base">{category.title ?? "—"}</span>
                  </div>
                </td>
                <td>
                  <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-200 border border-base-300 text-base-content/70">
                    /{category.slug}
                  </span>
                </td>
                <td>
                  <span class="badge badge-sm badge-neutral font-mono">{category.article_count ?? 0}</span>
                </td>
                <td class="text-right pr-6">
                  <div class="inline-flex items-center gap-1">
                    {canUpdate ? (
                      <a class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-base-200" href={editUrl} title={copy.adminEdit}>
                        <svg class="size-3.5"><use href="#ic-edit"></use></svg>
                      </a>
                    ) : null}
                    {canDelete ? (
                      <button
                        class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-error/10 hover:text-error"
                        type="button"
                        data-delete-id={category.id}
                        data-name={category.title ?? category.slug}
                        data-confirm={copy.adminDeleteConfirm}
                        data-success={copy.adminEditorialDeleted}
                        data-title={copy.adminDeleteTitle}
                        data-accept={copy.adminDeleteAccept}
                        data-cancel={copy.adminDeleteCancel}
                        title={copy.adminRemove}
                      >
                        <svg class="size-3.5"><use href="#ic-trash"></use></svg>
                      </button>
                    ) : null}
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <dialog id="admin-delete-dialog" class="modal">
    <div class="modal-box max-w-[480px] rounded-3xl p-6">
      <h3 class="font-display text-xl font-bold text-base-content" data-delete-title></h3>
      <p class="mt-3 text-sm text-base-content/80" data-delete-message></p>
      <div class="modal-action">
        <form method="dialog" class="contents">
          <button class="btn btn-ghost btn-sm" type="submit" data-delete-cancel></button>
        </form>
        <button class="btn btn-error btn-sm" type="button" data-delete-confirm></button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="submit">close</button></form>
  </dialog>

  <script is:inline>
    (function () {
      var bindCategories = function () {
        var toggleBtn = document.getElementById("btn-toggle-new-category");
        var closeBtn = document.getElementById("btn-close-new-category");
        var cancelBtn = document.getElementById("btn-cancel-new-category");
        var box = document.getElementById("new-category-box");

        if (toggleBtn && box && toggleBtn.dataset.bound !== "true") {
          toggleBtn.dataset.bound = "true";
          toggleBtn.addEventListener("click", function () { box.classList.toggle("hidden"); });
        }
        if (closeBtn && box && closeBtn.dataset.bound !== "true") {
          closeBtn.dataset.bound = "true";
          closeBtn.addEventListener("click", function () { box.classList.add("hidden"); });
        }
        if (cancelBtn && box && cancelBtn.dataset.bound !== "true") {
          cancelBtn.dataset.bound = "true";
          cancelBtn.addEventListener("click", function () { box.classList.add("hidden"); });
        }

        document.querySelectorAll("form[data-editorial-form]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            fetch(form.action, { method: "POST", body: new FormData(form) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast(form.getAttribute("data-success") || "Saved.", "success");
                  setTimeout(function () { window.location.reload(); }, 700);
                  return;
                }
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast(form.getAttribute("data-error") || "Failed to save.", "error");
              })
              .catch(function () {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Network error.", "error");
              });
          });
        });

        var dialog = document.getElementById("admin-delete-dialog");
        if (!dialog) return;
        var pending = null;

        if (dialog.dataset.bound !== "true") {
          dialog.dataset.bound = "true";
          var confirmBtn = dialog.querySelector("[data-delete-confirm]");
          if (confirmBtn) {
            confirmBtn.addEventListener("click", function () {
              if (!pending) return;
              var data = new FormData();
              data.append("_intent", "delete");
              data.append("id", pending.id);
              fetch("/api/admin/categories", { method: "POST", body: data })
                .then(function (res) { return res.json(); })
                .then(function (body) {
                  if (body && body.ok) {
                    if (window.AfroUpFeedback) window.AfroUpFeedback.toast(pending.success || "Deleted.", "success");
                    setTimeout(function () { window.location.reload(); }, 700);
                    return;
                  }
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast(pending.error || "Failed to delete.", "error");
                })
                .catch(function () {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Network error.", "error");
                });
              dialog.close();
            });
          }
        }

        document.querySelectorAll("button[data-delete-id]").forEach(function (button) {
          if (button.dataset.bound === "true") return;
          button.dataset.bound = "true";
          button.addEventListener("click", function () {
            var name = button.getAttribute("data-name") || "";
            var message = (button.getAttribute("data-confirm") || "").replace("{title}", name);
            dialog.querySelector("[data-delete-title]").textContent = button.getAttribute("data-title") || "";
            dialog.querySelector("[data-delete-message]").textContent = message;
            dialog.querySelector("[data-delete-confirm]").textContent = button.getAttribute("data-accept") || "Delete";
            dialog.querySelector("[data-delete-cancel]").textContent = button.getAttribute("data-cancel") || "Cancel";
            pending = {
              id: button.getAttribute("data-delete-id"),
              success: button.getAttribute("data-success") || "Deleted.",
              error: "Failed to delete.",
            };
            if (typeof dialog.showModal === "function") dialog.showModal();
          });
        });
      };

      bindCategories();
      document.addEventListener("astro:page-load", bindCategories);
    })();
  </script>
</AdminLayout>
