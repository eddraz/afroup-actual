---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getLocaleFromUrl, t } from "../../../lib/i18n";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);

const users = [
  { name: "Jenniffer M.", email: "jenniffer@afroup.com", role: "Admin", status: "Activo" },
  { name: "Carlos R.", email: "carlos.r@afroup.com", role: "Editor", status: "Activo" },
  { name: "María P.", email: "maria.p@gmail.com", role: "Suscriptor", status: "Activo" },
  { name: "Ana T.", email: "ana.t@yahoo.com", role: "Suscriptor", status: "Pausado" },
  { name: "Diego S.", email: "diego.s@outlook.com", role: "Editor", status: "Activo" },
];
---

<AdminLayout title={`${copy.titleAdmin} · ${copy.adminUsers}`} active="users">
  <header class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-end">
    <div>
      <p class="text-primary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.navAdmin}</p>
      <h1 class="font-display text-[28px] leading-[1.06] font-bold tracking-[-0.005em] lg:text-[34px]">{copy.adminUsers}</h1>
    </div>
  </header>

  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Correo</th>
              <th>Rol</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            {users.map((user) => (
              <tr>
                <td class="font-semibold">{user.name}</td>
                <td class="text-sm opacity-70">{user.email}</td>
                <td>
                  <span class:list={["badge badge-sm", user.role === "Admin" && "badge-accent", user.role === "Editor" && "badge-primary"]}>{user.role}</span>
                </td>
                <td>
                  <span class:list={["badge badge-sm", user.status === "Activo" && "badge-success", user.status === "Pausado" && "badge-ghost"]}>{user.status}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>