---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import PermissionMatrix from "../../../components/PermissionMatrix.astro";
import { getLocaleFromUrl, localizedPath, t } from "../../../lib/i18n";
import { env } from "cloudflare:workers";
import { routeIds } from "../../../lib/paths";
import {
  getCurrentAdmin,
  listVisibleAdminUsers,
  sessionTokenFrom,
} from "../../../lib/admin-scope";
import {
  grantsToJson,
  loadAllRoleGrants,
  loadAllUserGrants,
} from "../../../lib/permission-grants";
import type { PermissionAction } from "../../../lib/rbac";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const loginHref = localizedPath(locale, routeIds.login);

const actor = await getCurrentAdmin(env.DB, sessionTokenFrom(Astro.cookies));
if (!actor) {
  return Astro.redirect(`${loginHref}?next=${encodeURIComponent(Astro.url.pathname)}`, 303);
}

interface RoleRow {
  id: number;
  name: string;
  description: string | null;
}

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
}

interface PermissionRow {
  id: number;
  module_id: number;
  action: PermissionAction;
}

const users = await listVisibleAdminUsers(env.DB, actor.id);
const roles = (await env.DB.prepare("SELECT id, name, description FROM admin_roles ORDER BY name").all<RoleRow>()).results ?? [];
const modules = (await env.DB.prepare("SELECT id, name, slug FROM admin_modules ORDER BY name").all<ModuleRow>()).results ?? [];
const permissions = (await env.DB.prepare("SELECT id, module_id, action FROM admin_permissions ORDER BY module_id, action").all<PermissionRow>()).results ?? [];
const grantedByUser = await loadAllUserGrants(env.DB);
const grantedByRole = await loadAllRoleGrants(env.DB);
const rolePermissionsJson = grantsToJson(grantedByRole);

const actionLabels: Record<PermissionAction, string> = {
  create: copy.adminActionCreate,
  read: copy.adminActionRead,
  update: copy.adminActionUpdate,
  delete: copy.adminActionDelete,
};

const usuariosReadId = permissions.find((permission) => {
  if (permission.action !== "read") return false;
  return modules.some((module) => module.id === permission.module_id && module.slug === "usuarios");
})?.id;
---

<AdminLayout title={`${copy.titleAdmin} · ${copy.adminUsers}`} active="users">
  <header class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-end">
    <div>
      <p class="text-primary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.navAdmin}</p>
      <h1 class="font-display text-[28px] leading-[1.06] font-bold tracking-[-0.005em] lg:text-[34px]">{copy.adminUsers}</h1>
    </div>
  </header>

  <details class="card bg-base-100 border border-base-300 shadow-sm mt-6" open>
    <summary class="card-body cursor-pointer list-none">
      <span class="flex items-center gap-2 font-bold">
        <svg class="size-4"><use href="#ic-plus"></use></svg>
        {copy.adminNewUserInvite}
      </span>
      <p class="mt-1 text-sm opacity-70">{copy.adminInviteSelectRole}</p>
    </summary>

    <form method="post" action="/api/admin/users/invite" class="card-body border-t border-base-300 pt-4" data-invite-form>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.adminModuleName}</legend>
          <input class="input w-full" name="name" required maxlength="80" autocomplete="off" />
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.adminUserEmail}</legend>
          <input class="input w-full" name="email" type="email" required maxlength="120" autocomplete="off" />
        </fieldset>
        <fieldset class="fieldset sm:col-span-2">
          <legend class="fieldset-legend">{copy.adminUserRole}</legend>
          <select class="select w-full" name="roleId" data-role-select>
            <option value="">{copy.adminUserNoRole}</option>
            {roles.map((role) => <option value={role.id}>{role.name}</option>)}
          </select>
          <p class="text-xs opacity-60">{copy.adminInviteRoleHint}</p>
        </fieldset>
      </div>

      <p class="mt-3 text-xs font-extrabold tracking-[0.16em] text-base-content/60 uppercase">{copy.adminUserPermissions}</p>
      <p class="mt-1 text-sm opacity-70">{copy.adminPermissionMatrixHelp}</p>
      <div class="mt-2">
        <PermissionMatrix
          modules={modules}
          permissions={permissions}
          actionLabels={actionLabels}
          parentLabel={copy.adminPermissionParent}
          limitLabel={copy.adminPermissionLimit}
        />
      </div>

      <div class="alert alert-error mt-3 hidden" data-invite-error><span data-invite-error-text></span></div>
      <div class="alert alert-success mt-3 hidden" data-invite-success><span data-invite-success-text></span></div>
      <div class="flex justify-end gap-2">
        <button class="btn btn-ghost btn-sm" type="reset">{copy.adminCancel}</button>
        <button class="btn btn-primary btn-sm" type="submit">{copy.adminInviteSelectRole.includes("rol") ? "Enviar invitación" : copy.adminAdd}</button>
      </div>
    </form>
  </details>

  <div class="mt-6 flex flex-col gap-6">
    {users.map((user) => {
      const granted = grantedByUser.get(user.id) ?? new Map();
      const isSelf = user.id === actor.id;
      const isChild = user.created_by === actor.id;
      const canSeeParent = Boolean(usuariosReadId && granted.get(usuariosReadId)?.parent);
      return (
        <article class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body gap-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="font-display text-[20px] tracking-[-0.005em]">{user.name}</h2>
                <p class="text-sm opacity-70">{user.email}</p>
                <div class="mt-1 flex flex-wrap items-center gap-2">
                  <span class:list={["badge badge-sm", user.is_active ? "badge-success" : "badge-ghost"]}>{user.is_active ? copy.adminUserActive : copy.adminUserPaused}</span>
                  {user.invite_pending ? <span class="badge badge-sm badge-warning">{copy.inviteEyebrow}</span> : null}
                  {user.role_name ? <span class="badge badge-sm badge-accent">{user.role_name}</span> : null}
                  {isSelf ? <span class="badge badge-sm">{copy.adminYou}</span> : null}
                  {isChild ? <span class="badge badge-sm badge-ghost">{copy.adminCreatedByYou}</span> : null}
                  {canSeeParent ? <span class="badge badge-sm badge-info">{copy.adminParentVisible}</span> : null}
                </div>
              </div>
              {!isSelf ? (
                <form method="post" action="/api/admin/roles" data-admin-confirm>
                  <input type="hidden" name="_intent" value="delete_user" />
                  <input type="hidden" name="id" value={user.id} />
                  <button class="btn btn-square btn-ghost btn-sm" type="submit" title={copy.adminRemove}>
                    <svg class="size-4"><use href="#ic-trash"></use></svg>
                  </button>
                </form>
              ) : null}
            </div>

            {!isSelf ? (
              <form method="post" action="/api/admin/permissions" data-admin-permissions-form>
                <input type="hidden" name="_intent" value="assign_user" />
                <input type="hidden" name="userId" value={user.id} />
                <p class="text-xs font-extrabold tracking-[0.16em] text-base-content/60 uppercase">{copy.adminUserPermissions}</p>
                <p class="mt-1 text-sm opacity-70">{copy.adminPermissionMatrixHelp}</p>
                <div class="mt-3">
                  <PermissionMatrix
                    modules={modules}
                    permissions={permissions}
                    assignments={granted}
                    actionLabels={actionLabels}
                    parentLabel={copy.adminPermissionParent}
                    limitLabel={copy.adminPermissionLimit}
                  />
                </div>
                <div class="mt-3 flex justify-end gap-2">
                  <button class="btn btn-primary btn-sm" type="submit">{copy.adminSave}</button>
                </div>
              </form>
            ) : null}
          </div>
        </article>
      );
    })}
  </div>

  <script is:inline define:vars={{ rolePermissions: rolePermissionsJson, locale }}>
    (function () {
      var roleMap = JSON.parse(rolePermissions);
      var lang = locale === "en" ? "en" : "es";

      var bind = function () {
        var form = document.querySelector("[data-invite-form]");
        if (form && !form.dataset.boundRole) {
          form.dataset.boundRole = "true";
          var roleSelect = form.querySelector("[data-role-select]");
          var matrix = form.querySelector("[data-permission-matrix]");
          function applyRole(value) {
            var grants = value && roleMap[value] ? roleMap[value] : {};
            if (!matrix) return;
            matrix.querySelectorAll("[data-parent-box]").forEach(function (box) {
              var grant = grants[box.value];
              box.checked = Boolean(grant && grant.parent);
            });
            matrix.querySelectorAll("[data-quota-input]").forEach(function (input) {
              var grant = grants[input.getAttribute("data-permission-id")];
              input.value = grant && grant.quota != null ? grant.quota : "";
            });
          }
          if (roleSelect) {
            roleSelect.addEventListener("change", function (event) { applyRole(event.target.value); });
          }

          var errorBox = form.querySelector("[data-invite-error]");
          var errorText = form.querySelector("[data-invite-error-text]");
          var successBox = form.querySelector("[data-invite-success]");
          var successText = form.querySelector("[data-invite-success-text]");
          var submit = form.querySelector("button[type=submit]");

          form.addEventListener("submit", function (event) {
            event.preventDefault();
            if (errorBox) errorBox.classList.add("hidden");
            if (successBox) successBox.classList.add("hidden");
            submit.disabled = true;
            var data = new FormData(form);
            data.set("locale", lang);
            var messages = lang === "en" ? {
              name_required: "Name is required.",
              email_invalid: "Enter a valid email.",
              email_taken: "An admin already exists with that email.",
              email_failed: "We couldn't send the invite email.",
              insert_failed: "Could not save the user.",
              quota_exceeded: "This account reached its user limit.",
            } : {
              name_required: "Ingresá un nombre.",
              email_invalid: "Ingresá un correo válido.",
              email_taken: "Ya existe un administrador con ese correo.",
              email_failed: "No pudimos enviar el correo de invitación.",
              insert_failed: "No pudimos guardar el usuario.",
              quota_exceeded: "Esta cuenta llegó al límite de usuarios.",
            };
            fetch(form.action, { method: "POST", body: data })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (successText) successText.textContent = lang === "en"
                    ? "✓ Invite sent to " + result.body.emailSentTo
                    : "✓ Invitación enviada a " + result.body.emailSentTo;
                  if (successBox) successBox.classList.remove("hidden");
                  form.reset();
                  applyRole("");
                  setTimeout(function () { window.location.reload(); }, 1400);
                  return;
                }
                if (errorText) errorText.textContent = messages[result.body && result.body.error] || (lang === "en" ? "Could not save." : "No pudimos guardar.");
                if (errorBox) errorBox.classList.remove("hidden");
                submit.disabled = false;
              })
              .catch(function () {
                if (errorText) errorText.textContent = lang === "en" ? "Network error." : "Error de red.";
                if (errorBox) errorBox.classList.remove("hidden");
                submit.disabled = false;
              });
          });
        }

        document.querySelectorAll("form[data-admin-confirm]").forEach(function (f) {
          if (f.dataset.boundConfirm === "true") return;
          f.dataset.boundConfirm = "true";
          f.addEventListener("submit", function (event) {
            event.preventDefault();
            if (!window.confirm(lang === "en" ? "Delete this user?" : "¿Eliminar este usuario?")) return;
            var data = new FormData(f);
            fetch(f.action, { method: "POST", body: data }).then(function () { window.location.reload(); });
          });
        });

        document.querySelectorAll("form[data-admin-permissions-form]").forEach(function (f) {
          if (f.dataset.boundPerm === "true") return;
          f.dataset.boundPerm = "true";
          f.addEventListener("submit", function (event) {
            event.preventDefault();
            var data = new FormData(f);
            fetch(f.action, { method: "POST", body: data })
              .then(function (res) { return res.json(); })
              .then(function () {
                var banner = document.createElement("div");
                banner.className = "toast toast-end";
                banner.innerHTML = '<div class="alert alert-success"><span>' + (lang === "en" ? "Permissions saved." : "Permisos guardados.") + '</span></div>';
                document.body.appendChild(banner);
                setTimeout(function () { banner.remove(); }, 1800);
              });
          });
        });
      };
      bind();
      document.addEventListener("astro:after-swap", bind);
    })();
  </script>
</AdminLayout>
