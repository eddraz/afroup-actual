---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import PermissionMatrix from "../../../components/PermissionMatrix.astro";
import { localizedPath } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { routeIds } from "../../../lib/paths";
import { hasPermission } from "../../../lib/rbac";
import { parsePermissionGrants, type PermissionGrant } from "../../../lib/permission-grants";
import { env } from "cloudflare:workers";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import AdminToolbar from "../../../components/admin/AdminToolbar.astro";
import AdminTable from "../../../components/admin/AdminTable.astro";
import AdminDrawerPanel from "../../../components/admin/AdminDrawerPanel.astro";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "users");
if (access instanceof Response) return access;
const actor = access;

interface UserRow {
  id: number;
  email: string;
  name: string;
  is_active: number;
  role_id: number | null;
  role_name: string | null;
  created_by: number | null;
  invite_pending: number;
  created_at: string;
}

interface RoleOption {
  id: number;
  name: string;
}

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
}

interface PermissionRow {
  id: number;
  module_id: number;
  action: "create" | "read" | "update" | "delete";
}

interface GrantRow {
  user_id: number;
  permission_id: number;
  quota: number | null;
  translate_manual: number | null;
  translate_ai: number | null;
}

interface RoleGrantRow {
  role_id: number;
  permission_id: number;
  quota: number | null;
  translate_manual: number | null;
  translate_ai: number | null;
}

const canInvite = await hasPermission(env.DB, actor.id, "usuarios", "create");

const users = (await env.DB.prepare(
  `SELECT u.id, u.email, u.name, u.is_active, u.role_id, u.created_by,
          u.invite_pending, u.created_at, r.name AS role_name
     FROM users u
LEFT JOIN admin_roles r ON r.id = u.role_id
    WHERE u.id = ?
       OR u.created_by = ?
       OR u.id IN (SELECT record_id FROM record_shares WHERE shared_with_id = ? AND module_slug = 'users')
    ORDER BY u.id = ? DESC, u.name`,
)
  .bind(actor.id, actor.id, actor.id, actor.id)
  .all<UserRow>()).results ?? [];

const roles = (await env.DB.prepare(
  "SELECT id, name FROM admin_roles ORDER BY name",
).all<RoleOption>()).results ?? [];

const modules = (await env.DB.prepare(
  "SELECT id, name, slug FROM admin_modules ORDER BY name",
).all<ModuleRow>()).results ?? [];

const permissions = (await env.DB.prepare(
  "SELECT id, module_id, action FROM admin_permissions ORDER BY module_id, action",
).all<PermissionRow>()).results ?? [];

const grantRows = (await env.DB.prepare(
  "SELECT user_id, permission_id, quota, translate_manual, translate_ai FROM admin_user_permissions",
).all<GrantRow>()).results ?? [];

const roleGrantRows = (await env.DB.prepare(
  "SELECT role_id, permission_id, quota, translate_manual, translate_ai FROM admin_role_permissions",
).all<RoleGrantRow>()).results ?? [];

const rolePresets: Record<number, Record<number, { scope: string; translation_tier: string }>> = {};
for (const row of roleGrantRows) {
  if (!rolePresets[row.role_id]) rolePresets[row.role_id] = {};
  rolePresets[row.role_id][row.permission_id] = {
    scope: row.quota ? String(row.quota) : "unlimited",
    translation_tier: row.translate_ai ? "ai" : row.translate_manual ? "manual" : "none",
  };
}

const grantedByUser = new Map<number, Map<number, PermissionGrant>>();
for (const row of grantRows) {
  let map = grantedByUser.get(row.user_id);
  if (!map) {
    map = new Map<number, PermissionGrant>();
    grantedByUser.set(row.user_id, map);
  }
  map.set(row.permission_id, {
    quota: row.quota,
    translateManual: Boolean(row.translate_manual),
    translateAi: Boolean(row.translate_ai),
  });
}

const sharedWithMeRows = (await env.DB.prepare(
  "SELECT record_id FROM record_shares WHERE shared_with_id = ? AND module_slug = 'users'",
)
  .bind(actor.id)
  .all<{ record_id: number }>()).results ?? [];
const sharedWithMe = new Set(sharedWithMeRows.map((r) => r.record_id));

const shareable = (await env.DB.prepare(
  "SELECT id, name FROM users WHERE is_active = 1 AND id != ? ORDER BY name",
)
  .bind(actor.id)
  .all<{ id: number; name: string }>()).results ?? [];

const actionLabels: Record<PermissionRow["action"], string> = {
  create: copy.adminActionCreate,
  read: copy.adminActionRead,
  update: copy.adminActionUpdate,
  delete: copy.adminActionDelete,
};
---

<AdminLayout title={copy.adminUsers} active="users">
  <!-- Right-to-Left Drawer for Users -->
  <AdminDrawerPanel
    toggleId="user-drawer"
    width="form"
    title={copy.adminNewUserInvite || "Invite new member"}
    subtitle="Send an access link with preconfigured role and permissions."
  >
    <Fragment slot="content">
      <!-- Page Header -->
      <AdminPageHeader
        title={copy.adminUsers}
        count={users.length}
        countLabel="members"
        lead="Manage team members, collaborators, roles, and granular access permissions."
      >
        {canInvite ? (
          <Fragment slot="actions">
            <label
              for="user-drawer"
              class="drawer-button btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform cursor-pointer"
            >
              <svg class="size-4"><use href="#ic-plus"></use></svg>
              <span>{copy.adminNewUserInvite || "Invite User"}</span>
            </label>
          </Fragment>
        ) : null}
      </AdminPageHeader>

      <!-- Filter & Search Toolbar -->
      <AdminToolbar
        searchId="users-search"
        searchPlaceholder="Search users by name, email, or role..."
        filterName="user"
        filters={[
          { value: "all", label: `All (${users.length})` },
          { value: "active", label: `Active (${users.filter((u) => u.is_active).length})` },
          { value: "pending", label: `Invitations (${users.filter((u) => u.invite_pending).length})` },
        ]}
      />

      <!-- Users Table -->
      <AdminTable
        id="users-table"
        columns={[
          { label: "User", class: "py-4 pl-6" },
          { label: "Role" },
          { label: "Status" },
          { label: "Created" },
          { label: "Actions", class: "text-right pr-6" },
        ]}
      >
        {users.length === 0 ? (
          <Fragment slot="empty">
            <tr>
              <td colspan="5" class="text-center py-12 text-base-content/60">
                <div class="flex flex-col items-center gap-2">
                  <div class="size-12 rounded-2xl bg-base-200 flex items-center justify-center text-base-content/40">
                    <svg class="size-6"><use href="#ic-users"></use></svg>
                  </div>
                  <span class="font-bold text-base">No users registered</span>
                  <span class="text-xs text-base-content/50">Invite a team member to start collaborating</span>
                </div>
              </td>
            </tr>
          </Fragment>
        ) : (
          <Fragment slot="rows">
            {users.map((user) => {
              const granted = grantedByUser.get(user.id) ?? new Map();
              const isSelf = user.id === actor.id;
              const isChild = user.created_by === actor.id;
              const isShared = sharedWithMe.has(user.id);
              const initials = (user.name || "U")
                .split(" ")
                .map((p) => p[0])
                .slice(0, 2)
                .join("")
                .toUpperCase();
              const createdLabel = user.created_at ? user.created_at.slice(0, 10) : "—";

              return (
                <tr
                  class="hover:bg-base-200/50 transition-colors user-card"
                  data-name={(user.name || "").toLowerCase()}
                  data-email={(user.email || "").toLowerCase()}
                  data-role={(user.role_name || "").toLowerCase()}
                  data-active={user.is_active ? "active" : "paused"}
                  data-pending={user.invite_pending ? "pending" : "verified"}
                >
                  <td class="py-3.5 pl-6">
                    <div class="flex items-start gap-3.5">
                      <div class="avatar placeholder">
                        <div class="size-12 rounded-2xl bg-primary/10 text-primary font-bold font-display text-base border border-primary/20 flex items-center justify-center">
                          <span>{initials}</span>
                        </div>
                      </div>
                      <div class="min-w-0 space-y-2">
                        <div>
                          <div class="flex items-center gap-2">
                            <h3 class="font-display text-base font-bold text-base-content">{user.name}</h3>
                            {isSelf ? <span class="badge badge-xs badge-primary font-bold">{copy.adminYou || "You"}</span> : null}
                          </div>
                          <p class="text-xs text-base-content/60 font-mono break-all">{user.email}</p>
                          <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                            {isChild ? <span class="badge badge-xs badge-ghost font-semibold py-1 px-2">{copy.adminCreatedByYou || "Created by you"}</span> : null}
                            {isShared ? <span class="badge badge-xs badge-info font-semibold py-1 px-2">{copy.adminSharedWithYou || "Shared"}</span> : null}
                          </div>
                        </div>

                        {isChild ? (
                          <div class="border-t border-base-300/60 pt-2">
                            <form method="post" action="/api/admin/shares" class="flex flex-wrap items-center gap-2 text-xs" data-share-form>
                              <input type="hidden" name="module" value="users" />
                              <input type="hidden" name="recordId" value={user.id} />
                              <span class="font-semibold text-base-content/60">{copy.adminShareWith || "Share access with:"}</span>
                              <select class="select select-bordered select-xs text-xs font-semibold" name="sharedWithId" required>
                                <option value="">{copy.adminShareNone || "Select..."}</option>
                                {shareable.filter((candidate) => candidate.id !== user.id).map((candidate) => (
                                  <option value={candidate.id}>{candidate.name}</option>
                                ))}
                              </select>
                              <button class="btn btn-ghost btn-xs border border-base-300" type="submit">{copy.adminShare || "Share"}</button>
                            </form>
                          </div>
                        ) : null}

                        {!isSelf && isChild ? (
                          <details class="border-t border-base-300/60 pt-2 group">
                            <summary class="cursor-pointer text-xs font-bold text-base-content/70 hover:text-primary flex items-center justify-between list-none py-1">
                              <span class="flex items-center gap-1.5">
                                <svg class="size-4"><use href="#ic-key"></use></svg>
                                <span>{copy.adminEditPermissions || "Adjust Permissions"}</span>
                              </span>
                              <span class="text-base-content/40 group-open:rotate-180 transition-transform">▼</span>
                            </summary>

                            <form method="post" action="/api/admin/roles" class="mt-3 space-y-4" data-admin-form data-intent="update_user_permissions">
                              <input type="hidden" name="_intent" value="update_user_permissions" />
                              <input type="hidden" name="userId" value={user.id} />

                              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                <fieldset class="fieldset">
                                  <legend class="fieldset-legend font-semibold text-xs text-base-content/70">{copy.adminUserRole}</legend>
                                  <select class="select select-bordered select-sm w-full font-semibold" name="roleId">
                                    <option value="">{copy.adminUserNoRole || "No role assigned"}</option>
                                    {roles.map((role) => (
                                      <option value={role.id} selected={user.role_id === role.id}>{role.name}</option>
                                    ))}
                                  </select>
                                </fieldset>
                                <fieldset class="fieldset">
                                  <legend class="fieldset-legend font-semibold text-xs text-base-content/70">{copy.adminStatus || "Status"}</legend>
                                  <select class="select select-bordered select-sm w-full font-semibold" name="isActive">
                                    <option value="1" selected={user.is_active === 1}>{copy.adminUserActive || "Active"}</option>
                                    <option value="0" selected={user.is_active === 0}>{copy.adminUserPaused || "Paused"}</option>
                                  </select>
                                </fieldset>
                              </div>

                              <div class="mt-2">
                                <PermissionMatrix
                                  modules={modules}
                                  permissions={permissions}
                                  assignments={granted}
                                  actionLabels={actionLabels}
                                  allowLabel={copy.adminPermissionAllow}
                                  limitLabel={copy.adminPermissionLimit}
                                  translateLabel={copy.adminPermissionTranslate}
                                  translateNoneLabel={copy.adminPermissionTranslateNone}
                                  translateManualLabel={copy.adminPermissionTranslateManual}
                                  translateAiLabel={copy.adminPermissionTranslateAi}
                                  unlimitedLabel={copy.adminPermissionUnlimited}
                                  noneLabel={copy.adminPermissionNone}
                                  helpToggleLabel={copy.adminPermissionHelpToggle}
                                  doneLabel={copy.adminPermissionDone}
                                  helpCreate={copy.adminPermissionHelpCreate}
                                  helpRead={copy.adminPermissionHelpRead}
                                  helpUpdate={copy.adminPermissionHelpUpdate}
                                  helpDelete={copy.adminPermissionHelpDelete}
                                  helpAllow={copy.adminPermissionHelpAllow}
                                  helpLimit={copy.adminPermissionHelpLimit}
                                  helpTranslate={copy.adminPermissionHelpTranslate}
                                />
                              </div>

                              <div class="flex justify-end gap-2 pt-2 border-t border-base-300/60">
                                <button class="btn btn-primary btn-sm px-5 font-bold" type="submit">{copy.adminSave}</button>
                              </div>
                            </form>
                          </details>
                        ) : null}
                      </div>
                    </div>
                  </td>
                  <td>
                    {user.role_name ? (
                      <span class="badge badge-xs badge-accent font-bold py-1 px-2 uppercase">{user.role_name}</span>
                    ) : (
                      <span class="text-base-content/40">—</span>
                    )}
                  </td>
                  <td>
                    <div class="flex flex-wrap items-center gap-1.5">
                      <span class:list={[
                        "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider",
                        user.is_active ? "bg-success/15 text-success border border-success/30" : "bg-base-300 text-base-content/60"
                      ]}>
                        <span class:list={["size-1.5 rounded-full", user.is_active ? "bg-success animate-pulse" : "bg-base-content/40"]}></span>
                        {user.is_active ? copy.adminUserActive || "Active" : copy.adminUserPaused || "Paused"}
                      </span>
                      {user.invite_pending ? <span class="badge badge-xs badge-warning font-bold py-1 px-2 uppercase">{copy.inviteEyebrow || "Invitation Pending"}</span> : null}
                    </div>
                  </td>
                  <td>
                    <span class="font-mono text-xs text-base-content/70">{createdLabel}</span>
                  </td>
                  <td class="text-right pr-6">
                    {!isSelf ? (
                      <form method="post" action="/api/admin/roles" data-admin-confirm class="inline-flex">
                        <input type="hidden" name="_intent" value="delete_user" />
                        <input type="hidden" name="id" value={user.id} />
                        <button class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-error/10 hover:text-error" type="submit" title={copy.adminRemove}>
                          <svg class="size-3.5"><use href="#ic-trash"></use></svg>
                        </button>
                      </form>
                    ) : (
                      <span class="text-base-content/30 text-xs">—</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </Fragment>
        )}
      </AdminTable>
    </Fragment>

    <!-- Drawer Side (Right to Left Invite Form) -->
    {canInvite ? (
      <form method="post" action="/api/admin/users/invite" class="space-y-6 flex-1 flex flex-col justify-between" data-invite-form>
        <div class="space-y-5">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminModuleName || "Full Name"}</legend>
              <input class="input input-bordered w-full font-semibold" name="name" required maxlength="80" autocomplete="off" placeholder="Jenniffer M." />
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminUserEmail || "Email Address"}</legend>
              <input class="input input-bordered w-full font-semibold" name="email" type="email" required maxlength="120" autocomplete="off" placeholder="user@afroup.com" />
            </fieldset>
            <fieldset class="fieldset sm:col-span-2">
              <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminUserRole || "Default Role"}</legend>
              <select class="select select-bordered w-full font-semibold" name="roleId" data-role-select>
                <option value="">{copy.adminUserNoRole || "No role assigned"}</option>
                {roles.map((role) => <option value={role.id}>{role.name}</option>)}
              </select>
              <p class="text-xs text-base-content/50 mt-1">{copy.adminInviteRoleHint}</p>
            </fieldset>
          </div>

          <div class="border-t border-base-300 pt-4">
            <p class="text-xs font-extrabold tracking-wider text-base-content/60 uppercase">{copy.adminUserPermissions || "Specific Permission Matrix"}</p>
            <p class="mt-1 text-xs text-base-content/60">{copy.adminPermissionMatrixHelp}</p>
            <div class="mt-3">
              <PermissionMatrix
                modules={modules}
                permissions={permissions}
                actionLabels={actionLabels}
                allowLabel={copy.adminPermissionAllow}
                limitLabel={copy.adminPermissionLimit}
                translateLabel={copy.adminPermissionTranslate}
                translateNoneLabel={copy.adminPermissionTranslateNone}
                translateManualLabel={copy.adminPermissionTranslateManual}
                translateAiLabel={copy.adminPermissionTranslateAi}
                unlimitedLabel={copy.adminPermissionUnlimited}
                noneLabel={copy.adminPermissionNone}
                helpToggleLabel={copy.adminPermissionHelpToggle}
                doneLabel={copy.adminPermissionDone}
                helpCreate={copy.adminPermissionHelpCreate}
                helpRead={copy.adminPermissionHelpRead}
                helpUpdate={copy.adminPermissionHelpUpdate}
                helpDelete={copy.adminPermissionHelpDelete}
                helpAllow={copy.adminPermissionHelpAllow}
                helpLimit={copy.adminPermissionHelpLimit}
                helpTranslate={copy.adminPermissionHelpTranslate}
              />
            </div>
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-4 border-t border-base-300 mt-6 shrink-0">
          <label for="user-drawer" class="btn btn-ghost btn-sm cursor-pointer">{copy.adminCancel}</label>
          <button class="btn btn-primary btn-sm px-6 font-bold" type="submit">
            {copy.adminInviteSelectRole?.includes("role") ? "Send Invitation" : copy.adminAdd || "Save"}
          </button>
        </div>
      </form>
    ) : null}
  </AdminDrawerPanel>

  <script is:inline define:vars={{ roleMap: rolePresets }}>
    (function () {
      var bind = function () {
        var drawerToggle = document.getElementById("user-drawer");

        if (drawerToggle && drawerToggle.dataset.boundScroll !== "true") {
          drawerToggle.dataset.boundScroll = "true";
          drawerToggle.addEventListener("change", function () {
            if (drawerToggle.checked) {
              document.body.style.overflow = "hidden";
              var firstInput = document.querySelector(".drawer-side input:not([disabled])");
              if (firstInput) setTimeout(function () { firstInput.focus(); }, 150);
            } else {
              document.body.style.overflow = "";
            }
          });

          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && drawerToggle.checked) {
              drawerToggle.checked = false;
              document.body.style.overflow = "";
            }
          });
        }

        var form = document.querySelector("[data-invite-form]");
        if (form && !form.dataset.boundRole) {
          form.dataset.boundRole = "true";
          var roleSelect = form.querySelector("[data-role-select]");
          var matrix = form.querySelector("[data-permission-matrix]");
          function applyRole(value) {
            var grants = value && roleMap[value] ? roleMap[value] : {};
            if (!matrix) return;
            matrix.querySelectorAll("[data-allow-box]").forEach(function (box) {
              var grant = grants[box.value];
              box.checked = Boolean(grant);
              var row = box.closest("[data-permission-row]");
              var limit = row ? row.querySelector("[data-limit-select]") : null;
              var translate = row ? row.querySelector("[data-translate-select]") : null;
              if (limit) {
                limit.value = grant && grant.scope ? grant.scope : "unlimited";
                limit.disabled = !box.checked;
              }
              if (translate) {
                translate.value = grant && grant.translation_tier ? grant.translation_tier : "none";
                translate.disabled = !box.checked;
              }
            });
          }
          if (roleSelect) {
            roleSelect.addEventListener("change", function () { applyRole(roleSelect.value); });
          }
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            fetch(form.action, { method: "POST", body: new FormData(form) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Invitation sent.", "success");
                  if (drawerToggle) drawerToggle.checked = false;
                  document.body.style.overflow = "";
                  setTimeout(function () { window.location.reload(); }, 700);
                  return;
                }
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Failed to send invitation.", "error");
              })
              .catch(function () {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Network error.", "error");
              });
          });
        }

        // Live User Search & Status Filter
        var searchInput = document.getElementById("users-search");
        var filterButtons = document.querySelectorAll(".user-filter-btn");
        var cards = document.querySelectorAll(".user-card");

        var currentFilter = "all";
        var searchQuery = "";

        var applyUserFilters = function () {
          cards.forEach(function (card) {
            var name = card.getAttribute("data-name") || "";
            var email = card.getAttribute("data-email") || "";
            var role = card.getAttribute("data-role") || "";
            var active = card.getAttribute("data-active") || "";
            var pending = card.getAttribute("data-pending") || "";

            var matchesSearch = !searchQuery || name.indexOf(searchQuery) !== -1 || email.indexOf(searchQuery) !== -1 || role.indexOf(searchQuery) !== -1;
            var matchesFilter = currentFilter === "all" ||
              (currentFilter === "active" && active === "active") ||
              (currentFilter === "pending" && pending === "pending");

            if (matchesSearch && matchesFilter) {
              card.style.display = "";
            } else {
              card.style.display = "none";
            }
          });
        };

        if (searchInput && searchInput.dataset.bound !== "true") {
          searchInput.dataset.bound = "true";
          searchInput.addEventListener("input", function () {
            searchQuery = searchInput.value.trim().toLowerCase();
            applyUserFilters();
          });
        }

        filterButtons.forEach(function (btn) {
          if (btn.dataset.bound === "true") return;
          btn.dataset.bound = "true";
          btn.addEventListener("click", function () {
            filterButtons.forEach(function (b) {
              b.classList.remove("btn-primary", "text-primary-content");
              b.classList.add("btn-ghost");
            });
            btn.classList.remove("btn-ghost");
            btn.classList.add("btn-primary", "text-primary-content");

            currentFilter = btn.getAttribute("data-filter") || "all";
            applyUserFilters();
          });
        });
      };

      bind();
      document.addEventListener("astro:page-load", bind);
      document.addEventListener("astro:before-swap", function () {
        document.body.style.overflow = "";
      });
    })();
  </script>
</AdminLayout>


