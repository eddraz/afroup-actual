---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ArticleEditor from "../../../components/ArticleEditor.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { defaultLocale, joinPath, localizedPath } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { translationAccess, visibleOwnerClause } from "../../../lib/editorial";
import { hasPermission } from "../../../lib/rbac";
import { listSiteLanguages } from "../../../lib/site-languages";
import { routeIds } from "../../../lib/paths";
import { getCategoryTheme } from "../../../lib/category-routes";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "articulos");
if (access instanceof Response) return access;
const actor = access;

const canCreate = await hasPermission(env.DB, actor.id, "articulos", "create");
const canDelete = await hasPermission(env.DB, actor.id, "articulos", "delete");
const translation = await translationAccess(env.DB, actor.id, "articulos", canCreate ? "create" : "update");
const languages = await listSiteLanguages(env.DB);

interface ArticleRow {
  id: number;
  slug: string;
  status: string;
  cover_image_url: string | null;
  reading_time_minutes: number | null;
  created_at: string;
  updated_at: string;
  published_at: string | null;
  created_by: number | null;
  author_name: string | null;
  title: string | null;
  category_titles: string | null;
  primary_category_slug: string | null;
}

interface CategoryOption {
  id: number;
  slug: string;
  title: string;
}

const items = (await env.DB.prepare(
  `SELECT a.id, a.slug, a.status, a.cover_image_url, a.reading_time_minutes,
          a.created_at, a.updated_at, a.published_at,
          a.created_by, u.name AS author_name,
          (SELECT title FROM article_locales l
            WHERE l.article_id = a.id
            ORDER BY CASE WHEN l.locale = ? THEN 0 ELSE 1 END, l.locale
            LIMIT 1) AS title,
          (SELECT GROUP_CONCAT(title, ', ')
             FROM (
               SELECT COALESCE(
                 (SELECT title FROM article_category_locales WHERE category_id = m.category_id AND locale = ?),
                 (SELECT title FROM article_category_locales WHERE category_id = m.category_id AND locale = ?)
               ) AS title
                 FROM article_category_map m
                WHERE m.article_id = a.id
                ORDER BY m.sort_order, m.category_id
             )) AS category_titles,
          (SELECT c.slug FROM article_categories c
             JOIN article_category_map m ON m.category_id = c.id
            WHERE m.article_id = a.id
            ORDER BY m.sort_order, c.id
            LIMIT 1) AS primary_category_slug
     FROM articles a
LEFT JOIN users u ON u.id = a.created_by
    WHERE ${visibleOwnerClause("a.created_by")}
    ORDER BY a.updated_at DESC, a.id DESC`,
)
  .bind(locale, locale, defaultLocale, actor.id, "articulos", actor.id)
  .all<ArticleRow>()).results ?? [];

const categories = (await env.DB.prepare(
  `SELECT c.id, c.slug,
          COALESCE(
            (SELECT title FROM article_category_locales WHERE category_id = c.id AND locale = ?),
            (SELECT title FROM article_category_locales WHERE category_id = c.id AND locale = ?)
          ) AS title
     FROM article_categories c
    ORDER BY title`,
)
  .bind(locale, defaultLocale)
  .all<CategoryOption>()).results ?? [];

const listHref = localizedPath(locale, joinPath(routeIds.admin, "articulos"));
---

<AdminLayout title={copy.adminArticles} active="articles">
  {canCreate ? (
    <details class="card bg-base-100 border border-base-300 shadow-sm mb-6">
      <summary class="card-body cursor-pointer list-none flex flex-row items-center justify-between">
        <span class="flex items-center gap-2 font-bold text-base">
          <svg class="size-5"><use href="#ic-plus"></use></svg>
          {copy.adminNewArticle}
        </span>
        <span class="badge badge-sm badge-ghost">{copy.adminCategoryTitle}</span>
      </summary>
      <div class="border-t border-base-300 p-4 sm:p-6">
        <ArticleEditor
          categories={categories}
          languages={languages}
          translation={translation}
          locale={locale}
          copy={copy}
          backHref={listHref}
        />
      </div>
    </details>
  ) : null}

  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>{copy.adminCategoryTitle}</th>
              <th>{copy.adminArticleCategory}</th>
              <th>{copy.adminArticleAuthor}</th>
              <th>{copy.adminArticleReadingTime}</th>
              <th>{copy.adminArticleStatus}</th>
              <th>{copy.adminArticleUpdatedAt}</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            {items.length === 0 ? (
              <tr>
                <td colspan="7" class="text-center py-8 text-base-content/60">
                  No articles registered yet.
                </td>
              </tr>
            ) : null}
            {items.map((item) => {
              const editHref = localizedPath(locale, joinPath(routeIds.admin, `articulos/${item.id}`));
              const publicHref = item.primary_category_slug
                ? localizedPath(locale, `${item.primary_category_slug}/${item.slug}`)
                : null;

              return (
                <tr class="hover">
                  <td>
                    <div class="flex items-center gap-3">
                      {item.cover_image_url ? (
                        <div class="avatar size-10 rounded-lg overflow-hidden flex-none border border-base-300">
                          <img src={item.cover_image_url} alt="" class="size-full object-cover" />
                        </div>
                      ) : (
                        <div class="size-10 rounded-lg bg-base-200 border border-base-300 flex-none flex items-center justify-center text-xs opacity-40 font-mono">
                          AU
                        </div>
                      )}
                      <div>
                        <a href={editHref} class="font-bold hover:underline text-base-content block">
                          {item.title ?? item.slug}
                        </a>
                        <span class="text-xs text-base-content/60 font-mono">/{item.slug}</span>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="text-sm">{item.category_titles ?? copy.adminArticleNoCategory}</span>
                  </td>
                  <td>
                    <span class="text-sm font-medium">{item.author_name ?? "AfroUp"}</span>
                  </td>
                  <td>
                    <span class="badge badge-sm badge-ghost gap-1">
                      {item.reading_time_minutes ?? 5} {copy.adminArticleMinutes}
                    </span>
                  </td>
                  <td>
                    <span class:list={["badge badge-sm font-semibold", item.status === "published" ? "badge-success" : "badge-ghost"]}>
                      {item.status === "published" ? copy.adminArticlePublished : copy.adminArticleDraft}
                    </span>
                  </td>
                  <td>
                    <span class="text-xs text-base-content/70">
                      {item.updated_at ? item.updated_at.slice(0, 10) : "—"}
                    </span>
                  </td>
                  <td class="text-right">
                    <div class="inline-flex items-center gap-1.5">
                      {publicHref && item.status === "published" ? (
                        <a
                          class="btn btn-ghost btn-xs btn-square"
                          href={publicHref}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={copy.adminArticleViewPublic}
                        >
                          <svg class="size-3.5"><use href="#ic-link"></use></svg>
                        </a>
                      ) : null}
                      <a class="btn btn-primary btn-outline btn-xs" href={editHref}>
                        {copy.adminEdit}
                      </a>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
