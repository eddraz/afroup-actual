---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import PageLocaleSwitch from "../../../components/PageLocaleSwitch.astro";
import { requireModuleAccess } from "../../../lib/admin-scope";
import { defaultLocale } from "../../../lib/i18n";
import { resolveRequestCopy } from "../../../lib/request-locale";
import { translationAccess, visibleOwnerClause } from "../../../lib/editorial";
import { hasPermission } from "../../../lib/rbac";
import { listSiteLanguages } from "../../../lib/site-languages";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "articulos");
if (access instanceof Response) return access;
const actor = access;
const canCreate = await hasPermission(env.DB, actor.id, "articulos", "create");
const translation = await translationAccess(env.DB, actor.id, "articulos", canCreate ? "create" : "update");
const languages = await listSiteLanguages(env.DB);

interface ArticleRow {
  id: number;
  slug: string;
  status: string;
  title: string | null;
  category_title: string | null;
}

interface CategoryOption {
  id: number;
  title: string;
}

const items = (await env.DB.prepare(
  `SELECT a.id, a.slug, a.status,
          (SELECT title FROM article_locales l
            WHERE l.article_id = a.id
            ORDER BY CASE WHEN l.locale = ? THEN 0 ELSE 1 END, l.locale
            LIMIT 1) AS title,
          (SELECT GROUP_CONCAT(title, ', ')
             FROM (
               SELECT COALESCE(
                 (SELECT title FROM article_category_locales WHERE category_id = m.category_id AND locale = ?),
                 (SELECT title FROM article_category_locales WHERE category_id = m.category_id AND locale = ?)
               ) AS title
                 FROM article_category_map m
                WHERE m.article_id = a.id
                ORDER BY m.sort_order, m.category_id
             )) AS category_title
     FROM articles a
    WHERE ${visibleOwnerClause("a.created_by")}
    ORDER BY a.updated_at DESC, a.id DESC`,
)
  .bind(locale, locale, defaultLocale, actor.id, "articulos", actor.id)
  .all<ArticleRow>()).results ?? [];

const categories = (await env.DB.prepare(
  `SELECT c.id,
          COALESCE(
            (SELECT title FROM article_category_locales WHERE category_id = c.id AND locale = ?),
            (SELECT title FROM article_category_locales WHERE category_id = c.id AND locale = ?)
          ) AS title
     FROM article_categories c
    ORDER BY title`,
)
  .bind(locale, defaultLocale)
  .all<CategoryOption>()).results ?? [];
---

<AdminLayout title={copy.adminArticles} active="articles">
  {canCreate ? (
    <details class="card bg-base-100 border border-base-300 shadow-sm">
      <summary class="card-body cursor-pointer list-none">
        <span class="flex items-center gap-2 font-bold">
          <svg class="size-4"><use href="#ic-plus"></use></svg>
          {copy.adminNewArticle}
        </span>
      </summary>
      <form method="post" action="/api/admin/articles" class="card-body border-t border-base-300 pt-4" data-editorial-form data-success={copy.adminEditorialSaved} data-error={copy.adminEditorialSaveError}>
        <div class="flex justify-end">
          <PageLocaleSwitch languages={languages} label={copy.adminLanguages} current={defaultLocale} />
        </div>
        {languages.map((language) => {
          const locked = language.code !== defaultLocale && !translation.canWrite && !translation.canUseAi;
          return (
            <div class:list={["grid grid-cols-1 gap-3", language.code !== defaultLocale && "hidden"]} data-i18n-panel={language.code}>
              <fieldset class="fieldset">
                <legend class="fieldset-legend">{copy.adminCategoryTitle} · {language.native_name}</legend>
                <input class="input w-full" name={`title[${language.code}]`} maxlength="180" required={language.code === defaultLocale} disabled={locked} />
              </fieldset>
              <fieldset class="fieldset">
                <legend class="fieldset-legend">{copy.adminCategoryDescription} · {language.native_name}</legend>
                <textarea class="textarea w-full" name={`description[${language.code}]`} rows="3" maxlength="500" disabled={locked}></textarea>
              </fieldset>
            </div>
          );
        })}
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <fieldset class="fieldset">
            <legend class="fieldset-legend">{copy.adminCategorySlug}</legend>
            <input class="input w-full" name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="80" />
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">{copy.adminArticleCategory}</legend>
            <div class="flex flex-col gap-2">
              {categories.map((category) => (
                <label class="label cursor-pointer justify-start gap-2">
                  <input class="checkbox checkbox-sm" type="checkbox" name="categoryIds" value={category.id} />
                  <span class="label-text">{category.title}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">{copy.adminArticleTags}</legend>
            <input class="input w-full" name="tags" maxlength="240" placeholder={copy.adminArticleTagsHelp} />
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">{copy.adminArticleStatus}</legend>
            <select class="select w-full" name="status">
              <option value="draft">{copy.adminArticleDraft}</option>
              <option value="published">{copy.adminArticlePublished}</option>
            </select>
          </fieldset>
        </div>
        <div class="flex justify-end">
          <button class="btn btn-primary btn-sm" type="submit">{copy.adminSave}</button>
        </div>
      </form>
    </details>
  ) : null}

  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>{copy.adminCategoryTitle}</th>
              <th>{copy.adminArticleStatus}</th>
              <th>{copy.adminArticleCategory}</th>
            </tr>
          </thead>
          <tbody>
            {items.map((item) => (
              <tr>
                <td class="font-semibold">{item.title ?? item.slug}</td>
                <td>
                  <span class:list={["badge badge-sm", item.status === "published" ? "badge-success" : "badge-ghost"]}>
                    {item.status === "published" ? copy.adminArticlePublished : copy.adminArticleDraft}
                  </span>
                </td>
                <td>{item.category_title ?? copy.adminArticleNoCategory}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  (function () {
    document.querySelectorAll("form[data-editorial-form]").forEach(function (form) {
      if (form.dataset.bound === "true") return;
      form.dataset.bound = "true";
      form.addEventListener("submit", function (event) {
        event.preventDefault();
        var data = new FormData(form);
        fetch(form.action, { method: "POST", body: data })
          .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
          .then(function (result) {
            if (result.ok) {
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast(form.getAttribute("data-success") || "Guardado.", "success");
              setTimeout(function () { window.location.reload(); }, 700);
              return;
            }
            if (window.AfroUpFeedback) window.AfroUpFeedback.toast(form.getAttribute("data-error") || "No pudimos guardar.", "error");
          })
          .catch(function () {
            if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error de red.", "error");
          });
      });
    });
  })();
</script>
