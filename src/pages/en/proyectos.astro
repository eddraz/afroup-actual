---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../../lib/i18n";
import { routeIds } from "../../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const communityHref = localizedPath(locale, routeIds.community);
const collaborateHref = localizedPath(locale, routeIds.collaborate);
const projectHref = localizedPath(locale, routeIds.project);
const items = [
  {
    figure: "bg-secondary/30",
    label: "foto · biblioteca",
    status: copy.projectsStatusActive,
    statusClass: "badge-accent",
    title: "Biblioteca Afro Itinerante",
    dek: "Llevamos libros de autores afro a barrios y veredas, con círculos de lectura.",
    place: "Cali, Colombia",
  },
  {
    figure: "bg-accent/30",
    label: "foto · taller",
    status: copy.projectsStatusActive,
    statusClass: "badge-accent",
    title: "Memoria viva: rutas del cimarronaje",
    dek: "Cartografía comunitaria de la historia cimarrona del Caribe colombiano.",
    place: "Cartagena, Colombia",
  },
  {
    figure: "bg-[url('/assets/pattern.png')] bg-cover bg-center",
    label: "",
    status: copy.projectsStatusDone,
    statusClass: "badge-secondary",
    title: "Escuela de verano afrocéntrica",
    dek: "Talleres de historia y autoestima para 120 niñas y niños.",
    place: "Quibdó, Colombia · 2025",
  },
] as const;
---

<BaseLayout title={copy.titleProjects} active="comunidad">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li><a href={communityHref}>{copy.navCommunity}</a></li>
      <li>{copy.footerProjects}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] bg-primary text-primary-content shadow-lg">
    <div class="absolute inset-y-0 right-0 w-[200px] bg-[url('/assets/pattern.png')] bg-cover bg-center max-md:w-[90px]"></div>
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-accent text-xs font-extrabold tracking-[0.18em] uppercase">{copy.projectsEyebrow}</p>
      <h1 class="font-display max-w-[18ch] text-[31px] font-bold lg:text-[44px]">{copy.projectsTitle}</h1>
      <p class="max-w-[56ch] text-[17px] leading-[1.55] text-primary-content/80">{copy.projectsLead}</p>
    </div>
  </section>

  <div class="mt-[30px] grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <a class="card bg-base-200 shadow" href={projectHref}>
          <figure class:list={["relative aspect-[16/10]", item.figure]}>
            {item.label ? <span class="badge badge-sm absolute bottom-3 left-3">{item.label}</span> : null}
          </figure>
          <div class="card-body">
            <span class:list={["badge badge-soft w-fit", item.statusClass]}>{item.status}</span>
            <h3 class="card-title font-display">{item.title}</h3>
            <p class="opacity-70">{item.dek}</p>
            <p class="flex items-center gap-1.5 text-sm opacity-60">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <use href="#ic-pin"></use>
              </svg>
              {item.place}
            </p>
          </div>
        </a>
      ))
    }
  </div>

  <div class="card bg-accent text-accent-content mt-9">
    <div class="card-body sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h3 class="card-title">{copy.projectsBandTitle}</h3>
        <p>{copy.projectsBandDek}</p>
      </div>
      <div class="card-actions">
        <a class="btn btn-primary" href={collaborateHref}>
          {copy.projectsCta}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <use href="#ic-arrow"></use>
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
