---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../../lib/i18n";
import { routeIds } from "../../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const donateHref = localizedPath(locale, routeIds.donate);
const storeHref = routeIds.store;
const collaborateHref = routeIds.collaborate;
const socials = [
  { href: "#", label: "Instagram", icon: "ic-ig" },
  { href: "#", label: "TikTok", icon: "ic-tiktok" },
  { href: "#", label: "YouTube", icon: "ic-youtube" },
  { href: "#", label: "Facebook", icon: "ic-facebook" },
] as const;
const ways = [
  {
    icon: "ic-heart",
    wrap: "bg-secondary/30 text-secondary-content",
    title: copy.supportDonateTitle,
    dek: copy.supportDonateDek,
    href: donateHref,
    cta: copy.supportDonateCta,
    action: "btn btn-secondary",
    trailing: "ic-arrow",
  },
  {
    icon: "ic-bag",
    wrap: "bg-accent/20 text-accent",
    title: copy.supportStoreTitle,
    dek: copy.supportStoreDek,
    href: storeHref,
    cta: copy.supportStoreCta,
    action: "btn btn-accent",
    trailing: "ic-arrow",
  },
  {
    icon: "ic-users",
    wrap: "bg-primary/15 text-primary",
    title: copy.supportCollabTitle,
    dek: copy.supportCollabDek,
    href: collaborateHref,
    cta: copy.supportCollabCta,
    action: "btn btn-primary",
    trailing: "ic-arrow",
  },
  {
    icon: "ic-share",
    wrap: "bg-accent/20 text-accent",
    title: copy.supportShareTitle,
    dek: copy.supportShareDek,
    href: "#",
    cta: copy.supportShareCta,
    action: "btn btn-ghost",
    trailing: "ic-ig",
  },
] as const;
---

<BaseLayout title={copy.titleSupport} active="donar">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li>{copy.footerSupport}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] bg-secondary text-secondary-content shadow-lg">
    <div class="absolute inset-y-0 right-0 w-[200px] bg-[url('/assets/pattern.png')] bg-cover bg-center max-md:w-[90px]"></div>
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-xs font-extrabold tracking-[0.18em] uppercase opacity-70">{copy.donateEyebrow}</p>
      <h1 class="font-display max-w-[18ch] text-[31px] font-bold lg:text-[44px]">{copy.supportTitle}</h1>
      <p class="max-w-[56ch] text-[17px] leading-[1.55] opacity-80">{copy.supportLead}</p>
    </div>
  </section>

  <div class="mt-[30px] grid grid-cols-1 gap-[22px] sm:grid-cols-2">
    {
      ways.map((way) => (
        <article class="card h-full bg-base-200 shadow">
          <div class="card-body items-start gap-3 p-7">
            <span class:list={["btn btn-square pointer-events-none no-animation border-0 shadow-none", way.wrap]}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <use href={`#${way.icon}`}></use>
              </svg>
            </span>
            <h3 class="card-title font-display text-[22px]">{way.title}</h3>
            <p class="grow text-[15px] leading-[1.55] opacity-60">{way.dek}</p>
            <div class="card-actions">
              {
                way.icon === "ic-share" ? (
                  socials.map((social) => (
                    <a class="btn btn-ghost btn-sm" href={social.href} aria-label={social.label}>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <use href={`#${social.icon}`}></use>
                      </svg>
                      {social.label}
                    </a>
                  ))
                ) : (
                  <a class={way.action} href={way.href}>
                    {way.cta}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <use href={`#${way.trailing}`}></use>
                    </svg>
                  </a>
                )
              }
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="card bg-neutral text-neutral-content mt-9">
    <div class="card-body sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h3 class="card-title">{copy.supportBandTitle}</h3>
        <p class="opacity-70">{copy.supportBandDek}</p>
      </div>
      <div class="card-actions">
        <a class="btn btn-secondary" href={donateHref}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><use href="#ic-heart"></use></svg>
          {copy.donateCta}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
