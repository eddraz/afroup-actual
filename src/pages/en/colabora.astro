---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../../lib/i18n";
import { routeIds } from "../../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const communityHref = localizedPath(locale, routeIds.community);
const roles = [
  { icon: "ic-book2", wrap: "bg-accent/20 text-accent", title: copy.collabWriteTitle, dek: copy.collabWriteDek },
  { icon: "ic-share", wrap: "bg-secondary/30 text-secondary-content", title: copy.collabTranslateTitle, dek: copy.collabTranslateDek },
  { icon: "ic-search", wrap: "bg-primary/15 text-primary", title: copy.collabResearchTitle, dek: copy.collabResearchDek },
  { icon: "ic-play", wrap: "bg-accent/20 text-accent", title: copy.collabCreateTitle, dek: copy.collabCreateDek },
] as const;
---

<BaseLayout title={copy.titleCollaborate} active="comunidad">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li><a href={communityHref}>{copy.navCommunity}</a></li>
      <li>{copy.footerCollaborate}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] bg-accent text-accent-content shadow-lg">
    <div class="absolute inset-y-0 right-0 w-[200px] bg-[url('/assets/pattern.png')] bg-cover bg-center max-md:w-[90px]"></div>
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-xs font-extrabold tracking-[0.18em] uppercase opacity-70">{copy.collabEyebrow}</p>
      <h1 class="font-display max-w-[18ch] text-[31px] font-bold lg:text-[44px]">{copy.collabTitle}</h1>
      <p class="max-w-[56ch] text-[17px] leading-[1.55] opacity-80">{copy.collabLead}</p>
    </div>
  </section>

  <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      roles.map((role) => (
        <article class="card bg-base-200 shadow">
          <div class="card-body items-center text-center">
            <span class:list={["btn btn-circle pointer-events-none no-animation border-0 shadow-none", role.wrap]}>
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <use href={`#${role.icon}`}></use>
              </svg>
            </span>
            <h3 class="card-title font-display text-[17px]">{role.title}</h3>
            <p class="text-[13px] leading-[1.5] opacity-60">{role.dek}</p>
          </div>
        </article>
      ))
    }
  </div>

  <form class="card bg-base-200 mx-auto mt-[34px] max-w-[680px] shadow" onsubmit="return false">
    <div class="card-body">
      <h2 class="card-title font-display text-[21px]">{copy.collabFormTitle}</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.collabName}</legend>
          <input class="input w-full" type="text" name="name" placeholder={copy.collabNamePlaceholder} />
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.collabEmail}</legend>
          <input class="input w-full" type="email" name="email" placeholder={copy.collabEmailPlaceholder} />
        </fieldset>
      </div>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">{copy.collabRole}</legend>
        <select class="select w-full" name="role">
          <option>{copy.collabRoleWriter}</option>
          <option>{copy.collabRoleTranslator}</option>
          <option>{copy.collabRoleResearcher}</option>
          <option>{copy.collabRoleDesigner}</option>
          <option>{copy.collabRoleMedia}</option>
          <option>{copy.collabRoleOther}</option>
        </select>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">{copy.collabMessage}</legend>
        <textarea class="textarea w-full" name="message" rows="5" placeholder={copy.collabMessagePlaceholder}></textarea>
      </fieldset>
      <div class="card-actions">
        <button class="btn btn-primary" type="submit">
          {copy.collabSubmit}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <use href="#ic-arrow"></use>
          </svg>
        </button>
      </div>
      <p class="text-[12.5px] opacity-60">{copy.collabNote}</p>
    </div>
  </form>
</BaseLayout>
