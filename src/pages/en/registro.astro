---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../../lib/i18n";
import { routeIds } from "../../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const loginHref = localizedPath(locale, routeIds.login);
---

<BaseLayout title={copy.titleSignup} active="signup">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li><a href={loginHref}>{copy.navLogin}</a></li>
      <li>{copy.navSignup}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] border border-base-300 bg-base-200 shadow-lg">
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-primary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.signupEyebrow}</p>
      <h1 class="font-display max-w-[20ch] text-[31px] leading-[1.06] font-bold lg:text-[46px]">{copy.signupTitle}</h1>
      <p class="max-w-[58ch] text-[17px] leading-[1.55] opacity-70">{copy.signupLead}</p>
    </div>
  </section>

  <div class="mt-9 grid grid-cols-1 gap-7 lg:grid-cols-[1.15fr_0.85fr]">
    <form class="card bg-base-200 shadow" data-register-form>
      <div class="card-body gap-4">
        <h2 class="card-title font-display text-[22px] tracking-[-0.005em]">{copy.signupTitle}</h2>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.signupName}</legend>
          <input class="input w-full" type="text" name="name" autocomplete="name" placeholder={copy.signupNamePlaceholder} required />
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.loginEmail}</legend>
          <input class="input w-full" type="email" name="email" autocomplete="email" placeholder={copy.loginEmailPlaceholder} required />
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.loginPassword}</legend>
          <input class="input w-full" type="password" name="password" autocomplete="new-password" placeholder={copy.loginPasswordPlaceholder} minlength="8" required />
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.signupConfirm}</legend>
          <input class="input w-full" type="password" name="confirm" autocomplete="new-password" placeholder={copy.signupConfirmPlaceholder} minlength="8" required />
        </fieldset>

        <label class="label mt-1 cursor-pointer items-start gap-2 p-0">
          <input type="checkbox" name="terms" class="checkbox checkbox-sm mt-0.5" required />
          <span class="label-text text-sm leading-snug">{copy.signupTerms}</span>
        </label>

        <button class="btn btn-primary mt-2 h-[46px] min-h-[46px]" type="submit">
          {copy.signupSubmit}
          <svg class="size-4"><use href="#ic-arrow"></use></svg>
        </button>

        <div class="mt-1 flex flex-col items-center gap-1 text-center">
          <p class="text-sm opacity-70">{copy.signupHave}</p>
          <a class="btn btn-dash btn-sm" href={loginHref}>{copy.signupSignin}</a>
        </div>

      </div>
    </form>

    <div class="card bg-success/10 border border-success/40 mt-6 hidden" data-register-success>
      <div class="card-body gap-2">
        <p class="text-xs font-extrabold tracking-[0.18em] text-success uppercase">{copy.signupSuccessEyebrow}</p>
        <h2 class="font-display text-[22px] tracking-[-0.005em]">{copy.signupSuccessTitle}</h2>
        <p class="text-sm opacity-80" data-register-success-text></p>
        <a class="btn btn-ghost btn-sm mt-2 self-start" href={loginHref}>{copy.signupSuccessCta}</a>
      </div>
    </div>

    <div class="alert alert-error mt-6 hidden" data-register-error>
      <span data-register-error-text></span>
    </div>

    <script is:inline>
      (function () {
        var bind = function () {
          var form = document.querySelector("[data-register-form]");
          if (!form || form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          var success = document.querySelector("[data-register-success]");
          var successText = document.querySelector("[data-register-success-text]");
          var errorBox = document.querySelector("[data-register-error]");
          var errorText = document.querySelector("[data-register-error-text]");
          var submit = form.querySelector("button[type=submit]");
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            if (!success || !errorBox) return;
            success.classList.add("hidden");
            errorBox.classList.add("hidden");
            submit.disabled = true;
            var data = {
              name: form.querySelector("[name=name]").value.trim(),
              email: form.querySelector("[name=email]").value.trim(),
              password: form.querySelector("[name=password]").value,
              confirm: form.querySelector("[name=confirm]").value,
              locale: document.documentElement.lang || "es",
            };
            if (data.password !== data.confirm) {
              errorText.textContent = (document.documentElement.lang === "en")
                ? "Passwords don't match."
                : "Las contraseñas no coinciden.";
              errorBox.classList.remove("hidden");
              submit.disabled = false;
              return;
            }
            fetch("/api/register", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({
                name: data.name,
                email: data.email,
                password: data.password,
                locale: data.locale,
              }),
            })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (!result.ok) {
                  var key = result.body && result.body.error;
                  var lang = document.documentElement.lang === "en" ? "en" : "es";
                  var msg = lang === "en"
                    ? {
                        name_required: "Please enter your name.",
                        email_invalid: "Please enter a valid email.",
                        password_short: "Password must be at least 8 characters.",
                        email_taken: "An account already exists with that email.",
                        email_failed: "We couldn't send the email. Try again in a moment.",
                        insert_failed: "Could not save the account. Try again.",
                      }[key] || "Something went wrong. Try again."
                    : {
                        name_required: "Ingresa tu nombre.",
                        email_invalid: "Ingresa un correo válido.",
                        password_short: "La contraseña debe tener al menos 8 caracteres.",
                        email_taken: "Ya existe una cuenta con ese correo.",
                        email_failed: "No pudimos enviar el correo. Inténtalo de nuevo en un momento.",
                        insert_failed: "No pudimos guardar la cuenta. Inténtalo de nuevo.",
                      }[key] || "Algo salió mal. Inténtalo de nuevo.";
                  errorText.textContent = msg;
                  errorBox.classList.remove("hidden");
                  submit.disabled = false;
                  return;
                }
                successText.textContent = result.body.emailSentTo;
                success.classList.remove("hidden");
                form.classList.add("hidden");
              })
              .catch(function () {
                var lang = document.documentElement.lang === "en" ? "en" : "es";
                errorText.textContent = lang === "en"
                  ? "Network error. Try again."
                  : "Error de red. Inténtalo de nuevo.";
                errorBox.classList.remove("hidden");
                submit.disabled = false;
              });
          });
        };
        bind();
        document.addEventListener("astro:after-swap", bind);
      })();
    </script>

    <aside class="flex flex-col gap-5">
      <div class="card bg-base-200 shadow">
        <div class="card-body gap-5">
          <h3 class="font-display text-[20px] tracking-[-0.005em]">{copy.loginAsideTitle}</h3>

          <div class="flex items-start gap-3">
            <div class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-full">
              <svg class="size-5"><use href="#ic-bookmark"></use></svg>
            </div>
            <div>
              <p class="font-bold">{copy.loginBenefit1Title}</p>
              <p class="text-sm opacity-70">{copy.loginBenefit1Lead}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="bg-accent/15 text-accent flex size-11 shrink-0 items-center justify-center rounded-full">
              <svg class="size-5"><use href="#ic-bag"></use></svg>
            </div>
            <div>
              <p class="font-bold">{copy.loginBenefit2Title}</p>
              <p class="text-sm opacity-70">{copy.loginBenefit2Lead}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="bg-secondary/15 text-secondary flex size-11 shrink-0 items-center justify-center rounded-full">
              <svg class="size-5"><use href="#ic-book2"></use></svg>
            </div>
            <div>
              <p class="font-bold">{copy.loginBenefit3Title}</p>
              <p class="text-sm opacity-70">{copy.loginBenefit3Lead}</p>
            </div>
          </div>

          <div class="mt-1 h-[88px] rounded-[14px] bg-[url('/assets/pattern.png')] bg-cover bg-center"></div>
        </div>
      </div>

      <p class="text-[12.5px] opacity-60">{copy.loginAsideNote}</p>
    </aside>
  </div>
</BaseLayout>