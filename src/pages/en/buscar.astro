---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../../lib/i18n";
import { paths as staticPaths, routeIds } from "../../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const paths = {
  ...staticPaths,
  search: localizedPath(locale, routeIds.search),
  article: localizedPath(locale, routeIds.article),
    resource: localizedPath(locale, routeIds.resource),
    project: localizedPath(locale, routeIds.project),
};
const query = Astro.url.searchParams.get("q")?.trim() || "palenques";
const results = [
  {
    href: paths.article,
    kind: "Artículo · Historia",
    badge: "badge-secondary",
    figure: "bg-warning/30",
    label: "grabado",
    title: "Quilombos y palenques: territorios de libertad",
    dek: "Cómo las comunidades cimarronas construyeron autonomía, lengua y memoria en toda Abya Yala…",
    meta: "Jenniffer M. · 12 mar 2026 · 8 min",
    end: "arrow",
  },
  {
    href: paths.article,
    kind: "Artículo · Diáspora",
    badge: "badge-accent",
    figure: "bg-accent/30",
    label: "retrato",
    title: "San Basilio de Palenque: la lengua que sobrevivió",
    dek: "El criollo palenquero, patrimonio vivo de la resistencia afrocolombiana.",
    meta: "Equipo AfroUp · 28 feb 2026 · 6 min",
    end: "arrow",
  },
  {
    href: paths.product,
    kind: "Tienda · eBook",
    badge: "badge-secondary",
    figure: "bg-[url('/assets/pattern.png')] bg-cover bg-center",
    label: "",
    title: "Raíces: historia afro de Abya Yala",
    dek: "Capítulo 4 dedicado a los palenques del Gran Caribe. PDF + EPUB.",
    meta: "⭐ 4.9 (38)",
    end: "price",
    price: "US$ 12",
  },
  {
    href: paths.resource,
    kind: "Recurso · Guía PDF",
    badge: "badge-primary",
    figure: "bg-primary/20",
    label: "PDF",
    title: "Guía docente: cimarronaje en el aula",
    dek: "Actividades y fuentes primarias para secundaria. Descarga gratuita.",
    meta: "PDF · 24 págs · Gratis",
    end: "download",
  },
  {
    href: paths.project,
    kind: "Proyecto · Comunidad",
    badge: "badge-accent",
    figure: "bg-warning/30",
    label: "foto · taller",
    title: "Memoria viva: rutas del cimarronaje",
    dek: "Proyecto comunitario de cartografía histórica en el Caribe colombiano.",
    meta: "En curso · Cartagena, Colombia",
    end: "arrow",
  },
] as const;
---

<BaseLayout title={copy.titleSearch} active="buscar">
  <form class="mt-[30px]" action={paths.search} method="get">
    <label class="input h-16 w-full rounded-full border-2 border-neutral bg-base-200 px-6 text-lg font-semibold shadow">
      <svg class="size-[22px] shrink-0 opacity-50" viewBox="0 0 24 24" aria-hidden="true">
        <use href="#ic-search"></use>
      </svg>
      <input class="grow" type="search" name="q" value={query} aria-label={copy.searchAria} />
      <button class="btn btn-neutral btn-sm" type="submit">{copy.searchSubmit}</button>
    </label>
  </form>

  <div class="mt-4 mb-4 flex flex-wrap gap-2" data-chips>
    <button class="btn btn-sm" data-chip type="button">{copy.searchChipAll}</button>
    <button class="btn btn-dash btn-sm" data-chip type="button">{copy.searchChipArticles}</button>
    <button class="btn btn-dash btn-sm" data-chip type="button">{copy.searchChipStore}</button>
    <button class="btn btn-dash btn-sm" data-chip type="button">{copy.searchChipResources}</button>
    <button class="btn btn-dash btn-sm" data-chip type="button">{copy.searchChipProjects}</button>
  </div>

  <p class="mb-4 font-bold text-base-content/60">
    <span class="text-base-content">14 {copy.searchResultsFor}</span> {copy.searchResultsPreposition} “{query}”
  </p>

  <ul class="list">
    {
      results.map((item) => (
        <li class="list-row">
          <div class:list={["relative size-20 overflow-hidden rounded-box", item.figure]}>
            {item.label ? (
                  <div class="tooltip tooltip-top absolute bottom-1.5 left-1.5 max-w-[calc(100%-0.75rem)]" data-tip={item.label}>
                    <span class="badge badge-sm max-w-full truncate">{item.label}</span>
                  </div>
                ) : null}
          </div>
          <a class="list-col-grow" href={item.href}>
            <span class:list={["badge badge-soft badge-sm", item.badge]}>{item.kind}</span>
            <h3 class="font-display text-xl font-bold">{item.title}</h3>
            <p class="text-base-content/70">{item.dek}</p>
            <p class="text-sm text-base-content/50">{item.meta}</p>
          </a>
          {
            item.end === "price" ? (
              <span class="font-display text-xl font-extrabold">{item.price}</span>
            ) : item.end === "download" ? (
              <a class="btn btn-accent btn-sm" href={item.href}>{copy.searchDownload}</a>
            ) : (
              <a class="btn btn-ghost btn-square btn-sm" href={item.href} aria-label={item.title}>
                <svg class="size-5" aria-hidden="true">
                  <use href="#ic-arrow"></use>
                </svg>
              </a>
            )
          }
        </li>
      ))
    }
  </ul>

  <div class="mt-8 text-center">
    <button class="btn btn-ghost" type="button">{copy.searchLoadMore}</button>
  </div>
</BaseLayout>

<script>
  const chips = document.querySelectorAll("[data-chip]");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((item) => item.classList.add("btn-dash"));
      chip.classList.remove("btn-dash");
    });
  });
</script>
