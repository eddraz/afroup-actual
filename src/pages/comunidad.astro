---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const links = [
  {
    href: localizedPath(locale, routeIds.people),
    icon: "ic-users",
    wrap: "bg-secondary/30 text-secondary-content",
    title: copy.footerPeople,
    dek: copy.communityPeopleDek,
  },
  {
    href: localizedPath(locale, routeIds.projects),
    icon: "ic-pin",
    wrap: "bg-primary/15 text-primary",
    title: copy.footerProjects,
    dek: copy.communityProjectsDek,
  },
  {
    href: localizedPath(locale, routeIds.collaborate),
    icon: "ic-heart",
    wrap: "bg-accent/20 text-accent",
    title: copy.footerCollaborate,
    dek: copy.communityCollabDek,
  },
] as const;
---

<BaseLayout title={copy.titleCommunity} active="comunidad">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li>{copy.navCommunity}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] bg-neutral text-neutral-content shadow-lg">
    <div class="absolute inset-y-0 right-0 w-[200px] bg-[url('/assets/pattern.png')] bg-cover bg-center max-md:w-[90px]"></div>
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-secondary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.communityEyebrow}</p>
      <h1 class="font-display max-w-[18ch] text-[31px] font-bold lg:text-[44px]">{copy.communityTitle}</h1>
      <p class="max-w-[56ch] text-[17px] leading-[1.55] text-neutral-content/70">{copy.communityLead}</p>
    </div>
  </section>

  <div class="mt-[30px] grid grid-cols-1 gap-[22px] sm:grid-cols-2 lg:grid-cols-3">
    {
      links.map((item) => (
        <a class="card h-full bg-base-200 shadow" href={item.href}>
          <div class="card-body items-start gap-3 p-7">
            <span class:list={["btn btn-square pointer-events-none no-animation border-0 shadow-none", item.wrap]}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <use href={`#${item.icon}`}></use>
              </svg>
            </span>
            <h2 class="card-title font-display text-[22px]">{item.title}</h2>
            <p class="grow text-[15px] leading-[1.55] opacity-60">{item.dek}</p>
            <div class="card-actions">
              <span class="btn btn-ghost btn-sm pointer-events-none">
                {copy.communityOpen}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <use href="#ic-arrow"></use>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
