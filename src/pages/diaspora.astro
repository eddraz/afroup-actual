---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const articleHref = localizedPath(locale, routeIds.article);
const cards = [
  {
    featured: true,
    figure: "bg-accent/30",
    label: "foto · mapa diáspora",
    tag: "Diáspora · Destacado",
    title: "Rutas de la diáspora africana",
    dek: "Del Atlántico al Pacífico: cómo las comunidades negras reconstruyeron lengua, fe y territorio en Abya Yala.",
    meta: "Jenniffer M. · 8 min de lectura",
  },
  {
    featured: false,
    figure: "bg-warning/30",
    label: "retrato",
    tag: "Memoria",
    title: "Trenzas como mapas de resistencia",
    dek: "La historia oculta tejida en los peinados ancestrales.",
    meta: "Equipo AfroUp · 7 min",
  },
  {
    featured: false,
    figure: "bg-primary/20",
    label: "archivo",
    tag: "Lenguas",
    title: "San Basilio de Palenque: la lengua que sobrevivió",
    dek: "El criollo palenquero, patrimonio vivo de la resistencia afrocolombiana.",
    meta: "Equipo AfroUp · 6 min",
  },
  {
    featured: false,
    figure: "bg-accent/30",
    label: "foto · tambores",
    tag: "Cultura",
    title: "Las raíces del bullerengue en el Pacífico",
    dek: "El tambor como archivo vivo de la resistencia femenina afrocolombiana.",
    meta: "Equipo AfroUp · 6 min",
  },
  {
    featured: false,
    figure: "bg-primary/20",
    label: "foto · comunidad",
    tag: "Presente",
    title: "Voces de la diáspora",
    dek: "Cinco generaciones cuentan qué significa ser afrolatino hoy.",
    meta: "AfroUp TV · 6 min",
  },
] as const;
---

<BaseLayout title={copy.titleDiaspora} active="diaspora">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li>{copy.navDiaspora}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] bg-primary text-primary-content shadow-lg">
    <div class="absolute inset-y-0 right-0 w-[200px] bg-[url('/assets/pattern.png')] bg-cover bg-center max-md:w-[90px]"></div>
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-accent text-xs font-extrabold tracking-[0.18em] uppercase">{copy.categoryEyebrow}</p>
      <h1 class="font-display text-[31px] font-bold lg:text-[44px]">{copy.navDiaspora}</h1>
      <p class="max-w-[56ch] text-[17px] leading-[1.55] text-primary-content/80">{copy.diasporaLead}</p>
    </div>
  </section>

  <div class="mt-6 mb-6 flex flex-wrap gap-2" data-chips>
    <button class="btn btn-sm" data-chip type="button">{copy.diasporaChipAll}</button>
    <button class="btn btn-dash btn-sm" data-chip type="button">{copy.diasporaChipMemory}</button>
    <button class="btn btn-dash btn-sm" data-chip type="button">{copy.diasporaChipRoutes}</button>
    <button class="btn btn-dash btn-sm" data-chip type="button">{copy.diasporaChipLanguages}</button>
    <button class="btn btn-dash btn-sm" data-chip type="button">{copy.diasporaChipCulture}</button>
    <button class="btn btn-dash btn-sm" data-chip type="button">{copy.diasporaChipPresent}</button>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    {
      cards.map((card) => (
        <a class:list={["card bg-base-200 shadow", card.featured && "sm:col-span-2 sm:card-side"]} href={articleHref}>
          <figure class:list={["relative", card.featured ? "min-h-64 sm:w-1/2" : "aspect-[16/10]", card.figure]}>
            <span class="badge badge-sm absolute bottom-3 left-3">{card.label}</span>
          </figure>
          <div class="card-body">
            <span class="inline-flex items-center gap-2 text-[11.5px] font-extrabold tracking-[0.1em] text-accent uppercase">
              <span class="size-2.5 rounded-[3px] bg-accent"></span>
              {card.tag}
            </span>
            <h3 class="card-title font-display">{card.title}</h3>
            <p>{card.dek}</p>
            <p class="text-sm opacity-70">{card.meta}</p>
          </div>
        </a>
      ))
    }
  </div>

  <div class="mt-8 text-center">
    <button class="btn btn-ghost" type="button">{copy.diasporaLoadMore}</button>
  </div>
</BaseLayout>

<script>
  const chips = document.querySelectorAll("[data-chip]");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((item) => item.classList.add("btn-dash"));
      chip.classList.remove("btn-dash");
    });
  });
</script>
