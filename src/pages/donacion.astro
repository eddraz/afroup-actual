---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const aboutHref = localizedPath(locale, routeIds.about);
const amounts = ["US$ 5", "US$ 10", "US$ 25", "US$ 50"] as const;
const methods = [copy.donatePayCard, copy.donatePayPaypal, copy.donatePayNequi, copy.donatePayPse] as const;
const impacts = [
  {
    icon: "ic-book2",
    wrap: "bg-accent/20 text-accent",
    title: copy.donateImpactContentTitle,
    dek: copy.donateImpactContentDek,
  },
  {
    icon: "ic-users",
    wrap: "bg-secondary/30 text-secondary-content",
    title: copy.donateImpactAuthorsTitle,
    dek: copy.donateImpactAuthorsDek,
  },
  {
    icon: "ic-pin",
    wrap: "bg-primary/15 text-primary",
    title: copy.donateImpactProjectsTitle,
    dek: copy.donateImpactProjectsDek,
  },
] as const;
---

<BaseLayout title={copy.titleDonate} active="donar">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li>{copy.donateCta}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] bg-neutral text-neutral-content shadow-lg">
    <div class="absolute inset-y-0 right-0 w-[200px] bg-[url('/assets/pattern.png')] bg-cover bg-center max-md:w-[90px]"></div>
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-secondary text-xs font-extrabold tracking-[0.18em] uppercase">{copy.donateEyebrow}</p>
      <h1 class="font-display max-w-[18ch] text-[31px] font-bold lg:text-[44px]">{copy.donateTitle}</h1>
      <p class="max-w-[56ch] text-[17px] leading-[1.55] text-neutral-content/70">{copy.donateLead}</p>
    </div>
  </section>

  <div class="mt-8 grid grid-cols-1 items-start gap-8 xl:grid-cols-[1fr_420px]">
    <section>
      <h2 class="font-display mb-2.5 text-[26px] font-bold">{copy.donateImpactTitle}</h2>
      <ul class="list">
        {
          impacts.map((item) => (
            <li class="list-row">
              <span class:list={["btn btn-square pointer-events-none no-animation border-0 shadow-none", item.wrap]}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><use href={`#${item.icon}`}></use></svg>
              </span>
              <div>
                <h3 class="font-display text-lg font-bold">{item.title}</h3>
                <p class="text-[14.5px] leading-[1.55] opacity-60">{item.dek}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="card bg-neutral text-neutral-content mt-6">
        <div class="card-body sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="card-title">{copy.donateTransparencyTitle}</h3>
            <p class="opacity-70">{copy.donateTransparencyDek}</p>
          </div>
          <div class="card-actions">
            <a class="btn btn-accent" href={aboutHref}>{copy.donateMeetUs}</a>
          </div>
        </div>
      </div>
    </section>

    <aside class="card bg-base-200 xl:sticky xl:top-[90px] shadow">
      <div class="card-body">
        <h2 class="card-title font-display text-[22px]">{copy.donateCta}</h2>
        <div class="join w-full overflow-hidden rounded-field border border-base-300">
          <button class="btn btn-sm join-item flex-1 font-bold btn-active bg-neutral/80 text-neutral-content" type="button" data-freq>{copy.donateOnce}</button>
          <button class="btn btn-sm join-item flex-1 font-bold" type="button" data-freq>{copy.donateMonthly}</button>
        </div>
        <div class="mt-2 grid grid-cols-2 gap-2" data-amounts>
          {
            amounts.map((amount, index) => (
              <button class:list={["btn", index === 1 ? "btn-neutral" : "btn-dash"]} type="button" data-amount={amount}>
                {amount}
              </button>
            ))
          }
        </div>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.donateOther}</legend>
          <input class="input w-full" type="text" placeholder={copy.donateOtherPlaceholder} />
        </fieldset>
        <button class="btn btn-secondary btn-block" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><use href="#ic-heart"></use></svg>
          {copy.donateSubmit}
        </button>
        <div class="flex flex-wrap gap-2">
          {methods.map((method) => <span class="badge badge-outline">{method}</span>)}
        </div>
        <p class="text-[12.5px] opacity-60">🔒 {copy.donateSecure}</p>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  const freqs = document.querySelectorAll("[data-freq]");
  freqs.forEach((button) => {
    button.addEventListener("click", () => {
      freqs.forEach((item) => {
        item.classList.remove("btn-active", "bg-neutral/80", "text-neutral-content");
      });
      button.classList.add("btn-active", "bg-neutral/80", "text-neutral-content");
    });
  });

  const amounts = document.querySelectorAll("[data-amount]");
  amounts.forEach((button) => {
    button.addEventListener("click", () => {
      amounts.forEach((item) => {
        item.classList.add("btn-dash");
        item.classList.remove("btn-neutral");
      });
      button.classList.remove("btn-dash");
      button.classList.add("btn-neutral");
    });
  });
</script>
