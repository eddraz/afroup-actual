---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import AboutEditor from "../../components/AboutEditor.astro";
import { requireModuleAccess } from "../../lib/admin-scope";
import { resolveRequestCopy } from "../../lib/request-locale";
import { translationAccess } from "../../lib/editorial";
import { listSiteLanguages } from "../../lib/site-languages";
import { loadAllAboutPageLocales } from "../../lib/about";
import { localizedPath } from "../../lib/i18n";
import { routeIds } from "../../lib/paths";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "nosotros");
if (access instanceof Response) return access;
const actor = access;

const translation = await translationAccess(env.DB, actor.id, "nosotros", "update");
const languages = await listSiteLanguages(env.DB);
const aboutByLocale = await loadAllAboutPageLocales(env.DB);
const publicHref = localizedPath(locale, routeIds.about);
---

<AdminLayout title={copy.adminAbout || "Nosotros"} active="about">
  <AboutEditor
    aboutByLocale={aboutByLocale}
    languages={languages}
    translation={translation}
    locale={locale}
    copy={copy}
    publicHref={publicHref}
  />
</AdminLayout>
