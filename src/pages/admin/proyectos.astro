---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireModuleAccess, sessionTokenFrom } from "../../lib/admin-scope";
import { resolveRequestCopy } from "../../lib/request-locale";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "proyectos");
if (access instanceof Response) return access;
const actor = access;


const projects = [
  { name: "Archivo oral afrocolombiano", org: "Casa de la Memoria", stage: "En revisión", budget: "USD 8.500", date: "10 jun" },
  { name: "Atlas afrolatinoamericano", org: "Red AfroLatam", stage: "Aprobado", budget: "USD 12.000", date: "02 jun" },
  { name: "Podcast: Saberes del Pacífico", org: "Colectivo Tambó", stage: "Borrador", budget: "USD 3.200", date: "28 may" },
];
---

<AdminLayout title={copy.adminProjects} active="projects">
  <header class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-end">
    <div>
      <h1 class="font-display text-[28px] leading-[1.06] font-bold tracking-[-0.005em] lg:text-[34px]">{copy.adminProjects}</h1>
    </div>
  </header>

  <div class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>Proyecto</th>
              <th>Organización</th>
              <th>Etapa</th>
              <th>Presupuesto</th>
              <th>Fecha</th>
            </tr>
          </thead>
          <tbody>
            {projects.map((project) => (
              <tr>
                <td class="font-semibold">{project.name}</td>
                <td>{project.org}</td>
                <td>
                  <span class:list={["badge badge-sm", project.stage === "Aprobado" && "badge-success", project.stage === "En revisión" && "badge-warning", project.stage === "Borrador" && "badge-ghost"]}>{project.stage}</span>
                </td>
                <td>{project.budget}</td>
                <td class="text-sm opacity-70">{project.date}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>