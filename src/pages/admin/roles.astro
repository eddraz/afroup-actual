---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireModuleAccess, sessionTokenFrom } from "../../lib/admin-scope";
import PermissionMatrix from "../../components/PermissionMatrix.astro";
import { localizedPath, t } from "../../lib/i18n";
import { resolveRequestCopy } from "../../lib/request-locale";
import { routeIds } from "../../lib/paths";
import { env } from "cloudflare:workers";
import { loadAllRoleGrants } from "../../lib/permission-grants";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "roles");
if (access instanceof Response) return access;
const actor = access;

const adminHref = localizedPath(locale, routeIds.admin);

interface RoleRow {
  id: number;
  name: string;
  description: string | null;
}

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
}

interface PermissionRow {
  id: number;
  module_id: number;
  action: "create" | "read" | "update" | "delete";
}

interface RolePermRow {
  role_id: number;
  permission_id: number;
}

const roles = (await env.DB.prepare("SELECT id, name, description FROM admin_roles ORDER BY name").all<RoleRow>()).results ?? [];
const modules = (await env.DB.prepare("SELECT id, name, slug FROM admin_modules ORDER BY name").all<ModuleRow>()).results ?? [];
const permissions = (await env.DB.prepare("SELECT id, module_id, action FROM admin_permissions ORDER BY module_id, action").all<PermissionRow>()).results ?? [];
const grantedByRole = await loadAllRoleGrants(env.DB);

const actions: PermissionRow["action"][] = ["create", "read", "update", "delete"];

const actionLabels: Record<PermissionRow["action"], string> = {
  create: copy.adminActionCreate,
  read: copy.adminActionRead,
  update: copy.adminActionUpdate,
  delete: copy.adminActionDelete,
};


---

<AdminLayout title={copy.adminRoles} active="roles">
  

  <details class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <summary class="card-body cursor-pointer list-none">
      <span class="flex items-center gap-2 font-bold">
        <svg class="size-4"><use href="#ic-plus"></use></svg>
        {copy.adminNewRole}
      </span>
    </summary>
    <form method="post" action="/api/admin/roles" class="card-body border-t border-base-300 pt-4" data-admin-form data-intent="create_role">
      <input type="hidden" name="_intent" value="create_role" />
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.adminRoleName}</legend>
          <input class="input w-full" name="name" required maxlength="80" />
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{copy.adminRoleDescription}</legend>
          <input class="input w-full" name="description" maxlength="240" />
        </fieldset>
      </div>
      <p class="mt-4 text-xs font-extrabold tracking-[0.16em] text-base-content/60 uppercase">{copy.adminRolePermissions}</p>
      <p class="mt-1 text-sm opacity-70">{copy.adminPermissionMatrixHelp}</p>
      <div class="mt-2">
        <PermissionMatrix
          modules={modules}
          permissions={permissions}
          actionLabels={actionLabels}
          allowLabel={copy.adminPermissionAllow}
          limitLabel={copy.adminPermissionLimit}
          translateLabel={copy.adminPermissionTranslate}
          translateNoneLabel={copy.adminPermissionTranslateNone}
          translateManualLabel={copy.adminPermissionTranslateManual}
          translateAiLabel={copy.adminPermissionTranslateAi}
          unlimitedLabel={copy.adminPermissionUnlimited}
          noneLabel={copy.adminPermissionNone}
          helpToggleLabel={copy.adminPermissionHelpToggle}
          doneLabel={copy.adminPermissionDone}
          helpCreate={copy.adminPermissionHelpCreate}
          helpRead={copy.adminPermissionHelpRead}
          helpUpdate={copy.adminPermissionHelpUpdate}
          helpDelete={copy.adminPermissionHelpDelete}
          helpAllow={copy.adminPermissionHelpAllow}
          helpLimit={copy.adminPermissionHelpLimit}
          helpTranslate={copy.adminPermissionHelpTranslate}
        />
      </div>
      <div class="flex justify-end gap-2">
        <button class="btn btn-ghost btn-sm" type="reset">{copy.adminCancel}</button>
        <button class="btn btn-primary btn-sm" type="submit">{copy.adminAdd}</button>
      </div>
    </form>
  </details>

  <div class="mt-6 flex flex-col gap-6">
    {roles.map((role) => {
      const granted = grantedByRole.get(role.id) ?? new Map();
      return (
        <article class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body gap-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="font-display text-[20px] tracking-[-0.005em]">{role.name}</h2>
                <p class="text-sm opacity-70">{role.description ?? "—"}</p>
              </div>
              <form method="post" action="/api/admin/roles" data-admin-confirm data-intent="delete_role">
                <input type="hidden" name="_intent" value="delete_role" />
                <input type="hidden" name="id" value={role.id} />
                <button class="btn btn-square btn-ghost btn-sm" type="submit" title={copy.adminRemove}>
                  <svg class="size-4"><use href="#ic-trash"></use></svg>
                </button>
              </form>
            </div>

            <form method="post" action="/api/admin/permissions" data-admin-permissions-form>
              <input type="hidden" name="_intent" value="assign_role" />
              <input type="hidden" name="roleId" value={role.id} />
              <p class="text-xs font-extrabold tracking-[0.16em] text-base-content/60 uppercase">{copy.adminRolePermissions}</p>
                  <p class="mt-1 text-sm opacity-70">{copy.adminPermissionMatrixHelp}</p>
                  <div class="mt-3">
                    <PermissionMatrix
                      modules={modules}
                      permissions={permissions}
                      assignments={granted}
                      actionLabels={actionLabels}
                      allowLabel={copy.adminPermissionAllow}
                      limitLabel={copy.adminPermissionLimit}
                      translateLabel={copy.adminPermissionTranslate}
                      translateNoneLabel={copy.adminPermissionTranslateNone}
                      translateManualLabel={copy.adminPermissionTranslateManual}
                      translateAiLabel={copy.adminPermissionTranslateAi}
                      unlimitedLabel={copy.adminPermissionUnlimited}
                      noneLabel={copy.adminPermissionNone}
                      helpToggleLabel={copy.adminPermissionHelpToggle}
                      doneLabel={copy.adminPermissionDone}
                      helpCreate={copy.adminPermissionHelpCreate}
                      helpRead={copy.adminPermissionHelpRead}
                      helpUpdate={copy.adminPermissionHelpUpdate}
                      helpDelete={copy.adminPermissionHelpDelete}
                      helpAllow={copy.adminPermissionHelpAllow}
                      helpLimit={copy.adminPermissionHelpLimit}
                      helpTranslate={copy.adminPermissionHelpTranslate}
                    />
                  </div>
                  <div class="mt-3 flex justify-end gap-2">
                <button class="btn btn-primary btn-sm" type="submit">{copy.adminSave}</button>
              </div>
            </form>
          </div>
        </article>
      );
    })}
  </div>

  <script is:inline>
    (function () {
      var bind = function () {
        document.querySelectorAll("form[data-admin-form]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            var data = new FormData(form);
            fetch(form.action, { method: "POST", body: data })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) { window.location.reload(); return; }
                var lang = document.documentElement.lang === "en" ? "en" : "es";
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast(lang === "en" ? "Could not save." : "No pudimos guardar.", "error");
              });
          });
        });

        document.querySelectorAll("form[data-admin-confirm]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            var lang = document.documentElement.lang === "en" ? "en" : "es";
            if (!window.confirm(lang === "en" ? "Delete this role?" : "¿Eliminar este rol?")) return;
            var data = new FormData(form);
            fetch(form.action, { method: "POST", body: data }).then(function () { window.location.reload(); });
          });
        });

        document.querySelectorAll("form[data-admin-permissions-form]").forEach(function (form) {
          if (form.dataset.bound === "true") return;
          form.dataset.bound = "true";
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            var data = new FormData(form);
            fetch(form.action, { method: "POST", body: data })
              .then(function (res) { return res.json(); })
              .then(function () {
                var lang = document.documentElement.lang === "en" ? "en" : "es";
                if (window.AfroUpFeedback) {
                  window.AfroUpFeedback.toast(lang === "en" ? "Permissions saved." : "Permisos guardados.", "success");
                }
              });
          });
        });
      };
      bind();
      document.addEventListener("astro:after-swap", bind);
    })();
  </script>
</AdminLayout>