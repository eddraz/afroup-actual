---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireModuleAccess } from "../../lib/admin-scope";
import { localizedPath } from "../../lib/i18n";
import { resolveRequestCopy } from "../../lib/request-locale";
import { routeIds } from "../../lib/paths";
import { listSiteLanguages } from "../../lib/site-languages";
import { env } from "cloudflare:workers";
import AdminPageHeader from "../../components/admin/AdminPageHeader.astro";
import AdminToolbar from "../../components/admin/AdminToolbar.astro";
import AdminTable from "../../components/admin/AdminTable.astro";
import AdminDrawerPanel from "../../components/admin/AdminDrawerPanel.astro";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "idiomas");
if (access instanceof Response) return access;
const actor = access;

const languages = await listSiteLanguages(env.DB);
---

<AdminLayout title={copy.adminLanguages} active="languages">
  <!-- Right-to-Left Drawer for Languages -->
  <AdminDrawerPanel
    toggleId="lang-drawer"
    width="form"
    title={copy.adminLanguageTranslate || "Configurar nuevo idioma"}
    subtitle="Añade compatibilidad multilingüe para las publicaciones del portal."
  >
    <Fragment slot="content">
      <!-- Page Header -->
      <AdminPageHeader
        title={copy.adminLanguages}
        count={languages.length}
        countLabel="idiomas"
        lead="Gestiona la disponibilidad de idiomas públicos y las traducciones en el sistema."
      >
        <Fragment slot="actions">
          <label
            for="lang-drawer"
            class="drawer-button btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform cursor-pointer"
          >
            <svg class="size-4"><use href="#ic-plus"></use></svg>
            <span>{copy.adminLanguageTranslate || "Añadir Idioma"}</span>
          </label>
        </Fragment>
      </AdminPageHeader>

      <!-- Filter & Search Toolbar -->
      <AdminToolbar searchId="languages-search" searchPlaceholder="Buscar idiomas por código, nombre o traducción..." />

      <!-- Languages Table -->
      <AdminTable
        id="languages-table"
        columns={[
          { label: copy.adminLanguageShow || "Activo", class: "py-4 pl-6" },
          { label: copy.adminLanguageCode || "Código" },
          { label: copy.adminLanguageName || "Nombre" },
          { label: copy.adminLanguageNative || "Nombre Nativo" },
          { label: "Tipo", class: "text-right pr-6" },
        ]}
      >
        <Fragment slot="rows">
          {languages.map((language) => (
            <tr class="hover:bg-base-200/50 transition-colors language-row" data-code={language.code.toLowerCase()} data-name={(language.name || "").toLowerCase()} data-native={(language.native_name || "").toLowerCase()}>
              <td class="py-3.5 pl-6">
                <form method="post" action="/api/admin/languages" data-language-toggle>
                  <input type="hidden" name="_intent" value="toggle" />
                  <input type="hidden" name="code" value={language.code} />
                  <input type="hidden" name="visible" value={language.is_visible ? "0" : "1"} />
                  <input type="checkbox" class="checkbox checkbox-sm checkbox-primary rounded-md" checked={language.is_visible === 1} data-show-toggle />
                </form>
              </td>
              <td>
                <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-200 border border-base-300 font-bold uppercase text-base-content/80">
                  {language.code}
                </span>
              </td>
              <td class="font-bold text-base-content">{language.name}</td>
              <td class="text-base-content/80">{language.native_name}</td>
              <td class="text-right pr-6">
                {language.is_pillar ? (
                  <span class="badge badge-xs badge-accent font-bold py-1 px-2.5 uppercase">{copy.adminLanguagePillar || "Principal"}</span>
                ) : (
                  <span class="badge badge-xs badge-ghost py-1 px-2 font-semibold">Opcional</span>
                )}
              </td>
            </tr>
          ))}
        </Fragment>
      </AdminTable>
    </Fragment>

    <form method="post" action="/api/admin/languages" class="space-y-6 flex-1 flex flex-col justify-between" data-language-form>
      <input type="hidden" name="_intent" value="create" />
      <div class="space-y-5">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminLanguageCode || "Código ISO (2 letras)"}</legend>
            <input class="input input-bordered w-full font-mono font-bold uppercase" name="code" required maxlength="2" pattern="[a-zA-Z]{2}" placeholder="pt" />
          </fieldset>
          <fieldset class="fieldset sm:col-span-2">
            <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminLanguageName || "Nombre Internacional"}</legend>
            <input class="input input-bordered w-full font-semibold" name="name" required maxlength="80" placeholder="Portuguese" />
          </fieldset>
        </div>

        <fieldset class="fieldset">
          <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminLanguageNative || "Nombre Nativo"}</legend>
          <div class="join w-full">
            <input class="input input-bordered join-item w-full font-semibold" name="nativeName" maxlength="80" placeholder="Português" data-native-name />
            <button class="btn btn-ai join-item text-xs font-bold" type="button" data-suggest-native>{copy.adminLanguageSuggest || "Sugerir IA"}</button>
          </div>
          <p class="text-[11px] text-base-content/50 mt-1">{copy.adminLanguageNativeHelp}</p>
        </fieldset>
      </div>

      <div class="flex justify-end gap-2 pt-4 border-t border-base-300 mt-6 shrink-0">
        <label for="lang-drawer" class="btn btn-ghost btn-sm cursor-pointer">{copy.adminCancel}</label>
        <button class="btn btn-primary btn-sm px-6 font-bold" type="submit">{copy.adminLanguageTranslate || "Añadir Idioma"}</button>
      </div>
    </form>
  </AdminDrawerPanel>

  <script is:inline>
    (function () {
      var bind = function () {
        var drawerToggle = document.getElementById("lang-drawer");

        if (drawerToggle && drawerToggle.dataset.boundScroll !== "true") {
          drawerToggle.dataset.boundScroll = "true";
          drawerToggle.addEventListener("change", function () {
            if (drawerToggle.checked) {
              document.body.style.overflow = "hidden";
              var firstInput = document.querySelector(".drawer-side input:not([disabled])");
              if (firstInput) setTimeout(function () { firstInput.focus(); }, 150);
            } else {
              document.body.style.overflow = "";
            }
          });

          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && drawerToggle.checked) {
              drawerToggle.checked = false;
              document.body.style.overflow = "";
            }
          });
        }

        // Search live filter
        var searchInput = document.getElementById("languages-search");
        var rows = document.querySelectorAll(".language-row");

        if (searchInput && searchInput.dataset.bound !== "true") {
          searchInput.dataset.bound = "true";
          searchInput.addEventListener("input", function () {
            var q = searchInput.value.trim().toLowerCase();
            rows.forEach(function (r) {
              var code = r.getAttribute("data-code") || "";
              var name = r.getAttribute("data-name") || "";
              var native = r.getAttribute("data-native") || "";
              if (!q || code.indexOf(q) !== -1 || name.indexOf(q) !== -1 || native.indexOf(q) !== -1) {
                r.style.display = "";
              } else {
                r.style.display = "none";
              }
            });
          });
        }

        // Form submission
        var langForm = document.querySelector("[data-language-form]");
        if (langForm && !langForm.dataset.boundSubmit) {
          langForm.dataset.boundSubmit = "true";
          langForm.addEventListener("submit", function (event) {
            event.preventDefault();
            fetch(langForm.action, { method: "POST", body: new FormData(langForm) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Idioma añadido.", "success");
                  if (drawerToggle) drawerToggle.checked = false;
                  document.body.style.overflow = "";
                  setTimeout(function () { window.location.reload(); }, 600);
                  return;
                }
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error al añadir idioma.", "error");
              })
              .catch(function () {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error de red.", "error");
              });
          });
        }

        // Toggle visibility
        document.querySelectorAll("input[data-show-toggle]").forEach(function (input) {
          if (input.dataset.boundToggle) return;
          input.dataset.boundToggle = "true";
          input.addEventListener("change", function () {
            var form = input.closest("form");
            if (form) {
              fetch(form.action, { method: "POST", body: new FormData(form) })
                .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
                .then(function (result) {
                  if (result.ok) {
                    if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Idioma actualizado.", "success");
                    return;
                  }
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error al actualizar visibilidad.", "error");
                  input.checked = !input.checked;
                })
                .catch(function () {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error de red.", "error");
                  input.checked = !input.checked;
                });
            }
          });
        });

        // AI Suggestion
        var suggestBtn = document.querySelector("[data-suggest-native]");
        if (suggestBtn && !suggestBtn.dataset.boundSuggest) {
          suggestBtn.dataset.boundSuggest = "true";
          suggestBtn.addEventListener("click", function () {
            var nameInp = document.querySelector("input[name='name']");
            var nativeInp = document.querySelector("input[data-native-name]");
            var codeInp = document.querySelector("input[name='code']");
            var name = nameInp ? nameInp.value.trim() : "";
            var code = codeInp ? codeInp.value.trim() : "";

            if (!name && !code) {
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Ingresa el código o nombre primero.", "error");
              return;
            }

            suggestBtn.disabled = true;
            fetch("/api/admin/translate", {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: new URLSearchParams({
                module: "idiomas",
                source: name || code,
                target: code || "es",
                intent: "suggest_native_name"
              })
            })
              .then(function (r) { return r.json(); })
              .then(function (res) {
                if (res.ok && res.text && nativeInp) {
                  nativeInp.value = res.text;
                }
              })
              .finally(function () { suggestBtn.disabled = false; });
          });
        }
      };

      bind();
      document.addEventListener("astro:page-load", bind);
      document.addEventListener("astro:before-swap", function () {
        document.body.style.overflow = "";
      });
    })();
  </script>
</AdminLayout>
