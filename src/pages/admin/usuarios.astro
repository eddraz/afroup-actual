---
import AdminLayout from "../../layouts/AdminLayout.astro";
import PermissionMatrix from "../../components/PermissionMatrix.astro";
import { localizedPath, t } from "../../lib/i18n";
import { resolveRequestCopy } from "../../lib/request-locale";
import { env } from "cloudflare:workers";
import { routeIds } from "../../lib/paths";
import {
  listVisibleAdminUsers,
  requireModuleAccess,
} from "../../lib/admin-scope";
import {
  grantsToJson,
  loadAllRoleGrants,
  loadAllUserGrants,
} from "../../lib/permission-grants";
import { hasPermission, type PermissionAction } from "../../lib/rbac";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "users");
if (access instanceof Response) return access;
const actor = access;

const canInvite = await hasPermission(env.DB, actor.id, "users", "create");

interface RoleRow {
  id: number;
  name: string;
  description: string | null;
}

interface ModuleRow {
  id: number;
  name: string;
  slug: string;
}

interface PermissionRow {
  id: number;
  module_id: number;
  action: PermissionAction;
}

const users = await listVisibleAdminUsers(env.DB, actor.id);
const shareable = users.filter((user) => user.id !== actor.id && user.created_by === actor.id);
const sharedRows = (await env.DB.prepare(
  `SELECT record_id FROM record_shares WHERE module_slug = 'users' AND shared_with_id = ?`,
).bind(actor.id).all<{ record_id: number }>()).results ?? [];
const sharedWithMe = new Set(sharedRows.map((row) => row.record_id));
const roles = (await env.DB.prepare("SELECT id, name, description FROM admin_roles ORDER BY name").all<RoleRow>()).results ?? [];
const modules = (await env.DB.prepare("SELECT id, name, slug FROM admin_modules ORDER BY name").all<ModuleRow>()).results ?? [];
const permissions = (await env.DB.prepare("SELECT id, module_id, action FROM admin_permissions ORDER BY module_id, action").all<PermissionRow>()).results ?? [];
const grantedByUser = await loadAllUserGrants(env.DB);
const grantedByRole = await loadAllRoleGrants(env.DB);
const rolePermissionsJson = grantsToJson(grantedByRole);

const actionLabels: Record<PermissionAction, string> = {
  create: copy.adminActionCreate,
  read: copy.adminActionRead,
  update: copy.adminActionUpdate,
  delete: copy.adminActionDelete,
};
---

<AdminLayout title={copy.adminUsers} active="users">
  <!-- Page Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5">
        <h2 class="font-display text-2xl font-bold text-base-content">{copy.adminUsers}</h2>
        <span class="badge badge-neutral badge-sm font-semibold">{users.length} miembros</span>
      </div>
      <p class="text-xs sm:text-sm text-base-content/60 mt-1">
        Administra el equipo editorial, colaboradores, roles y permisos granulares de acceso.
      </p>
    </div>

    {canInvite ? (
      <button
        type="button"
        id="btn-toggle-invite"
        class="btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform"
      >
        <svg class="size-4"><use href="#ic-plus"></use></svg>
        <span>{copy.adminNewUserInvite || "Invitar Usuario"}</span>
      </button>
    ) : null}
  </div>

  <!-- Collapsible Invite Form -->
  {canInvite ? (
    <div id="invite-box" class="hidden mb-8">
      <div class="rounded-3xl border border-primary/30 bg-base-100 p-6 sm:p-8 shadow-md ring-1 ring-primary/20">
        <div class="flex items-center justify-between border-b border-base-300 pb-3 mb-6">
          <div class="flex items-center gap-2">
            <span class="size-2.5 rounded-full bg-primary animate-pulse"></span>
            <h3 class="font-display font-bold text-lg text-base-content">{copy.adminNewUserInvite || "Invitar nuevo miembro"}</h3>
          </div>
          <button type="button" class="btn btn-circle btn-ghost btn-xs" id="btn-close-invite">✕</button>
        </div>

        <form method="post" action="/api/admin/users/invite" class="space-y-5" data-invite-form>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminModuleName || "Nombre completo"}</legend>
              <input class="input input-bordered w-full font-semibold" name="name" required maxlength="80" autocomplete="off" placeholder="Jenniffer M." />
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminUserEmail || "Correo electrónico"}</legend>
              <input class="input input-bordered w-full font-semibold" name="email" type="email" required maxlength="120" autocomplete="off" placeholder="usuario@afroup.com" />
            </fieldset>
            <fieldset class="fieldset sm:col-span-2">
              <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{copy.adminUserRole || "Rol predeterminado"}</legend>
              <select class="select select-bordered w-full font-semibold" name="roleId" data-role-select>
                <option value="">{copy.adminUserNoRole || "Sin rol asignado"}</option>
                {roles.map((role) => <option value={role.id}>{role.name}</option>)}
              </select>
              <p class="text-xs text-base-content/50 mt-1">{copy.adminInviteRoleHint}</p>
            </fieldset>
          </div>

          <div class="border-t border-base-300 pt-4">
            <p class="text-xs font-extrabold tracking-wider text-base-content/60 uppercase">{copy.adminUserPermissions || "Matriz de Permisos Específicos"}</p>
            <p class="mt-1 text-xs text-base-content/60">{copy.adminPermissionMatrixHelp}</p>
            <div class="mt-3">
              <PermissionMatrix
                modules={modules}
                permissions={permissions}
                actionLabels={actionLabels}
                allowLabel={copy.adminPermissionAllow}
                limitLabel={copy.adminPermissionLimit}
                translateLabel={copy.adminPermissionTranslate}
                translateNoneLabel={copy.adminPermissionTranslateNone}
                translateManualLabel={copy.adminPermissionTranslateManual}
                translateAiLabel={copy.adminPermissionTranslateAi}
                unlimitedLabel={copy.adminPermissionUnlimited}
                noneLabel={copy.adminPermissionNone}
                helpToggleLabel={copy.adminPermissionHelpToggle}
                doneLabel={copy.adminPermissionDone}
                helpCreate={copy.adminPermissionHelpCreate}
                helpRead={copy.adminPermissionHelpRead}
                helpUpdate={copy.adminPermissionHelpUpdate}
                helpDelete={copy.adminPermissionHelpDelete}
                helpAllow={copy.adminPermissionHelpAllow}
                helpLimit={copy.adminPermissionHelpLimit}
                helpTranslate={copy.adminPermissionHelpTranslate}
              />
            </div>
          </div>

          <div class="flex justify-end gap-2 pt-2 border-t border-base-300">
            <button class="btn btn-ghost btn-sm" type="reset" id="btn-cancel-invite">{copy.adminCancel}</button>
            <button class="btn btn-primary btn-sm px-5 font-bold" type="submit">
              {copy.adminInviteSelectRole?.includes("rol") ? "Enviar invitación" : copy.adminAdd || "Guardar"}
            </button>
          </div>
        </form>
      </div>
    </div>
  ) : null}

  <!-- Filter & Search Toolbar -->
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-100 p-3 shadow-xs">
    <div class="relative flex-1 min-w-[240px] max-w-md">
      <svg class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none">
        <use href="#ic-users"></use>
      </svg>
      <input
        type="search"
        id="users-search"
        placeholder="Buscar usuarios por nombre, correo o rol..."
        class="input input-sm input-bordered w-full pl-9 bg-base-200/40 text-xs sm:text-sm font-medium"
      />
    </div>

    <div class="join border border-base-300 bg-base-200/50 p-0.5 rounded-xl">
      <button class="btn btn-xs join-item btn-ghost font-bold text-[11px] user-filter-btn active-filter" data-filter="all">
        Todos ({users.length})
      </button>
      <button class="btn btn-xs join-item btn-ghost font-bold text-[11px] user-filter-btn" data-filter="active">
        Activos ({users.filter(u => u.is_active).length})
      </button>
      <button class="btn btn-xs join-item btn-ghost font-bold text-[11px] user-filter-btn" data-filter="pending">
        Invitaciones ({users.filter(u => u.invite_pending).length})
      </button>
    </div>
  </div>

  <!-- Users Grid / List -->
  <div class="grid grid-cols-1 gap-4" id="users-container">
    {users.length === 0 ? (
      <div class="rounded-3xl border border-base-300 bg-base-100 p-12 shadow-xs text-center">
        <div class="flex flex-col items-center gap-2">
          <div class="size-12 rounded-2xl bg-base-200 flex items-center justify-center text-base-content/40">
            <svg class="size-6"><use href="#ic-users"></use></svg>
          </div>
          <span class="font-bold text-base">No hay usuarios registrados</span>
          <span class="text-xs text-base-content/50">Invita a un miembro para comenzar a colaborar</span>
        </div>
      </div>
    ) : null}

    {users.map((user) => {
      const granted = grantedByUser.get(user.id) ?? new Map();
      const isSelf = user.id === actor.id;
      const isChild = user.created_by === actor.id;
      const isShared = sharedWithMe.has(user.id);
      const initials = (user.name || "U")
        .split(" ")
        .map((p) => p[0])
        .slice(0, 2)
        .join("")
        .toUpperCase();

      return (
        <article
          class="rounded-3xl border border-base-300 bg-base-100 p-5 sm:p-6 shadow-xs space-y-4 hover:border-base-300/80 transition-all user-card"
          data-name={(user.name || "").toLowerCase()}
          data-email={(user.email || "").toLowerCase()}
          data-role={(user.role_name || "").toLowerCase()}
          data-active={user.is_active ? "active" : "paused"}
          data-pending={user.invite_pending ? "pending" : "verified"}
        >
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex items-center gap-3.5">
              <div class="avatar placeholder">
                <div class="size-12 rounded-2xl bg-primary/10 text-primary font-bold font-display text-base border border-primary/20 flex items-center justify-center">
                  <span>{initials}</span>
                </div>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="font-display text-lg font-bold text-base-content">{user.name}</h3>
                  {isSelf ? <span class="badge badge-xs badge-primary font-bold">{copy.adminYou || "Tú"}</span> : null}
                </div>
                <p class="text-xs text-base-content/60 font-mono">{user.email}</p>
                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                  <span class:list={[
                    "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider",
                    user.is_active ? "bg-success/15 text-success border border-success/30" : "bg-base-300 text-base-content/60"
                  ]}>
                    <span class:list={["size-1.5 rounded-full", user.is_active ? "bg-success animate-pulse" : "bg-base-content/40"]}></span>
                    {user.is_active ? copy.adminUserActive || "Activo" : copy.adminUserPaused || "Pausado"}
                  </span>
                  {user.invite_pending ? <span class="badge badge-xs badge-warning font-bold py-1 px-2 uppercase">{copy.inviteEyebrow || "Invitación Pendiente"}</span> : null}
                  {user.role_name ? <span class="badge badge-xs badge-accent font-bold py-1 px-2 uppercase">{user.role_name}</span> : null}
                  {isChild ? <span class="badge badge-xs badge-ghost font-semibold py-1 px-2">{copy.adminCreatedByYou || "Creado por ti"}</span> : null}
                  {isShared ? <span class="badge badge-xs badge-info font-semibold py-1 px-2">{copy.adminSharedWithYou || "Compartido"}</span> : null}
                </div>
              </div>
            </div>

            {!isSelf ? (
              <form method="post" action="/api/admin/roles" data-admin-confirm>
                <input type="hidden" name="_intent" value="delete_user" />
                <input type="hidden" name="id" value={user.id} />
                <button class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-error/10 hover:text-error" type="submit" title={copy.adminRemove}>
                  <svg class="size-3.5"><use href="#ic-trash"></use></svg>
                </button>
              </form>
            ) : null}
          </div>

          {isChild ? (
            <div class="border-t border-base-300/60 pt-3">
              <form method="post" action="/api/admin/shares" class="flex flex-wrap items-center gap-2 text-xs" data-share-form>
                <input type="hidden" name="module" value="users" />
                <input type="hidden" name="recordId" value={user.id} />
                <span class="font-semibold text-base-content/60">{copy.adminShareWith || "Compartir acceso con:"}</span>
                <select class="select select-bordered select-xs text-xs font-semibold" name="sharedWithId" required>
                  <option value="">{copy.adminShareNone || "Seleccionar..."}</option>
                  {shareable.filter((candidate) => candidate.id !== user.id).map((candidate) => (
                    <option value={candidate.id}>{candidate.name}</option>
                  ))}
                </select>
                <button class="btn btn-ghost btn-xs border border-base-300" type="submit">{copy.adminShare || "Compartir"}</button>
              </form>
            </div>
          ) : null}

          {!isSelf && isChild ? (
            <details class="border-t border-base-300/60 pt-3 group">
              <summary class="cursor-pointer text-xs font-bold text-base-content/70 hover:text-primary flex items-center justify-between list-none py-1">
                <span class="flex items-center gap-1.5">
                  <svg class="size-3.5"><use href="#ic-key"></use></svg>
                  <span>{copy.adminUserPermissions || "Configurar permisos directos del usuario"}</span>
                </span>
                <span class="text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <form method="post" action="/api/admin/permissions" data-admin-permissions-form class="mt-3 space-y-3">
                <input type="hidden" name="_intent" value="assign_user" />
                <input type="hidden" name="userId" value={user.id} />
                <PermissionMatrix
                  modules={modules}
                  permissions={permissions}
                  assignments={granted}
                  actionLabels={actionLabels}
                  allowLabel={copy.adminPermissionAllow}
                  limitLabel={copy.adminPermissionLimit}
                  translateLabel={copy.adminPermissionTranslate}
                  translateNoneLabel={copy.adminPermissionTranslateNone}
                  translateManualLabel={copy.adminPermissionTranslateManual}
                  translateAiLabel={copy.adminPermissionTranslateAi}
                  unlimitedLabel={copy.adminPermissionUnlimited}
                  noneLabel={copy.adminPermissionNone}
                  helpToggleLabel={copy.adminPermissionHelpToggle}
                  doneLabel={copy.adminPermissionDone}
                  helpCreate={copy.adminPermissionHelpCreate}
                  helpRead={copy.adminPermissionHelpRead}
                  helpUpdate={copy.adminPermissionHelpUpdate}
                  helpDelete={copy.adminPermissionHelpDelete}
                  helpAllow={copy.adminPermissionHelpAllow}
                  helpLimit={copy.adminPermissionHelpLimit}
                  helpTranslate={copy.adminPermissionHelpTranslate}
                />
                <div class="flex justify-end gap-2 pt-2">
                  <button class="btn btn-primary btn-xs px-4 font-bold" type="submit">{copy.adminSave || "Guardar permisos"}</button>
                </div>
              </form>
            </details>
          ) : null}
        </article>
      );
    })}
  </div>

  <script is:inline define:vars={{ rolePermissions: rolePermissionsJson, locale }}>
    (function () {
      var roleMap = JSON.parse(rolePermissions);
      var lang = locale === "en" ? "en" : "es";

      var bind = function () {
        var toggleBtn = document.getElementById("btn-toggle-invite");
        var closeBtn = document.getElementById("btn-close-invite");
        var cancelBtn = document.getElementById("btn-cancel-invite");
        var inviteBox = document.getElementById("invite-box");

        if (toggleBtn && inviteBox && toggleBtn.dataset.bound !== "true") {
          toggleBtn.dataset.bound = "true";
          toggleBtn.addEventListener("click", function () {
            inviteBox.classList.toggle("hidden");
          });
        }
        if (closeBtn && inviteBox && closeBtn.dataset.bound !== "true") {
          closeBtn.dataset.bound = "true";
          closeBtn.addEventListener("click", function () { inviteBox.classList.add("hidden"); });
        }
        if (cancelBtn && inviteBox && cancelBtn.dataset.bound !== "true") {
          cancelBtn.dataset.bound = "true";
          cancelBtn.addEventListener("click", function () { inviteBox.classList.add("hidden"); });
        }

        var form = document.querySelector("[data-invite-form]");
        if (form && !form.dataset.boundRole) {
          form.dataset.boundRole = "true";
          var roleSelect = form.querySelector("[data-role-select]");
          var matrix = form.querySelector("[data-permission-matrix]");
          function applyRole(value) {
            var grants = value && roleMap[value] ? roleMap[value] : {};
            if (!matrix) return;
            matrix.querySelectorAll("[data-allow-box]").forEach(function (box) {
              var grant = grants[box.value];
              box.checked = Boolean(grant);
              var row = box.closest("[data-permission-row]");
              var limit = row ? row.querySelector("[data-limit-select]") : null;
              var translate = row ? row.querySelector("[data-translate-select]") : null;
              if (limit) {
                limit.value = grant && grant.scope ? grant.scope : "unlimited";
                limit.disabled = !box.checked;
              }
              if (translate) {
                translate.value = grant && grant.translation_tier ? grant.translation_tier : "none";
                translate.disabled = !box.checked;
              }
            });
          }
          if (roleSelect) {
            roleSelect.addEventListener("change", function () { applyRole(roleSelect.value); });
          }
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            fetch(form.action, { method: "POST", body: new FormData(form) })
              .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
              .then(function (result) {
                if (result.ok) {
                  if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Invitación enviada.", "success");
                  setTimeout(function () { window.location.reload(); }, 700);
                  return;
                }
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("No pudimos enviar la invitación.", "error");
              })
              .catch(function () {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error de red.", "error");
              });
          });
        }

        // Live User Search & Status Filter
        var searchInput = document.getElementById("users-search");
        var filterButtons = document.querySelectorAll(".user-filter-btn");
      var cards = document.querySelectorAll(".user-card");

      var currentFilter = "all";
      var searchQuery = "";

      var applyUserFilters = function () {
        cards.forEach(function (card) {
          var name = card.getAttribute("data-name") || "";
          var email = card.getAttribute("data-email") || "";
          var role = card.getAttribute("data-role") || "";
          var active = card.getAttribute("data-active") || "";
          var pending = card.getAttribute("data-pending") || "";

          var matchesSearch = !searchQuery || name.indexOf(searchQuery) !== -1 || email.indexOf(searchQuery) !== -1 || role.indexOf(searchQuery) !== -1;
          var matchesFilter = currentFilter === "all" ||
            (currentFilter === "active" && active === "active") ||
            (currentFilter === "pending" && pending === "pending");

          if (matchesSearch && matchesFilter) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      };

      if (searchInput && searchInput.dataset.bound !== "true") {
        searchInput.dataset.bound = "true";
        searchInput.addEventListener("input", function () {
          searchQuery = searchInput.value.trim().toLowerCase();
          applyUserFilters();
        });
      }

      filterButtons.forEach(function (btn) {
        if (btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";
        btn.addEventListener("click", function () {
          filterButtons.forEach(function (b) {
            b.classList.remove("btn-primary", "text-primary-content");
            b.classList.add("btn-ghost");
          });
          btn.classList.remove("btn-ghost");
          btn.classList.add("btn-primary", "text-primary-content");

          currentFilter = btn.getAttribute("data-filter") || "all";
          applyUserFilters();
        });
      });
    };

    bind();
    document.addEventListener("astro:page-load", bind);
  })();
</script>
</AdminLayout>
