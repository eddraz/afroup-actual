---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import ContactAdmin from "../../components/ContactAdmin.astro";
import { requireModuleAccess } from "../../lib/admin-scope";
import { resolveRequestCopy } from "../../lib/request-locale";
import { translationAccess } from "../../lib/editorial";
import { listSiteLanguages } from "../../lib/site-languages";
import { loadAllContactPageLocales, listContactSubmissions, getContactSubmissionStats } from "../../lib/contact";
import { localizedPath } from "../../lib/i18n";
import { routeIds } from "../../lib/paths";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "contacto");
if (access instanceof Response) return access;
const actor = access;

const translation = await translationAccess(env.DB, actor.id, "contacto", "update");
const languages = await listSiteLanguages(env.DB);
const contactByLocale = await loadAllContactPageLocales(env.DB);
const submissions = await listContactSubmissions(env.DB);
const stats = await getContactSubmissionStats(env.DB);
const publicHref = localizedPath(locale, routeIds.contact);
---

<AdminLayout title={copy.adminContact || "Contacto"} active="contact">
  <ContactAdmin
    contactByLocale={contactByLocale}
    submissions={submissions}
    stats={stats}
    languages={languages}
    translation={translation}
    locale={locale}
    copy={copy}
    publicHref={publicHref}
  />
</AdminLayout>
