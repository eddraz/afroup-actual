---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import ReferentesAdmin from "../../components/ReferentesAdmin.astro";
import { requireModuleAccess } from "../../lib/admin-scope";
import { resolveRequestCopy } from "../../lib/request-locale";
import { translationAccess } from "../../lib/editorial";
import { listSiteLanguages } from "../../lib/site-languages";
import {
  loadReferentes,
  loadAllReferentesWithLocales,
  loadAllReferentesPageConfigs,
  getReferentesStats,
} from "../../lib/referentes";
import { localizedPath } from "../../lib/i18n";
import { routeIds } from "../../lib/paths";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "referentes");
if (access instanceof Response) return access;
const actor = access;

const translation = await translationAccess(env.DB, actor.id, "referentes", "update");
const languages = await listSiteLanguages(env.DB);
const referentes = await loadReferentes(env.DB, locale);
const allReferentesWithLocales = await loadAllReferentesWithLocales(env.DB);
const pageConfigByLocale = await loadAllReferentesPageConfigs(env.DB);
const stats = await getReferentesStats(env.DB);
const publicHref = localizedPath(locale, routeIds.people);
---

<AdminLayout title={copy.adminReferentes || "Referentes"} active="referentes">
  <ReferentesAdmin
    referentes={referentes}
    allReferentesWithLocales={allReferentesWithLocales}
    pageConfigByLocale={pageConfigByLocale}
    stats={stats}
    languages={languages}
    translation={translation}
    locale={locale}
    copy={copy}
    publicHref={publicHref}
  />
</AdminLayout>
