---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import ArticleEditor from "../../components/ArticleEditor.astro";
import { requireModuleAccess } from "../../lib/admin-scope";
import { defaultLocale, joinPath, localizedPath } from "../../lib/i18n";
import { resolveRequestCopy } from "../../lib/request-locale";
import { translationAccess, visibleOwnerClause } from "../../lib/editorial";
import { hasPermission } from "../../lib/rbac";
import { listSiteLanguages, loadEditorCopyByLocale } from "../../lib/site-languages";
import { routeIds } from "../../lib/paths";
import { getCategoryTheme } from "../../lib/category-routes";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "articulos");
if (access instanceof Response) return access;
const actor = access;

const canCreate = await hasPermission(env.DB, actor.id, "articulos", "create");
const canDelete = await hasPermission(env.DB, actor.id, "articulos", "delete");
const translation = await translationAccess(env.DB, actor.id, "articulos", canCreate ? "create" : "update");
const languages = await listSiteLanguages(env.DB);
const editorCopyByLocale = await loadEditorCopyByLocale(env.DB, languages);

interface ArticleRow {
  id: number;
  slug: string;
  status: string;
  cover_image_url: string | null;
  reading_time_minutes: number | null;
  created_at: string;
  updated_at: string;
  published_at: string | null;
  created_by: number | null;
  author_name: string | null;
  title: string | null;
  category_titles: string | null;
  primary_category_slug: string | null;
}

interface CategoryOption {
  id: number;
  slug: string;
  title: string;
}

const items = (await env.DB.prepare(
  `SELECT a.id, a.slug, a.status, a.cover_image_url, a.reading_time_minutes,
          a.created_at, a.updated_at, a.published_at,
          a.created_by, u.name AS author_name,
          (SELECT title FROM article_locales l
            WHERE l.article_id = a.id
            ORDER BY CASE WHEN l.locale = ? THEN 0 ELSE 1 END, l.locale
            LIMIT 1) AS title,
          (SELECT GROUP_CONCAT(COALESCE(loc.title, def.title), ', ')
             FROM article_category_map m
             LEFT JOIN article_category_locales loc ON loc.category_id = m.category_id AND loc.locale = ?
             LEFT JOIN article_category_locales def ON def.category_id = m.category_id AND def.locale = ?
            WHERE m.article_id = a.id) AS category_titles,
          (SELECT c.slug FROM article_categories c
             JOIN article_category_map m ON m.category_id = c.id
            WHERE m.article_id = a.id
            ORDER BY m.sort_order, c.id
            LIMIT 1) AS primary_category_slug
     FROM articles a
LEFT JOIN users u ON u.id = a.created_by
    WHERE ${visibleOwnerClause("a.created_by")}
    ORDER BY a.updated_at DESC, a.id DESC`,
)
  .bind(locale, locale, defaultLocale, actor.id, "articulos", actor.id)
  .all<ArticleRow>()).results ?? [];

const categories = (await env.DB.prepare(
  `SELECT c.id, c.slug,
          COALESCE(
            (SELECT title FROM article_category_locales WHERE category_id = c.id AND locale = ?),
            (SELECT title FROM article_category_locales WHERE category_id = c.id AND locale = ?)
          ) AS title
     FROM article_categories c
    ORDER BY title`,
)
  .bind(locale, defaultLocale)
  .all<CategoryOption>()).results ?? [];

const existingTags = (await env.DB.prepare("SELECT name FROM tags ORDER BY name ASC").all<{ name: string }>()).results?.map((r) => r.name) ?? [];

const listHref = localizedPath(locale, joinPath(routeIds.admin, "articulos"));
const publishedCount = items.filter((i) => i.status === "published").length;
const draftsCount = items.length - publishedCount;

function formatDate(dateStr?: string | null) {
  if (!dateStr) return "—";
  try {
    const d = new Date(dateStr.endsWith("Z") ? dateStr : `${dateStr}Z`);
    return new Intl.DateTimeFormat(locale === "en" ? "en-US" : "es-ES", {
      day: "numeric",
      month: "short",
      year: "numeric",
    }).format(d);
  } catch {
    return dateStr.slice(0, 10);
  }
}
---

<AdminLayout title={copy.adminArticles} active="articles">
  <!-- Right-to-Left Drawer (90% width) for Article Writing & Editing -->
  <div class="drawer drawer-end">
    <input id="article-editor-drawer" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content">
      <!-- Page Header & Stats Summary -->
      <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5">
            <h2 class="font-display text-2xl font-bold text-base-content">{copy.adminArticles}</h2>
            <span class="badge badge-neutral badge-sm font-semibold">{items.length} {copy.adminCategoryTitle || "artículos"}</span>
          </div>
          <p class="text-xs sm:text-sm text-base-content/60 mt-1">
            Publica, traduce y organiza las historias del legado afro en múltiples categorías.
          </p>
        </div>

        {canCreate ? (
          <div class="flex items-center gap-2">
            <label
              for="article-editor-drawer"
              class="btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform drawer-button cursor-pointer"
              id="btn-open-new-article-drawer"
            >
              <svg class="size-4"><use href="#ic-plus"></use></svg>
              <span>{copy.adminNewArticle}</span>
            </label>
          </div>
        ) : null}
      </div>

      <!-- Filter & Search Toolbar -->
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-100 p-3 shadow-xs">
        <!-- Live Search Input -->
        <div class="relative flex-1 min-w-[240px] max-w-md">
          <svg class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none">
            <use href="#ic-world"></use>
          </svg>
          <input
            type="search"
            id="articles-search"
            placeholder="Buscar artículos por título, autor o slug..."
            class="input input-sm input-bordered w-full pl-9 bg-base-200/40 text-xs sm:text-sm font-medium"
          />
        </div>

        <!-- Filter Buttons -->
        <div class="flex items-center gap-2">
          <!-- Status Tabs -->
          <div class="join border border-base-300 bg-base-200/50 p-0.5 rounded-xl">
            <button class="btn btn-xs join-item btn-ghost font-bold text-[11px] filter-status-btn active-filter" data-filter-status="all">
              Todos ({items.length})
            </button>
            <button class="btn btn-xs join-item btn-ghost font-bold text-[11px] filter-status-btn" data-filter-status="published">
              Publicados ({publishedCount})
            </button>
            <button class="btn btn-xs join-item btn-ghost font-bold text-[11px] filter-status-btn" data-filter-status="draft">
              Borradores ({draftsCount})
            </button>
          </div>

          <!-- Category Filter Dropdown -->
          <select id="articles-cat-filter" class="select select-sm select-bordered text-xs font-semibold bg-base-200/40 max-w-[160px]">
            <option value="all">Todas las categorías</option>
            {categories.map((cat) => (
              <option value={cat.slug}>{cat.title}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Articles Table Container -->
      <div class="rounded-3xl border border-base-300 bg-base-100 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full" id="articles-table">
            <thead>
              <tr class="border-b border-base-300 bg-base-200/60 text-xs font-extrabold uppercase tracking-wider text-base-content/60">
                <th class="py-4 pl-6">{copy.adminCategoryTitle || "Artículo"}</th>
                <th>{copy.adminArticleCategory || "Categoría"}</th>
                <th>{copy.adminArticleAuthor || "Autor"}</th>
                <th>{copy.adminArticleReadingTime || "Lectura"}</th>
                <th>{copy.adminArticleStatus || "Estado"}</th>
                <th>{copy.adminArticleUpdatedAt || "Fecha"}</th>
                <th class="text-right pr-6">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-300/60 font-medium text-sm">
              {items.length === 0 ? (
                <tr>
                  <td colspan="7" class="text-center py-12 text-base-content/60">
                    <div class="flex flex-col items-center gap-2">
                      <div class="size-12 rounded-2xl bg-base-200 flex items-center justify-center text-base-content/40">
                        <svg class="size-6"><use href="#ic-book2"></use></svg>
                      </div>
                      <span class="font-bold text-base">No hay artículos creados</span>
                      <span class="text-xs text-base-content/50">Comienza haciendo clic en "+ Redactar Artículo"</span>
                    </div>
                  </td>
                </tr>
              ) : null}

              {items.map((item) => {
                const editHref = localizedPath(locale, joinPath(routeIds.admin, `articulos/${item.id}`));
                const publicHref = item.primary_category_slug
                  ? localizedPath(locale, `${item.primary_category_slug}/${item.slug}`)
                  : null;
                const theme = getCategoryTheme(item.primary_category_slug || "");
                const isPublished = item.status === "published";

                return (
                  <tr
                    class="hover:bg-base-200/50 transition-colors article-row"
                    data-title={(item.title ?? "").toLowerCase()}
                    data-slug={(item.slug ?? "").toLowerCase()}
                    data-author={(item.author_name ?? "").toLowerCase()}
                    data-status={item.status}
                    data-cat={item.primary_category_slug || "none"}
                  >
                    <!-- Title & Thumbnail -->
                    <td class="py-3.5 pl-6">
                      <div class="flex items-center gap-3.5 max-w-[340px]">
                        {item.cover_image_url ? (
                          <div class="size-11 rounded-xl overflow-hidden flex-none border border-base-300 bg-base-200 shadow-2xs">
                            <img src={item.cover_image_url} alt="" class="size-full object-cover" />
                          </div>
                        ) : (
                          <div class="size-11 rounded-xl bg-base-200 border border-base-300 flex-none flex items-center justify-center text-xs font-bold font-display opacity-40">
                            AU
                          </div>
                        )}
                        <div class="min-w-0">
                          <a href={editHref} class="font-bold text-base-content hover:text-primary transition-colors block truncate">
                            {item.title ?? item.slug}
                          </a>
                          <span class="text-xs text-base-content/50 font-mono block truncate">/{item.slug}</span>
                        </div>
                      </div>
                    </td>

                    <!-- Categories -->
                    <td>
                      {item.category_titles ? (
                        <span class:list={["inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold uppercase", theme.textClass, "bg-base-200/80 border border-base-300/80"]}>
                          <span class:list={["size-2 rounded-full", theme.dotClass]}></span>
                          <span class="truncate max-w-[130px]">{item.category_titles}</span>
                        </span>
                      ) : (
                        <span class="text-xs text-base-content/40 italic">{copy.adminArticleNoCategory || "Sin categoría"}</span>
                      )}
                    </td>

                    <!-- Author -->
                    <td>
                      <span class="text-xs font-semibold text-base-content/80">{item.author_name ?? "AfroUp"}</span>
                    </td>

                    <!-- Reading time -->
                    <td>
                      <span class="text-xs font-semibold text-base-content/70">
                        {item.reading_time_minutes ?? 5} min
                      </span>
                    </td>

                    <!-- Status -->
                    <td>
                      <span class:list={[
                        "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider",
                        isPublished ? "bg-success/15 text-success border border-success/30" : "bg-base-300/60 text-base-content/70 border border-base-300"
                      ]}>
                        <span class:list={["size-1.5 rounded-full", isPublished ? "bg-success animate-pulse" : "bg-base-content/40"]}></span>
                        <span>{isPublished ? copy.adminArticlePublished || "Publicado" : copy.adminArticleDraft || "Borrador"}</span>
                      </span>
                    </td>

                    <!-- Date -->
                    <td>
                      <span class="text-xs text-base-content/60 whitespace-nowrap">
                        {formatDate(item.updated_at || item.created_at)}
                      </span>
                    </td>

                    <!-- Actions -->
                    <td class="text-right pr-6">
                      <div class="inline-flex items-center gap-1.5">
                        {publicHref ? (
                          <a
                            class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-base-200 text-base-content/70 hover:text-base-content"
                            href={isPublished ? publicHref : `${publicHref}?preview=true`}
                            target="_blank"
                            rel="noopener noreferrer"
                            title={isPublished ? (copy.adminArticleViewPublic || "Ver en sitio público") : "Vista Previa de Borrador"}
                          >
                            <svg class="size-3.5"><use href={isPublished ? "#ic-link" : "#ic-eye"}></use></svg>
                          </a>
                        ) : null}

                        <a class="btn btn-primary btn-sm btn-outline text-xs font-bold h-7 min-h-0 px-3" href={editHref}>
                          <svg class="size-3.5"><use href="#ic-edit"></use></svg>
                          <span>{copy.adminEdit || "Editar"}</span>
                        </a>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 90% Screen Width Right-to-Left Drawer (drawer-side) -->
    <div class="drawer-side z-50">
      <label for="article-editor-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
      <aside class="flex h-dvh max-h-dvh min-h-dvh w-[90vw] max-w-[1600px] flex-col bg-base-100 text-base-content border-l border-base-300 shadow-2xl p-6 sm:p-8 overflow-y-auto overscroll-contain">
        <!-- Drawer Header -->
        <div class="flex items-center justify-between border-b border-base-300 pb-4 mb-6 shrink-0">
          <div class="flex items-center gap-3">
            <span class="size-3 rounded-full bg-primary animate-pulse"></span>
            <h3 class="font-display text-xl font-bold text-base-content">
              {copy.adminNewArticle || "Redactor de Artículos"}
            </h3>
            <span class="badge badge-xs badge-accent font-bold uppercase py-1 px-2.5">90% Studio Canvas</span>
          </div>
          <label for="article-editor-drawer" class="btn btn-circle btn-ghost btn-sm" aria-label="Cerrar redactor">
            ✕
          </label>
        </div>

        <!-- Article Editor Component inside 90% drawer -->
        <ArticleEditor
          categories={categories}
          existingTags={existingTags}
          languages={languages}
              editorCopyByLocale={editorCopyByLocale}
          translation={translation}
          locale={locale}
          copy={copy}
          backHref={listHref}
        />
      </aside>
    </div>
  </div>
</AdminLayout>

<style is:global>
  #article-editor-drawer:checked ~ .drawer-side {
    pointer-events: auto !important;
    visibility: visible !important;
    overflow-y: hidden !important;
  }
  #article-editor-drawer:checked ~ .drawer-side > aside {
    pointer-events: auto !important;
    overflow-y: auto !important;
    max-height: 100dvh !important;
    height: 100dvh !important;
    -webkit-overflow-scrolling: touch;
  }
</style>

<script is:inline>
  (function () {
    var bindArticlesUI = function () {
      // Live Search & Filtering
      var searchInput = document.getElementById("articles-search");
      var catFilter = document.getElementById("articles-cat-filter");
      var statusButtons = document.querySelectorAll(".filter-status-btn");
      var rows = document.querySelectorAll(".article-row");

      var currentStatus = "all";
      var currentCat = "all";
      var searchQuery = "";

      var applyFilters = function () {
        rows.forEach(function (row) {
          var title = row.getAttribute("data-title") || "";
          var slug = row.getAttribute("data-slug") || "";
          var author = row.getAttribute("data-author") || "";
          var status = row.getAttribute("data-status") || "";
          var cat = row.getAttribute("data-cat") || "";

          var matchesSearch = !searchQuery || title.indexOf(searchQuery) !== -1 || slug.indexOf(searchQuery) !== -1 || author.indexOf(searchQuery) !== -1;
          var matchesStatus = currentStatus === "all" || status === currentStatus;
          var matchesCat = currentCat === "all" || cat === currentCat;

          if (matchesSearch && matchesStatus && matchesCat) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      };

      if (searchInput && searchInput.dataset.bound !== "true") {
        searchInput.dataset.bound = "true";
        searchInput.addEventListener("input", function () {
          searchQuery = searchInput.value.trim().toLowerCase();
          applyFilters();
        });
      }

      if (catFilter && catFilter.dataset.bound !== "true") {
        catFilter.dataset.bound = "true";
        catFilter.addEventListener("change", function () {
          currentCat = catFilter.value;
          applyFilters();
        });
      }

      statusButtons.forEach(function (btn) {
        if (btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";
        btn.addEventListener("click", function () {
          statusButtons.forEach(function (b) {
            b.classList.remove("btn-primary", "text-primary-content");
            b.classList.add("btn-ghost");
          });
          currentStatus = btn.getAttribute("data-filter-status") || "all";
          applyFilters();
        });
      });

      // Drawer scroll lock & escape listener
      var drawerToggle = document.getElementById("article-editor-drawer");
      if (drawerToggle && drawerToggle.dataset.boundScroll !== "true") {
        drawerToggle.dataset.boundScroll = "true";
        drawerToggle.addEventListener("change", function () {
          if (drawerToggle.checked) {
            document.body.style.overflow = "hidden";
          } else {
            document.body.style.overflow = "";
          }
        });

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && drawerToggle.checked) {
            drawerToggle.checked = false;
            document.body.style.overflow = "";
          }
        });
      }
    };

    bindArticlesUI();
    document.addEventListener("astro:page-load", bindArticlesUI);
    document.addEventListener("astro:before-swap", function () {
      document.body.style.overflow = "";
    });
  })();
</script>
