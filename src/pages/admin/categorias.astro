---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageLocaleSwitch from "../../components/PageLocaleSwitch.astro";
import { defaultLocale } from "../../lib/i18n";
import { requireModuleAccess } from "../../lib/admin-scope";
import { resolveRequestCopy } from "../../lib/request-locale";
import { translationAccess } from "../../lib/editorial";
import { hasPermission } from "../../lib/rbac";
import { listSiteLanguages } from "../../lib/site-languages";
import { getCategoryTheme } from "../../lib/category-routes";
import CategoryEditor from "../../components/CategoryEditor.astro";
import AdminPageHeader from "../../components/admin/AdminPageHeader.astro";
import AdminToolbar from "../../components/admin/AdminToolbar.astro";
import AdminTable from "../../components/admin/AdminTable.astro";
import AdminDrawerPanel from "../../components/admin/AdminDrawerPanel.astro";

export const prerender = false;

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const access = await requireModuleAccess(env.DB, Astro.cookies, Astro.url, locale, "categorias");
if (access instanceof Response) return access;
const actor = access;

const canCreate = await hasPermission(env.DB, actor.id, "categorias", "create");
const canUpdate = await hasPermission(env.DB, actor.id, "categorias", "update");
const canDelete = await hasPermission(env.DB, actor.id, "categorias", "delete");
const translation = await translationAccess(env.DB, actor.id, "categorias", canCreate ? "create" : "update");
const languages = await listSiteLanguages(env.DB);

interface CategoryRow {
  id: number;
  slug: string;
  title: string | null;
  article_count: number;
}

const categories = (await env.DB.prepare(
  `SELECT c.id, c.slug,
          COALESCE(
            (SELECT title FROM article_category_locales WHERE category_id = c.id AND locale = ?),
            (SELECT title FROM article_category_locales WHERE category_id = c.id AND locale = ?)
          ) AS title,
          (SELECT COUNT(*) FROM article_category_map m WHERE m.category_id = c.id) AS article_count
     FROM article_categories c
    ORDER BY title`,
)
  .bind(locale, defaultLocale)
  .all<CategoryRow>()).results ?? [];
---

<AdminLayout title={copy.adminCategories} active="categories">
  <!-- Right-to-Left Drawer for Categories -->
  <AdminDrawerPanel
    toggleId="category-drawer"
    width="form"
    title={copy.adminNewCategory}
    subtitle="Configura la nueva categoría y sus versiones traducidas."
  >
    <Fragment slot="content">
      <!-- Page Header & Stats Summary -->
      <AdminPageHeader
        title={copy.adminCategories}
        count={categories.length}
        countLabel="taxonomías"
        lead="Organiza la estructura temática, colores de marca y jerarquía del contenido editorial."
      >
        {canCreate ? (
          <Fragment slot="actions">
            <label
              for="category-drawer"
              class="drawer-button btn btn-primary btn-sm gap-2 shadow-sm hover:scale-[1.02] transition-transform cursor-pointer"
            >
              <svg class="size-4"><use href="#ic-plus"></use></svg>
              <span>{copy.adminNewCategory}</span>
            </label>
          </Fragment>
        ) : null}
      </AdminPageHeader>

      <!-- Filter & Search Toolbar -->
      <AdminToolbar searchId="categories-search" searchPlaceholder="Buscar categorías por nombre o slug..." />

      <!-- Categories Table -->
      <AdminTable
        id="categories-table"
        columns={[{ label: copy.adminCategoryTitle || "Categoría", class: "py-4 pl-6" }, { label: copy.adminCategorySlug || "Slug URL" }, { label: "Artículos" }, { label: "Acciones", class: "text-right pr-6" }]}
      >
        {categories.length === 0 ? (
          <Fragment slot="empty">
            <tr>
              <td colspan="4" class="text-center py-12 text-base-content/60">
                <div class="flex flex-col items-center gap-2">
                  <div class="size-12 rounded-2xl bg-base-200 flex items-center justify-center text-base-content/40">
                    <svg class="size-6"><use href="#ic-stack"></use></svg>
                  </div>
                  <span class="font-bold text-base">No hay categorías registradas</span>
                  <span class="text-xs text-base-content/50">Crea la primera categoría para organizar tus artículos</span>
                </div>
              </td>
            </tr>
          </Fragment>
        ) : (
          <Fragment slot="rows">
            {categories.map((category) => {
              const theme = getCategoryTheme(category.slug);
              const editUrl = `${Astro.url.pathname.replace(/\/$/, "")}/${category.id}`;

              return (
                <tr class="hover:bg-base-200/50 transition-colors category-row" data-name={(category.title ?? "").toLowerCase()} data-slug={(category.slug ?? "").toLowerCase()}>
                  <td class="py-3.5 pl-6">
                    <div class="flex items-center gap-2.5">
                      <span class:list={["size-2.5 rounded-full", theme.dotClass]}></span>
                      <span class="font-bold text-base-content text-base">{category.title ?? "—"}</span>
                    </div>
                  </td>
                  <td>
                    <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-200 border border-base-300 text-base-content/70">
                      /{category.slug}
                    </span>
                  </td>
                  <td>
                    <span class="badge badge-sm badge-neutral font-mono">{category.article_count ?? 0}</span>
                  </td>
                  <td class="text-right pr-6">
                    <div class="inline-flex items-center gap-1.5">
                      {canUpdate ? (
                        <a class="btn btn-primary btn-sm btn-outline text-xs font-bold h-7 min-h-0 px-3" href={editUrl} title={copy.adminEdit}>
                          <svg class="size-3.5"><use href="#ic-edit"></use></svg>
                          <span>{copy.adminEdit || "Editar"}</span>
                        </a>
                      ) : null}
                      {canDelete ? (
                        <button
                          class="btn btn-square btn-ghost btn-xs border border-base-300 hover:bg-error/10 hover:text-error"
                          type="button"
                          data-delete-id={category.id}
                          data-name={category.title ?? category.slug}
                          data-confirm={copy.adminDeleteConfirm}
                          data-success={copy.adminEditorialDeleted}
                          data-title={copy.adminDeleteTitle}
                          data-accept={copy.adminDeleteAccept}
                          data-cancel={copy.adminDeleteCancel}
                          title={copy.adminRemove}
                        >
                          <svg class="size-3.5"><use href="#ic-trash"></use></svg>
                        </button>
                      ) : null}
                    </div>
                  </td>
                </tr>
              );
            })}
          </Fragment>
        )}
      </AdminTable>
    </Fragment>

    <CategoryEditor
      languages={languages}
      translation={translation}
      locale={locale}
      copy={copy}
      layoutMode="drawer"
    />
  </AdminDrawerPanel>

  <dialog id="admin-delete-dialog" class="modal">
    <div class="modal-box max-w-[480px] rounded-3xl p-6">
      <h3 class="font-display text-xl font-bold text-base-content" data-delete-title></h3>
      <p class="mt-3 text-sm text-base-content/80" data-delete-message></p>
      <div class="modal-action">
        <form method="dialog" class="contents">
          <button class="btn btn-ghost btn-sm" type="submit" data-delete-cancel></button>
        </form>
        <button class="btn btn-error btn-sm" type="button" data-delete-confirm></button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="submit">close</button></form>
  </dialog>
</AdminLayout>

<script is:inline>
  (function () {
    var bindCategories = function () {
      var drawerToggle = document.getElementById("category-drawer");

      if (drawerToggle && drawerToggle.dataset.boundScroll !== "true") {
        drawerToggle.dataset.boundScroll = "true";
        drawerToggle.addEventListener("change", function () {
          if (drawerToggle.checked) {
            document.body.style.overflow = "hidden";
            var firstInput = document.querySelector(".drawer-side input:not([disabled])");
            if (firstInput) setTimeout(function () { firstInput.focus(); }, 150);
          } else {
            document.body.style.overflow = "";
          }
        });

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && drawerToggle.checked) {
            drawerToggle.checked = false;
            document.body.style.overflow = "";
          }
        });
      }

      // Live search filter
      var searchInput = document.getElementById("categories-search");
      var rows = document.querySelectorAll(".category-row");

      if (searchInput && searchInput.dataset.bound !== "true") {
        searchInput.dataset.bound = "true";
        searchInput.addEventListener("input", function () {
          var query = searchInput.value.trim().toLowerCase();
          rows.forEach(function (row) {
            var name = row.getAttribute("data-name") || "";
            var slug = row.getAttribute("data-slug") || "";
            if (!query || name.indexOf(query) !== -1 || slug.indexOf(query) !== -1) {
              row.style.display = "";
            } else {
              row.style.display = "none";
            }
          });
        });
      }

      // Editorial Form Submit
      var forms = document.querySelectorAll("form[data-editorial-form]");
      forms.forEach(function (form) {
        if (form.dataset.bound === "true") return;
        form.dataset.bound = "true";
        form.addEventListener("submit", function (event) {
          event.preventDefault();
          var btn = form.querySelector("button[type='submit']");
          if (btn) btn.disabled = true;

          var data = new FormData(form);
          fetch(form.action, { method: "POST", body: data })
            .then(function (res) {
              return res.json().then(function (body) { return { ok: res.ok, body: body }; });
            })
            .then(function (result) {
              if (result.ok) {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast(form.getAttribute("data-success") || "Guardado.", "success");
                if (drawerToggle) drawerToggle.checked = false;
                document.body.style.overflow = "";
                setTimeout(function () { window.location.reload(); }, 600);
                return;
              }
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast(result.body && result.body.error ? result.body.error : form.getAttribute("data-error") || "Error al guardar.", "error");
              if (btn) btn.disabled = false;
            })
            .catch(function () {
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error de red.", "error");
              if (btn) btn.disabled = false;
            });
        });
      });

      // Delete confirmation
      var deleteDialog = document.getElementById("admin-delete-dialog");
      var titleEl = deleteDialog ? deleteDialog.querySelector("[data-delete-title]") : null;
      var msgEl = deleteDialog ? deleteDialog.querySelector("[data-delete-message]") : null;
      var acceptBtn = deleteDialog ? deleteDialog.querySelector("[data-delete-confirm]") : null;
      var cancelBtnDialog = deleteDialog ? deleteDialog.querySelector("[data-delete-cancel]") : null;
      var pendingId = null;

      document.querySelectorAll("[data-delete-id]").forEach(function (btn) {
        if (btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";
        btn.addEventListener("click", function () {
          pendingId = btn.getAttribute("data-delete-id");
          var name = btn.getAttribute("data-name") || "";
          var title = btn.getAttribute("data-title") || "Eliminar";
          var confirmMsg = btn.getAttribute("data-confirm") || "¿Eliminar elemento?";
          var accept = btn.getAttribute("data-accept") || "Eliminar";
          var cancel = btn.getAttribute("data-cancel") || "Cancelar";

          if (titleEl) titleEl.textContent = title;
          if (msgEl) msgEl.textContent = confirmMsg.replace("{name}", name);
          if (acceptBtn) acceptBtn.textContent = accept;
          if (cancelBtnDialog) cancelBtnDialog.textContent = cancel;

          if (deleteDialog && typeof deleteDialog.showModal === "function") {
            deleteDialog.showModal();
          }
        });
      });

      if (acceptBtn && acceptBtn.dataset.bound !== "true") {
        acceptBtn.dataset.bound = "true";
        acceptBtn.addEventListener("click", function () {
          if (!pendingId) return;
          acceptBtn.disabled = true;

          var data = new FormData();
          data.append("id", pendingId);
          data.append("_intent", "delete");

          fetch("/api/admin/categories", { method: "POST", body: data })
            .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
            .then(function (result) {
              if (result.ok) {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Categoría eliminada.", "success");
                setTimeout(function () { window.location.reload(); }, 600);
                return;
              }
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast(result.body && result.body.error ? result.body.error : "No se pudo eliminar.", "error");
              acceptBtn.disabled = false;
              if (deleteDialog) deleteDialog.close();
            })
            .catch(function () {
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error de red.", "error");
              acceptBtn.disabled = false;
              if (deleteDialog) deleteDialog.close();
            });
        });
      }
    };

    bindCategories();
    document.addEventListener("astro:page-load", bindCategories);
    document.addEventListener("astro:before-swap", function () {
      document.body.style.overflow = "";
    });
  })();
</script>
