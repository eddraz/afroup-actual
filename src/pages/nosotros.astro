---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";
import { loadAboutPageLocale } from "../lib/about";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const donateHref = localizedPath(locale, routeIds.donate);
const collaborateHref = localizedPath(locale, routeIds.collaborate);

const aboutData = await loadAboutPageLocale(env.DB, locale);
---

<BaseLayout title={aboutData.og?.title || copy.titleAbout} description={aboutData.og?.description}>
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li>{copy.footerAbout}</li>
    </ul>
  </div>

  <section class="hero relative mt-6 overflow-hidden rounded-[24px] bg-primary text-primary-content shadow-lg">
    <div class="absolute inset-y-0 right-0 w-[200px] bg-[url('/assets/pattern.png')] bg-cover bg-center max-md:w-[90px]"></div>
    <div class="hero-content relative w-full flex-col items-start gap-3 px-6 py-8 lg:px-11 lg:py-11">
      <p class="text-accent text-xs font-extrabold tracking-[0.18em] uppercase">{aboutData.eyebrow}</p>
      <h1 class="font-display max-w-[18ch] text-[31px] font-bold lg:text-[44px]">{aboutData.title}</h1>
      <p class="max-w-[56ch] text-[17px] leading-[1.55] text-primary-content/80">{aboutData.lead}</p>
    </div>
  </section>

  <div class="mt-[30px] grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
    <section>
      <h2 class="font-display text-[26px] font-bold">{aboutData.story_title}</h2>
      <p class="mt-3 text-[15.5px] leading-[1.7] opacity-80 whitespace-pre-line">
        {aboutData.story_body}
      </p>
      {aboutData.values && aboutData.values.length > 0 ? (
        <div class="mt-[18px] flex flex-wrap gap-2">
          {aboutData.values.map((chip) => <span class="badge badge-ghost font-medium">{chip}</span>)}
        </div>
      ) : null}
    </section>
    <div class="grid grid-cols-1 gap-4">
      <article class="card bg-base-200 shadow">
        <div class="card-body">
          <h3 class="card-title font-display">{aboutData.mission_title}</h3>
          <p class="text-[14.5px] leading-[1.6] opacity-70">{aboutData.mission_body}</p>
        </div>
      </article>
      <article class="card bg-base-200 shadow">
        <div class="card-body">
          <h3 class="card-title font-display">{aboutData.vision_title}</h3>
          <p class="text-[14.5px] leading-[1.6] opacity-70">{aboutData.vision_body}</p>
        </div>
      </article>
    </div>
  </div>

  {aboutData.stats && aboutData.stats.length > 0 ? (
    <div class="stats stats-vertical mt-[30px] w-full bg-base-200 shadow lg:stats-horizontal">
      {aboutData.stats.map((stat, idx) => {
        const colorClass = idx === 0 ? "text-primary" : idx === 1 ? "text-accent" : "text-secondary";
        return (
          <div class="stat">
            <div class:list={["stat-value font-mono", colorClass]}>{stat.value}</div>
            <div class="stat-desc text-sm opacity-70">{stat.label}</div>
          </div>
        );
      })}
    </div>
  ) : null}

  <h2 class="font-display mt-10 mb-5 text-[26px] font-bold">{copy.aboutTeamTitle || "Equipo y colaboradores"}</h2>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      aboutData.team.map((person, idx) => {
        const fallbackFigure = idx === 0 ? "bg-secondary/30" : idx === 1 ? "bg-accent/30" : idx === 2 ? "bg-primary/20" : "bg-[url('/assets/pattern.png')] bg-cover bg-center";
        return (
          <article class="card bg-base-200 shadow overflow-hidden">
            {person.avatar_url ? (
              <figure class="aspect-[4/3] bg-base-300">
                <img src={person.avatar_url} alt={person.name} class="w-full h-full object-cover" />
              </figure>
            ) : (
              <figure class:list={["aspect-[4/3]", person.figure || fallbackFigure]}></figure>
            )}
            <div class="card-body">
              <h3 class="card-title font-display">{person.name}</h3>
              <p class="text-sm opacity-60">{person.role}</p>
            </div>
          </article>
        );
      })
    }
  </div>

  <section class="mt-10 rounded-[24px] bg-neutral text-neutral-content p-6 sm:p-8 md:p-9 shadow-lg flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="flex-1 min-w-0 pr-0 md:pr-4 space-y-1">
      <h3 class="font-display text-xl sm:text-2xl font-bold text-neutral-content">{aboutData.cta_title}</h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-neutral-content/75">{aboutData.cta_body}</p>
    </div>
    <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 shrink-0">
      <a
        class="btn btn-accent rounded-full font-bold px-6 py-2.5 text-sm text-[#063b42] border-0 hover:scale-[1.02] transition-transform shadow-xs"
        href={collaborateHref}
      >
        {aboutData.collaborate_label || copy.aboutCollaborate}
      </a>
      <a
        class="btn btn-secondary rounded-full font-bold px-6 py-2.5 text-sm text-[#5a4406] border-0 gap-2 hover:scale-[1.02] transition-transform shadow-xs"
        href={donateHref}
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <use href="#ic-heart"></use>
        </svg>
        <span>{aboutData.donate_label || copy.aboutDonate}</span>
      </a>
    </div>
  </section>
</BaseLayout>
