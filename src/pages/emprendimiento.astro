---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";

export const prerender = true;

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const homeHref = localizedPath(locale, routeIds.home);
const entrepreneursHref = localizedPath(locale, routeIds.entrepreneurs);
const entrepreneurHref = localizedPath(locale, routeIds.entrepreneur);
const facts = [
  { label: copy.entrepreneurField, value: "Moda · textiles" },
  { label: copy.entrepreneurTeam, value: "12 artesanas" },
  { label: copy.entrepreneurShip, value: "Toda Colombia" },
  { label: copy.entrepreneurContact, value: "hola@tejidosubuntu.co" },
] as const;
const more = [
  { figure: "bg-accent/30", label: "foto · cocina", title: "Sabores del Manglar", meta: "Alimentos · Cali" },
  { figure: "bg-primary/20", label: "foto · cosmética", title: "Crespa & Libre", meta: "Belleza · Bogotá" },
  { figure: "bg-secondary/30", label: "foto · joyería", title: "Oro Negro Joyas", meta: "Arte · Quibdó" },
] as const;
---

<BaseLayout title={copy.titleEntrepreneur} active="comunidad">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a href={homeHref}>{copy.navHome}</a></li>
      <li><a href={entrepreneursHref}>{copy.footerEntrepreneurs}</a></li>
      <li>Tejidos Ubuntu</li>
    </ul>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-5">
    <div class="size-[108px] shrink-0 rounded-[24px] bg-[url('/assets/pattern.png')] bg-cover bg-center shadow"></div>
    <div class="min-w-0 grow">
      <span class="inline-flex items-center gap-2 text-[11.5px] font-extrabold tracking-[0.1em] text-secondary uppercase">
        <span class="size-2.5 rounded-[3px] bg-secondary"></span>
        Moda · Hecho a mano
      </span>
      <h1 class="font-display mt-1 text-[32px] font-bold lg:text-[38px]">Tejidos Ubuntu</h1>
      <p class="mt-1 flex items-center gap-1.5 text-sm font-bold opacity-60">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <use href="#ic-pin"></use>
        </svg>
        Buenaventura, Colombia · desde 2022
      </p>
    </div>
    <a class="btn btn-primary" href="#">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <use href="#ic-ig"></use>
      </svg>
      @tejidosubuntu
    </a>
  </div>

  <div class="mt-7 grid grid-cols-1 items-start gap-8 lg:grid-cols-[1fr_340px]">
    <section>
      <h2 class="font-display text-2xl font-bold">{copy.entrepreneurStory}</h2>
      <p class="mt-3 text-[15.5px] leading-[1.7] opacity-80">
        Un taller de doce mujeres de Buenaventura que transforma telas de estampa africana en moda contemporánea. Cada prenda lleva el nombre de la artesana que la confeccionó, y parte de las ganancias financia un fondo de becas para jóvenes del barrio.
      </p>
      <blockquote class="border-secondary font-display mt-6 border-l-4 pl-5 text-[22px] leading-[1.25] font-bold">
        “Ubuntu: soy porque somos. Cosemos comunidad.”
      </blockquote>
      <div class="mt-4 grid grid-cols-3 gap-3">
        <div class="relative aspect-square overflow-hidden rounded-box bg-secondary/30">
          <span class="badge badge-sm absolute bottom-2 left-2">producto</span>
        </div>
        <div class="relative aspect-square overflow-hidden rounded-box bg-accent/30">
          <span class="badge badge-sm absolute bottom-2 left-2">taller</span>
        </div>
        <div class="relative aspect-square overflow-hidden rounded-box bg-primary/20">
          <span class="badge badge-sm absolute bottom-2 left-2">equipo</span>
        </div>
      </div>
    </section>

    <aside class="card bg-base-200 lg:sticky lg:top-[90px] shadow">
      <div class="card-body">
        <h2 class="card-title">{copy.entrepreneurFacts}</h2>
        <ul class="list">
          {
            facts.map((fact) => (
              <li class="list-row">
                <span class="opacity-60">{fact.label}</span>
                <span class="list-col-grow text-right font-bold">{fact.value}</span>
              </li>
            ))
          }
        </ul>
        <div class="card-actions">
          <a class="btn btn-secondary btn-block" href="#">
            {copy.entrepreneurVisit}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <use href="#ic-arrow"></use>
            </svg>
          </a>
        </div>
      </div>
    </aside>
  </div>

  <div class="mt-10 mb-5 flex items-end justify-between gap-4">
    <h2 class="font-display text-[26px] font-bold">{copy.entrepreneurMore}</h2>
    <a class="btn btn-ghost btn-sm" href={entrepreneursHref}>
      {copy.entrepreneurSeeAll}
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <use href="#ic-arrow"></use>
      </svg>
    </a>
  </div>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      more.map((item) => (
        <a class="card bg-base-200 shadow" href={entrepreneurHref}>
          <figure class:list={["relative aspect-[16/10]", item.figure]}>
            {item.label ? <span class="badge badge-sm absolute bottom-3 left-3">{item.label}</span> : null}
          </figure>
          <div class="card-body">
            <h3 class="card-title font-display">{item.title}</h3>
            <p class="text-sm opacity-60">{item.meta}</p>
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
