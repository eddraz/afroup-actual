---
import { KNOWN_BUCKETS } from "../lib/r2-storage";

interface Props {
  bucket?: string;
  allowedTypes?: string;
  prefix?: string;
  showBucketSelector?: boolean;
  allowOptimization?: boolean;
  targetInputId?: string;
  componentId?: string;
  locale?: string;
  flat?: boolean;
}

const {
  bucket = "media",
  allowedTypes = "*/*",
  prefix = "",
  showBucketSelector = true,
  allowOptimization = true,
  targetInputId = "",
  componentId = "r2-uploader-" + Math.random().toString(36).slice(2, 8),
  locale = "es",
  flat = false,
} = Astro.props;

const isEn = locale.startsWith("en");

const text = {
  dragLead: isEn ? "Drag & drop files here, or click to browse" : "Arrastra y suelta tus archivos aquí, o haz clic para explorar",
  pasteHint: isEn ? "Accepts single or multiple files · You can also paste directly (Ctrl+V / Cmd+V)" : "Acepta uno o múltiples archivos · También puedes pegar directamente con Ctrl+V / Cmd+V",
  urlDivider: isEn ? "OR PASTE AN IMAGE / FILE URL" : "O PEGA AQUÍ LA URL DE UNA IMAGEN O ARCHIVO",
  urlPlaceholder: isEn ? "https://example.com/image.jpg" : "https://ejemplo.com/imagen.jpg",
  fetchUrlBtn: isEn ? "Add from URL" : "Cargar URL",
  bucketLabel: isEn ? "Destination Bucket" : "Bucket de Destino",
  prefixLabel: isEn ? "Folder / Prefix (Optional)" : "Carpeta / Prefijo (Opcional)",
  prefixPlaceholder: isEn ? "e.g. covers/2026" : "ej. portadas/2026",
  optTitle: isEn ? "Image Optimization & Scaling" : "Optimización y Escalado",
  optSubtitle: isEn ? "Reduce file size maintaining high quality" : "Reduce el peso manteniendo alta calidad visual",
  optToggle: isEn ? "Optimize image" : "Optimizar imagen",
  optFormat: isEn ? "Format" : "Formato",
  optQuality: isEn ? "Quality" : "Calidad",
  optDimensions: isEn ? "Dimensions (Max: original)" : "Dimensiones (Máximo: original)",
  optWidth: isEn ? "Width" : "Ancho",
  optHeight: isEn ? "Height" : "Alto",
  optLockAspect: isEn ? "Keep aspect ratio" : "Mantener proporción",
  btnUpload: isEn ? "Upload to R2" : "Guardar en R2",
  btnUploading: isEn ? "Uploading..." : "Subiendo a R2...",
  uploadSuccess: isEn ? "Files uploaded successfully to R2!" : "¡Archivos subidos con éxito a R2!",
  btnCopyUrl: isEn ? "Copy Link" : "Copiar Enlace",
  btnUploadAnother: isEn ? "Upload More Files" : "Subir Más Archivos",
  stagedFilesTitle: isEn ? "Files to upload" : "Archivos a subir",
  addMoreBtn: isEn ? "+ Add more files" : "+ Agregar más archivos",
  clearAll: isEn ? "Clear all" : "Limpiar lista",
};
---

<div
  class={`r2-uploader-root space-y-5 ${flat ? "" : "rounded-3xl border border-base-300 bg-base-100 p-5 sm:p-6 shadow-xs"}`}
  id={componentId}
  data-bucket={bucket}
  data-allowed-types={allowedTypes}
  data-default-prefix={prefix}
  data-allow-opt={allowOptimization ? "true" : "false"}
  data-target-input={targetInputId}
>
  <!-- Stage 1: File Ingestion (Dropzone + Inline Paste + URL Input in one unified view) -->
  <div class="stage-ingestion space-y-4" id={`${componentId}-stage-ingest`}>
    <div
      class="dropzone-area border-2 border-dashed border-base-300 rounded-3xl p-6 sm:p-8 text-center hover:border-primary/80 transition-all bg-base-200/30 flex flex-col items-center justify-center gap-3 cursor-pointer group relative overflow-hidden"
      id={`${componentId}-dropzone`}
      tabindex="0"
    >
      <div class="size-12 rounded-2xl bg-base-200 group-hover:bg-primary/10 group-hover:text-primary transition-colors flex items-center justify-center text-base-content/50 pointer-events-none">
        <svg class="size-6"><use href="#ic-cloud"></use></svg>
      </div>
      <div class="pointer-events-none">
        <p class="text-sm font-bold text-base-content group-hover:text-primary transition-colors">
          {text.dragLead}
        </p>
        <p class="text-xs text-base-content/50 mt-1 max-w-md mx-auto">
          {text.pasteHint}
        </p>
      </div>
      <input
        type="file"
        class="hidden file-input-element"
        accept={allowedTypes}
        multiple
        id={`${componentId}-file-input`}
      />

      <!-- Embedded URL Import Input -->
      <div class="w-full max-w-md pt-2" onclick="event.stopPropagation()">
        <div class="divider text-[10px] font-bold tracking-wider text-base-content/40 uppercase my-1">
          {text.urlDivider}
        </div>
        <div class="join w-full shadow-xs">
          <input
            type="url"
            class="input input-bordered input-sm join-item w-full font-mono text-xs bg-base-100"
            placeholder={text.urlPlaceholder}
            id={`${componentId}-url-input`}
          />
          <button
            type="button"
            class="btn btn-sm btn-primary join-item font-bold"
            id={`${componentId}-btn-fetch-url`}
          >
            <svg class="size-3.5"><use href="#ic-world"></use></svg>
            <span>{text.fetchUrlBtn}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Stage 2: Staged Files Queue & Per-Item Optimization Controls -->
  <div class="stage-queue hidden space-y-4" id={`${componentId}-stage-queue`}>
    <div class="flex items-center justify-between border-b border-base-300 pb-2.5">
      <div class="flex items-center gap-2">
        <span class="size-2 rounded-full bg-primary animate-pulse"></span>
        <h4 class="font-display font-bold text-sm text-base-content">
          {text.stagedFilesTitle} (<span id={`${componentId}-queue-count`}>0</span>)
        </h4>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" class="btn btn-ghost btn-xs text-primary font-bold" id={`${componentId}-btn-add-more`}>
          {text.addMoreBtn}
        </button>
        <button type="button" class="btn btn-ghost btn-xs text-error font-semibold" id={`${componentId}-btn-clear-all`}>
          {text.clearAll}
        </button>
      </div>
    </div>

    <!-- Items Container List -->
    <div class="space-y-3 max-h-[50vh] overflow-y-auto pr-1" id={`${componentId}-queue-list`}>
      <!-- Dynamically generated item cards -->
    </div>

    <!-- Overall Destination & Prefix Settings -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3 border-t border-base-300">
      {showBucketSelector ? (
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{text.bucketLabel}</legend>
          <select class="select select-bordered select-sm w-full font-semibold" id={`${componentId}-dest-bucket`}>
            {KNOWN_BUCKETS.map((b) => (
              <option value={b.id} selected={b.id === bucket}>
                {b.label} ({b.bucketName})
              </option>
            ))}
          </select>
        </fieldset>
      ) : (
        <input type="hidden" id={`${componentId}-dest-bucket`} value={bucket} />
      )}

      <fieldset class="fieldset">
        <legend class="fieldset-legend font-bold text-xs uppercase text-base-content/70">{text.prefixLabel}</legend>
        <input
          class="input input-bordered input-sm w-full font-mono text-xs"
          placeholder={text.prefixPlaceholder}
          value={prefix}
          id={`${componentId}-dest-prefix`}
        />
      </fieldset>
    </div>

    <!-- Progress Bar (Visible during upload) -->
    <div class="hidden space-y-2 p-4 rounded-2xl bg-base-200 border border-base-300" id={`${componentId}-upload-progress-container`}>
      <div class="flex items-center justify-between text-xs font-bold">
        <span id={`${componentId}-progress-label`}>{text.btnUploading}</span>
        <span class="font-mono text-primary" id={`${componentId}-progress-percent`}>0%</span>
      </div>
      <progress class="progress progress-primary w-full" value="0" max="100" id={`${componentId}-progress-bar`}></progress>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center justify-between pt-3 border-t border-base-300">
      <button type="button" class="btn btn-ghost btn-sm" id={`${componentId}-btn-cancel`}>
        Cancelar
      </button>
      <button type="button" class="btn btn-primary btn-sm px-6 font-bold gap-2" id={`${componentId}-btn-upload-all`}>
        <svg class="size-4"><use href="#ic-cloud"></use></svg>
        <span id={`${componentId}-btn-upload-label`}>{text.btnUpload}</span>
      </button>
    </div>
  </div>

  <!-- Stage 3: Success Results List -->
  <div class="stage-success hidden rounded-3xl border border-success/30 bg-success/5 p-5 space-y-4" id={`${componentId}-stage-success`}>
    <div class="flex items-center gap-3">
      <div class="size-10 rounded-xl bg-success text-success-content flex items-center justify-center shrink-0 shadow-xs">
        <svg class="size-5"><use href="#ic-shield"></use></svg>
      </div>
      <div>
        <h4 class="font-display font-bold text-base text-base-content">{text.uploadSuccess}</h4>
        <p class="text-xs text-base-content/60" id={`${componentId}-success-summary`}>Todos los archivos han sido guardados.</p>
      </div>
    </div>

    <div class="space-y-2 max-h-48 overflow-y-auto" id={`${componentId}-success-links-list`}>
      <!-- Filled dynamically with uploaded links -->
    </div>

    <div class="pt-2 flex justify-end">
      <button type="button" class="btn btn-outline btn-sm font-bold" id={`${componentId}-btn-reset`}>
        {text.btnUploadAnother}
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ componentId, allowedTypes, allowOptimization, isEn }}>
  (function () {
    var bind = function () {
      var root = document.getElementById(componentId);
      if (!root || root.dataset.boundInit === "true") return;
      root.dataset.boundInit = "true";

      var dropzone = document.getElementById(componentId + "-dropzone");
      var fileInput = document.getElementById(componentId + "-file-input");
      var urlInput = document.getElementById(componentId + "-url-input");
      var btnFetchUrl = document.getElementById(componentId + "-btn-fetch-url");

      var stageIngest = document.getElementById(componentId + "-stage-ingest");
      var stageQueue = document.getElementById(componentId + "-stage-queue");
      var stageSuccess = document.getElementById(componentId + "-stage-success");

      var queueCount = document.getElementById(componentId + "-queue-count");
      var queueList = document.getElementById(componentId + "-queue-list");
      var btnAddMore = document.getElementById(componentId + "-btn-add-more");
      var btnClearAll = document.getElementById(componentId + "-btn-clear-all");
      var btnCancel = document.getElementById(componentId + "-btn-cancel");
      var btnUploadAll = document.getElementById(componentId + "-btn-upload-all");
      var btnUploadLabel = document.getElementById(componentId + "-btn-upload-label");

      var destBucket = document.getElementById(componentId + "-dest-bucket");
      var destPrefix = document.getElementById(componentId + "-dest-prefix");

      var progressContainer = document.getElementById(componentId + "-upload-progress-container");
      var progressBar = document.getElementById(componentId + "-progress-bar");
      var progressPercent = document.getElementById(componentId + "-progress-percent");
      var progressLabel = document.getElementById(componentId + "-progress-label");

      var successSummary = document.getElementById(componentId + "-success-summary");
      var successLinksList = document.getElementById(componentId + "-success-links-list");
      var btnReset = document.getElementById(componentId + "-btn-reset");

      // Staged Items Array: { id, file, originalSize, isImage, imgBitmap, origW, origH, optEnabled, format, quality, width, height, lockAspect, status, resultUrl }
      var stagedItems = [];

      var formatBytes = function (bytes) {
        if (!bytes || bytes <= 0) return "0 B";
        var k = 1024;
        var sizes = ["B", "KB", "MB", "GB"];
        var i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
      };

      // Add Files to Queue
      var addFilesToQueue = function (files) {
        if (!files || files.length === 0) return;

        var remaining = files.length;
        Array.from(files).forEach(function (file) {
          var id = "item-" + Math.random().toString(36).slice(2, 9);
          var isImage = file.type.indexOf("image/") === 0;

          var item = {
            id: id,
            file: file,
            originalSize: file.size,
            isImage: isImage,
            imgBitmap: null,
            origW: 0,
            origH: 0,
            optEnabled: isImage,
            format: "webp",
            quality: 85,
            width: 0,
            height: 0,
            lockAspect: true,
            status: "pending",
            resultUrl: null,
          };

          stagedItems.push(item);

          if (isImage) {
            var reader = new FileReader();
            reader.onload = function (e) {
              var img = new Image();
              img.onload = function () {
                item.imgBitmap = img;
                item.origW = img.naturalWidth || img.width;
                item.origH = img.naturalHeight || img.height;
                item.width = item.origW;
                item.height = item.origH;
                item.dataUrl = e.target.result;
                renderQueue();
              };
              img.src = e.target.result;
            };
            reader.readAsDataURL(file);
          } else {
            renderQueue();
          }
        });
      };

      // Drag & Drop
      dropzone.addEventListener("click", function () {
        if (fileInput) fileInput.click();
      });

      if (btnAddMore) {
        btnAddMore.addEventListener("click", function () {
          if (fileInput) fileInput.click();
        });
      }

      ["dragenter", "dragover"].forEach(function (eventName) {
        dropzone.addEventListener(eventName, function (e) {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add("border-primary", "bg-primary/5");
        });
      });

      ["dragleave", "drop"].forEach(function (eventName) {
        dropzone.addEventListener(eventName, function (e) {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove("border-primary", "bg-primary/5");
        });
      });

      dropzone.addEventListener("drop", function (e) {
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
          addFilesToQueue(e.dataTransfer.files);
        }
      });

      if (fileInput) {
        fileInput.addEventListener("change", function () {
          if (fileInput.files && fileInput.files.length > 0) {
            addFilesToQueue(fileInput.files);
            fileInput.value = "";
          }
        });
      }

      // Clipboard Paste Listener (Captures anywhere on the page or when component has focus)
      window.addEventListener("paste", function (e) {
        if (!e.clipboardData) return;
        var items = e.clipboardData.items;
        if (!items) return;

        var foundImage = false;
        for (var i = 0; i < items.length; i++) {
          if (items[i].type.indexOf("image") !== -1) {
            var blob = items[i].getAsFile();
            if (blob) {
              foundImage = true;
              addFilesToQueue([blob]);
            }
          }
        }

        if (!foundImage) {
          var textPasted = e.clipboardData.getData("text");
          if (textPasted && (textPasted.startsWith("http://") || textPasted.startsWith("https://"))) {
            if (textPasted.match(/\.(jpeg|jpg|png|webp|gif|svg|pdf)$/i) || textPasted.indexOf("image") !== -1) {
              fetchUrlItem(textPasted);
            }
          }
        }
      });

      // URL Ingestion Handler
      var fetchUrlItem = function (srcUrl) {
        if (!srcUrl) return;
        if (btnFetchUrl) {
          btnFetchUrl.disabled = true;
          btnFetchUrl.textContent = isEn ? "Fetching..." : "Cargando...";
        }

        var formData = new FormData();
        formData.append("_intent", "fetch_url");
        formData.append("sourceUrl", srcUrl);

        fetch("/api/admin/r2", { method: "POST", body: formData })
          .then(function (res) { return res.json(); })
          .then(function (result) {
            if (result.ok && result.dataUrl) {
              fetch(result.dataUrl)
                .then(function (r) { return r.blob(); })
                .then(function (blob) {
                  var file = new File([blob], result.fileName || "downloaded-image.webp", { type: result.contentType });
                  addFilesToQueue([file]);
                  if (urlInput) urlInput.value = "";
                });
            } else {
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast(isEn ? "Could not load URL." : "No se pudo cargar la imagen desde la URL.", "error");
            }
          })
          .catch(function () {
            if (window.AfroUpFeedback) window.AfroUpFeedback.toast(isEn ? "Network error fetching URL." : "Error de red al cargar la URL.", "error");
          })
          .finally(function () {
            if (btnFetchUrl) {
              btnFetchUrl.disabled = false;
              btnFetchUrl.textContent = isEn ? "Add from URL" : "Cargar URL";
            }
          });
      };

      if (btnFetchUrl && urlInput) {
        btnFetchUrl.addEventListener("click", function (e) {
          e.stopPropagation();
          fetchUrlItem(urlInput.value.trim());
        });
      }

      // Render Queue UI
      var renderQueue = function () {
        if (stagedItems.length === 0) {
          stageIngest.classList.remove("hidden");
          stageQueue.classList.add("hidden");
          stageSuccess.classList.add("hidden");
          return;
        }

        stageIngest.classList.add("hidden");
        stageQueue.classList.remove("hidden");
        stageSuccess.classList.add("hidden");

        if (queueCount) queueCount.textContent = stagedItems.length;
        if (btnUploadLabel) {
          btnUploadLabel.textContent = (isEn ? "Upload " : "Guardar ") + stagedItems.length + (isEn ? " Files to R2" : " Archivos en R2");
        }

        if (!queueList) return;
        queueList.innerHTML = "";

        stagedItems.forEach(function (item, index) {
          var card = document.createElement("div");
          card.className = "rounded-2xl border border-base-300 bg-base-200/30 p-3.5 space-y-3 transition-all";
          card.id = "card-" + item.id;

          // Header line (Thumbnail, name, size, delete button)
          var topRow = document.createElement("div");
          topRow.className = "flex items-center justify-between gap-3";

          var leftInfo = document.createElement("div");
          leftInfo.className = "flex items-center gap-3 min-w-0";

          var thumb = document.createElement("div");
          thumb.className = "size-11 rounded-xl bg-base-300/60 border border-base-300 shrink-0 overflow-hidden flex items-center justify-center";
          if (item.isImage && item.dataUrl) {
            var imgTag = document.createElement("img");
            imgTag.src = item.dataUrl;
            imgTag.className = "size-full object-cover";
            thumb.appendChild(imgTag);
          } else {
            thumb.innerHTML = '<svg class="size-5 text-base-content/40"><use href="#ic-stack"></use></svg>';
          }
          leftInfo.appendChild(thumb);

          var details = document.createElement("div");
          details.className = "min-w-0";
          var nameSpan = document.createElement("span");
          nameSpan.className = "font-bold text-xs text-base-content block truncate max-w-[200px] sm:max-w-xs";
          nameSpan.textContent = item.file.name;
          details.appendChild(nameSpan);

          var metaSpan = document.createElement("div");
          metaSpan.className = "flex items-center gap-1.5 font-mono text-[11px] text-base-content/60 mt-0.5";
          metaSpan.innerHTML = '<span class="badge badge-neutral badge-xs font-bold">' + formatBytes(item.originalSize) + '</span>' +
            (item.origW ? '<span class="badge badge-primary badge-xs font-bold">' + item.origW + '×' + item.origH + '</span>' : '');
          details.appendChild(metaSpan);
          leftInfo.appendChild(details);
          topRow.appendChild(leftInfo);

          var rightActions = document.createElement("div");
          rightActions.className = "flex items-center gap-2 shrink-0";

          // Status Badge
          var statusBadge = document.createElement("span");
          statusBadge.className = "badge badge-xs font-bold";
          if (item.status === "pending") {
            statusBadge.classList.add("badge-ghost");
            statusBadge.textContent = "Pendiente";
          } else if (item.status === "optimizing") {
            statusBadge.classList.add("badge-warning");
            statusBadge.textContent = "Optimizando...";
          } else if (item.status === "uploading") {
            statusBadge.classList.add("badge-primary");
            statusBadge.textContent = "Subiendo...";
          } else if (item.status === "done") {
            statusBadge.classList.add("badge-success");
            statusBadge.textContent = "Listo ✓";
          }
          rightActions.appendChild(statusBadge);

          // Remove button
          var btnRemove = document.createElement("button");
          btnRemove.type = "button";
          btnRemove.className = "btn btn-ghost btn-circle btn-xs text-base-content/40 hover:text-error";
          btnRemove.innerHTML = "✕";
          btnRemove.onclick = function () {
            stagedItems = stagedItems.filter(function (it) { return it.id !== item.id; });
            renderQueue();
          };
          rightActions.appendChild(btnRemove);
          topRow.appendChild(rightActions);
          card.appendChild(topRow);

          // Optimization Controls (If image)
          if (item.isImage && item.origW > 0) {
            var optBox = document.createElement("div");
            optBox.className = "rounded-xl border border-base-300 bg-base-100 p-3 space-y-2.5 text-xs";

            var toggleRow = document.createElement("div");
            toggleRow.className = "flex items-center justify-between";
            toggleRow.innerHTML = '<span class="font-bold text-[11px] text-base-content/80 uppercase tracking-wider">Optimización y Escalado</span>';

            var toggleLabel = document.createElement("label");
            toggleLabel.className = "label cursor-pointer gap-2 py-0";
            var toggleCheck = document.createElement("input");
            toggleCheck.type = "checkbox";
            toggleCheck.className = "toggle toggle-primary toggle-xs";
            toggleCheck.checked = item.optEnabled;
            toggleCheck.onchange = function () {
              item.optEnabled = toggleCheck.checked;
              controlsDiv.style.display = item.optEnabled ? "" : "none";
            };
            toggleLabel.appendChild(toggleCheck);
            toggleRow.appendChild(toggleLabel);
            optBox.appendChild(toggleRow);

            var controlsDiv = document.createElement("div");
            controlsDiv.className = "grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1";
            controlsDiv.style.display = item.optEnabled ? "" : "none";

            // Format selector
            var fmtField = document.createElement("div");
            fmtField.innerHTML = '<span class="text-[10px] font-bold text-base-content/60 block mb-1">Formato</span>';
            var fmtSel = document.createElement("select");
            fmtSel.className = "select select-bordered select-xs w-full font-semibold";
            fmtSel.innerHTML = '<option value="webp"' + (item.format === "webp" ? " selected" : "") + '>WebP (Recomendado)</option>' +
              '<option value="jpeg"' + (item.format === "jpeg" ? " selected" : "") + '>JPEG</option>' +
              '<option value="png"' + (item.format === "png" ? " selected" : "") + '>PNG</option>' +
              '<option value="original"' + (item.format === "original" ? " selected" : "") + '>Original</option>';
            fmtSel.onchange = function () { item.format = fmtSel.value; };
            fmtField.appendChild(fmtSel);
            controlsDiv.appendChild(fmtField);

            // Width with max constraint
            var widthField = document.createElement("div");
            widthField.innerHTML = '<span class="text-[10px] font-bold text-base-content/60 block mb-1">Ancho (Máx: ' + item.origW + 'px)</span>';
            var widthInput = document.createElement("input");
            widthInput.type = "number";
            widthInput.min = "1";
            widthInput.max = String(item.origW);
            widthInput.value = String(item.width);
            widthInput.className = "input input-bordered input-xs w-full font-mono font-bold";
            widthInput.oninput = function () {
              var val = parseInt(widthInput.value, 10);
              if (val > item.origW) val = item.origW;
              item.width = val || item.origW;
              if (item.lockAspect && item.origH) {
                item.height = Math.round(item.width / (item.origW / item.origH));
                heightInput.value = String(item.height);
              }
            };
            widthField.appendChild(widthInput);
            controlsDiv.appendChild(widthField);

            // Height with max constraint
            var heightField = document.createElement("div");
            heightField.innerHTML = '<span class="text-[10px] font-bold text-base-content/60 block mb-1">Alto (Máx: ' + item.origH + 'px)</span>';
            var heightInput = document.createElement("input");
            heightInput.type = "number";
            heightInput.min = "1";
            heightInput.max = String(item.origH);
            heightInput.value = String(item.height);
            heightInput.className = "input input-bordered input-xs w-full font-mono font-bold";
            heightInput.oninput = function () {
              var val = parseInt(heightInput.value, 10);
              if (val > item.origH) val = item.origH;
              item.height = val || item.origH;
              if (item.lockAspect && item.origW) {
                item.width = Math.round(item.height * (item.origW / item.origH));
                widthInput.value = String(item.width);
              }
            };
            heightField.appendChild(heightInput);
            controlsDiv.appendChild(heightField);

            optBox.appendChild(controlsDiv);
            card.appendChild(optBox);
          }

          queueList.appendChild(card);
        });
      };

      // Clear all
      if (btnClearAll) {
        btnClearAll.addEventListener("click", function () {
          stagedItems = [];
          renderQueue();
        });
      }

      if (btnCancel) {
        btnCancel.addEventListener("click", function () {
          stagedItems = [];
          renderQueue();
        });
      }

      // Optimize a single image item
      var processItem = function (item) {
        return new Promise(function (resolve) {
          if (!item.isImage || !item.optEnabled || !item.imgBitmap) {
            resolve(item.file);
            return;
          }

          var targetW = Math.min(item.width || item.origW, item.origW);
          var targetH = Math.min(item.height || item.origH, item.origH);
          var fmt = item.format || "webp";
          var mime = fmt === "webp" ? "image/webp" : fmt === "jpeg" ? "image/jpeg" : fmt === "png" ? "image/png" : item.file.type;
          var q = (item.quality || 85) / 100;

          var canvas = document.createElement("canvas");
          canvas.width = targetW;
          canvas.height = targetH;
          var ctx = canvas.getContext("2d");
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = "high";

          ctx.drawImage(item.imgBitmap, 0, 0, targetW, targetH);

          canvas.toBlob(function (blob) {
            if (!blob) {
              resolve(item.file);
              return;
            }
            var cleanName = item.file.name.replace(/\.[^/.]+$/, "");
            var ext = fmt === "webp" ? "webp" : fmt === "jpeg" ? "jpg" : fmt === "png" ? "png" : item.file.name.split(".").pop() || "bin";
            var finalFile = new File([blob], cleanName + "." + ext, { type: mime });
            resolve(finalFile);
          }, mime, q);
        });
      };

      // Upload All Batch Processing
      if (btnUploadAll) {
        btnUploadAll.addEventListener("click", function () {
          if (stagedItems.length === 0) return;

          btnUploadAll.disabled = true;
          if (progressContainer) progressContainer.classList.remove("hidden");

          var total = stagedItems.length;
          var completed = 0;
          var bucketVal = destBucket ? destBucket.value : "media";
          var prefixVal = destPrefix ? destPrefix.value.trim() : "";
          var uploadedResults = [];

          var uploadNext = function (index) {
            if (index >= total) {
              // Finish Batch
              if (progressContainer) progressContainer.classList.add("hidden");
              stageQueue.classList.add("hidden");
              stageSuccess.classList.remove("hidden");

              if (successSummary) {
                successSummary.textContent = (isEn ? "Successfully uploaded " : "Se han subido ") + total + (isEn ? " files to R2." : " archivos a R2.");
              }

              if (successLinksList) {
                successLinksList.innerHTML = "";
                uploadedResults.forEach(function (res) {
                  var row = document.createElement("div");
                  row.className = "flex items-center justify-between gap-2 p-2 rounded-xl bg-base-100 border border-base-300 text-xs";
                  row.innerHTML = '<span class="font-mono truncate max-w-xs font-semibold">' + res.key + '</span>' +
                    '<button type="button" class="btn btn-xs btn-primary font-bold copy-btn" data-url="' + window.location.origin + res.streamUrl + '">Copiar</button>';
                  successLinksList.appendChild(row);
                });

                successLinksList.querySelectorAll(".copy-btn").forEach(function (btn) {
                  btn.addEventListener("click", function () {
                    var u = btn.getAttribute("data-url");
                    navigator.clipboard.writeText(u).then(function () {
                      if (window.AfroUpFeedback) window.AfroUpFeedback.toast(isEn ? "Link copied." : "Enlace copiado.", "success");
                    });
                  });
                });
              }

              // Event dispatch
              document.dispatchEvent(new CustomEvent("r2-upload-success", {
                detail: {
                  files: uploadedResults,
                  bucket: bucketVal,
                  total: total,
                },
              }));

              btnUploadAll.disabled = false;
              return;
            }

            var item = stagedItems[index];
            item.status = "optimizing";
            renderQueue();

            processItem(item).then(function (fileToUpload) {
              item.status = "uploading";
              renderQueue();

              var formData = new FormData();
              formData.append("_intent", "upload");
              formData.append("file", fileToUpload);
              formData.append("bucket", bucketVal);
              if (prefixVal) formData.append("prefix", prefixVal);
              formData.append("customName", fileToUpload.name);

              fetch("/api/admin/r2", { method: "POST", body: formData })
                .then(function (res) { return res.json(); })
                .then(function (res) {
                  if (res.ok) {
                    item.status = "done";
                    item.resultUrl = res.streamUrl;
                    uploadedResults.push(res);
                  } else {
                    item.status = "error";
                  }
                })
                .catch(function () {
                  item.status = "error";
                })
                .finally(function () {
                  completed++;
                  var percent = Math.round((completed / total) * 100);
                  if (progressBar) progressBar.value = percent;
                  if (progressPercent) progressPercent.textContent = percent + "%";
                  if (progressLabel) {
                    progressLabel.textContent = (isEn ? "Uploading " : "Subiendo ") + completed + " / " + total + "...";
                  }

                  uploadNext(index + 1);
                });
            });
          };

          uploadNext(0);
        });
      }

      // Reset
      if (btnReset) {
        btnReset.addEventListener("click", function () {
          stagedItems = [];
          renderQueue();
          if (fileInput) fileInput.value = "";
          if (urlInput) urlInput.value = "";
        });
      }
    };

    bind();
    document.addEventListener("astro:page-load", bind);
  })();
</script>
