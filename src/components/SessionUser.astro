---
import SessionAvatar from "./SessionAvatar.astro";

interface Props {
  id?: string;
  name?: string;
  email?: string;
  avatarUrl?: string | null;
  size?: "sm" | "md" | "lg";
  showEmail?: boolean;
  compact?: boolean;
  menu?: boolean;
  extraHref?: string;
  extraLabel?: string;
  accountHref?: string;
  accountLabel?: string;
  logoutHref?: string;
  logoutLabel?: string;
}

const {
  id,
  name = "",
  email = "",
  avatarUrl = null,
  size = "sm",
  showEmail = false,
  compact = false,
  menu = false,
  extraHref,
  extraLabel,
  accountHref,
  accountLabel,
  logoutHref = "/api/logout?next=/login",
  logoutLabel = "Cerrar sesión",
} = Astro.props;

const menuId = id || `session-user-menu-${Math.random().toString(36).slice(2, 9)}`;
const anchorName = `--${menuId}`;
---

{menu ? (
  <div class:list={[compact ? "" : "w-full"]}>
    <button
      type="button"
      class:list={[
        compact
          ? "btn btn-square btn-ghost overflow-hidden border border-base-300 bg-base-100 p-0"
          : "w-full rounded-box p-1 text-left hover:bg-base-200",
      ]}
      popovertarget={menuId}
      style={`anchor-name:${anchorName}`}
      data-session-tooltip
      data-tip={name}
      data-session-user-btn
    >
      {compact ? (
        <SessionAvatar name={name} avatarUrl={avatarUrl} size={size} />
      ) : (
        <div class="flex min-w-0 items-center gap-2" data-session-user>
          <SessionAvatar name={name} avatarUrl={avatarUrl} size={size} />
          <div class="min-w-0 leading-tight">
            <p class="truncate text-sm font-bold" data-session-name>{name}</p>
            {showEmail ? <p class="truncate text-xs opacity-60" data-session-email>{email}</p> : null}
          </div>
        </div>
      )}
    </button>
    <div
      id={menuId}
      popover
      class:list={[
        "dropdown bg-base-100 rounded-box z-40 w-64 border border-base-300 p-2 shadow-xl",
        compact ? "dropdown-bottom dropdown-end mt-2" : "dropdown-top mb-2",
      ]}
      style={`position-anchor:${anchorName}`}
    >
      {accountHref ? (
        <a class="btn btn-ghost btn-sm w-full justify-start gap-2.5 font-semibold text-base-content/85 hover:text-base-content" href={accountHref}>
          <svg class="size-4 shrink-0"><use href="#ic-user"></use></svg>
          <span>{accountLabel || "Tu cuenta"}</span>
        </a>
      ) : null}
      {extraHref ? (
        <a class="btn btn-ghost btn-sm w-full justify-start gap-2.5 font-semibold text-base-content/85 hover:text-base-content" href={extraHref}>
          <svg class="size-4 shrink-0"><use href="#ic-arrow"></use></svg>
          <span>{extraLabel || "Volver al sitio"}</span>
        </a>
      ) : null}
      <form method="post" action={logoutHref} class="w-full">
        <button type="submit" class="btn btn-ghost btn-sm w-full justify-start gap-2.5 font-semibold text-error/85 hover:text-error hover:bg-error/10" data-admin-signout>
          <svg class="size-4 shrink-0"><use href="#ic-logout"></use></svg>
          <span>{logoutLabel}</span>
        </button>
      </form>
    </div>
  </div>
) : (
  <div class="flex min-w-0 items-center gap-2" data-session-user>
    <SessionAvatar name={name} avatarUrl={avatarUrl} size={size} />
    <div class="min-w-0 leading-tight">
      <p class="truncate text-sm font-bold" data-session-name>{name}</p>
      {showEmail ? <p class="truncate text-xs opacity-60" data-session-email>{email}</p> : null}
    </div>
  </div>
)}
