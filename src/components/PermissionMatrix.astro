---
import type { PermissionAction } from "../lib/rbac";
import type { PermissionGrant } from "../lib/permission-grants";

interface ModuleItem {
  id: number;
  name: string;
}

interface PermissionItem {
  id: number;
  module_id: number;
  action: PermissionAction;
}

interface Props {
  modules: ModuleItem[];
  permissions: PermissionItem[];
  assignments?: Map<number, PermissionGrant>;
  actionLabels: Record<PermissionAction, string>;
  allowLabel: string;
  limitLabel: string;
  translateLabel: string;
  translateNoneLabel: string;
  translateManualLabel: string;
  translateAiLabel: string;
  unlimitedLabel?: string;
  noneLabel?: string;
  helpToggleLabel?: string;
  doneLabel?: string;
  helpCreate?: string;
  helpRead?: string;
  helpUpdate?: string;
  helpDelete?: string;
  helpAllow?: string;
  helpLimit?: string;
  helpTranslate?: string;
  readonly?: boolean;
}

const {
  modules,
  permissions,
  assignments = new Map<number, PermissionGrant>(),
  actionLabels,
  allowLabel,
  limitLabel,
  translateLabel,
  translateNoneLabel,
  translateManualLabel,
  translateAiLabel,
  unlimitedLabel = "All",
  noneLabel = "—",
  helpToggleLabel = "What this means",
  doneLabel = "Done",
  helpCreate = "",
  helpRead = "",
  helpUpdate = "",
  helpDelete = "",
  helpAllow = "",
  helpLimit = "",
  helpTranslate = "",
  readonly = false,
} = Astro.props;

const actions: PermissionAction[] = ["create", "read", "update", "delete"];
const helpByAction: Record<PermissionAction, string> = {
  create: helpCreate,
  read: helpRead,
  update: helpUpdate,
  delete: helpDelete,
};
const byModuleAction = new Map<string, number>();
for (const permission of permissions) {
  byModuleAction.set(`${permission.module_id}:${permission.action}`, permission.id);
}

function chipParts(grant: PermissionGrant | undefined) {
  if (!grant) return [] as Array<{ text: string; tip: string; tone: "neutral" | "ai" }>;
  const parts: Array<{ text: string; tip: string; tone: "neutral" | "ai" }> = [];
  parts.push({ text: allowLabel, tip: allowLabel, tone: "neutral" });
  if (grant.quota !== null) parts.push({ text: String(grant.quota), tip: limitLabel, tone: "neutral" });
  if (grant.translateManual) parts.push({ text: translateManualLabel, tip: translateLabel, tone: "neutral" });
  if (grant.translateAi) parts.push({ text: translateAiLabel, tip: translateLabel, tone: "ai" });
  return parts;
}
---

<div
  class="overflow-x-auto"
  data-permission-matrix
  data-label-allow={allowLabel}
  data-label-all={unlimitedLabel}
  data-label-none={noneLabel}
  data-label-limit={limitLabel}
  data-label-translate={translateLabel}
  data-label-manual={translateManualLabel}
  data-label-ai={translateAiLabel}
>
  <table class="table table-sm">
    <thead>
      <tr>
        <th></th>
        {actions.map((action) => <th class="text-center">{actionLabels[action]}</th>)}
      </tr>
    </thead>
    <tbody>
      {modules.map((module) => (
        <tr>
          <th class="align-middle whitespace-nowrap">
            <button type="button" class="btn btn-ghost btn-sm justify-start px-2" data-open-module={module.id}>
              {module.name}
            </button>
          </th>
          {actions.map((action) => {
            const permissionId = byModuleAction.get(`${module.id}:${action}`);
            if (!permissionId) return <td class="text-center opacity-40">—</td>;
            const grant = assignments.get(permissionId);
            const parts = chipParts(grant);
            return (
              <td class="text-center">
                <button
                  type="button"
                  class="inline-flex max-w-[11rem] flex-wrap items-center justify-center gap-1"
                  data-perm-chip={permissionId}
                  data-open-module={module.id}
                >
                  {parts.length ? (
                    parts.map((part) => (
                      <span
                        class:list={["tooltip tooltip-top", part.tone === "ai" && "tooltip-secondary"]}
                        data-tip={part.tip}
                      >
                        <span class:list={["badge badge-sm badge-soft", part.tone === "ai" && "badge-ai"]}>
                          {part.text}
                        </span>
                      </span>
                    ))
                  ) : (
                    <span class="badge badge-ghost badge-sm">{noneLabel}</span>
                  )}
                </button>
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>

  {modules.map((module) => (
    <dialog class="modal" data-module-modal={module.id}>
      <div class="modal-box max-w-xl">
        <h3 class="font-display text-lg font-bold">{module.name}</h3>
        <details class="collapse collapse-arrow bg-base-200 mt-3">
          <summary class="collapse-title text-sm font-semibold">{helpToggleLabel}</summary>
          <div class="collapse-content text-sm opacity-80">
            <ul class="list-disc space-y-1 pl-4">
              {actions.map((action) => (
                <li><span class="font-semibold">{actionLabels[action]}:</span> {helpByAction[action]}</li>
              ))}
              <li>{helpAllow}</li>
              <li>{helpLimit}</li>
              <li>{helpTranslate}</li>
            </ul>
          </div>
        </details>

        <div class="mt-4 flex flex-col gap-4">
          {actions.map((action) => {
            const permissionId = byModuleAction.get(`${module.id}:${action}`);
            if (!permissionId) return null;
            const grant = assignments.get(permissionId);
            return (
              <fieldset class="fieldset rounded-box border border-base-300 p-3">
                <legend class="fieldset-legend">{actionLabels[action]}</legend>
                <label class="label cursor-pointer justify-start gap-2">
                  <input
                    type="checkbox"
                    class="checkbox checkbox-sm"
                    name="permissionIds"
                    value={permissionId}
                    checked={Boolean(grant)}
                    disabled={readonly}
                    data-allow-box
                  />
                  <span class="label-text">{allowLabel}</span>
                </label>
                <label class="label flex-col items-start gap-1">
                  <span class="label-text opacity-70">{limitLabel}</span>
                  <input
                    class="input input-sm w-32"
                    type="number"
                    min="0"
                    step="1"
                    name={`quota-${permissionId}`}
                    value={grant?.quota ?? ""}
                    placeholder={unlimitedLabel}
                    disabled={readonly}
                    data-quota-input
                    data-permission-id={permissionId}
                  />
                </label>
                <p class="label-text opacity-70">{translateLabel}</p>
                <label class="label cursor-pointer justify-start gap-2">
                  <input
                    type="checkbox"
                    class="checkbox checkbox-sm"
                    name="translateManualIds"
                    value={permissionId}
                    checked={grant?.translateManual === true}
                    disabled={readonly}
                    data-translate-manual
                    data-permission-id={permissionId}
                  />
                  <span class="label-text">{translateManualLabel}</span>
                </label>
                <label class="label cursor-pointer justify-start gap-2">
                  <input
                    type="checkbox"
                    class="checkbox checkbox-ai checkbox-sm"
                    name="translateAiIds"
                    value={permissionId}
                    checked={grant?.translateAi === true}
                    disabled={readonly}
                    data-translate-ai
                    data-permission-id={permissionId}
                  />
                  <span class="label-text">{translateAiLabel}</span>
                </label>
              </fieldset>
            );
          })}
        </div>

        <div class="modal-action">
          <button type="button" class="btn" data-close-modal>{doneLabel}</button>
        </div>
      </div>
      <button type="button" class="modal-backdrop" data-close-modal>{doneLabel}</button>
    </dialog>
  ))}
</div>
<script is:inline src="/permission-matrix.js"></script>
