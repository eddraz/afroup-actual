---
import R2Uploader from "./R2Uploader.astro";
import {
  OG_FORM_NAMES,
  emptyOgMetadata,
  type OpenGraphMetadata,
} from "../lib/og-metadata";

interface Props {
  localeCode: string;
  values?: OpenGraphMetadata;
  canUseAi?: boolean;
  kind: "article" | "category";
  moduleSlug: "articulos" | "categorias";
  primaryLocale?: string;
  locale?: string;
  copy: Record<string, string>;
  disabled?: boolean;
}

const {
  localeCode,
  values = emptyOgMetadata(),
  canUseAi = false,
  kind,
  moduleSlug,
  primaryLocale = "es",
  locale = "es",
  copy,
  disabled = false,
} = Astro.props;

const ogImageId = `og-image-${kind}-${localeCode}`;
const twitterImageId = `og-twitter-image-${kind}-${localeCode}`;

const fields: Array<{ key: keyof typeof OG_FORM_NAMES; label: string; multiline?: boolean }> = [
  { key: "url", label: copy.adminOgUrl || "og:url" },
  { key: "type", label: copy.adminOgType || "og:type" },
  { key: "title", label: copy.adminOgTitle || "og:title" },
  { key: "description", label: copy.adminOgDescription || "og:description", multiline: true },
  { key: "imageAlt", label: copy.adminOgImageAlt || "og:image:alt" },
  { key: "twitterCard", label: copy.adminOgTwitterCard || "twitter:card" },
  { key: "twitterTitle", label: copy.adminOgTwitterTitle || "twitter:title" },
  { key: "twitterDescription", label: copy.adminOgTwitterDescription || "twitter:description", multiline: true },
];
---

<div class="collapse collapse-arrow rounded-2xl border border-base-300 bg-base-200/40">
  <input type="checkbox" />
  <div class="collapse-title font-display text-sm font-bold min-h-0 py-3">
    {copy.adminMetadata || "Opciones avanzadas"}
    <p class="text-xs font-normal text-base-content/60 mt-0.5">{copy.adminMetadataLead || "Metadatos Open Graph y Twitter."}</p>
  </div>
  <div class="collapse-content space-y-3">
    {canUseAi ? (
      <button
        type="button"
        class="btn btn-ai btn-sm gap-2"
        data-og-generate
        data-og-locale={localeCode}
        data-og-kind={kind}
        data-og-module={moduleSlug}
        data-og-primary={primaryLocale}
        data-og-need-fields={kind === "article" ? (copy.adminOgGenerateNeedFields || "") : (copy.adminOgGenerateNeedCategoryFields || "")}
      >
        {copy.adminOgGenerate || "Generar con IA"}
      </button>
    ) : null}
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      {fields.map((field) => (
        <fieldset class:list={["fieldset", field.multiline && "sm:col-span-2"]}>
          <legend class="fieldset-legend text-[11px] font-mono uppercase tracking-wide text-base-content/60">
            {field.label}
          </legend>
          {field.multiline ? (
            <textarea
              class="textarea textarea-bordered w-full text-sm"
              name={`${OG_FORM_NAMES[field.key]}[${localeCode}]`}
              rows="2"
              disabled={disabled}
            >{values[field.key]}</textarea>
          ) : (
            <input
              class="input input-bordered w-full text-sm font-mono"
              name={`${OG_FORM_NAMES[field.key]}[${localeCode}]`}
              value={values[field.key]}
              disabled={disabled}
            />
          )}
        </fieldset>
      ))}
    </div>
    <fieldset class="fieldset">
      <legend class="fieldset-legend text-[11px] font-mono uppercase tracking-wide text-base-content/60">
        {copy.adminOgImage || "og:image"}
      </legend>
      <input
        type="hidden"
        id={ogImageId}
        name={`og_image[${localeCode}]`}
        value={values.image}
        disabled={disabled}
        data-og-image-input
        data-og-twitter-name={`og_twitter_image[${localeCode}]`}
      />
      <R2Uploader
        bucket="media"
        prefix={`og/${kind}`}
        allowedTypes="image/*"
        targetInputId={ogImageId}
        locale={locale}
        flat={true}
        showBucketSelector={false}
        allowAiGenerate={true}
        allowFormContext={kind === "article"}
        canUseAi={canUseAi}
        promptModel="@cf/deepseek-ai/deepseek-v4-flash-0731"
        imageModel="xai/grok-imagine-image-2.0"
        videoModel="bytedance/seedance-2.5"
        musicModel="minimax/music-2.6"
        textModel="@cf/deepseek-ai/deepseek-v4-flash-0731"
        prompt=""
      />
    </fieldset>
    <fieldset class="fieldset">
      <legend class="fieldset-legend text-[11px] font-mono uppercase tracking-wide text-base-content/60">
        {copy.adminOgTwitterImage || "twitter:image"}
      </legend>
      <input
        type="hidden"
        id={twitterImageId}
        name={`og_twitter_image[${localeCode}]`}
        value={values.twitterImage}
        disabled={disabled}
      />
      <R2Uploader
        bucket="media"
        prefix={`og/${kind}/twitter`}
        allowedTypes="image/*"
        targetInputId={twitterImageId}
        locale={locale}
        flat={true}
        showBucketSelector={false}
        allowAiGenerate={true}
        allowFormContext={kind === "article"}
        canUseAi={canUseAi}
        promptModel="@cf/deepseek-ai/deepseek-v4-flash-0731"
        imageModel="xai/grok-imagine-image-2.0"
        videoModel="bytedance/seedance-2.5"
        musicModel="minimax/music-2.6"
        textModel="@cf/deepseek-ai/deepseek-v4-flash-0731"
        prompt=""
      />
    </fieldset>
  </div>
</div>

<script is:inline>
  (function () {
    var readValue = function (form, name) {
      var el = form.querySelector('[name="' + name + '"]');
      return el ? String(el.value || "") : "";
    };
    var strip = function (value) {
      return String(value || "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
    };
    var bind = function () {
      document.querySelectorAll("[data-og-image-input]").forEach(function (input) {
        if (input.dataset.mirrorBound === "true") return;
        input.dataset.mirrorBound = "true";
        input.addEventListener("change", function () {
          var twitterName = input.getAttribute("data-og-twitter-name");
          if (!twitterName) return;
          var form = input.closest("form");
          if (!form) return;
          var twitter = form.querySelector('[name="' + twitterName + '"]');
          if (twitter && !String(twitter.value || "").trim()) twitter.value = input.value;
        });
      });
      document.querySelectorAll("[data-og-generate]").forEach(function (button) {
        if (button.dataset.bound === "true") return;
        button.dataset.bound = "true";
        button.addEventListener("click", function () {
          var locale = button.getAttribute("data-og-locale") || "es";
          var primary = button.getAttribute("data-og-primary") || "es";
          var form = button.closest("form");
          if (!form) return;
          var kind = button.getAttribute("data-og-kind") || "article";
          var title = readValue(form, "title[" + locale + "]").trim() || readValue(form, "title[" + primary + "]").trim();
          var description = readValue(form, "description[" + locale + "]") || readValue(form, "description[" + primary + "]");
          var content = readValue(form, "content_html[" + locale + "]") || readValue(form, "content_html[" + primary + "]");
          var tags = readValue(form, "tags").trim();
          var categoryBoxes = form.querySelectorAll('input[name="categoryIds"]:checked');
          var coverInput = form.querySelector("[data-cover-input], #article-cover-image-input");
          var ogImage = readValue(form, "og_image[" + locale + "]") || (coverInput ? String(coverInput.value || "") : "");
          var categories = [];
          categoryBoxes.forEach(function (box) {
            var label = box.closest("label");
            var name = label ? String(label.textContent || "").replace(/\s+/g, " ").trim() : "";
            categories.push(name || String(box.value || ""));
          });
          var missing = [];
          if (!title) missing.push("title");
          if (!strip(description)) missing.push("description");
          if (kind !== "category") {
            if (!strip(content)) missing.push("content");
            if (!tags) missing.push("tags");
            if (!categories.length) missing.push("categories");
          }
          if (missing.length) {
            var need = button.getAttribute("data-og-need-fields") || "";
            if (window.AfroUpFeedback) window.AfroUpFeedback.toast(need, "error");
            return;
          }
          var data = new FormData();
          data.set("module", button.getAttribute("data-og-module") || "articulos");
          data.set("kind", kind);
          data.set("locale", locale);
          data.set("title", title);
          data.set("description", description);
          data.set("content", content);
          data.set("tags", tags);
          data.set("categories", categories.join(","));
          data.set("image", ogImage);
          data.set("url", readValue(form, "og_url[" + locale + "]"));
          button.disabled = true;
          fetch("/api/admin/og", { method: "POST", body: data })
            .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
            .then(function (result) {
              button.disabled = false;
              if (!result.ok || !result.body || !result.body.metadata) {
                if (window.AfroUpFeedback) window.AfroUpFeedback.toast((result.body && result.body.error) || "No pudimos generar la metadata.", "error");
                return;
              }
              var meta = result.body.metadata;
              var map = {
                url: "og_url",
                type: "og_type",
                title: "og_title",
                description: "og_description",
                image: "og_image",
                imageAlt: "og_image_alt",
                twitterCard: "og_twitter_card",
                twitterTitle: "og_twitter_title",
                twitterDescription: "og_twitter_description",
                twitterImage: "og_twitter_image",
              };
              Object.keys(map).forEach(function (key) {
                var field = form.querySelector('[name="' + map[key] + "[" + locale + ']"]');
                if (field && meta[key]) field.value = meta[key];
              });
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Metadata generada.", "success");
            })
            .catch(function () {
              button.disabled = false;
              if (window.AfroUpFeedback) window.AfroUpFeedback.toast("Error de red.", "error");
            });
        });
      });
    };
    bind();
    document.addEventListener("astro:page-load", bind);
  })();
</script>
