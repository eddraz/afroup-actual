---
import PageLocaleSwitch from "./PageLocaleSwitch.astro";
import R2Uploader from "./R2Uploader.astro";
import { defaultLocale, localizedPath } from "../lib/i18n";
import type { BioTranslationAccess } from "../lib/bio-writes";
import { getCategoryTheme } from "../lib/category-routes";

export interface Props {
  article?: {
    id?: number;
    slug?: string;
    status?: string;
    cover_image_url?: string | null;
    reading_time_minutes?: number | null;
    created_by?: number | null;
    created_by_name?: string | null;
    created_at?: string;
    updated_at?: string;
    published_at?: string | null;
  } | null;
  titles?: Record<string, string>;
  descriptions?: Record<string, string>;
  contents?: Record<string, string>;
  categoryIds?: number[];
  tags?: string[];
  categories: Array<{ id: number; title: string; slug: string }>;
  languages: Array<{ code: string; name: string; native_name: string }>;
  translation: BioTranslationAccess;
  canDelete?: boolean;
  locale: string;
  copy: Record<string, string>;
  backHref: string;
  action?: string;
}

const {
  article,
  titles = {},
  descriptions = {},
  contents = {},
  categoryIds = [],
  tags = [],
  categories = [],
  languages = [],
  translation,
  canDelete = false,
  locale,
  copy,
  backHref,
  action = "/api/admin/articles",
} = Astro.props;

const isEdit = Boolean(article?.id);
const selectedCategoryIds = new Set(categoryIds);
const tagsString = tags.join(", ");
const primaryCategorySlug = categories.find((c) => selectedCategoryIds.has(c.id))?.slug;
const publicPath = article?.slug && primaryCategorySlug
  ? localizedPath(locale, `${primaryCategorySlug}/${article.slug}`)
  : null;
---

<form
  method="post"
  action={action}
  data-article-form
  data-success={copy.adminEditorialSaved}
  data-error={copy.adminEditorialSaveError}
  class="space-y-6"
>
  {isEdit ? <input type="hidden" name="id" value={article?.id} /> : null}

  <!-- Sticky Top Action Bar inside 90% Workspace -->
  <div class="sticky top-0 z-20 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-100/95 p-3.5 backdrop-blur-md shadow-xs">
    <div class="flex items-center gap-3 min-w-0">
      <a class="btn btn-ghost btn-sm gap-1.5 text-xs font-bold" href={backHref}>
        <svg class="size-4"><use href="#ic-arrow"></use></svg>
        <span>{copy.adminArticles}</span>
      </a>
      <span class="text-base-content/30 hidden sm:inline">/</span>
      <span class="font-display font-bold text-sm text-base-content truncate hidden sm:inline max-w-[320px]">
        {isEdit ? (titles[defaultLocale] || article?.slug) : copy.adminNewArticle}
      </span>
      {isEdit && article?.status === "published" ? (
        <span class="badge badge-success badge-xs py-1 px-2 font-bold uppercase tracking-wider hidden md:inline-flex">Publicado</span>
      ) : isEdit ? (
        <span class="badge badge-ghost badge-xs py-1 px-2 font-bold uppercase tracking-wider hidden md:inline-flex">Borrador</span>
      ) : null}
    </div>

    <div class="flex items-center gap-2">
      {publicPath ? (
        <a
          class="btn btn-ghost btn-sm gap-1.5 text-xs border border-base-300 hover:bg-base-200"
          href={article?.status === "published" ? publicPath : `${publicPath}?preview=true`}
          target="_blank"
          rel="noopener noreferrer"
          data-article-preview-btn
          title={article?.status === "published" ? (copy.adminArticleViewPublic || "Ver público") : "Ver vista previa del borrador"}
        >
          <svg class="size-3.5"><use href={article?.status === "published" ? "#ic-link" : "#ic-eye"}></use></svg>
          <span class="hidden sm:inline">{article?.status === "published" ? (copy.adminArticleViewPublic || "Ver público") : "Vista Previa"}</span>
        </a>
      ) : null}

      {isEdit && canDelete ? (
        <button
          class="btn btn-error btn-outline btn-sm text-xs"
          type="button"
          data-article-delete-btn
          data-article-id={article?.id}
          data-article-title={titles[defaultLocale] || article?.slug}
        >
          <svg class="size-3.5"><use href="#ic-trash"></use></svg>
          <span class="hidden sm:inline">{copy.adminDeleteAccept}</span>
        </button>
      ) : null}

      <button class="btn btn-primary btn-sm px-6 font-bold shadow-sm hover:scale-[1.02] transition-transform" type="submit">
        <svg class="size-4"><use href="#ic-check"></use></svg>
        <span>{copy.adminSave || "Guardar Artículo"}</span>
      </button>
    </div>
  </div>

  <!-- Expansive 2-Column Grid (90vw workspace) -->
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 items-start">
    <!-- Left Column: Primary Editorial Canvas (Col 8 on lg, Col 9 on xl) -->
    <div class="space-y-6 lg:col-span-8 xl:col-span-9">
      <!-- Language Selector Header -->
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-100 p-4 shadow-xs">
        <div class="flex items-center gap-2">
          <span class="text-xs font-extrabold uppercase tracking-wider text-base-content/50">Idioma de Edición:</span>
          <PageLocaleSwitch languages={languages} label={copy.adminLanguages} current={defaultLocale} />
        </div>

        {languages.map((language) => {
          const isPrimary = language.code === defaultLocale;
          return !isPrimary && translation.canUseAi ? (
            <button
              class="btn btn-ai btn-xs gap-1.5 font-bold"
              type="button"
              data-translate-all-btn={language.code}
            >
              <svg class="size-3.5"><use href="#ic-sparkles"></use></svg>
              <span>Traducir al {language.native_name} con IA</span>
            </button>
          ) : null;
        })}
      </div>

      <!-- Multilingual Editorial Panels -->
      {languages.map((language) => {
        const isPrimary = language.code === defaultLocale;
        const locked = !isPrimary && !translation.canWrite && !translation.canUseAi;
        const titleVal = titles[language.code] ?? "";
        const descVal = descriptions[language.code] ?? "";
        const contentVal = contents[language.code] ?? "";

        return (
          <div
            class:list={["space-y-6 rounded-3xl border border-base-300 bg-base-100 p-6 sm:p-8 shadow-xs", !isPrimary && "hidden"]}
            data-i18n-panel={language.code}
            data-locale={language.code}
          >
            <!-- Panel Header -->
            <div class="flex items-center justify-between border-b border-base-300 pb-3">
              <span class="badge badge-outline badge-md font-bold gap-1.5 py-1 px-3">
                <span class="size-2 rounded-full bg-primary animate-pulse"></span>
                {language.native_name} ({language.code.toUpperCase()})
              </span>
              <span class="text-xs font-medium text-base-content/50">
                {isPrimary ? "Contenido principal de referencia" : "Versión traducida"}
              </span>
            </div>

            <!-- Title Input (Large Editorial Heading) -->
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase tracking-wider text-base-content/60">
                {copy.adminCategoryTitle || "Título del Artículo"} · {language.native_name}
              </legend>
              <input
                class="input input-bordered w-full font-display text-2xl sm:text-3xl font-extrabold h-auto py-4 px-5 focus:border-primary placeholder:opacity-40"
                name={`title[${language.code}]`}
                data-title-input={language.code}
                maxlength="180"
                required={isPrimary}
                disabled={locked}
                value={titleVal}
                placeholder={isPrimary ? "Escribe un título impactante aquí..." : `Título traducido al ${language.native_name}...`}
              />
            </fieldset>

            <!-- Dek / Short Summary Textarea -->
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase tracking-wider text-base-content/60">
                {copy.adminCategoryDescription || "Bajada o Resumen (Dek)"} · {language.native_name}
              </legend>
              <textarea
                class="textarea textarea-bordered w-full text-base leading-relaxed p-4 focus:border-primary placeholder:opacity-40"
                name={`description[${language.code}]`}
                data-desc-input={language.code}
                rows="2"
                maxlength="500"
                disabled={locked}
                placeholder="Breve introducción o bajada editorial que contextualiza la historia..."
              >{descVal}</textarea>
            </fieldset>

            <!-- Editor.js Canvas -->
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-bold text-xs uppercase tracking-wider text-base-content/60 flex items-center justify-between">
                <span>{copy.adminArticleContent || "Cuerpo del Artículo"} (Editor en Bloques)</span>
                <button
                  class="btn btn-ghost btn-xs gap-1.5 text-xs text-base-content/70 hover:text-base-content"
                  type="button"
                  data-preview-toggle={language.code}
                >
                  <svg class="size-3.5"><use href="#ic-book2"></use></svg>
                  <span>{copy.adminLanguageShow || "Vista previa"}</span>
                </button>
              </legend>

              <div class="space-y-3">
                <!-- Editor.js Container Box -->
                <div class="min-h-[480px] w-full rounded-2xl border border-base-300 bg-base-100 p-6 sm:p-8 shadow-inner focus-within:border-primary/60 transition-colors">
                  <div
                    id={`editorjs-${language.code}`}
                    class="editorjs-holder min-h-[400px] article-prose max-w-none"
                    data-editorjs-locale={language.code}
                    data-disabled={locked ? "true" : "false"}
                  ></div>
                </div>

                <!-- Synced HTML Textarea (hidden) -->
                <textarea
                  class="hidden"
                  name={`content_html[${language.code}]`}
                  data-content-input={language.code}
                >{contentVal}</textarea>

                <!-- Live Preview Box -->
                <div
                  class="hidden rounded-2xl bg-base-200/50 p-6 sm:p-8 border border-base-300 article-prose max-w-none shadow-xs"
                  data-preview-box={language.code}
                >
                  <div class="text-xs uppercase tracking-wider text-base-content/50 font-extrabold mb-4 pb-2 border-b border-base-300">
                    {copy.adminLanguageShow || "Vista previa del artículo"} ({language.code.toUpperCase()})
                  </div>
                  <div data-preview-content={language.code}></div>
                </div>
              </div>
            </fieldset>
          </div>
        );
      })}
    </div>

    <!-- Right Column: Metadata & Publication Settings (Col 4 on lg, Col 3 on xl) -->
    <div class="space-y-6 lg:col-span-4 xl:col-span-3">
      <!-- Card: Estado y Publicación -->
      <div class="rounded-3xl border border-base-300 bg-base-100 p-5 shadow-xs space-y-4">
        <h3 class="font-display font-bold text-sm text-base-content flex items-center gap-2 border-b border-base-300/80 pb-3">
          <svg class="size-4 text-primary"><use href="#ic-pin"></use></svg>
          <span>Publicación & Estado</span>
        </h3>

        <!-- Status Selector -->
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-semibold text-xs text-base-content/70">{copy.adminArticleStatus || "Estado"}</legend>
          <select class="select select-bordered select-sm w-full font-bold" name="status">
            <option value="draft" selected={article?.status !== "published"}>📝 {copy.adminArticleDraft || "Borrador"}</option>
            <option value="published" selected={article?.status === "published"}>🌐 {copy.adminArticlePublished || "Publicado en vivo"}</option>
          </select>
        </fieldset>

        <!-- Slug Input -->
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-semibold text-xs text-base-content/70">{copy.adminCategorySlug || "Slug URL"}</legend>
          <input
            class="input input-bordered input-sm w-full font-mono text-xs"
            name="slug"
            pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
            maxlength="80"
            value={article?.slug ?? ""}
            placeholder="ejemplo-slug-articulo"
          />
        </fieldset>

        <!-- Dynamic Reading Time -->
        <fieldset class="fieldset">
          <div class="flex items-center justify-between">
            <legend class="fieldset-legend font-semibold text-xs text-base-content/70">
              {copy.adminArticleReadingTime || "Tiempo de Lectura"}
            </legend>
            <span class="badge badge-primary badge-xs font-bold gap-1" data-reading-time-badge>
              <svg class="size-3"><use href="#ic-clock"></use></svg>
              <span data-reading-time-text>{article?.reading_time_minutes ? `${article.reading_time_minutes} min` : "1 min"}</span>
            </span>
          </div>
          <div class="join w-full">
            <input
              class="input input-bordered input-sm join-item w-full font-mono font-bold"
              type="number"
              name="reading_time_minutes"
              id="article-reading-time-input"
              data-reading-time-input
              min="1"
              max="120"
              value={article?.reading_time_minutes ?? 1}
              placeholder="1"
            />
            <span class="btn btn-sm btn-neutral join-item pointer-events-none font-semibold text-xs">min</span>
          </div>
          <div class="flex items-center justify-between text-[10px] text-base-content/60 mt-1">
            <span class="flex items-center gap-1 font-medium">
              <span class="size-1.5 rounded-full bg-success animate-pulse"></span>
              Dinámico (~200 ppm)
            </span>
            <span data-word-count-text class="font-mono font-semibold">0 palabras</span>
          </div>
        </fieldset>
      </div>

      <!-- Card: Imagen de Portada -->
      <div class="rounded-3xl border border-base-300 bg-base-100 p-5 shadow-xs space-y-4">
        <h3 class="font-display font-bold text-sm text-base-content flex items-center justify-between border-b border-base-300/80 pb-3">
          <span class="flex items-center gap-2">
            <svg class="size-4 text-accent"><use href="#ic-share"></use></svg>
            <span>{copy.adminArticleCoverImage || "Imagen de Portada"}</span>
          </span>
          {article?.cover_image_url ? (
            <span class="badge badge-success badge-xs py-0.5 font-bold">Asignada</span>
          ) : null}
        </h3>

        <div class="space-y-3">
          <!-- Cover Preview -->
          <div
            class="aspect-video w-full rounded-2xl bg-base-200 border border-base-300 overflow-hidden flex items-center justify-center text-xs text-base-content/50 shadow-2xs relative group"
            data-cover-preview
          >
            {article?.cover_image_url ? (
              <img src={article.cover_image_url} alt="Cover preview" class="size-full object-cover" />
            ) : (
              <div class="flex flex-col items-center gap-1.5 text-base-content/40">
                <svg class="size-7 opacity-40"><use href="#ic-book2"></use></svg>
                <span class="font-semibold text-xs">Sin imagen de portada</span>
              </div>
            )}
          </div>

          <!-- Upload / Optimize Trigger Button -->
          <button
            type="button"
            class="btn btn-sm btn-primary w-full gap-2 font-bold shadow-xs hover:scale-[1.01] transition-transform"
            data-open-cover-modal
          >
            <svg class="size-4"><use href="#ic-cloud"></use></svg>
            <span>{article?.cover_image_url ? "Cambiar / Optimizar Portada" : "Subir y Optimizar Portada"}</span>
          </button>

          {article?.cover_image_url ? (
            <button
              type="button"
              class="btn btn-ghost btn-xs w-full text-error font-semibold"
              data-remove-cover-btn
            >
              Quitar portada actual
            </button>
          ) : (
            <button
              type="button"
              class="btn btn-ghost btn-xs w-full text-error font-semibold hidden"
              data-remove-cover-btn
            >
              Quitar portada actual
            </button>
          )}

          <!-- Hidden cover_image_url input managed by R2Uploader and remove button -->
          <input
            type="hidden"
            name="cover_image_url"
            id="article-cover-image-input"
            data-cover-input
            value={article?.cover_image_url ?? ""}
          />
        </div>

        <!-- Cover Image Uploader Modal -->
        <dialog class="modal z-50" data-cover-modal>
          <div class="modal-box max-w-2xl p-6 bg-base-100 rounded-3xl border border-base-300 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-base-300 pb-3">
              <div class="flex items-center gap-2">
                <span class="size-2.5 rounded-full bg-accent animate-pulse"></span>
                <h3 class="font-display font-bold text-base text-base-content">
                  Subir y Optimizar Portada del Artículo
                </h3>
              </div>
              <button type="button" class="btn btn-circle btn-ghost btn-xs" data-close-cover-modal>✕</button>
            </div>

            <R2Uploader
              bucket="media"
              prefix="covers"
              allowedTypes="image/*"
              targetInputId="article-cover-image-input"
              locale={locale}
              flat={true}
            />
          </div>
        </dialog>
      </div>

      <!-- Card: Categorías -->
      <div class="rounded-3xl border border-base-300 bg-base-100 p-5 shadow-xs space-y-4">
        <h3 class="font-display font-bold text-sm text-base-content flex items-center gap-2 border-b border-base-300/80 pb-3">
          <svg class="size-4 text-secondary"><use href="#ic-stack"></use></svg>
          <span>{copy.adminArticleCategory || "Categorías"}</span>
        </h3>

        <div class="grid grid-cols-1 gap-1.5 rounded-2xl border border-base-300/80 p-2.5 bg-base-200/40 max-h-56 overflow-y-auto">
          {categories.map((category) => {
            const theme = getCategoryTheme(category.slug);
            return (
              <label class="label cursor-pointer justify-start gap-2.5 rounded-xl p-1.5 hover:bg-base-100 transition-colors">
                <input
                  class="checkbox checkbox-xs checkbox-primary rounded-md"
                  type="checkbox"
                  name="categoryIds"
                  value={category.id}
                  checked={selectedCategoryIds.has(category.id)}
                />
                <span class="flex items-center gap-2 text-xs font-bold text-base-content">
                  <span class:list={["size-2 rounded-full", theme.dotClass]}></span>
                  {category.title}
                </span>
              </label>
            );
          })}
        </div>
      </div>

      <!-- Card: Etiquetas (Tags) -->
      <div class="rounded-3xl border border-base-300 bg-base-100 p-5 shadow-xs space-y-4">
        <h3 class="font-display font-bold text-sm text-base-content flex items-center gap-2 border-b border-base-300/80 pb-3">
          <svg class="size-4 text-warning"><use href="#ic-pin"></use></svg>
          <span>{copy.adminArticleTags || "Etiquetas"}</span>
        </h3>

        <textarea
          class="textarea textarea-bordered textarea-sm w-full text-xs leading-relaxed"
          name="tags"
          rows="2"
          maxlength="240"
          placeholder="cultura, musica, historia, diaspora"
        >{tagsString}</textarea>
        <span class="text-[11px] text-base-content/50 block">Separadas por comas.</span>
      </div>

      <!-- Card: Metadatos de Autoría (si es edición) -->
      {isEdit && article ? (
        <div class="rounded-3xl border border-base-300 bg-base-200/40 p-4 text-xs space-y-2 text-base-content/70">
          <div class="flex items-center justify-between border-b border-base-300/60 pb-1.5">
            <span>Autor</span>
            <span class="font-bold text-base-content">{article.created_by_name || "Equipo AfroUp"}</span>
          </div>
          {article.created_at ? (
            <div class="flex items-center justify-between border-b border-base-300/60 pb-1.5">
              <span>Creado</span>
              <span class="font-mono">{article.created_at.slice(0, 10)}</span>
            </div>
          ) : null}
          {article.updated_at ? (
            <div class="flex items-center justify-between">
              <span>Última edición</span>
              <span class="font-mono">{article.updated_at.slice(0, 10)}</span>
            </div>
          ) : null}
        </div>
      ) : null}
    </div>
  </div>
</form>

<script>
  import { initArticleEditors, destroyArticleEditors, blocksToHtml, htmlToBlocks } from "../lib/editorjs-client";

  function setupArticleEditor() {
    const form = document.querySelector<HTMLFormElement>("form[data-article-form]");
    if (!form) return;

    const editors = initArticleEditors();

    // Preview Toggle & Auto-update
    document.querySelectorAll<HTMLButtonElement>("[data-preview-toggle]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", async () => {
        const locale = btn.getAttribute("data-preview-toggle");
        if (!locale) return;
        const box = document.querySelector<HTMLElement>(`[data-preview-box='${locale}']`);
        const content = document.querySelector<HTMLElement>(`[data-preview-content='${locale}']`);
        if (!box || !content) return;

        if (box.classList.contains("hidden")) {
          const editor = editors[locale];
          let html = "";
          if (editor) {
            try {
              const output = await editor.save();
              html = blocksToHtml(output);
            } catch {}
          }
          if (!html) {
            const textarea = document.querySelector<HTMLTextAreaElement>(`[data-content-input='${locale}']`);
            html = textarea?.value || "";
          }
          content.innerHTML = html || "<p class='italic opacity-50'>Sin contenido aún.</p>";
          box.classList.remove("hidden");
        } else {
          box.classList.add("hidden");
        }
      });
    });

    // Live Article Preview Button Action (Auto-sync before opening)
    const previewBtn = document.querySelector<HTMLAnchorElement>("[data-article-preview-btn]");
    if (previewBtn && previewBtn.dataset.bound !== "true") {
      previewBtn.dataset.bound = "true";
      previewBtn.addEventListener("click", async () => {
        for (const [locale, editor] of Object.entries(editors)) {
          try {
            const data = await editor.save();
            const html = blocksToHtml(data);
            const input = document.querySelector<HTMLTextAreaElement>(`[data-content-input='${locale}']`);
            if (input) input.value = html;
          } catch {}
        }
        const formData = new FormData(form);
        try {
          await fetch(form.action, { method: "POST", body: formData });
        } catch {}
      });
    }

    // Live Cover Image Modal & Preview
    const coverInput = document.querySelector<HTMLInputElement>("[data-cover-input]");
    const coverPreview = document.querySelector<HTMLElement>("[data-cover-preview]");
    const coverModal = document.querySelector<HTMLDialogElement>("[data-cover-modal]");
    const openCoverBtn = document.querySelector<HTMLButtonElement>("[data-open-cover-modal]");
    const closeCoverBtn = document.querySelector<HTMLButtonElement>("[data-close-cover-modal]");
    const removeCoverBtn = document.querySelector<HTMLButtonElement>("[data-remove-cover-btn]");

    if (openCoverBtn && coverModal && openCoverBtn.dataset.bound !== "true") {
      openCoverBtn.dataset.bound = "true";
      openCoverBtn.addEventListener("click", () => {
        coverModal.showModal();
      });
    }

    if (closeCoverBtn && coverModal && closeCoverBtn.dataset.bound !== "true") {
      closeCoverBtn.dataset.bound = "true";
      closeCoverBtn.addEventListener("click", () => {
        coverModal.close();
      });
    }

    if (removeCoverBtn && coverInput && removeCoverBtn.dataset.bound !== "true") {
      removeCoverBtn.dataset.bound = "true";
      removeCoverBtn.addEventListener("click", () => {
        coverInput.value = "";
        coverInput.dispatchEvent(new Event("input", { bubbles: true }));
        removeCoverBtn.classList.add("hidden");
      });
    }

    if (coverInput && coverPreview && coverInput.dataset.bound !== "true") {
      coverInput.dataset.bound = "true";
      coverInput.addEventListener("input", () => {
        const val = coverInput.value.trim();
        if (val) {
          coverPreview.innerHTML = `<img src="${val}" alt="Cover preview" class="size-full object-cover" onerror="this.parentElement.innerHTML='<span class=\\'text-error font-semibold\\'>Error al cargar URL</span>'" />`;
          if (removeCoverBtn) removeCoverBtn.classList.remove("hidden");
        } else {
          coverPreview.innerHTML = `<div class="flex flex-col items-center gap-1.5 text-base-content/40"><span class="font-semibold text-xs">Sin imagen de portada</span></div>`;
          if (removeCoverBtn) removeCoverBtn.classList.add("hidden");
        }
      });
    }

    // Auto-close cover modal on successful upload
    document.addEventListener("r2-upload-success", (e: any) => {
      if (e.detail?.files?.length && coverModal && coverModal.open) {
        setTimeout(() => {
          coverModal.close();
          if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Portada asignada y optimizada.", "success");
        }, 800);
      }
    });

    // Dynamic Reading Time Calculation
    const readingTimeInput = document.querySelector<HTMLInputElement>("[data-reading-time-input]");
    const readingTimeText = document.querySelector<HTMLElement>("[data-reading-time-text]");
    const wordCountText = document.querySelector<HTMLElement>("[data-word-count-text]");

    const updateDynamicReadingTime = async () => {
      if (!readingTimeInput) return;

      const primaryTitle = (document.querySelector<HTMLInputElement>("[data-title-input='es']")?.value ||
                            document.querySelector<HTMLInputElement>("[data-title-input]")?.value || "").trim();
      const primaryDesc = (document.querySelector<HTMLTextAreaElement>("[data-desc-input='es']")?.value ||
                           document.querySelector<HTMLTextAreaElement>("[data-desc-input]")?.value || "").trim();

      let bodyHtml = "";
      const primaryEditor = editors["es"] || Object.values(editors)[0];
      if (primaryEditor) {
        try {
          const data = await primaryEditor.save();
          bodyHtml = blocksToHtml(data);
        } catch {}
      }
      if (!bodyHtml) {
        bodyHtml = document.querySelector<HTMLTextAreaElement>("[data-content-input='es']")?.value ||
                   document.querySelector<HTMLTextAreaElement>("[data-content-input]")?.value || "";
      }

      const fullCombined = `${primaryTitle} ${primaryDesc} ${bodyHtml}`;
      const cleanText = fullCombined
        .replace(/<[^>]*>/g, " ")
        .replace(/[^\w\s\u00C0-\u017F]/g, " ")
        .replace(/\s+/g, " ")
        .trim();

      const words = cleanText ? cleanText.split(" ").filter(Boolean).length : 0;
      const calculatedMinutes = Math.max(1, Math.ceil(words / 200));

      readingTimeInput.value = String(calculatedMinutes);
      if (readingTimeText) readingTimeText.textContent = `${calculatedMinutes} min`;
      if (wordCountText) wordCountText.textContent = `${words} palabras`;
    };

    // Calculate immediately on load
    setTimeout(updateDynamicReadingTime, 150);

    // Listen to changes across text inputs
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-title-input], [data-desc-input], [data-content-input]").forEach((inp) => {
      inp.addEventListener("input", () => { updateDynamicReadingTime(); });
    });

    // Listen to Editor.js content change events
    document.addEventListener("editorjs-content-change", () => {
      updateDynamicReadingTime();
    });

    // AI Translation Buttons
    document.querySelectorAll<HTMLButtonElement>("[data-translate-all-btn]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", async () => {
        const targetLocale = btn.getAttribute("data-translate-all-btn");
        if (!targetLocale) return;

        const sourceTitle = document.querySelector<HTMLInputElement>("[data-title-input='es']")?.value || "";
        const sourceDesc = document.querySelector<HTMLTextAreaElement>("[data-desc-input='es']")?.value || "";

        let sourceContent = "";
        const sourceEditor = editors["es"];
        if (sourceEditor) {
          try {
            const saved = await sourceEditor.save();
            sourceContent = blocksToHtml(saved);
            const esInp = document.querySelector<HTMLTextAreaElement>(`[data-content-input='es']`);
            if (esInp) esInp.value = sourceContent;
          } catch {}
        } else {
          sourceContent = document.querySelector<HTMLTextAreaElement>("[data-content-input='es']")?.value || "";
        }

        if (!sourceTitle && !sourceDesc && !sourceContent) {
          if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Primero escribe el contenido en español.", "error");
          return;
        }

        btn.disabled = true;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span class="loading loading-spinner loading-xs"></span> Traduciendo...';

        const tasks: Promise<any>[] = [];

        if (sourceTitle) {
          const formTitle = new FormData();
          formTitle.append("module", "articulos");
          formTitle.append("source", sourceTitle);
          formTitle.append("target", targetLocale);
          tasks.push(
            fetch("/api/admin/translate", { method: "POST", body: formTitle })
              .then((r) => r.json())
              .then((res: any) => {
                if (res.ok && res.text) {
                  const inp = document.querySelector<HTMLInputElement>(`[data-title-input='${targetLocale}']`);
                  if (inp) inp.value = res.text;
                }
              })
          );
        }

        if (sourceDesc) {
          const formDesc = new FormData();
          formDesc.append("module", "articulos");
          formDesc.append("source", sourceDesc);
          formDesc.append("target", targetLocale);
          tasks.push(
            fetch("/api/admin/translate", { method: "POST", body: formDesc })
              .then((r) => r.json())
              .then((res: any) => {
                if (res.ok && res.text) {
                  const inp = document.querySelector<HTMLTextAreaElement>(`[data-desc-input='${targetLocale}']`);
                  if (inp) inp.value = res.text;
                }
              })
          );
        }

        if (sourceContent) {
          const formContent = new FormData();
          formContent.append("module", "articulos");
          formContent.append("source", sourceContent);
          formContent.append("target", targetLocale);
          formContent.append("is_html", "1");
          tasks.push(
            fetch("/api/admin/translate", { method: "POST", body: formContent })
              .then((r) => r.json())
              .then(async (res: any) => {
                if (res.ok && res.text) {
                  const targetEditor = editors[targetLocale];
                  if (targetEditor) {
                    const newBlocks = htmlToBlocks(res.text);
                    if (newBlocks.blocks.length) {
                      await targetEditor.render(newBlocks);
                    }
                  }
                  const inp = document.querySelector<HTMLTextAreaElement>(`[data-content-input='${targetLocale}']`);
                  if (inp) inp.value = res.text;
                }
              })
          );
        }

        try {
          await Promise.all(tasks);
          if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Traducción completada.", "success");
        } catch {
          if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Error al traducir con IA.", "error");
        } finally {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      });
    });

    // Form submit
    if (form.dataset.bound !== "true") {
      form.dataset.bound = "true";
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const submitBtn = form.querySelector<HTMLButtonElement>("button[type='submit']");
        if (submitBtn) submitBtn.disabled = true;

        // Save all EditorJS blocks to hidden content inputs
        for (const [locale, editor] of Object.entries(editors)) {
          try {
            const data = await editor.save();
            const html = blocksToHtml(data);
            const input = document.querySelector<HTMLTextAreaElement>(`[data-content-input='${locale}']`);
            if (input) input.value = html;
          } catch (err) {
            console.warn("EditorJS save warning for locale", locale, err);
          }
        }

        const data = new FormData(form);
        fetch(form.action, { method: "POST", body: data })
          .then((res) => res.json().then((body: any) => ({ ok: res.ok, body })))
          .then((result: any) => {
            if (result.ok) {
              if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast(form.getAttribute("data-success") || "Guardado.", "success");
              setTimeout(() => {
                if (result.body && result.body.id && !form.querySelector("input[name='id']")) {
                  window.location.href = window.location.pathname.replace(/\/articulos\/?$/, "/articulos/" + result.body.id);
                } else {
                  window.location.reload();
                }
              }, 600);
              return;
            }
            if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast(result.body?.error || form.getAttribute("data-error") || "Error al guardar.", "error");
            if (submitBtn) submitBtn.disabled = false;
          })
          .catch(() => {
            if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Error de red.", "error");
            if (submitBtn) submitBtn.disabled = false;
          });
      });
    }

    // Delete confirmation
    document.querySelectorAll<HTMLButtonElement>("[data-article-delete-btn]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-article-id");
        const title = btn.getAttribute("data-article-title") || "este artículo";

        const proceed = () => {
          const data = new FormData();
          if (id) data.append("id", id);
          data.append("_intent", "delete");

          fetch("/api/admin/articles", { method: "POST", body: data })
            .then((res) => res.json())
            .then((res: any) => {
              if (res.ok) {
                if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Artículo eliminado.", "success");
                setTimeout(() => {
                  window.location.href = window.location.pathname.replace(/\/articulos\/[0-9]+\/?$/, "/articulos");
                }, 600);
              } else {
                if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("No se pudo eliminar el artículo.", "error");
              }
            })
            .catch(() => {
              if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Error de red.", "error");
            });
        };

        if ((window as any).AfroUpFeedback && (window as any).AfroUpFeedback.modal) {
          (window as any).AfroUpFeedback.modal({
            title: "Eliminar artículo",
            message: `¿Seguro que quieres eliminar el artículo «${title}»? No podrás recuperarlo.`,
            acceptText: "Eliminar",
            cancelText: "Cancelar",
            onAccept: proceed,
          });
        } else if (confirm(`¿Seguro que quieres eliminar el artículo «${title}»?`)) {
          proceed();
        }
      });
    });
  }

  // Ensure clean teardown on page transition and single init per page load
  document.addEventListener("astro:before-swap", destroyArticleEditors);
  document.addEventListener("astro:page-load", setupArticleEditor);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupArticleEditor();
  }
</script>
