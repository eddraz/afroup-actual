---
import PageLocaleSwitch from "./PageLocaleSwitch.astro";
import { defaultLocale, localizedPath } from "../lib/i18n";
import type { BioTranslationAccess } from "../lib/bio-writes";
import { getCategoryTheme } from "../lib/category-routes";

export interface Props {
  article?: {
    id?: number;
    slug?: string;
    status?: string;
    cover_image_url?: string | null;
    reading_time_minutes?: number | null;
    created_by?: number | null;
    created_by_name?: string | null;
    created_at?: string;
    updated_at?: string;
    published_at?: string | null;
  } | null;
  titles?: Record<string, string>;
  descriptions?: Record<string, string>;
  contents?: Record<string, string>;
  categoryIds?: number[];
  tags?: string[];
  categories: Array<{ id: number; title: string; slug: string }>;
  languages: Array<{ code: string; name: string; native_name: string }>;
  translation: BioTranslationAccess;
  canDelete?: boolean;
  locale: string;
  copy: Record<string, string>;
  backHref: string;
  action?: string;
}

const {
  article,
  titles = {},
  descriptions = {},
  contents = {},
  categoryIds = [],
  tags = [],
  categories = [],
  languages = [],
  translation,
  canDelete = false,
  locale,
  copy,
  backHref,
  action = "/api/admin/articles",
} = Astro.props;

const isEdit = Boolean(article?.id);
const selectedCategoryIds = new Set(categoryIds);
const tagsString = tags.join(", ");
const primaryCategorySlug = categories.find((c) => selectedCategoryIds.has(c.id))?.slug;
const publicPath = article?.slug && primaryCategorySlug
  ? localizedPath(locale, `${primaryCategorySlug}/${article.slug}`)
  : null;
---

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div class="flex items-center gap-3">
    <a class="btn btn-ghost btn-sm" href={backHref}>
      <svg class="size-4"><use href="#ic-arrow"></use></svg>
      {copy.adminArticles}
    </a>
    {publicPath && article?.status === "published" ? (
      <a class="btn btn-outline btn-sm gap-1.5" href={publicPath} target="_blank" rel="noopener noreferrer">
        <svg class="size-4"><use href="#ic-link"></use></svg>
        {copy.adminArticleViewPublic}
      </a>
    ) : null}
  </div>
  {isEdit && canDelete ? (
    <button
      class="btn btn-error btn-outline btn-sm"
      type="button"
      data-article-delete-btn
      data-article-id={article?.id}
      data-article-title={titles[defaultLocale] || article?.slug}
    >
      <svg class="size-4"><use href="#ic-trash"></use></svg>
      {copy.adminDeleteAccept}
    </button>
  ) : null}
</div>

<form
  method="post"
  action={action}
  class="card bg-base-100 border border-base-300 shadow-sm"
  data-article-form
  data-success={copy.adminEditorialSaved}
  data-error={copy.adminEditorialSaveError}
>
  <div class="card-body gap-6">
    {isEdit ? <input type="hidden" name="id" value={article?.id} /> : null}

    <!-- Header / Language switch -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-base-300 pb-4">
      <div>
        <h2 class="font-display text-xl font-bold">
          {isEdit ? `${copy.adminEdit}: ${titles[defaultLocale] || article?.slug}` : copy.adminNewArticle}
        </h2>
        {isEdit && article?.created_by_name ? (
          <p class="text-xs text-base-content/70 mt-0.5">
            {copy.adminArticleAuthor}: <span class="font-semibold text-base-content">{article.created_by_name}</span>
            {article.created_at ? ` · ${copy.adminArticleCreatedAt}: ${article.created_at.slice(0, 10)}` : ""}
            {article.updated_at ? ` · ${copy.adminArticleUpdatedAt}: ${article.updated_at.slice(0, 10)}` : ""}
          </p>
        ) : null}
      </div>
      <PageLocaleSwitch languages={languages} label={copy.adminLanguages} current={defaultLocale} />
    </div>

    <!-- Multilingual fields -->
    {languages.map((language) => {
      const isPrimary = language.code === defaultLocale;
      const locked = !isPrimary && !translation.canWrite && !translation.canUseAi;
      const titleVal = titles[language.code] ?? "";
      const descVal = descriptions[language.code] ?? "";
      const contentVal = contents[language.code] ?? "";

      return (
        <div
          class:list={["flex flex-col gap-4", !isPrimary && "hidden"]}
          data-i18n-panel={language.code}
          data-locale={language.code}
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="badge badge-outline font-semibold gap-1">
              <span class="size-2 rounded-full bg-primary"></span>
              {language.native_name} ({language.code.toUpperCase()})
            </span>
            {!isPrimary && translation.canUseAi ? (
              <button
                class="btn btn-ai btn-sm gap-1.5"
                type="button"
                data-translate-all-btn={language.code}
              >
                <svg class="size-4"><use href="#ic-sparkles"></use></svg>
                {copy.adminTranslateWithAi}
              </button>
            ) : null}
          </div>

          <!-- Title -->
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold">
              {copy.adminCategoryTitle} · {language.native_name}
            </legend>
            <input
              class="input input-bordered w-full font-semibold"
              name={`title[${language.code}]`}
              data-title-input={language.code}
              maxlength="180"
              required={isPrimary}
              disabled={locked}
              value={titleVal}
              placeholder={isPrimary ? "Título del artículo..." : `Traducción al ${language.native_name}...`}
            />
          </fieldset>

          <!-- Short description / Dek -->
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold">
              {copy.adminCategoryDescription} · {language.native_name}
            </legend>
            <textarea
              class="textarea textarea-bordered w-full leading-relaxed"
              name={`description[${language.code}]`}
              data-desc-input={language.code}
              rows="3"
              maxlength="500"
              disabled={locked}
              placeholder="Descripción corta o bajada (dek) del artículo..."
            >{descVal}</textarea>
          </fieldset>

          <!-- Rich Content with Editor.js -->
          <fieldset class="fieldset">
            <legend class="fieldset-legend font-bold flex items-center justify-between">
              <span>{copy.adminArticleContent} · {language.native_name}</span>
              <div class="flex items-center gap-2">
                <span class="badge badge-sm badge-neutral font-mono">Editor.js</span>
                <button
                  class="btn btn-ghost btn-xs gap-1.5"
                  type="button"
                  data-preview-toggle={language.code}
                >
                  <svg class="size-3.5"><use href="#ic-book2"></use></svg>
                  {copy.adminLanguageShow || "Vista previa"}
                </button>
              </div>
            </legend>

            <div class="flex flex-col gap-3">
              <!-- Editor.js Canvas Box -->
              <div
                class="min-h-[340px] w-full rounded-2xl border border-base-300 bg-base-100 p-6 shadow-xs transition-colors focus-within:border-primary/50"
              >
                <div
                  id={`editorjs-${language.code}`}
                  class="editorjs-holder min-h-[260px] article-prose max-w-none"
                  data-editorjs-locale={language.code}
                  data-disabled={locked ? "true" : "false"}
                ></div>
              </div>

              <!-- Synced HTML Textarea (hidden) -->
              <textarea
                class="hidden"
                name={`content_html[${language.code}]`}
                data-content-input={language.code}
              >{contentVal}</textarea>

              <!-- Live Preview Box -->
              <div
                class="hidden rounded-2xl bg-base-200/40 p-6 border border-base-300 article-prose max-w-none"
                data-preview-box={language.code}
              >
                <div class="text-xs uppercase tracking-wider text-base-content/50 font-bold mb-4 pb-2 border-b border-base-300">
                  {copy.adminLanguageShow || "Vista previa del artículo"} ({language.code.toUpperCase()})
                </div>
                <div data-preview-content={language.code}></div>
              </div>
            </div>
          </fieldset>
        </div>
      );
    })}

    <!-- Global Article Metadata -->
    <div class="border-t border-base-300 pt-4">
      <h3 class="font-display font-bold text-lg mb-3">Configuración y Metadatos</h3>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Slug -->
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-semibold">{copy.adminCategorySlug}</legend>
          <input
            class="input input-bordered w-full"
            name="slug"
            pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
            maxlength="80"
            value={article?.slug ?? ""}
            placeholder="ejemplo-slug-articulo"
          />
        </fieldset>

        <!-- Status -->
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-semibold">{copy.adminArticleStatus}</legend>
          <select class="select select-bordered w-full" name="status">
            <option value="draft" selected={article?.status !== "published"}>{copy.adminArticleDraft}</option>
            <option value="published" selected={article?.status === "published"}>{copy.adminArticlePublished}</option>
          </select>
        </fieldset>

        <!-- Reading Time -->
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-semibold">{copy.adminArticleReadingTime}</legend>
          <input
            class="input input-bordered w-full"
            type="number"
            name="reading_time_minutes"
            min="1"
            max="120"
            value={article?.reading_time_minutes ?? ""}
            placeholder="Auto (según palabras)"
          />
        </fieldset>
      </div>

      <!-- Cover Image URL -->
      <fieldset class="fieldset mt-4">
        <legend class="fieldset-legend font-semibold">{copy.adminArticleCoverImage}</legend>
        <div class="flex flex-col sm:flex-row gap-3 items-start">
          <input
            class="input input-bordered flex-1 w-full"
            name="cover_image_url"
            data-cover-input
            type="text"
            maxlength="500"
            value={article?.cover_image_url ?? ""}
            placeholder={copy.adminArticleCoverImageHelp}
          />
          <div
            class="size-14 rounded-lg bg-base-200 border border-base-300 flex-none overflow-hidden flex items-center justify-center text-xs text-base-content/50"
            data-cover-preview
          >
            {article?.cover_image_url ? (
              <img src={article.cover_image_url} alt="Cover preview" class="size-full object-cover" />
            ) : (
              <span>Sin foto</span>
            )}
          </div>
        </div>
      </fieldset>

      <!-- Categories & Tags -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 mt-4">
        <!-- Categories Multi-check -->
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-semibold">{copy.adminArticleCategory}</legend>
          <div class="grid grid-cols-2 gap-2 rounded-xl border border-base-300 p-3 bg-base-200/40">
            {categories.map((category) => {
              const theme = getCategoryTheme(category.slug);
              return (
                <label class="label cursor-pointer justify-start gap-2.5 rounded-lg p-1 hover:bg-base-100">
                  <input
                    class="checkbox checkbox-sm checkbox-primary"
                    type="checkbox"
                    name="categoryIds"
                    value={category.id}
                    checked={selectedCategoryIds.has(category.id)}
                  />
                  <span class="flex items-center gap-1.5 text-sm font-semibold">
                    <span class:list={["size-2 rounded-full", theme.dotClass]}></span>
                    {category.title}
                  </span>
                </label>
              );
            })}
          </div>
        </fieldset>

        <!-- Tags -->
        <fieldset class="fieldset">
          <legend class="fieldset-legend font-semibold">{copy.adminArticleTags}</legend>
          <textarea
            class="textarea textarea-bordered w-full"
            name="tags"
            rows="3"
            maxlength="240"
            placeholder={copy.adminArticleTagsHelp}
          >{tagsString}</textarea>
        </fieldset>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-end gap-3 border-t border-base-300 pt-4">
      <a class="btn btn-ghost btn-sm" href={backHref}>{copy.adminDeleteCancel}</a>
      <button class="btn btn-primary btn-sm px-6" type="submit">
        <svg class="size-4"><use href="#ic-check"></use></svg>
        {copy.adminSave}
      </button>
    </div>
  </div>
</form>

<script>
  import { initArticleEditors, destroyArticleEditors, blocksToHtml, htmlToBlocks } from "../lib/editorjs-client";

  function setupArticleEditor() {
    const form = document.querySelector<HTMLFormElement>("form[data-article-form]");
    if (!form) return;

    const editors = initArticleEditors();

    // Preview Toggle & Auto-update
    document.querySelectorAll<HTMLButtonElement>("[data-preview-toggle]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", async () => {
        const locale = btn.getAttribute("data-preview-toggle");
        if (!locale) return;
        const box = document.querySelector<HTMLElement>(`[data-preview-box='${locale}']`);
        const content = document.querySelector<HTMLElement>(`[data-preview-content='${locale}']`);
        if (!box || !content) return;

        if (box.classList.contains("hidden")) {
          const editor = editors[locale];
          let html = "";
          if (editor) {
            try {
              const output = await editor.save();
              html = blocksToHtml(output);
            } catch {}
          }
          if (!html) {
            const textarea = document.querySelector<HTMLTextAreaElement>(`[data-content-input='${locale}']`);
            html = textarea?.value || "";
          }
          content.innerHTML = html || "<p class='italic opacity-50'>Sin contenido aún.</p>";
          box.classList.remove("hidden");
        } else {
          box.classList.add("hidden");
        }
      });
    });

    // Live Cover Image Preview
    const coverInput = document.querySelector<HTMLInputElement>("[data-cover-input]");
    const coverPreview = document.querySelector<HTMLElement>("[data-cover-preview]");
    if (coverInput && coverPreview && coverInput.dataset.bound !== "true") {
      coverInput.dataset.bound = "true";
      coverInput.addEventListener("input", () => {
        const val = coverInput.value.trim();
        if (val) {
          coverPreview.innerHTML = `<img src="${val}" alt="Cover preview" class="size-full object-cover" onerror="this.parentElement.innerHTML='Error'" />`;
        } else {
          coverPreview.innerHTML = "<span>Sin foto</span>";
        }
      });
    }

    // AI Translation Buttons
    document.querySelectorAll<HTMLButtonElement>("[data-translate-all-btn]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", async () => {
        const targetLocale = btn.getAttribute("data-translate-all-btn");
        if (!targetLocale) return;

        const sourceTitle = document.querySelector<HTMLInputElement>("[data-title-input='es']")?.value || "";
        const sourceDesc = document.querySelector<HTMLTextAreaElement>("[data-desc-input='es']")?.value || "";

        let sourceContent = "";
        const sourceEditor = editors["es"];
        if (sourceEditor) {
          try {
            const saved = await sourceEditor.save();
            sourceContent = blocksToHtml(saved);
            const esInp = document.querySelector<HTMLTextAreaElement>("[data-content-input='es']");
            if (esInp) esInp.value = sourceContent;
          } catch {}
        } else {
          sourceContent = document.querySelector<HTMLTextAreaElement>("[data-content-input='es']")?.value || "";
        }

        if (!sourceTitle && !sourceDesc && !sourceContent) {
          if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Primero escribe el contenido en español.", "error");
          return;
        }

        btn.disabled = true;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span class="loading loading-spinner loading-xs"></span> Traduciendo...';

        const tasks: Promise<any>[] = [];

        if (sourceTitle) {
          const formTitle = new FormData();
          formTitle.append("module", "articulos");
          formTitle.append("source", sourceTitle);
          formTitle.append("target", targetLocale);
          tasks.push(
            fetch("/api/admin/translate", { method: "POST", body: formTitle })
              .then((r) => r.json())
              .then((res: any) => {
                if (res.ok && res.text) {
                  const inp = document.querySelector<HTMLInputElement>(`[data-title-input='${targetLocale}']`);
                  if (inp) inp.value = res.text;
                }
              })
          );
        }

        if (sourceDesc) {
          const formDesc = new FormData();
          formDesc.append("module", "articulos");
          formDesc.append("source", sourceDesc);
          formDesc.append("target", targetLocale);
          tasks.push(
            fetch("/api/admin/translate", { method: "POST", body: formDesc })
              .then((r) => r.json())
              .then((res: any) => {
                if (res.ok && res.text) {
                  const inp = document.querySelector<HTMLTextAreaElement>(`[data-desc-input='${targetLocale}']`);
                  if (inp) inp.value = res.text;
                }
              })
          );
        }

        if (sourceContent) {
          const formContent = new FormData();
          formContent.append("module", "articulos");
          formContent.append("source", sourceContent);
          formContent.append("target", targetLocale);
          formContent.append("is_html", "1");
          tasks.push(
            fetch("/api/admin/translate", { method: "POST", body: formContent })
              .then((r) => r.json())
              .then(async (res: any) => {
                if (res.ok && res.text) {
                  const targetEditor = editors[targetLocale];
                  if (targetEditor) {
                    const newBlocks = htmlToBlocks(res.text);
                    if (newBlocks.blocks.length) {
                      await targetEditor.render(newBlocks);
                    }
                  }
                  const inp = document.querySelector<HTMLTextAreaElement>(`[data-content-input='${targetLocale}']`);
                  if (inp) inp.value = res.text;
                }
              })
          );
        }

        try {
          await Promise.all(tasks);
          if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Traducción completada.", "success");
        } catch {
          if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Error al traducir con IA.", "error");
        } finally {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      });
    });

    // Form submit
    if (form.dataset.bound !== "true") {
      form.dataset.bound = "true";
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const submitBtn = form.querySelector<HTMLButtonElement>("button[type='submit']");
        if (submitBtn) submitBtn.disabled = true;

        // Save all EditorJS blocks to hidden content inputs
        for (const [locale, editor] of Object.entries(editors)) {
          try {
            const data = await editor.save();
            const html = blocksToHtml(data);
            const input = document.querySelector<HTMLTextAreaElement>(`[data-content-input='${locale}']`);
            if (input) input.value = html;
          } catch (err) {
            console.warn("EditorJS save warning for locale", locale, err);
          }
        }

        const data = new FormData(form);
        fetch(form.action, { method: "POST", body: data })
          .then((res) => res.json().then((body: any) => ({ ok: res.ok, body })))
          .then((result: any) => {
            if (result.ok) {
              if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast(form.getAttribute("data-success") || "Guardado.", "success");
              setTimeout(() => {
                if (result.body && result.body.id && !form.querySelector("input[name='id']")) {
                  window.location.href = window.location.pathname.replace(/\/articulos\/?$/, "/articulos/" + result.body.id);
                } else {
                  window.location.reload();
                }
              }, 600);
              return;
            }
            if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast(result.body?.error || form.getAttribute("data-error") || "Error al guardar.", "error");
            if (submitBtn) submitBtn.disabled = false;
          })
          .catch(() => {
            if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Error de red.", "error");
            if (submitBtn) submitBtn.disabled = false;
          });
      });
    }

    // Delete confirmation
    document.querySelectorAll<HTMLButtonElement>("[data-article-delete-btn]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-article-id");
        const title = btn.getAttribute("data-article-title") || "este artículo";

        const proceed = () => {
          const data = new FormData();
          if (id) data.append("id", id);
          data.append("_intent", "delete");

          fetch("/api/admin/articles", { method: "POST", body: data })
            .then((res) => res.json())
            .then((res: any) => {
              if (res.ok) {
                if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Artículo eliminado.", "success");
                setTimeout(() => {
                  window.location.href = window.location.pathname.replace(/\/articulos\/[0-9]+\/?$/, "/articulos");
                }, 600);
              } else {
                if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("No se pudo eliminar el artículo.", "error");
              }
            })
            .catch(() => {
              if ((window as any).AfroUpFeedback) (window as any).AfroUpFeedback.toast("Error de red.", "error");
            });
        };

        if ((window as any).AfroUpFeedback && (window as any).AfroUpFeedback.modal) {
          (window as any).AfroUpFeedback.modal({
            title: "Eliminar artículo",
            message: `¿Seguro que quieres eliminar el artículo «${title}»? No podrás recuperarlo.`,
            acceptText: "Eliminar",
            cancelText: "Cancelar",
            onAccept: proceed,
          });
        } else if (confirm(`¿Seguro que quieres eliminar el artículo «${title}»?`)) {
          proceed();
        }
      });
    });
  }

  // Ensure clean teardown on page transition and single init per page load
  document.addEventListener("astro:before-swap", destroyArticleEditors);
  document.addEventListener("astro:page-load", setupArticleEditor);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupArticleEditor();
  }
</script>
