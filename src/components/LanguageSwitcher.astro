---
import { defaultLocale, localeFromPath } from "../lib/i18n";

interface Props {
  scope?: "visible" | "all";
}

const { scope = "visible" } = Astro.props;
const current = localeFromPath(Astro.url.pathname);
---

<div class="hidden" data-language-switcher data-current={current} data-default={defaultLocale} data-scope={scope}></div>
<script is:inline>
  (function () {
    var switchPath = function (nextCode, defaultCode) {
      var url = new URL(window.location.href);
      var parts = url.pathname.split("/").filter(Boolean);
      if (parts[0] && parts[0].length === 2) parts.shift();
      var rest = parts.join("/");
      var nextPath = nextCode === defaultCode
        ? (rest ? "/" + rest : "/")
        : "/" + nextCode + (rest ? "/" + rest : "");
      return nextPath + url.search;
    };

    var render = function (root, languages) {
      var current = root.getAttribute("data-current") || "es";
      var defaultCode = root.getAttribute("data-default") || "es";
      var scope = root.getAttribute("data-scope") || "visible";
      var items = languages || [];
      if (scope !== "all" && !items.some(function (item) { return item.code === current; }) && items.length) {
        window.location.replace(switchPath(items[0].code, defaultCode));
        return;
      }
      root.innerHTML = "";
      root.className = "";
      if (items.length <= 1) {
        root.classList.add("hidden");
        return;
      }
      if (items.length === 2) {
        root.className = "join w-full overflow-hidden rounded-field border border-base-300";
        items.forEach(function (item) {
          var link = document.createElement("a");
          link.className = "btn btn-sm join-item flex-1 font-bold" + (item.code === current ? " btn-active bg-neutral/80 text-neutral-content" : "");
          link.href = switchPath(item.code, defaultCode);
          link.textContent = item.code.toUpperCase();
          root.appendChild(link);
        });
        return;
      }
      var select = document.createElement("select");
      select.className = "select select-sm w-full max-w-[11rem]";
      select.setAttribute("aria-label", "Language");
      items.forEach(function (item) {
        var option = document.createElement("option");
        option.value = item.code;
        option.textContent = item.code.toUpperCase() + " — " + (item.nativeName || item.name);
        if (item.code === current) option.selected = true;
        select.appendChild(option);
      });
      select.addEventListener("change", function () {
        window.location.href = switchPath(select.value, defaultCode);
      });
      root.appendChild(select);
    };

    var bind = function () {
      var roots = document.querySelectorAll("[data-language-switcher]");
      if (!roots.length) return;
      var unbound = [];
      roots.forEach(function (root) {
        if (root.dataset.bound !== "true") {
          root.dataset.bound = "true";
          unbound.push(root);
        }
      });
      if (!unbound.length) return;
      var scope = unbound[0].getAttribute("data-scope") || "visible";
      var href = scope === "all" ? "/api/languages?scope=all" : "/api/languages";
      fetch(href, { credentials: "same-origin" })
        .then(function (res) { return res.json(); })
        .then(function (result) {
          if (!result || !result.ok) return;
          unbound.forEach(function (root) {
            render(root, result.languages || []);
          });
        })
        .catch(function () {});
    };

    bind();
    document.addEventListener("astro:page-load", function () {
      document.querySelectorAll("[data-language-switcher]").forEach(function (root) {
        root.dataset.bound = "";
      });
      bind();
    });
  })();
</script>
