---
import { ClientRouter } from "astro:transitions";
import { env } from "cloudflare:workers";
import AfroUpLogo from "../components/AfroUpLogo.astro";
import SessionUser from "../components/SessionUser.astro";
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { getCurrentUser, sessionTokenFrom } from "../lib/admin-scope";
import { joinPath, localizedPath } from "../lib/i18n";
import { routeIds } from "../lib/paths";
import { hasPermission } from "../lib/rbac";
import { resolveRequestCopy } from "../lib/request-locale";

interface Props {
  title?: string;
  active?: "dashboard" | "articles" | "categories" | "storage" | "users" | "comments" | "projects" | "modules" | "permissions" | "roles" | "languages";
}

const { locale, copy } = await resolveRequestCopy(env.DB, Astro.url);
const { title = copy.titleAdmin, active = "dashboard" } = Astro.props;

const adminBase = localizedPath(locale, routeIds.admin);
const paths = {
  home: localizedPath(locale, routeIds.home),
  admin: adminBase,
  articles: joinPath(adminBase, "articulos"),
  categories: joinPath(adminBase, "categorias"),
  storage: joinPath(adminBase, "almacenamiento"),
  users: joinPath(adminBase, "usuarios"),
  comments: joinPath(adminBase, "comentarios"),
  projects: joinPath(adminBase, "proyectos"),
  modules: joinPath(adminBase, "modulos"),
  permissions: joinPath(adminBase, "permisos"),
  roles: joinPath(adminBase, "roles"),
  languages: joinPath(adminBase, "idiomas"),
};
const actor = await getCurrentUser(env.DB, sessionTokenFrom(Astro.cookies));
const canRead = async (slug: string) => Boolean(actor && (await hasPermission(env.DB, actor.id, slug, "read")));
const can = {
  articles: await canRead("articulos"),
  categories: await canRead("categorias"),
  storage: await canRead("almacenamiento"),
  comments: await canRead("comentarios"),
  projects: await canRead("proyectos"),
  modules: await canRead("modulos"),
  permissions: await canRead("permisos"),
  roles: await canRead("roles"),
  users: await canRead("users"),
  languages: await canRead("idiomas"),
};
const showContent = can.articles || can.categories || can.storage || can.comments || can.projects;
const showAccess = can.modules || can.permissions || can.roles || can.users || can.languages;

function navClass(key: NonNullable<Props["active"]>) {
  const base = "min-h-[42px] rounded-xl px-3 py-[9px] text-[15.5px] font-semibold";
  return key === active ? `${base} menu-active` : base;
}
---

<!DOCTYPE html>
<html lang={locale} data-theme="afroup">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" href="/assets/mark-black.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var applyTheme = function (doc) {
          try {
            var stored = localStorage.getItem("afroup-theme");
            var theme = stored === "afroup-dark" || stored === "afroup"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "afroup-dark"
                : "afroup";
            (doc || document).documentElement.setAttribute("data-theme", theme);
          } catch (error) {}
        };
        var applySidebar = function (doc) {
          try {
            var collapsed = localStorage.getItem("afroup-admin-collapsed") === "true";
            var root = (doc || document).documentElement;
            if (collapsed) {
              root.setAttribute("data-admin-collapsed", "true");
            } else {
              root.removeAttribute("data-admin-collapsed");
            }
          } catch (error) {}
        };
        applyTheme(document);
        applySidebar(document);
        document.addEventListener("astro:before-swap", function (event) {
          applyTheme(event.newDocument);
          applySidebar(event.newDocument);
        });
        document.addEventListener("astro:after-swap", function () {
          applyTheme(document);
          applySidebar(document);
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <svg class="absolute" width="0" height="0" aria-hidden="true">
      <defs>
        <symbol id="ic-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l-2 0l9 -9l9 9l-2 0"></path><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"></path><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"></path></symbol>
        <symbol id="ic-book2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12"></path><path d="M19 16h-12a2 2 0 0 0 -2 2"></path><path d="M9 8h6"></path></symbol>
        <symbol id="ic-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path><path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path><path d="M21 21v-2a4 4 0 0 0 -3 -3.85"></path></symbol>
        <symbol id="ic-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path d="M13 6l6 6"></path></symbol>
        <symbol id="ic-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l16 0"></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path></symbol>
        <symbol id="ic-sidebar-collapse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path><path d="M9 4v16"></path><path d="M15 10l-2 2l2 2"></path></symbol>
        <symbol id="ic-sidebar-expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path><path d="M9 4v16"></path><path d="M13 10l2 2l-2 2"></path></symbol>
        <symbol id="ic-share" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4v4c-6.575 1.028 -9.02 6.788 -10 12c-.037 .206 5.384 -5.962 10 -6v4l8 -7l-8 -7"></path></symbol>
        <symbol id="ic-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0"></path></symbol>
        <symbol id="ic-logout" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2"></path><path d="M9 12h12l-3 -3"></path><path d="M18 15l3 -3"></path></symbol>
        <symbol id="ic-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"></path></symbol>
        <symbol id="ic-key" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.555 3.843l3.602 3.602a2.877 2.877 0 0 1 0 4.069l-2.643 2.643a2.877 2.877 0 0 1 -4.069 0l-.301 -.301l-6.558 6.558a2 2 0 0 1 -1.239 .578l-.175 .008h-1.172a1 1 0 0 1 -.993 -.883l-.007 -.117v-1.172a2 2 0 0 1 .467 -1.284l.119 -.13l.414 -.414h2v-2h2v-2l2.144 -2.144l-.301 -.301a2.877 2.877 0 0 1 0 -4.069l2.643 -2.643a2.877 2.877 0 0 1 4.069 0"></path><path d="M15 9h.01"></path></symbol>
        <symbol id="ic-stack" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5l-9 5l-9 -5l9 -5"></path><path d="M3 12l9 5l9 -5"></path><path d="M3 17l9 5l9 -5"></path></symbol>
        <symbol id="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"></path></symbol>
        <symbol id="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454l0 .008"></path></symbol>
        <symbol id="ic-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l16 0"></path><path d="M10 11l0 6"></path><path d="M14 11l0 6"></path><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path></symbol>
        <symbol id="ic-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"></path><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415"></path><path d="M16 5l3 3"></path></symbol>
        <symbol id="ic-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5l0 14"></path><path d="M5 12l14 0"></path></symbol>
        <symbol id="ic-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path></symbol>
        <symbol id="ic-world" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path><path d="M3.6 9h16.8"></path><path d="M3.6 15h16.8"></path><path d="M11.5 3a17 17 0 0 0 0 18"></path><path d="M12.5 3a17 17 0 0 1 0 18"></path></symbol>
        <symbol id="ic-language" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h7"></path><path d="M9 3v2c0 4.418 -2.239 8 -5 8"></path><path d="M5 9c0 2.144 2.952 3.908 6.7 4"></path><path d="M12 20l4 -9l4 9"></path><path d="M19.1 18h-6.2"></path></symbol>
        <symbol id="ic-cloud" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.657 18c-2.572 0 -4.657 -2.007 -4.657 -4.483c0 -2.179 1.637 -3.988 3.784 -4.398c.414 -2.853 2.871 -5.119 5.866 -5.119c3.087 0 5.602 2.41 5.923 5.419a5.11 5.11 0 0 1 1.777 -.319c2.572 0 4.65 2.007 4.65 4.483c0 2.476 -2.078 4.483 -4.65 4.483l-12.693 0"></path></symbol>
        <symbol id="ic-folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2"></path></symbol>
      </defs>
    </svg>

    <div class="drawer lg:drawer-open h-screen h-dvh max-h-screen overflow-hidden" id="admin-layout-drawer">
      <input id="admin-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex h-screen h-dvh max-h-screen flex-col overflow-hidden bg-base-100/50">
        <!-- Top Studio Navbar (Fixed) -->
        <header class="navbar shrink-0 min-h-[64px] border-b border-base-300 bg-base-100/90 px-4 backdrop-blur-md lg:px-8">
          <div class="navbar-start gap-2.5">
            <label for="admin-drawer" class="btn btn-square btn-ghost btn-sm drawer-button lg:hidden" aria-label={copy.adminOpenMenu}>
              <svg class="size-5"><use href="#ic-menu"></use></svg>
            </label>
            <button
              type="button"
              id="admin-sidebar-toggle"
              class="btn btn-square btn-ghost btn-sm hidden lg:inline-flex text-base-content/70 hover:text-base-content hover:bg-base-200"
              aria-label={copy.adminToggleSidebar}
              title={copy.adminToggleSidebar}
            >
              <svg class="size-5 sidebar-icon-collapse"><use href="#ic-sidebar-collapse"></use></svg>
              <svg class="size-5 sidebar-icon-expand hidden"><use href="#ic-sidebar-expand"></use></svg>
            </button>
            
            <div class="flex items-center gap-2">
              <div class="hidden sm:flex items-center gap-2 text-xs font-bold tracking-wide uppercase text-base-content/50">
                <span class="flex items-center gap-1.5 text-base-content/80">
                  <span class="size-1.5 rounded-full bg-accent shadow-[0_0_8px_var(--color-accent)]"></span>
                  Studio
                </span>
                <span>/</span>
              </div>
              <h1 class="font-display text-[18px] sm:text-[20px] leading-tight font-bold tracking-[-0.01em] text-base-content">{title}</h1>
            </div>
          </div>

          <div class="navbar-end gap-2.5">
            <div class="hidden md:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-base-200/80 border border-base-300 text-base-content/70">
              <span class="size-2 rounded-full bg-success animate-pulse"></span>
              <span>D1 Cloudflare</span>
            </div>

            <a
              href={paths.home}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost btn-sm gap-1.5 text-xs font-bold border border-base-300 hover:bg-base-200 text-base-content/80 hover:text-base-content"
              title={copy.adminBackSite || "Ver sitio público"}
            >
              <svg class="size-3.5"><use href="#ic-arrow"></use></svg>
              <span class="hidden sm:inline">{copy.adminBackSite || "Sitio Web"}</span>
            </a>

            <label class="swap swap-rotate btn btn-square btn-ghost btn-sm border border-base-300 hover:bg-base-200" aria-label={copy.themeAria}>
              <input type="checkbox" class="theme-controller" value="afroup-dark" />
              <svg class="swap-off size-4"><use href="#ic-sun"></use></svg>
              <svg class="swap-on size-4"><use href="#ic-moon"></use></svg>
            </label>
          </div>
        </header>

        <!-- Main Content Area (Scrollable content) -->
        <main class="admin-content-scroll w-full flex-1 min-h-0 overflow-y-auto px-4 py-6 sm:px-6 lg:px-8">
          <div class="mx-auto w-full max-w-[1240px]">
            <slot />
          </div>
        </main>
      </div>

      <!-- Sidebar (Fixed Container, only menu scrolls) -->
      <div class="drawer-side z-30 h-screen h-dvh max-h-screen overflow-hidden">
        <label for="admin-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
        <aside id="admin-sidebar" class="flex h-screen h-dvh max-h-screen w-[264px] flex-col border-r border-base-300 bg-base-200 text-base-content backdrop-blur-sm shadow-xs overflow-hidden">
          <!-- Logo Brand Header (Fixed at top) -->
          <a href={paths.admin} class="admin-logo-link block shrink-0 px-6 py-5 border-b border-base-300/60 text-base-content transition-opacity hover:opacity-90" aria-label="AfroUp Studio">
            <div class="admin-logo-full flex items-center justify-between">
              <AfroUpLogo height={28} variant="wordmark" />
              <span class="badge badge-xs badge-accent font-extrabold uppercase tracking-wider py-1.5 px-2">Studio</span>
            </div>
            <div class="admin-logo-mark relative hidden">
              <AfroUpLogo height={28} variant="mark" />
            </div>
          </a>

          <!-- Navigation Links (Only sidebar menu scrolls with thin, black scrollbar) -->
          <div class="sidebar-scroll min-h-0 w-full flex-1 overflow-x-hidden overflow-y-auto">
              <ul class="menu w-full px-3.5 py-4 gap-1">
            <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminDashboard}>
              <a class={navClass("dashboard")} href={paths.admin}>
                <svg class="size-4.5 shrink-0"><use href="#ic-home"></use></svg>
                <span class="admin-nav-label truncate">{copy.adminDashboard}</span>
              </a>
            </li>

            {showContent ? (
              <li class="menu-title mt-4 px-3 text-[11px] font-extrabold tracking-wider uppercase text-base-content/40">
                {copy.adminNavContent || "Editorial & Contenido"}
              </li>
            ) : null}

            {can.articles ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminArticles}>
                <a class={navClass("articles")} href={paths.articles}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-book2"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminArticles}</span>
                </a>
              </li>
            ) : null}

            {can.categories ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminCategories}>
                <a class={navClass("categories")} href={paths.categories}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-stack"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminCategories}</span>
                </a>
              </li>
            ) : null}

            {can.comments ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminComments}>
                <a class={navClass("comments")} href={paths.comments}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-pin"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminComments}</span>
                </a>
              </li>
            ) : null}

            {can.projects ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminProjects}>
                <a class={navClass("projects")} href={paths.projects}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-share"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminProjects}</span>
                </a>
              </li>
            ) : null}

            {can.storage ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminStorage || "Almacenamiento R2"}>
                <a class={navClass("storage")} href={paths.storage}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-cloud"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminStorage || "Almacenamiento R2"}</span>
                </a>
              </li>
            ) : null}

            {showAccess ? (
              <li class="menu-title mt-4 px-3 text-[11px] font-extrabold tracking-wider uppercase text-base-content/40">
                {copy.adminNavAccess || "Sistema & Roles"}
              </li>
            ) : null}

            {can.users ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminUsers}>
                <a class={navClass("users")} href={paths.users}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-users"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminUsers}</span>
                </a>
              </li>
            ) : null}

            {can.roles ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminRoles}>
                <a class={navClass("roles")} href={paths.roles}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-shield"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminRoles}</span>
                </a>
              </li>
            ) : null}

            {can.permissions ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminPermissions}>
                <a class={navClass("permissions")} href={paths.permissions}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-key"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminPermissions}</span>
                </a>
              </li>
            ) : null}

            {can.modules ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminModules}>
                <a class={navClass("modules")} href={paths.modules}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-stack"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminModules}</span>
                </a>
              </li>
            ) : null}

            {can.languages ? (
              <li class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminLanguages}>
                <a class={navClass("languages")} href={paths.languages}>
                  <svg class="size-4.5 shrink-0"><use href="#ic-language"></use></svg>
                  <span class="admin-nav-label truncate">{copy.adminLanguages}</span>
                </a>
              </li>
            ) : null}
          </ul>
          </div>

          <!-- Sidebar Footer with Language Switcher and Session User -->
          <div class="admin-sidebar-footer mt-auto flex shrink-0 flex-col gap-3 border-t border-base-300/80 p-3 bg-base-200">
            <div class="admin-lang-expanded w-full">
              <LanguageSwitcher scope="all" />
            </div>
            <div class="admin-lang-collapsed relative hidden">
              <div class="admin-nav-tooltip tooltip tooltip-right" data-tip={copy.adminLanguages || "Idiomas"}>
                <button
                  type="button"
                  class="btn btn-square btn-ghost overflow-hidden border border-base-300 bg-base-100 p-0"
                  popovertarget="admin-lang-popover"
                  style="anchor-name:--admin-lang"
                  aria-label={copy.adminLanguages || "Idiomas"}
                >
                  <svg class="size-5"><use href="#ic-language"></use></svg>
                </button>
              </div>
              <div
                id="admin-lang-popover"
                popover
                class="dropdown bg-base-100 rounded-box z-40 w-52 border border-base-300 p-3 shadow-xl dropdown-right dropdown-top mb-2"
                style="position-anchor:--admin-lang"
              >
                <div class="mb-2 flex items-center gap-1.5 text-xs font-bold text-base-content/70">
                  <svg class="size-4"><use href="#ic-language"></use></svg>
                  <span>{copy.adminLanguages || "Idiomas"}</span>
                </div>
                <LanguageSwitcher scope="all" />
              </div>
            </div>
            <SessionUser
              showEmail
              menu
              extraHref={paths.home}
              extraLabel={copy.adminBackSite}
              logoutHref={`/api/logout?next=${encodeURIComponent("/login")}`}
              logoutLabel={copy.adminSignOut}
            />
          </div>
        </aside>
      </div>
    </div>

    <div
      id="admin-sidebar-tip"
      role="tooltip"
      class="pointer-events-none fixed z-[100] hidden -translate-y-1/2 rounded-field bg-neutral px-2 py-1 text-xs leading-5 text-neutral-content shadow"
    ></div>

    <style is:global>
      /* Ensure Admin Drawer and Sidebar are strictly bounded to viewport */
      #admin-layout-drawer {
        height: 100vh !important;
        height: 100dvh !important;
        max-height: 100vh !important;
        max-height: 100dvh !important;
        overflow: hidden !important;
      }

      #admin-layout-drawer > .drawer-side,
      .drawer.lg\:drawer-open > .drawer-side {
        height: 100vh !important;
        height: 100dvh !important;
        max-height: 100vh !important;
        max-height: 100dvh !important;
        overflow: hidden !important;
      }

      #admin-sidebar {
        display: flex !important;
        flex-direction: column !important;
        height: 100vh !important;
        height: 100dvh !important;
        max-height: 100vh !important;
        max-height: 100dvh !important;
        width: 264px;
        overflow: hidden !important;
      }

      #admin-sidebar .sidebar-scroll {
        flex: 1 1 0% !important;
        min-height: 0 !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        flex-wrap: nowrap !important;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
      }

      /* Custom Thin Black Scrollbars (sidebar menu & admin content) */
      #admin-sidebar .sidebar-scroll,
      .sidebar-scroll {
        scrollbar-width: thin !important;
        scrollbar-color: #111111 transparent !important;
      }
      #admin-sidebar .sidebar-scroll::-webkit-scrollbar,
      .sidebar-scroll::-webkit-scrollbar {
        width: 5px !important;
        height: 5px !important;
        display: block !important;
      }
      #admin-sidebar .sidebar-scroll::-webkit-scrollbar-track,
      .sidebar-scroll::-webkit-scrollbar-track {
        background: transparent !important;
      }
      #admin-sidebar .sidebar-scroll::-webkit-scrollbar-thumb,
      .sidebar-scroll::-webkit-scrollbar-thumb {
        background: #111111 !important;
        border-radius: 9999px !important;
        min-height: 24px !important;
      }
      #admin-sidebar .sidebar-scroll::-webkit-scrollbar-thumb:hover,
      .sidebar-scroll::-webkit-scrollbar-thumb:hover {
        background: #000000 !important;
      }

      [data-theme="afroup-dark"] #admin-sidebar .sidebar-scroll,
      [data-theme="afroup-dark"] .sidebar-scroll {
        scrollbar-color: #2e2c26 transparent !important;
      }
      [data-theme="afroup-dark"] #admin-sidebar .sidebar-scroll::-webkit-scrollbar-thumb,
      [data-theme="afroup-dark"] .sidebar-scroll::-webkit-scrollbar-thumb {
        background: #2e2c26 !important;
        border: 1px solid rgba(255, 255, 255, 0.18) !important;
      }
      [data-theme="afroup-dark"] #admin-sidebar .sidebar-scroll::-webkit-scrollbar-thumb:hover,
      [data-theme="afroup-dark"] .sidebar-scroll::-webkit-scrollbar-thumb:hover {
        background: #444137 !important;
      }

      .admin-content-scroll {
        scrollbar-width: thin !important;
        scrollbar-color: #18181b transparent !important;
      }
      .admin-content-scroll::-webkit-scrollbar {
        width: 6px !important;
        height: 6px !important;
        display: block !important;
      }
      .admin-content-scroll::-webkit-scrollbar-track {
        background: transparent !important;
      }
      .admin-content-scroll::-webkit-scrollbar-thumb {
        background: #18181b !important;
        border-radius: 9999px !important;
        min-height: 24px !important;
      }
      .admin-content-scroll::-webkit-scrollbar-thumb:hover {
        background: #000000 !important;
      }

      [data-theme="afroup-dark"] .admin-content-scroll {
        scrollbar-color: #2e2c26 transparent !important;
      }
      [data-theme="afroup-dark"] .admin-content-scroll::-webkit-scrollbar-thumb {
        background: #2e2c26 !important;
        border: 1px solid rgba(255, 255, 255, 0.18) !important;
      }
      [data-theme="afroup-dark"] .admin-content-scroll::-webkit-scrollbar-thumb:hover {
        background: #444137 !important;
      }

      #admin-sidebar {
        transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1), padding 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .admin-nav-tooltip::before,
      .admin-nav-tooltip::after {
        display: none !important;
      }

      @media (min-width: 1024px) {
        html[data-admin-collapsed="true"] #admin-sidebar {
          width: 80px;
        }
        html[data-admin-collapsed="true"] .sidebar-icon-collapse {
          display: none;
        }
        html[data-admin-collapsed="true"] .sidebar-icon-expand {
          display: block;
        }
        html[data-admin-collapsed="true"] .admin-logo-link {
          padding-left: 0.5rem;
          padding-right: 0.5rem;
          padding-top: 1.5rem;
          padding-bottom: 1.25rem;
          display: flex;
          justify-content: center;
          align-items: center;
        }
        html[data-admin-collapsed="true"] .admin-logo-full {
          display: none;
        }
        html[data-admin-collapsed="true"] .admin-logo-mark {
          display: flex;
          justify-content: center;
          align-items: center;
        }
        html[data-admin-collapsed="true"] aside .menu {
          padding-left: 0.5rem;
          padding-right: 0.5rem;
        }
        html[data-admin-collapsed="true"] aside .menu > li > a {
          justify-content: center;
          padding-left: 0.5rem;
          padding-right: 0.5rem;
          gap: 0;
        }
        html[data-admin-collapsed="true"] aside .admin-nav-label {
          display: none;
        }
        html[data-admin-collapsed="true"] aside .menu-title {
          display: none;
        }
        html[data-admin-collapsed="true"] aside .admin-sidebar-footer {
          padding: 0.5rem;
          align-items: center;
        }
        html[data-admin-collapsed="true"] .admin-lang-expanded {
          display: none;
        }
        html[data-admin-collapsed="true"] .admin-lang-collapsed {
          display: flex;
          justify-content: center;
          width: 100%;
        }
        html[data-admin-collapsed="true"] aside [data-session-user] .leading-tight {
          display: none;
        }
        html[data-admin-collapsed="true"] aside [data-session-user] {
          justify-content: center;
        }
        html[data-admin-collapsed="true"] aside button[popovertarget="session-user-menu"] {
          display: flex;
          justify-content: center;
          width: 100%;
          padding: 0.25rem;
        }
      }
    </style>

    <script is:inline>
      (function () {
        var bindThemeController = function () {
          var controller = document.querySelector(".theme-controller");
          if (!controller || controller.dataset.bound === "true") return;
          controller.dataset.bound = "true";
          var apply = function (theme) {
            document.documentElement.setAttribute("data-theme", theme);
            controller.checked = theme === "afroup-dark";
            try { localStorage.setItem("afroup-theme", theme); } catch (error) {}
          };
          try {
            var stored = localStorage.getItem("afroup-theme");
            apply(
              stored === "afroup-dark" || stored === "afroup"
                ? stored
                : window.matchMedia("(prefers-color-scheme: dark)").matches
                  ? "afroup-dark"
                  : "afroup"
            );
          } catch (error) {
            apply("afroup");
          }
          controller.addEventListener("change", function () {
            apply(controller.checked ? "afroup-dark" : "afroup");
          });
        };
        bindThemeController();
        document.addEventListener("astro:page-load", bindThemeController);

        var bindSidebarToggle = function () {
          var toggle = document.getElementById("admin-sidebar-toggle");
          if (!toggle || toggle.dataset.bound === "true") return;
          toggle.dataset.bound = "true";
          toggle.addEventListener("click", function () {
            var isCollapsed = document.documentElement.getAttribute("data-admin-collapsed") === "true";
            var next = !isCollapsed;
            var tip = document.getElementById("admin-sidebar-tip");
            if (tip) {
              tip.classList.add("hidden");
              tip.textContent = "";
            }
            if (next) {
              document.documentElement.setAttribute("data-admin-collapsed", "true");
              try { localStorage.setItem("afroup-admin-collapsed", "true"); } catch (e) {}
            } else {
              document.documentElement.removeAttribute("data-admin-collapsed");
              try { localStorage.setItem("afroup-admin-collapsed", "false"); } catch (e) {}
            }
          });
        };
        bindSidebarToggle();
        document.addEventListener("astro:page-load", bindSidebarToggle);

        var bindSidebarTips = function () {
          var tip = document.getElementById("admin-sidebar-tip");
          var sidebar = document.getElementById("admin-sidebar");
          if (!tip || !sidebar || tip.dataset.bound === "true") return;
          tip.dataset.bound = "true";
          var hide = function () {
            tip.classList.add("hidden");
            tip.textContent = "";
          };
          var show = function (el) {
            if (document.documentElement.getAttribute("data-admin-collapsed") !== "true") return;
            if (!window.matchMedia("(min-width: 1024px)").matches) return;
            var text = el.getAttribute("data-tip");
            if (!text) return;
            var rect = el.getBoundingClientRect();
            tip.textContent = text;
            tip.style.top = rect.top + rect.height / 2 + "px";
            tip.style.left = rect.right + 8 + "px";
            tip.classList.remove("hidden");
          };
          sidebar.addEventListener("pointerover", function (event) {
            var el = event.target.closest("[data-tip]");
            if (!el || !sidebar.contains(el)) return;
            show(el);
          });
          sidebar.addEventListener("pointerout", function (event) {
            var el = event.target.closest("[data-tip]");
            if (!el) return;
            if (event.relatedTarget && el.contains(event.relatedTarget)) return;
            hide();
          });
          var scroller = sidebar.querySelector(".sidebar-scroll");
          if (scroller) scroller.addEventListener("scroll", hide, { passive: true });
        };
        bindSidebarTips();
        document.addEventListener("astro:page-load", bindSidebarTips);

        var ROLE_KEY = "afroup-role";
        var ADMIN_USER_KEY = "afroup-admin-user";
        var PUBLIC_PATHS = ["/admin/login", "/admin/usuarios/aceptar"];

        var isPublicPath = function (path) {
          for (var i = 0; i < PUBLIC_PATHS.length; i += 1) {
            if (path.indexOf(PUBLIC_PATHS[i]) !== -1) return true;
          }
          return false;
        };

        document.addEventListener("afroup:session", function (event) {
          var path = window.location.pathname;
          if (isPublicPath(path)) return;
          var result = event.detail || {};
          if (result.ok && result.user) return;
          window.location.replace("/login?next=" + encodeURIComponent(path));
        });

        document.querySelectorAll("[data-admin-signout]").forEach(function (button) {
          if (button.dataset.bound === "true") return;
          button.dataset.bound = "true";
          button.addEventListener("click", function () {
            try {
              localStorage.removeItem(ROLE_KEY);
              localStorage.removeItem(ADMIN_USER_KEY);
            } catch (error) {}
          });
        });
      })();
    </script>
    <script is:inline src="/form-feedback.js"></script>
    <script is:inline src="/session-user.js"></script>
  </body>
</html>
