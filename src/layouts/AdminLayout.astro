---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";
import { routeIds } from "../lib/paths";

interface Props {
  title?: string;
  active?: "dashboard" | "articles" | "users" | "comments" | "projects";
}

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const { title = copy.titleAdmin, active = "dashboard" } = Astro.props;

const paths = {
  home: localizedPath(locale, routeIds.home),
  admin: localizedPath(locale, routeIds.admin),
  articles: `${localizedPath(locale, routeIds.admin)}/articulos`,
  users: `${localizedPath(locale, routeIds.admin)}/usuarios`,
  comments: `${localizedPath(locale, routeIds.admin)}/comentarios`,
  projects: `${localizedPath(locale, routeIds.admin)}/proyectos`,
};

const esAdminHref = locale === "es" ? paths.articles : "/admin/articulos";
const enAdminHref = locale === "en" ? paths.articles : "/en/admin/articulos";

function navClass(key: string) {
  const base = "flex items-center gap-2.5 rounded-lg px-3 py-2 text-[14px] font-semibold transition-colors";
  return key === active
    ? `${base} bg-primary text-primary-content`
    : `${base} text-neutral-content/85 hover:bg-white/10`;
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="astro-view-transitions-enabled" content="true" />
    <meta name="astro-view-transitions-fallback" content="animate" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-base-200 text-base-content min-h-screen">
    <div class="flex min-h-screen flex-col lg:flex-row">
      <aside class="bg-neutral text-neutral-content flex shrink-0 flex-col gap-2 px-4 py-5 lg:w-[232px] lg:min-h-screen">
        <a href={paths.admin} class="flex items-center gap-2 px-2 py-2">
          <span class="font-display text-[18px] font-extrabold tracking-[-0.005em]">AfroUp</span>
          <span class="badge badge-sm badge-accent text-[10px] font-extrabold tracking-[0.16em] uppercase">Admin</span>
        </a>

        <nav class="mt-3 flex flex-1 flex-col gap-1" data-admin-nav>
          <a class={navClass("dashboard")} href={paths.admin}>
            <svg class="size-5"><use href="#ic-home"></use></svg>
            {copy.adminDashboard}
          </a>
          <a class={navClass("articles")} href={paths.articles}>
            <svg class="size-5"><use href="#ic-book2"></use></svg>
            {copy.adminArticles}
          </a>
          <a class={navClass("comments")} href={paths.comments}>
            <svg class="size-5"><use href="#ic-pin"></use></svg>
            {copy.adminComments}
          </a>
          <a class={navClass("projects")} href={paths.projects}>
            <svg class="size-5"><use href="#ic-share"></use></svg>
            {copy.adminProjects}
          </a>
          <a class={navClass("users")} href={paths.users}>
            <svg class="size-5"><use href="#ic-users"></use></svg>
            {copy.adminUsers}
          </a>
        </nav>

        <div class="mt-4 flex flex-col gap-2 border-t border-white/10 pt-4">
          <a class="flex items-center gap-2 rounded-lg px-3 py-2 text-[13.5px] text-neutral-content/70 hover:bg-white/10" href={paths.home}>
            <svg class="size-4"><use href="#ic-arrow"></use></svg>
            {copy.adminBackSite}
          </a>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="bg-base-100 sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-base-300 px-5 py-3 lg:px-8">
          <div class="flex items-center gap-3 text-sm">
            <span class="text-base-content/60">{copy.adminSignedInAs}</span>
            <span class="font-bold">admin@afroup.com</span>
            <span class="badge badge-sm badge-accent">{copy.adminRoleAdmin}</span>
          </div>
          <div class="flex items-center gap-3">
            <a class="btn btn-sm btn-ghost" href={esAdminHref}>ES</a>
            <a class="btn btn-sm btn-ghost" href={enAdminHref}>EN</a>
            <button type="button" class="btn btn-sm btn-dash" data-admin-signout>
              <svg class="size-4"><use href="#ic-logout"></use></svg>
              {copy.adminSignOut}
            </button>
          </div>
        </header>

        <main class="flex-1 px-5 py-6 lg:px-8 lg:py-8">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      (function () {
        var ROLE_KEY = "afroup-role";
        var LOGIN_PATH = "/login";

        var gate = function () {
          var role = localStorage.getItem(ROLE_KEY);
          if (role !== "admin") {
            var back = encodeURIComponent(window.location.pathname);
            window.location.replace(LOGIN_PATH + "?next=" + back);
          }
        };

        var bindSignOut = function () {
          var buttons = document.querySelectorAll("[data-admin-signout]");
          buttons.forEach(function (button) {
            if (button.dataset.bound === "true") return;
            button.dataset.bound = "true";
            button.addEventListener("click", function () {
              localStorage.removeItem(ROLE_KEY);
              window.location.href = LOGIN_PATH;
            });
          });
        };

        gate();
        bindSignOut();
        document.addEventListener("astro:after-swap", function () {
          gate();
          bindSignOut();
        });
      })();
    </script>
  </body>
</html>