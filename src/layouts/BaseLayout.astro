    </svg>

    <div class="drawer lg:drawer-open h-screen h-dvh max-h-screen overflow-hidden" id="site-layout-drawer">
      <input id="site-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex h-screen h-dvh max-h-screen flex-col overflow-hidden">
        <div class="navbar shrink-0 min-h-[74px] border-b border-base-300 bg-base-100/85 px-4 backdrop-blur lg:px-[38px]">
          <div class="navbar-start flex-1 gap-2">
            <label for="site-drawer" class="btn btn-square btn-ghost drawer-button lg:hidden" aria-label={copy.menuAria}>
              <svg class="size-5"><use href="#ic-menu"></use></svg>
            </label>
            <button
              type="button"
              id="site-sidebar-toggle"
              class="btn btn-square btn-ghost hidden lg:inline-flex"
              aria-label={copy.navToggleSidebar}
              title={copy.navToggleSidebar}
            >
              <svg class="size-5 sidebar-icon-collapse"><use href="#ic-sidebar-collapse"></use></svg>
              <svg class="size-5 sidebar-icon-expand hidden"><use href="#ic-sidebar-expand"></use></svg>
            </button>
            <form class="w-full max-w-[440px]" action={paths.search} method="get">
              <label class="input h-11 min-h-11 w-full bg-base-200">
                <svg class="h-[1em] shrink-0 opacity-50" viewBox="0 0 24 24" aria-hidden="true">
                  <use href="#ic-search"></use>
                </svg>
                <input class="grow" type="search" name="q" value={currentQuery} placeholder={copy.searchPlaceholder} aria-label={copy.searchAria} />
                    <button class="btn btn-neutral btn-xs" type="submit">Buscar</button>
              </label>
            </form>
          </div>
          <div class="navbar-end gap-3">
            <span class="font-display hidden text-[15px] font-semibold text-primary sm:inline">{copy.mantra}</span>
                <label class="swap swap-rotate" aria-label={copy.themeAria}>
                  <input type="checkbox" class="theme-controller" value="afroup-dark" />
                  <svg class="swap-off size-5"><use href="#ic-sun"></use></svg>
                  <svg class="swap-on size-5"><use href="#ic-moon"></use></svg>
                </label>
                <div data-session-guest-nav>
                  <div class="tooltip tooltip-bottom" data-tip={copy.navLogin}>
                    <a class="btn btn-square btn-ghost overflow-hidden border border-base-300 bg-base-100 p-0" href={paths.login} aria-label={copy.navLogin}>
                      <SessionAvatar guest />
                    </a>
                  </div>
                </div>
                <div class="hidden" data-session-user-nav>
                  <SessionUser
                    menu
                    compact
                    accountHref={paths.account}
                    accountLabel={copy.navAccount}
                    logoutHref={`/api/logout?next=${encodeURIComponent(paths.login)}`}
                    logoutLabel={copy.accountLogout}
                  />
                </div>
          </div>
        </div>

        <div class="site-content-scroll sidebar-scroll min-h-0 w-full flex-1 overflow-x-hidden overflow-y-auto">
        <main class="mx-auto w-full max-w-[1180px] px-4 pb-10 pt-[30px] sm:px-[18px] lg:px-[38px]">
          <slot />
        </main>

        <div class="bg-neutral text-neutral-content">
          <div class="h-3 w-full bg-[url('/assets/pattern.png')] bg-left bg-[length:300px]"></div>
          <div class="mx-auto w-full max-w-[1180px] px-4 py-10 sm:px-[18px] lg:px-[38px]">
            <div class="mb-7 flex flex-col items-start justify-between gap-4 border-b border-white/10 pb-6 sm:flex-row sm:items-center">
              <AfroUpLogo height={30} class="text-neutral-content" />
              <a class="btn btn-secondary max-sm:btn-block" href={paths.donate}>
                <svg class="size-4"><use href="#ic-heart"></use></svg>
                {copy.donateCta}
              </a>
            </div>
            <footer class="footer sm:footer-horizontal">
              <nav>
                <h6 class="footer-title">{copy.navLearn}</h6>
                <a href={paths.africa}>{copy.navAfrica}</a>
                <a href={paths.diaspora}>{copy.navDiaspora}</a>
                <a href={paths.antirracismo}>{copy.navAntiracism}</a>
                <a href={paths.historia}>{copy.navHistory}</a>
                <a href={paths.estetica}>{copy.navAesthetics}</a>
                <a href={paths.actualidad}>{copy.navCurrent}</a>
              </nav>
              <nav>
                <h6 class="footer-title">{copy.footerAfroup}</h6>
