---
import { ClientRouter } from "astro:transitions";
import AfroUpLogo from "../components/AfroUpLogo.astro";
import SessionAvatar from "../components/SessionAvatar.astro";
import SessionUser from "../components/SessionUser.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import "../styles/global.css";
import { localizedPath, t, getLocaleFromUrl } from "../lib/i18n";
import { routeIds, socials, type NavKey } from "../lib/paths";

interface Props {
  title?: string;
  active?: NavKey | string;
}

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const paths = {
  home: localizedPath(locale, routeIds.home),
  search: localizedPath(locale, routeIds.search),
  africa: localizedPath(locale, routeIds.africa),
  diaspora: localizedPath(locale, routeIds.diaspora),
  antirracismo: localizedPath(locale, routeIds.antirracismo),
  historia: localizedPath(locale, routeIds.historia),
  estetica: localizedPath(locale, routeIds.estetica),
  actualidad: localizedPath(locale, routeIds.actualidad),
  category: routeIds.category,
  store: localizedPath(locale, routeIds.store),
  resources: localizedPath(locale, routeIds.resources),
  donate: localizedPath(locale, routeIds.donate),
  about: localizedPath(locale, routeIds.about),
  contact: localizedPath(locale, routeIds.contact),
  support: localizedPath(locale, routeIds.support),
  community: localizedPath(locale, routeIds.community),
  projects: localizedPath(locale, routeIds.projects),
  entrepreneurs: localizedPath(locale, routeIds.entrepreneurs),
  people: localizedPath(locale, routeIds.people),
  collaborate: localizedPath(locale, routeIds.collaborate),
  saved: localizedPath(locale, routeIds.saved),
  login: localizedPath(locale, routeIds.login),
  signup: localizedPath(locale, routeIds.signup),
  recover: localizedPath(locale, routeIds.recover),
  account: localizedPath(locale, routeIds.account),
};
const { title = copy.titleHome, active = "inicio" } = Astro.props;
const currentQuery = Astro.url.searchParams.get("q") ?? "";

function navClass(key: NavKey) {
  const base = "min-h-[42px] rounded-xl px-3 py-[9px] text-[15.5px] font-semibold";
  return key === active ? `${base} menu-active` : base;
}

function tabClass(key: NavKey) {
  return key === active ? "dock-active" : undefined;
}
---

<!DOCTYPE html>
<html lang={locale} data-theme="afroup">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" href="/assets/mark-black.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
        <script is:inline>
          (function () {
            var applyTheme = function (doc) {
              try {
                var stored = localStorage.getItem("afroup-theme");
                var theme = stored === "afroup-dark" || stored === "afroup"
                  ? stored
                  : window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "afroup-dark"
                    : "afroup";
                (doc || document).documentElement.setAttribute("data-theme", theme);
              } catch (error) {}
            };
            var applySidebar = function (doc) {
              try {
                var collapsed = localStorage.getItem("afroup-site-collapsed") === "true";
                var root = (doc || document).documentElement;
                if (collapsed) {
                  root.setAttribute("data-site-collapsed", "true");
                } else {
                  root.removeAttribute("data-site-collapsed");
                }
              } catch (error) {}
            };
            applyTheme(document);
            applySidebar(document);
            document.addEventListener("astro:before-swap", function (event) {
              applyTheme(event.newDocument);
              applySidebar(event.newDocument);
            });
            document.addEventListener("astro:after-swap", function () {
              applyTheme(document);
              applySidebar(document);
            });
          })();
        </script>
        <ClientRouter />
        <slot name="head" />
  </head>
  <body>
    <svg class="absolute" width="0" height="0" aria-hidden="true">
      <defs>
