---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { localizedPath, switchLocalePath, t, getLocaleFromUrl } from "../lib/i18n";
import { routeIds, type NavKey } from "../lib/paths";

interface Props {
  title?: string;
  active?: NavKey;
}

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const paths = {
  home: localizedPath(locale, routeIds.home),
  search: localizedPath(locale, routeIds.search),
  africa: localizedPath(locale, routeIds.africa),
  diaspora: localizedPath(locale, routeIds.diaspora),
  antirracismo: localizedPath(locale, routeIds.antirracismo),
  historia: localizedPath(locale, routeIds.historia),
  estetica: localizedPath(locale, routeIds.estetica),
  category: routeIds.category,
  store: routeIds.store,
  resources: routeIds.resources,
  donate: routeIds.donate,
  about: routeIds.about,
  contact: routeIds.contact,
  support: routeIds.support,
  projects: routeIds.projects,
  entrepreneurs: routeIds.entrepreneurs,
  people: routeIds.people,
  collaborate: routeIds.collaborate,
};
const { title = copy.titleHome, active = "inicio" } = Astro.props;
const esHref = switchLocalePath(Astro.url, "es");
const enHref = switchLocalePath(Astro.url, "en");
const currentQuery = Astro.url.searchParams.get("q") ?? "";

function navClass(key: NavKey) {
  const base = "min-h-[42px] rounded-xl px-3 py-[9px] text-[15.5px] font-semibold";
  return key === active ? `${base} menu-active` : base;
}

function tabClass(key: NavKey) {
  return key === active ? "dock-active" : undefined;
}
---

<!DOCTYPE html>
<html lang={locale} data-theme="afroup">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" href="/assets/mark-black.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
        <script is:inline>
          (function () {
            var applyTheme = function (doc) {
              try {
                var stored = localStorage.getItem("afroup-theme");
                var theme = stored === "afroup-dark" || stored === "afroup"
                  ? stored
                  : window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "afroup-dark"
                    : "afroup";
                (doc || document).documentElement.setAttribute("data-theme", theme);
              } catch (error) {}
            };
            applyTheme(document);
            document.addEventListener("astro:before-swap", function (event) {
              applyTheme(event.newDocument);
            });
            document.addEventListener("astro:after-swap", function () {
              applyTheme(document);
            });
          })();
        </script>
        <ClientRouter />
        <slot name="head" />
  </head>
  <body>
    <svg class="absolute" width="0" height="0" aria-hidden="true">
      <defs>
        <symbol id="ic-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></symbol>
        <symbol id="ic-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M4 11 12 4l8 7"></path><path d="M6 10v9h12v-9"></path></symbol>
        <symbol id="ic-bag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 8h12l-1 12H7z"></path><path d="M9 8a3 3 0 0 1 6 0"></path></symbol>
        <symbol id="ic-book2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M4 5v15l4-2 4 2 4-2 4 2V5"></path><path d="M8 8h8M8 12h8"></path></symbol>
        <symbol id="ic-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"></circle><path d="M3 20a6 6 0 0 1 12 0"></path><path d="M16 6a3 3 0 0 1 0 6M21 20a6 6 0 0 0-5-5.9"></path></symbol>
        <symbol id="ic-bookmark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 4h12v16l-6-4-6 4z"></path></symbol>
        <symbol id="ic-heart" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C1 9 2.5 5.5 6 5.5c2 0 3.2 1.2 4 2.3.8-1.1 2-2.3 4-2.3 3.5 0 5 3.5 3.5 6.5C19 16.5 12 21 12 21z"></path></symbol>
        <symbol id="ic-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></symbol>
        <symbol id="ic-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></symbol>
        <symbol id="ic-play" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5v14l12-7z"></path></symbol>
        <symbol id="ic-ig" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="5"></rect><circle cx="12" cy="12" r="3.5"></circle><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"></circle></symbol>
            <symbol id="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></symbol>
            <symbol id="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path></symbol>
      </defs>
    </svg>

    <div class="drawer lg:drawer-open">
      <input id="site-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex min-h-screen flex-col">
        <div class="navbar sticky top-0 z-20 min-h-[74px] border-b border-base-300 bg-base-100/85 px-4 backdrop-blur lg:px-[38px]">
          <div class="navbar-start flex-1 gap-2">
            <label for="site-drawer" class="btn btn-square btn-ghost drawer-button lg:hidden" aria-label={copy.menuAria}>
              <svg class="size-5"><use href="#ic-menu"></use></svg>
            </label>
            <form class="w-full max-w-[440px]" action={paths.search} method="get">
              <label class="input h-11 min-h-11 w-full bg-base-200">
                <svg class="h-[1em] shrink-0 opacity-50" viewBox="0 0 24 24" aria-hidden="true">
                  <use href="#ic-search"></use>
                </svg>
                <input class="grow" type="search" name="q" value={currentQuery} placeholder={copy.searchPlaceholder} aria-label={copy.searchAria} />
                    <button class="btn btn-neutral btn-xs" type="submit">Buscar</button>
              </label>
            </form>
          </div>
          <div class="navbar-end gap-3">
            <span class="font-display hidden text-[15px] font-semibold text-primary sm:inline">{copy.mantra}</span>
                <label class="swap swap-rotate" aria-label={copy.themeAria}>
                  <input type="checkbox" class="theme-controller" value="afroup-dark" />
                  <svg class="swap-off size-5"><use href="#ic-sun"></use></svg>
                  <svg class="swap-on size-5"><use href="#ic-moon"></use></svg>
                </label>
          </div>
        </div>

        <main class="mx-auto w-full max-w-[1180px] flex-1 px-4 pb-24 pt-[30px] sm:px-[18px] lg:px-[38px] lg:pb-10">
          <slot />
        </main>

        <div class="bg-neutral text-neutral-content">
          <div class="h-3 w-full bg-[url('/assets/pattern.png')] bg-left bg-[length:300px]"></div>
          <div class="mx-auto w-full max-w-[1180px] px-4 py-10 sm:px-[18px] lg:px-[38px]">
            <div class="mb-7 flex flex-col items-start justify-between gap-4 border-b border-white/10 pb-6 sm:flex-row sm:items-center">
              <img src="/assets/logo-white.png" alt="AfroUp" class="h-[30px] w-auto" />
              <a class="btn btn-secondary max-sm:btn-block" href={paths.donate}>
                <svg class="size-4"><use href="#ic-heart"></use></svg>
                {copy.donateCta}
              </a>
            </div>
            <footer class="footer sm:footer-horizontal">
              <nav>
                <h6 class="footer-title">{copy.navLearn}</h6>
                <a href={paths.africa}>{copy.navAfrica}</a>
                <a href={paths.diaspora}>{copy.navDiaspora}</a>
                <a href={paths.antirracismo}>{copy.navAntiracism}</a>
                <a href={paths.historia}>{copy.navHistory}</a>
                <a href={paths.estetica}>{copy.navAesthetics}</a>
                <a href={paths.category}>{copy.navCurrent}</a>
              </nav>
              <nav>
                <h6 class="footer-title">{copy.footerAfroup}</h6>
                <a href={paths.store}>{copy.navStore}</a>
                <a href={paths.resources}>{copy.navResources}</a>
                <a href={paths.about}>{copy.footerAbout}</a>
                <a href={paths.contact}>{copy.footerContact}</a>
                <a href={paths.support}>{copy.footerSupport}</a>
              </nav>
              <nav>
                <h6 class="footer-title">{copy.navCommunity}</h6>
                <a href={paths.projects}>{copy.footerProjects}</a>
                <a href={paths.entrepreneurs}>{copy.footerEntrepreneurs}</a>
                <a href={paths.people}>{copy.footerPeople}</a>
                <a href={paths.collaborate}>{copy.footerCollaborate}</a>
              </nav>
              <nav>
                <h6 class="footer-title">{copy.footerContactUs}</h6>
                <a href={paths.contact}>hello@afroup.org</a>
                <a href={paths.contact}>+57 320 7146</a>
              </nav>
              <nav>
                <h6 class="footer-title">{copy.footerFollow}</h6>
                <a href="#">Instagram</a>
                <a href="#">TikTok</a>
                <a href="#">YouTube</a>
                <a href="#">Facebook</a>
              </nav>
            </footer>
          </div>
        </div>

        <nav class="dock lg:hidden">
          <a class={tabClass("inicio")} href={paths.home}>
            <svg class="size-5"><use href="#ic-home"></use></svg>
            <span class="dock-label">{copy.navHome}</span>
          </a>
          <a class={tabClass("buscar")} href={paths.search}>
            <svg class="size-5"><use href="#ic-search"></use></svg>
            <span class="dock-label">{copy.navSearch}</span>
          </a>
          <a class={tabClass("tienda")} href={paths.store}>
            <svg class="size-5"><use href="#ic-bag"></use></svg>
            <span class="dock-label">{copy.navStore}</span>
          </a>
          <a class={tabClass("guardados")} href="#">
            <svg class="size-5"><use href="#ic-bookmark"></use></svg>
            <span class="dock-label">{copy.navSaved}</span>
          </a>
          <a class={tabClass("donar")} href={paths.donate}>
            <svg class="size-5"><use href="#ic-heart"></use></svg>
            <span class="dock-label">{copy.navDonate}</span>
          </a>
        </nav>
      </div>

      <div class="drawer-side z-30 overflow-hidden">
        <label for="site-drawer" aria-label={copy.closeMenuAria} class="drawer-overlay"></label>
        <div class="flex h-dvh max-h-dvh w-[264px] flex-col border-r border-base-300 bg-base-200">
          <div class="shrink-0 px-[30px] pt-[30px] pb-[21px]">
            <a href={paths.home}>
              <img src="/assets/logo-black.png" alt="AfroUp" class="h-[30px] w-auto dark:hidden" />
                  <img src="/assets/logo-white.png" alt="AfroUp" class="hidden h-[30px] w-auto dark:block" />
            </a>
          </div>
          <ul class="sidebar-scroll menu min-h-0 w-full grow flex-nowrap overflow-x-hidden overflow-y-auto px-5 py-0">
            <li>
              <a class={navClass("inicio")} href={paths.home}>
                <svg class="size-5"><use href="#ic-home"></use></svg>
                {copy.navHome}
              </a>
            </li>
            <li>
              <a class={navClass("buscar")} href={paths.search}>
                <svg class="size-5"><use href="#ic-search"></use></svg>
                {copy.navSearch}
              </a>
            </li>
            <li class="menu-title text-[11.5px] font-extrabold tracking-[0.16em] text-[#a9a496] uppercase">{copy.navLearn}</li>
            <li>
              <a class={navClass("africa")} href={paths.africa}>
                <span class="size-2 rounded-full bg-primary"></span>
                {copy.navAfrica}
              </a>
            </li>
            <li>
              <a class={navClass("diaspora")} href={paths.diaspora}>
                <span class="size-2 rounded-full bg-accent"></span>
                {copy.navDiaspora}
              </a>
            </li>
            <li>
              <a class={navClass("antirracismo")} href={paths.antirracismo}>
                <span class="size-2 rounded-full bg-secondary"></span>
                {copy.navAntiracism}
              </a>
            </li>
            <li>
              <a class={navClass("historia")} href={paths.historia}>
                <span class="size-2 rounded-full bg-secondary"></span>
                {copy.navHistory}
              </a>
            </li>
            <li>
              <a class={navClass("estetica")} href={paths.estetica}>
                <span class="size-2 rounded-full bg-accent"></span>
                {copy.navAesthetics}
              </a>
            </li>
            <li>
              <a class={navClass("actualidad")} href={paths.category}>
                <span class="size-2 rounded-full bg-primary"></span>
                {copy.navCurrent}
              </a>
            </li>
            <li class="menu-title text-[11.5px] font-extrabold tracking-[0.16em] text-[#a9a496] uppercase">{copy.navCommunity}</li>
            <li>
              <a class={navClass("tienda")} href={paths.store}>
                <svg class="size-5"><use href="#ic-bag"></use></svg>
                {copy.navStore}
              </a>
            </li>
            <li>
              <a class={navClass("recursos")} href={paths.resources}>
                <svg class="size-5"><use href="#ic-book2"></use></svg>
                {copy.navResources}
              </a>
            </li>
            <li>
              <a class={navClass("comunidad")} href={paths.projects}>
                <svg class="size-5"><use href="#ic-users"></use></svg>
                {copy.navCommunity}
              </a>
            </li>
            <li>
              <a class={navClass("guardados")} href="#">
                <svg class="size-5"><use href="#ic-bookmark"></use></svg>
                {copy.navSaved}
              </a>
            </li>
          </ul>
          <div class="mt-auto flex shrink-0 flex-col gap-3 p-4 pt-0">
            <div class="join w-full overflow-hidden rounded-field border border-base-300">
              <a class:list={["btn btn-sm join-item flex-1 font-bold", locale === "es" && "btn-active bg-neutral/80 text-neutral-content"]} href={esHref}>ES</a>
              <a class:list={["btn btn-sm join-item flex-1 font-bold", locale === "en" && "btn-active bg-neutral/80 text-neutral-content"]} href={enHref}>EN</a>
            </div>
            <a class="btn btn-secondary btn-block" href={paths.donate}>
              <svg class="size-4"><use href="#ic-heart"></use></svg>
              {copy.donateCta}
            </a>
          </div>
        </div>
      </div>
    </div>
        <script is:inline>
          (function () {
            var bindThemeController = function () {
              var controller = document.querySelector(".theme-controller");
              if (!controller || controller.dataset.bound === "true") return;
              controller.dataset.bound = "true";
              var apply = function (theme) {
                document.documentElement.setAttribute("data-theme", theme);
                controller.checked = theme === "afroup-dark";
                try { localStorage.setItem("afroup-theme", theme); } catch (error) {}
              };
              try {
                var stored = localStorage.getItem("afroup-theme");
                apply(
                  stored === "afroup-dark" || stored === "afroup"
                    ? stored
                    : window.matchMedia("(prefers-color-scheme: dark)").matches
                      ? "afroup-dark"
                      : "afroup"
                );
              } catch (error) {
                apply("afroup");
              }
              controller.addEventListener("change", function () {
                apply(controller.checked ? "afroup-dark" : "afroup");
              });
            };
            bindThemeController();
            document.addEventListener("astro:page-load", bindThemeController);
          })();
        </script>
  </body>
</html>
