---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { localizedPath, switchLocalePath, t, getLocaleFromUrl } from "../lib/i18n";
import { routeIds, type NavKey } from "../lib/paths";

interface Props {
  title?: string;
  active?: NavKey;
}

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const paths = {
  home: localizedPath(locale, routeIds.home),
  search: localizedPath(locale, routeIds.search),
  africa: localizedPath(locale, routeIds.africa),
  diaspora: localizedPath(locale, routeIds.diaspora),
  antirracismo: localizedPath(locale, routeIds.antirracismo),
  historia: localizedPath(locale, routeIds.historia),
  estetica: localizedPath(locale, routeIds.estetica),
  actualidad: localizedPath(locale, routeIds.actualidad),
  category: routeIds.category,
  store: localizedPath(locale, routeIds.store),
  resources: localizedPath(locale, routeIds.resources),
  donate: localizedPath(locale, routeIds.donate),
  about: localizedPath(locale, routeIds.about),
  contact: localizedPath(locale, routeIds.contact),
  support: localizedPath(locale, routeIds.support),
  community: localizedPath(locale, routeIds.community),
  projects: localizedPath(locale, routeIds.projects),
  entrepreneurs: localizedPath(locale, routeIds.entrepreneurs),
  people: localizedPath(locale, routeIds.people),
  collaborate: localizedPath(locale, routeIds.collaborate),
  saved: localizedPath(locale, routeIds.saved),
};
const { title = copy.titleHome, active = "inicio" } = Astro.props;
const esHref = switchLocalePath(Astro.url, "es");
const enHref = switchLocalePath(Astro.url, "en");
const currentQuery = Astro.url.searchParams.get("q") ?? "";

function navClass(key: NavKey) {
  const base = "min-h-[42px] rounded-xl px-3 py-[9px] text-[15.5px] font-semibold";
  return key === active ? `${base} menu-active` : base;
}

function tabClass(key: NavKey) {
  return key === active ? "dock-active" : undefined;
}
---

<!DOCTYPE html>
<html lang={locale} data-theme="afroup">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" href="/assets/mark-black.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
        <script is:inline>
          (function () {
            var applyTheme = function (doc) {
              try {
                var stored = localStorage.getItem("afroup-theme");
                var theme = stored === "afroup-dark" || stored === "afroup"
                  ? stored
                  : window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "afroup-dark"
                    : "afroup";
                (doc || document).documentElement.setAttribute("data-theme", theme);
              } catch (error) {}
            };
            applyTheme(document);
            document.addEventListener("astro:before-swap", function (event) {
              applyTheme(event.newDocument);
            });
            document.addEventListener("astro:after-swap", function () {
              applyTheme(document);
            });
          })();
        </script>
        <ClientRouter />
        <slot name="head" />
  </head>
  <body>
    <svg class="absolute" width="0" height="0" aria-hidden="true">
      <defs>
        <symbol id="ic-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path></symbol>
            <symbol id="ic-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l-2 0l9 -9l9 9l-2 0"></path><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"></path><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"></path></symbol>
            <symbol id="ic-bag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.331 8h11.339a2 2 0 0 1 1.977 2.304l-1.255 8.152a3 3 0 0 1 -2.966 2.544h-6.852a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304"></path><path d="M9 11v-5a3 3 0 0 1 6 0v5"></path></symbol>
            <symbol id="ic-book2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12"></path><path d="M19 16h-12a2 2 0 0 0 -2 2"></path><path d="M9 8h6"></path></symbol>
            <symbol id="ic-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path><path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path><path d="M21 21v-2a4 4 0 0 0 -3 -3.85"></path></symbol>
            <symbol id="ic-bookmark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 7v14l-6 -4l-6 4v-14a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4"></path></symbol>
            <symbol id="ic-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path></symbol>
            <symbol id="ic-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path d="M13 6l6 6"></path></symbol>
            <symbol id="ic-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l16 0"></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path></symbol>
            <symbol id="ic-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v16l13 -8l-13 -8"></path></symbol>
            <symbol id="ic-ig" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path d="M16.5 7.5v.01"></path></symbol>
            <symbol id="ic-tiktok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7.917v4.034a9.948 9.948 0 0 1 -5 -1.951v4.5a6.5 6.5 0 1 1 -8 -6.326v4.326a2.5 2.5 0 1 0 4 2v-11.5h4.083a6.005 6.005 0 0 0 4.917 4.917"></path></symbol>
            <symbol id="ic-youtube" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8"></path><path d="M10 9l5 3l-5 3l0 -6"></path></symbol>
            <symbol id="ic-facebook" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"></path></symbol>
            <symbol id="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"></path></symbol>
            <symbol id="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454l0 .008"></path></symbol>
            <symbol id="ic-share" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4v4c-6.575 1.028 -9.02 6.788 -10 12c-.037 .206 5.384 -5.962 10 -6v4l8 -7l-8 -7"></path></symbol>
            <symbol id="ic-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15l6 -6"></path><path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464"></path><path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463"></path></symbol>
            <symbol id="ic-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0"></path></symbol>
            <symbol id="ic-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path></symbol>
            <symbol id="ic-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path><path d="M7 11l5 5l5 -5"></path><path d="M12 4l0 12"></path></symbol>
          </defs>
    </svg>

    <div class="drawer lg:drawer-open">
      <input id="site-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex min-h-screen flex-col">
        <div class="navbar sticky top-0 z-20 min-h-[74px] border-b border-base-300 bg-base-100/85 px-4 backdrop-blur lg:px-[38px]">
          <div class="navbar-start flex-1 gap-2">
            <label for="site-drawer" class="btn btn-square btn-ghost drawer-button lg:hidden" aria-label={copy.menuAria}>
              <svg class="size-5"><use href="#ic-menu"></use></svg>
            </label>
            <form class="w-full max-w-[440px]" action={paths.search} method="get">
              <label class="input h-11 min-h-11 w-full bg-base-200">
                <svg class="h-[1em] shrink-0 opacity-50" viewBox="0 0 24 24" aria-hidden="true">
                  <use href="#ic-search"></use>
                </svg>
                <input class="grow" type="search" name="q" value={currentQuery} placeholder={copy.searchPlaceholder} aria-label={copy.searchAria} />
                    <button class="btn btn-neutral btn-xs" type="submit">Buscar</button>
              </label>
            </form>
          </div>
          <div class="navbar-end gap-3">
            <span class="font-display hidden text-[15px] font-semibold text-primary sm:inline">{copy.mantra}</span>
                <label class="swap swap-rotate" aria-label={copy.themeAria}>
                  <input type="checkbox" class="theme-controller" value="afroup-dark" />
                  <svg class="swap-off size-5"><use href="#ic-sun"></use></svg>
                  <svg class="swap-on size-5"><use href="#ic-moon"></use></svg>
                </label>
          </div>
        </div>

        <main class="mx-auto w-full max-w-[1180px] flex-1 px-4 pb-24 pt-[30px] sm:px-[18px] lg:px-[38px] lg:pb-10">
          <slot />
        </main>

        <div class="bg-neutral text-neutral-content">
          <div class="h-3 w-full bg-[url('/assets/pattern.png')] bg-left bg-[length:300px]"></div>
          <div class="mx-auto w-full max-w-[1180px] px-4 py-10 sm:px-[18px] lg:px-[38px]">
            <div class="mb-7 flex flex-col items-start justify-between gap-4 border-b border-white/10 pb-6 sm:flex-row sm:items-center">
              <img src="/assets/logo-white.png" alt="AfroUp" class="h-[30px] w-auto" />
              <a class="btn btn-secondary max-sm:btn-block" href={paths.donate}>
                <svg class="size-4"><use href="#ic-heart"></use></svg>
                {copy.donateCta}
              </a>
            </div>
            <footer class="footer sm:footer-horizontal">
              <nav>
                <h6 class="footer-title">{copy.navLearn}</h6>
                <a href={paths.africa}>{copy.navAfrica}</a>
                <a href={paths.diaspora}>{copy.navDiaspora}</a>
                <a href={paths.antirracismo}>{copy.navAntiracism}</a>
                <a href={paths.historia}>{copy.navHistory}</a>
                <a href={paths.estetica}>{copy.navAesthetics}</a>
                <a href={paths.actualidad}>{copy.navCurrent}</a>
              </nav>
              <nav>
                <h6 class="footer-title">{copy.footerAfroup}</h6>
                <a href={paths.store}>{copy.navStore}</a>
                <a href={paths.resources}>{copy.navResources}</a>
                <a href={paths.about}>{copy.footerAbout}</a>
                <a href={paths.contact}>{copy.footerContact}</a>
                <a href={paths.support}>{copy.footerSupport}</a>
              </nav>
              <nav>
                <h6 class="footer-title">{copy.navCommunity}</h6>
                <a href={paths.projects}>{copy.footerProjects}</a>
                <a href={paths.entrepreneurs}>{copy.footerEntrepreneurs}</a>
                <a href={paths.people}>{copy.footerPeople}</a>
                <a href={paths.collaborate}>{copy.footerCollaborate}</a>
              </nav>
              <nav>
                <h6 class="footer-title">{copy.footerContactUs}</h6>
                <a href={paths.contact}>hello@afroup.org</a>
                <a href={paths.contact}>+57 320 7146</a>
              </nav>
              <nav>
                <h6 class="footer-title">{copy.footerFollow}</h6>
                <a href="#">Instagram</a>
                <a href="#">TikTok</a>
                <a href="#">YouTube</a>
                <a href="#">Facebook</a>
              </nav>
            </footer>
          </div>
        </div>

        <nav class="dock lg:hidden">
          <a class={tabClass("inicio")} href={paths.home}>
            <svg class="size-5"><use href="#ic-home"></use></svg>
            <span class="dock-label">{copy.navHome}</span>
          </a>
          <a class={tabClass("buscar")} href={paths.search}>
            <svg class="size-5"><use href="#ic-search"></use></svg>
            <span class="dock-label">{copy.navSearch}</span>
          </a>
          <a class={tabClass("tienda")} href={paths.store}>
            <svg class="size-5"><use href="#ic-bag"></use></svg>
            <span class="dock-label">{copy.navStore}</span>
          </a>
          <a class={tabClass("guardados")} href={paths.saved}>
            <svg class="size-5"><use href="#ic-bookmark"></use></svg>
            <span class="dock-label">{copy.navSaved}</span>
          </a>
          <a class={tabClass("donar")} href={paths.donate}>
            <svg class="size-5"><use href="#ic-heart"></use></svg>
            <span class="dock-label">{copy.navDonate}</span>
          </a>
        </nav>
      </div>

      <div class="drawer-side z-30 overflow-hidden">
        <label for="site-drawer" aria-label={copy.closeMenuAria} class="drawer-overlay"></label>
        <div class="flex h-dvh max-h-dvh w-[264px] flex-col border-r border-base-300 bg-base-200">
          <div class="shrink-0 px-[30px] pt-[30px] pb-[21px]">
            <a href={paths.home}>
              <img src="/assets/logo-black.png" alt="AfroUp" class="h-[30px] w-auto dark:hidden" />
                  <img src="/assets/logo-white.png" alt="AfroUp" class="hidden h-[30px] w-auto dark:block" />
            </a>
          </div>
          <ul class="sidebar-scroll menu min-h-0 w-full grow flex-nowrap overflow-x-hidden overflow-y-auto px-5 py-0">
            <li>
              <a class={navClass("inicio")} href={paths.home}>
                <svg class="size-5"><use href="#ic-home"></use></svg>
                {copy.navHome}
              </a>
            </li>
            <li>
              <a class={navClass("buscar")} href={paths.search}>
                <svg class="size-5"><use href="#ic-search"></use></svg>
                {copy.navSearch}
              </a>
            </li>
            <li class="menu-title text-[11.5px] font-extrabold tracking-[0.16em] text-[#a9a496] uppercase">{copy.navLearn}</li>
            <li>
              <a class={navClass("africa")} href={paths.africa}>
                <span class="size-2 rounded-full bg-primary"></span>
                {copy.navAfrica}
              </a>
            </li>
            <li>
              <a class={navClass("diaspora")} href={paths.diaspora}>
                <span class="size-2 rounded-full bg-accent"></span>
                {copy.navDiaspora}
              </a>
            </li>
            <li>
              <a class={navClass("antirracismo")} href={paths.antirracismo}>
                <span class="size-2 rounded-full bg-secondary"></span>
                {copy.navAntiracism}
              </a>
            </li>
            <li>
              <a class={navClass("historia")} href={paths.historia}>
                <span class="size-2 rounded-full bg-secondary"></span>
                {copy.navHistory}
              </a>
            </li>
            <li>
              <a class={navClass("estetica")} href={paths.estetica}>
                <span class="size-2 rounded-full bg-accent"></span>
                {copy.navAesthetics}
              </a>
            </li>
            <li>
              <a class={navClass("actualidad")} href={paths.actualidad}>
                <span class="size-2 rounded-full bg-primary"></span>
                {copy.navCurrent}
              </a>
            </li>
            <li class="menu-title text-[11.5px] font-extrabold tracking-[0.16em] text-[#a9a496] uppercase">{copy.navCommunity}</li>
            <li>
              <a class={navClass("tienda")} href={paths.store}>
                <svg class="size-5"><use href="#ic-bag"></use></svg>
                {copy.navStore}
              </a>
            </li>
            <li>
              <a class={navClass("recursos")} href={paths.resources}>
                <svg class="size-5"><use href="#ic-book2"></use></svg>
                {copy.navResources}
              </a>
            </li>
            <li>
              <a class={navClass("comunidad")} href={paths.community}>
                <svg class="size-5"><use href="#ic-users"></use></svg>
                {copy.navCommunity}
              </a>
            </li>
            <li>
              <a class={navClass("guardados")} href={paths.saved}>
                <svg class="size-5"><use href="#ic-bookmark"></use></svg>
                {copy.navSaved}
              </a>
            </li>
          </ul>
          <div class="mt-auto flex shrink-0 flex-col gap-3 p-4 pt-0">
            <div class="join w-full overflow-hidden rounded-field border border-base-300">
              <a class:list={["btn btn-sm join-item flex-1 font-bold", locale === "es" && "btn-active bg-neutral/80 text-neutral-content"]} href={esHref}>ES</a>
              <a class:list={["btn btn-sm join-item flex-1 font-bold", locale === "en" && "btn-active bg-neutral/80 text-neutral-content"]} href={enHref}>EN</a>
            </div>
            <a class="btn btn-secondary btn-block" href={paths.donate}>
              <svg class="size-4"><use href="#ic-heart"></use></svg>
              {copy.donateCta}
            </a>
          </div>
        </div>
      </div>
    </div>
        <script is:inline>
          (function () {
            var bindThemeController = function () {
              var controller = document.querySelector(".theme-controller");
              if (!controller || controller.dataset.bound === "true") return;
              controller.dataset.bound = "true";
              var apply = function (theme) {
                document.documentElement.setAttribute("data-theme", theme);
                controller.checked = theme === "afroup-dark";
                try { localStorage.setItem("afroup-theme", theme); } catch (error) {}
              };
              try {
                var stored = localStorage.getItem("afroup-theme");
                apply(
                  stored === "afroup-dark" || stored === "afroup"
                    ? stored
                    : window.matchMedia("(prefers-color-scheme: dark)").matches
                      ? "afroup-dark"
                      : "afroup"
                );
              } catch (error) {
                apply("afroup");
              }
              controller.addEventListener("change", function () {
                apply(controller.checked ? "afroup-dark" : "afroup");
              });
            };
            bindThemeController();
            document.addEventListener("astro:page-load", bindThemeController);
          })();
        </script>
  </body>
</html>
