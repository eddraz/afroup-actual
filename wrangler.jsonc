{
  "name": "afroup",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afroup-db",
      "database_id": "local-dev-only",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "AfroUp"
  }
}
